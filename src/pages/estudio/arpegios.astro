---
// Arpegios (sección Estudio). El texto está en src/data/estudio/arpegios.md; aquí va
// el mapa del mástil con las notas del arpegio y su recorrido (lib/arpegios.ts).
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import { Content, getHeadings } from '../../data/estudio/arpegios.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';

const indice = getHeadings().filter((h) => h.depth === 2);
const CUALIDADES = [
  ['Imaj7', 'maj7'],
  ['I7', '7'],
  ['Im7', 'm7'],
  ['Im7b5', 'm7b5'],
  ['I°7', '°7'],
  ['ImMaj7', 'mMaj7'],
  ['I6', '6'],
  ['Im6', 'm6'],
  ['I7sus4', '7sus4'],
  ['I', 'Tríada mayor'],
  ['Im', 'Tríada menor'],
];
const CUERDAS = [6, 5, 4, 3, 2, 1];
import { ULTIMA_POSICION } from '../../lib/arpegios.ts';
---

<Base titulo="Arpegios">
  <SelectorTonica clave="arpegios">
    <label>Sonido
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{i.nombre}</option>)}</select>
    </label>
    <Tempo clave="arpegios" inicial={90} />
  </SelectorTonica>

  <section class="ejemplo" aria-label="Mapa del arpegio">
    <div class="opciones">
      <label class="campo">Acorde
        <select data-cualidad>{CUALIDADES.map(([v, n]) => <option value={v}>{n}</option>)}</select>
      </label>
      <div class="grupo-botones" role="group" aria-label="Zona">
        <button type="button" class="boton" data-zona="todo" aria-pressed="false">Todo</button>
        <button type="button" class="boton" data-zona="posicion" aria-pressed="false">Posición</button>
        <button type="button" class="boton" data-zona="cuerda" aria-pressed="false">Una cuerda</button>
        <button type="button" class="boton" data-zona="dos-cuerdas" aria-pressed="false">Dos cuerdas</button>
      </div>
      <label class="campo" data-solo="posicion">Desde el traste
        <select data-desde>{Array.from({ length: ULTIMA_POSICION }, (_, i) => <option value={i + 1}>{i + 1}</option>)}</select>
      </label>
      <label class="campo" data-solo="cuerda">Cuerda
        <select data-cuerda>{CUERDAS.map((c) => <option value={6 - c}>{c}ª</option>)}</select>
      </label>
      <label class="campo" data-solo="dos-cuerdas">Cuerdas
        <select data-dos-cuerdas>{CUERDAS.slice(0, 5).map((c) => <option value={6 - c}>{c}ª y {c - 1}ª</option>)}</select>
      </label>
      <div class="grupo-botones" role="group" aria-label="Empezar por">
        <span class="etiqueta">Empezar por</span>
        {['1', '3', '5', '7'].map((g) => <button type="button" class="boton" data-desde-grado={g} aria-pressed="false">{g}</button>)}
      </div>
    </div>
    <p class="titulo-arpegio" data-titulo></p>
    <div class="mastil-caja" data-mastil></div>
    <p class="suave leyenda">Tablatura: la 1ª cuerda arriba. Cada nota lleva su grado; la tónica, en color.</p>
    <div class="botones-audio">
      <button type="button" data-audio="una" aria-pressed="false">▶ Tocar</button>
      <button type="button" data-audio="bucle" aria-pressed="false" title="Suena sin parar hasta pulsar Detener">∞ Bucle</button>
      <button type="button" data-detener>■ Detener</button>
    </div>
  </section>

  <nav class="indice" aria-label="En esta página">
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>
</Base>

<script>
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { eventosArpegio, mastilSVG, notasArpegio, recorrido, type Zona, posicionValida } from '../../lib/arpegios.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica, mostrarZona } from '../../lib/cliente.ts';
  import { parseAcordeGrado, simboloEn } from '../../lib/progresiones.ts';

  interface Opciones {
    cualidad: string;
    zona: Zona['tipo'];
    desde: number;
    cuerda: number;
    dosCuerdas: number;
    desdeGrado: string;
  }
  const CLAVE = 'arpegios:opciones';
  const op: Opciones = { cualidad: 'Imaj7', zona: 'posicion', desde: 7, cuerda: 5, dosCuerdas: 4, desdeGrado: '1', ...leerJSON<Partial<Opciones>>(CLAVE) };
  op.desde = posicionValida(op.desde);
  let tonica = 'C';
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('arpegios:sonido');

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const selCualidad = $<HTMLSelectElement>('[data-cualidad]');
  const selDesde = $<HTMLSelectElement>('[data-desde]');
  const selCuerda = $<HTMLSelectElement>('[data-cuerda]');
  const selDos = $<HTMLSelectElement>('[data-dos-cuerdas]');
  const caja = $('[data-mastil]');
  const titulo = $('[data-titulo]');
  selCualidad.value = op.cualidad;
  selDesde.value = String(op.desde);
  selCuerda.value = String(op.cuerda);
  selDos.value = String(op.dosCuerdas);

  const zona = (): Zona =>
    op.zona === 'posicion'
      ? { tipo: 'posicion', desde: op.desde }
      : op.zona === 'cuerda'
        ? { tipo: 'cuerda', cuerda: op.cuerda }
        : op.zona === 'dos-cuerdas'
          ? { tipo: 'dos-cuerdas', cuerda: op.dosCuerdas }
          : { tipo: 'todo' };
  const acorde = () => parseAcordeGrado(op.cualidad);

  function pintar() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-zona]')) b.setAttribute('aria-pressed', String(b.dataset.zona === op.zona));
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-desde-grado]')) {
      const hay = acorde().formula.some((g) => g.replace(/^[b#]+/, '') === b.dataset.desdeGrado);
      b.disabled = !hay;
      b.setAttribute('aria-pressed', String(b.dataset.desdeGrado === op.desdeGrado && hay));
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-solo]')) el.hidden = el.dataset.solo !== op.zona;
    const a = acorde();
    titulo.innerHTML = `<strong>${esc(simboloEn(tonica, a))}</strong> · ${esc(a.formula.join(' '))}`;
    caja.innerHTML = mastilSVG(notasArpegio(tonica, a), zona());
    mostrarZona(caja);
    guardarJSON(CLAVE, op);
  }

  selCualidad.addEventListener('change', () => ((op.cualidad = selCualidad.value), pintar()));
  selDesde.addEventListener('change', () => ((op.desde = Number(selDesde.value)), pintar()));
  selCuerda.addEventListener('change', () => ((op.cuerda = Number(selCuerda.value)), pintar()));
  selDos.addEventListener('change', () => ((op.dosCuerdas = Number(selDos.value)), pintar()));
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    if (b.dataset.zona) op.zona = b.dataset.zona as Zona['tipo'];
    else if (b.dataset.desdeGrado) op.desdeGrado = b.dataset.desdeGrado;
    else return;
    pintar();
  });

  conectarAudio((boton) => {
    const notas = recorrido(notasArpegio(tonica, acorde()), zona(), op.desdeGrado);
    // Tocando todo el mástil, en negras (son muchas notas); en una zona, en corcheas.
    const { eventos, duracion } = eventosArpegio(notas, tempo(), op.zona === 'todo');
    const paso = duracion / (notas.length + 2);
    let marcado = -1;
    const marcar = (k: number) => {
      if (k === marcado) return;
      marcado = k;
      caja.querySelector('.sonando')?.classList.remove('sonando');
      const n = notas[k];
      if (n) caja.querySelector(`.nota[data-midi="${n.midi}"][data-cuerda="${n.cuerda}"]`)?.classList.add('sonando');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion,
      bucle: () => boton.dataset.audio === 'bucle',
      alProgresar: (t) => marcar(Math.min(notas.length - 1, Math.floor(t / paso))),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((t) => {
    tonica = t;
    pintar();
  });
  pintar();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.5rem;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-bottom: 0.75rem;
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    font-weight: 700;
  }
  .campo select {
    width: auto;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .grupo-botones .etiqueta {
    margin-right: 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .grupo-botones [data-desde-grado] {
    min-width: 2.6rem;
    padding: 0;
  }
  .titulo-arpegio {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }
  /* El mástil no cabe en el móvil: se desplaza en horizontal dentro de su caja. */
  .mastil-caja {
    overflow-x: auto;
    padding: 0.5rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .leyenda {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
  }
</style>
