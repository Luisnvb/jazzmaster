---
// Chord melody (sección Estudio). El texto está en src/data/estudio/chord-melody.md;
// aquí va el buscador de formas con la melodía arriba (lib/chordmelody.ts).
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import { Content, getHeadings } from '../../data/estudio/chord-melody.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { CALIDADES_CM } from '../../lib/chordmelody.ts';
import { TONICAS } from '../../lib/teoria.ts';

const indice = getHeadings().filter((h) => h.depth === 2);
---

<Base titulo="Chord melody">
  <SelectorTonica clave="chord-melody" etiqueta="Acorde">
    <label>Sonido
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{i.nombre}</option>)}</select>
    </label>
    <Tempo clave="chord-melody" inicial={80} />
  </SelectorTonica>

  <section class="ejemplo" aria-label="Buscador de formas">
    <div class="opciones">
      <div class="grupo-botones" role="group" aria-label="Calidad del acorde">
        <span class="etiqueta">Calidad</span>
        {CALIDADES_CM.map((c) => <button type="button" class="boton" data-calidad={c.id} aria-pressed="false"><span data-tonica-texto>C</span>{c.sufijo}</button>)}
      </div>
    </div>
    <div class="opciones">
      <div class="grupo-botones" role="group" aria-label="Nota de la melodía" data-melodias>
        <span class="etiqueta">Melodía</span>
      </div>
      <label class="campo">Otra nota
        <select data-otra>{TONICAS.filter((t) => t !== 'Gb').map((t) => <option value={t}>{t}</option>)}</select>
      </label>
    </div>
    <div class="opciones">
      <label class="casilla"><input type="checkbox" data-tensiones /> Tensiones debajo (9, 13…)</label>
      <label class="casilla"><input type="checkbox" data-tres /> Solo 3 notas</label>
    </div>
    <p class="titulo-escala" data-titulo></p>
    <ol class="formas" data-formas></ol>
    <p class="suave leyenda">Los números son grados sobre el acorde; la melodía es la nota de la cuerda más aguda. Pulsa una forma para oírla: el acorde y después la melodía sola.</p>
    <div class="botones-audio">
      <button type="button" data-audio="todas" aria-pressed="false">▶ Todas seguidas</button>
      <button type="button" data-detener>■ Detener</button>
    </div>
  </section>

  <nav class="indice" aria-label="En esta página">
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>
</Base>

<script>
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { CALIDADES_CM, buscarFormas, gradoMelodia, melodiasDisponibles, papelMelodia, secuenciaForma, type FormaCM } from '../../lib/chordmelody.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica } from '../../lib/cliente.ts';
  import { diagramaSVG } from '../../lib/diagrama.ts';
  import { formatNota, parseNota, pitchClass } from '../../lib/teoria.ts';
  import type { Evento } from '../../lib/secuencias.ts';

  interface Opciones {
    calidad: string;
    /** Nota de melodía como semitonos sobre la raíz (así se conserva al cambiar de tónica). */
    melodia: number;
    tensiones: boolean;
    tres: boolean;
  }
  const CLAVE = 'chord-melody:opciones';
  const op: Opciones = { calidad: 'maj7', melodia: 4, tensiones: false, tres: false, ...leerJSON<Partial<Opciones>>(CLAVE) };
  if (!CALIDADES_CM.some((c) => c.id === op.calidad)) op.calidad = 'maj7';
  let raiz = 'C';
  let formas: FormaCM[] = [];
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('chord-melody:sonido');

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const grupoMelodias = $('[data-melodias]');
  const selOtra = $<HTMLSelectElement>('[data-otra]');
  const casillaTensiones = $<HTMLInputElement>('[data-tensiones]');
  const casillaTres = $<HTMLInputElement>('[data-tres]');
  const titulo = $('[data-titulo]');
  const lista = $('[data-formas]');
  casillaTensiones.checked = op.tensiones;
  casillaTres.checked = op.tres;

  const mod = (n: number) => ((n % 12) + 12) % 12;
  const calidad = () => CALIDADES_CM.find((c) => c.id === op.calidad)!;
  const NOMBRES = ['C', 'Db', 'D', 'Eb', 'E', 'F', 'F#', 'G', 'Ab', 'A', 'Bb', 'B'];
  /** Nombre de la nota de melodía: el de su grado en el acorde si lo es, si no el habitual. */
  const notaMelodia = () => {
    const disp = melodiasDisponibles(raiz, calidad()).find((x) => mod(pitchClass(parseNota(x.nota)) - pitchClass(parseNota(raiz))) === op.melodia);
    return disp ? disp.nota : NOMBRES[mod(pitchClass(parseNota(raiz)) + op.melodia)];
  };
  const PAPEL = { acorde: 'nota del acorde', tension: 'tensión', fuera: 'choca con el acorde' };

  function pintar() {
    const c = calidad();
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-calidad]')) b.setAttribute('aria-pressed', String(b.dataset.calidad === op.calidad));
    const disp = melodiasDisponibles(raiz, c);
    grupoMelodias.innerHTML =
      '<span class="etiqueta">Melodía</span>' +
      disp
        .map((x) => {
          const st = mod(pitchClass(parseNota(x.nota)) - pitchClass(parseNota(raiz)));
          return `<button type="button" class="boton" data-melodia="${st}" aria-pressed="${st === op.melodia}">${esc(x.nota)} <small>${esc(x.grado)}</small></button>`;
        })
        .join('');
    const mel = notaMelodia();
    selOtra.value = NOMBRES[mod(pitchClass(parseNota(raiz)) + op.melodia)];
    formas = buscarFormas(raiz, c, mel, { tensiones: op.tensiones, maxNotas: op.tres ? 3 : 4 });
    const papel = papelMelodia(raiz, c, mel);
    titulo.innerHTML = `<strong>${esc(mel)}</strong> arriba de <strong>${esc(formatNota(parseNota(raiz)))}${esc(c.sufijo)}</strong>: es la <strong>${esc(gradoMelodia(raiz, c, mel))}</strong>, <span class="papel ${papel}">${PAPEL[papel]}</span> · ${formas.length} formas`;
    lista.innerHTML = formas
      .map(
        (f, i) => `<li><button type="button" class="forma" data-i="${i}" data-audio="una" aria-pressed="false" aria-label="Forma ${i + 1}">
          ${diagramaSVG({ trastes: f.trastes, grados: f.grados })}
          <span class="suave detalle">Melodía en la ${6 - f.cuerdaMelodia}ª, traste ${f.trasteMelodia}${f.raizEnElBajo ? ' · raíz en el bajo' : ''}</span>
        </button></li>`,
      )
      .join('');
    guardarJSON(CLAVE, op);
  }

  selOtra.addEventListener('change', () => {
    op.melodia = mod(pitchClass(parseNota(selOtra.value)) - pitchClass(parseNota(raiz)));
    pintar();
  });
  casillaTensiones.addEventListener('change', () => ((op.tensiones = casillaTensiones.checked), pintar()));
  casillaTres.addEventListener('change', () => ((op.tres = casillaTres.checked), pintar()));
  document.addEventListener('click', (e) => {
    const el = e.target as Element;
    const bc = el.closest<HTMLButtonElement>('button[data-calidad]');
    if (bc) return ((op.calidad = bc.dataset.calidad!), pintar());
    const bm = el.closest<HTMLButtonElement>('button[data-melodia]');
    if (bm) return ((op.melodia = Number(bm.dataset.melodia)), pintar());
  });

  conectarAudio((boton) => {
    const una = boton.dataset.audio === 'una';
    const lista_ = una ? [formas[Number(boton.dataset.i)]] : formas;
    const eventos: Evento[] = [];
    const tramos: { inicio: number; fin: number }[] = [];
    let t = 0;
    for (const f of lista_) {
      const s = secuenciaForma(f, tempo());
      eventos.push(...s.eventos.map((x) => ({ ...x, inicio: x.inicio + t })));
      tramos.push({ inicio: t, fin: t + s.duracion });
      t += s.duracion;
    }
    let marcado = -1;
    const marcar = (k: number) => {
      if (una || k === marcado) return;
      marcado = k;
      lista.querySelector('.sonando-ahora')?.classList.remove('sonando-ahora');
      if (k >= 0) lista.querySelector(`[data-i="${k}"]`)?.classList.add('sonando-ahora');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion: t,
      alProgresar: (x) => marcar(tramos.findIndex((y) => x >= y.inicio && x < y.fin)),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((t) => {
    raiz = t;
    for (const el of document.querySelectorAll('[data-tonica-texto]')) el.textContent = t;
    pintar();
  });
  pintar();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.5rem;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-bottom: 0.75rem;
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .grupo-botones :global(.etiqueta) {
    margin-right: 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .grupo-botones :global(small) {
    font-weight: 600;
    opacity: 0.75;
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }
  .campo select {
    width: auto;
    margin: 0;
  }
  .titulo-escala {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }
  .titulo-escala :global(.papel) {
    font-weight: 700;
  }
  .titulo-escala :global(.papel.fuera) {
    color: var(--mal);
  }
  .formas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 0.45rem;
  }
  @media (max-width: 40rem) {
    .formas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .formas :global(.forma) {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    width: 100%;
    height: 100%;
    padding: 0.5rem 0.35rem 0.55rem;
    font: inherit;
    color: var(--texto);
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    cursor: pointer;
  }
  .formas :global(.forma:hover),
  .formas :global(.forma.sonando),
  .formas :global(.forma.sonando-ahora) {
    border-color: var(--acento);
    background: var(--acento-suave);
  }
  .formas :global(.diagrama) {
    width: 100%;
    max-width: 7.5rem;
  }
  .formas :global(.detalle) {
    font-size: 0.75rem;
    line-height: 1.3;
    text-align: center;
  }
  .leyenda {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
  }
</style>
