---
// Pentatónicas en jazz (sección Estudio). El texto está en src/data/estudio/pentatonicas.md;
// aquí va la tabla de pentatónicas por acorde con el mapa del mástil (lib/pentatonicas.ts).
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import { Content, getHeadings } from '../../data/estudio/pentatonicas.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { ULTIMA_POSICION } from '../../lib/arpegios.ts';
import { ACORDES_PENTA } from '../../lib/pentatonicas.ts';

const indice = getHeadings().filter((h) => h.depth === 2);
const CUERDAS = [6, 5, 4, 3, 2, 1];
const FIGURAS = [
  ['escala', 'Escala (sube y baja)'],
  ['grupos-3', 'Grupos de 3'],
  ['grupos-4', 'Grupos de 4'],
  ['saltos', 'Saltando una nota (cuartas)'],
];
---

<Base titulo="Pentatónicas en jazz">
  <SelectorTonica clave="estudio-penta">
    <label>Sonido
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{i.nombre}</option>)}</select>
    </label>
    <Tempo clave="estudio-penta" inicial={100} />
  </SelectorTonica>

  <section class="ejemplo" aria-label="Pentatónicas por acorde">
    <div class="opciones">
      <div class="grupo-botones" role="group" aria-label="Acorde">
        <span class="etiqueta">Acorde</span>
        {ACORDES_PENTA.map((a) => <button type="button" class="boton" data-acorde={a.id} aria-pressed="false" title={a.nombre}><span data-tonica-texto>C</span>{a.simbolo}</button>)}
      </div>
    </div>
    <ul class="opciones-penta" data-opciones aria-label="Pentatónicas para este acorde"></ul>

    <div class="opciones">
      <div class="grupo-botones" role="group" aria-label="Zona">
        <button type="button" class="boton" data-zona="todo" aria-pressed="false">Todo</button>
        <button type="button" class="boton" data-zona="posicion" aria-pressed="false">Posición</button>
        <button type="button" class="boton" data-zona="cuerda" aria-pressed="false">Una cuerda</button>
        <button type="button" class="boton" data-zona="dos-cuerdas" aria-pressed="false">Dos cuerdas</button>
      </div>
      <label class="campo" data-solo="posicion">Desde el traste
        <select data-desde>{Array.from({ length: ULTIMA_POSICION }, (_, i) => <option value={i + 1}>{i + 1}</option>)}</select>
      </label>
      <label class="campo" data-solo="cuerda">Cuerda
        <select data-cuerda>{CUERDAS.map((c) => <option value={6 - c}>{c}ª</option>)}</select>
      </label>
      <label class="campo" data-solo="dos-cuerdas">Cuerdas
        <select data-dos-cuerdas>{CUERDAS.slice(0, 5).map((c) => <option value={6 - c}>{c}ª y {c - 1}ª</option>)}</select>
      </label>
      <label class="campo">Figura
        <select data-figura>{FIGURAS.map(([v, n]) => <option value={v}>{n}</option>)}</select>
      </label>
      <label class="casilla"><input type="checkbox" data-con-acorde /> Con acorde de fondo</label>
    </div>
    <p class="titulo-escala" data-titulo></p>
    <div class="mastil-caja" data-mastil></div>
    <p class="suave leyenda">Tablatura: la 1ª cuerda arriba. Rellenas, las notas del acorde; en blanco, las tensiones. Los números son grados sobre el acorde, no sobre la pentatónica.</p>
    <div class="botones-audio">
      <button type="button" data-audio="una" aria-pressed="false">▶ Tocar</button>
      <button type="button" data-audio="bucle" aria-pressed="false" title="Suena sin parar hasta pulsar Detener">∞ Bucle</button>
      <button type="button" data-detener>■ Detener</button>
    </div>
  </section>

  <nav class="indice" aria-label="En esta página">
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>
</Base>

<script>
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { eventosArpegio, mastilSVG, posicionValida, recorrido, secuenciaZona, type NotaMastil, type Zona } from '../../lib/arpegios.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica, mostrarZona } from '../../lib/cliente.ts';
  import { ACORDES_PENTA, NIVELES, esTension, fondoAcorde, letrasPenta, nombrePenta, notasPenta, relativa } from '../../lib/pentatonicas.ts';

  type Figura = 'escala' | 'grupos-3' | 'grupos-4' | 'saltos';
  interface Opciones {
    acorde: string;
    opcion: string;
    zona: Zona['tipo'];
    desde: number;
    cuerda: number;
    dosCuerdas: number;
    figura: Figura;
    fondo: boolean;
  }
  const CLAVE = 'estudio-penta:opciones';
  const op: Opciones = {
    acorde: 'maj7',
    opcion: 'maj7-1',
    zona: 'posicion',
    desde: 7,
    cuerda: 5,
    dosCuerdas: 4,
    figura: 'escala',
    fondo: true,
    ...leerJSON<Partial<Opciones>>(CLAVE),
  };
  op.desde = posicionValida(op.desde);
  if (!ACORDES_PENTA.some((a) => a.id === op.acorde)) op.acorde = ACORDES_PENTA[0].id;
  let tonica = 'C';
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('estudio-penta:sonido');

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const selects = {
    desde: $<HTMLSelectElement>('[data-desde]'),
    cuerda: $<HTMLSelectElement>('[data-cuerda]'),
    dosCuerdas: $<HTMLSelectElement>('[data-dos-cuerdas]'),
    figura: $<HTMLSelectElement>('[data-figura]'),
  };
  for (const [k, sel] of Object.entries(selects)) sel.value = String(op[k as keyof typeof selects]);
  const casillaFondo = $<HTMLInputElement>('[data-con-acorde]');
  casillaFondo.checked = op.fondo;
  const listaOpciones = $('[data-opciones]');
  const caja = $('[data-mastil]');
  const titulo = $('[data-titulo]');

  const acorde = () => ACORDES_PENTA.find((a) => a.id === op.acorde)!;
  const opcion = () => {
    const a = acorde();
    return a.opciones.find((o) => o.id === op.opcion) ?? a.opciones[0];
  };
  const zona = (): Zona =>
    op.zona === 'posicion'
      ? { tipo: 'posicion', desde: op.desde }
      : op.zona === 'cuerda'
        ? { tipo: 'cuerda', cuerda: op.cuerda }
        : op.zona === 'dos-cuerdas'
          ? { tipo: 'dos-cuerdas', cuerda: op.dosCuerdas }
          : { tipo: 'todo' };
  const notas = () => notasPenta(tonica, acorde(), opcion());

  function pintar() {
    const a = acorde();
    const o = opcion();
    op.opcion = o.id;
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-acorde]')) b.setAttribute('aria-pressed', String(b.dataset.acorde === op.acorde));
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-zona]')) b.setAttribute('aria-pressed', String(b.dataset.zona === op.zona));
    for (const el of document.querySelectorAll<HTMLElement>('[data-solo]')) el.hidden = el.dataset.solo !== op.zona;
    listaOpciones.innerHTML = a.opciones
      .map(
        (x) => `<li><button type="button" class="opcion-penta" data-opcion="${x.id}" aria-pressed="${x.id === o.id}">
          <span class="cabeza"><strong>${esc(nombrePenta(tonica, x))}</strong><span class="nivel ${x.nivel}">${esc(NIVELES[x.nivel])}</span></span>
          <span class="suave relativa">= ${esc(relativa(tonica, x))} · ${esc(letrasPenta(tonica, x).join(' '))}</span>
          <span class="grados">${x.notas.map((g) => `<span class="grado ${esTension(a, g) ? 'tension' : 'acorde'}">${esc(g)}</span>`).join('')}</span>
          <span class="sonido">${esc(x.sonido)}</span>
        </button></li>`,
      )
      .join('');
    titulo.innerHTML = `<strong>${esc(nombrePenta(tonica, o))}</strong> sobre <strong>${esc(tonica)}${esc(a.simbolo)}</strong>`;
    caja.innerHTML = mastilSVG(notas(), zona());
    mostrarZona(caja);
    guardarJSON(CLAVE, op);
  }

  for (const [k, sel] of Object.entries(selects)) {
    sel.addEventListener('change', () => {
      (op as unknown as Record<string, unknown>)[k] = k === 'figura' ? sel.value : Number(sel.value);
      pintar();
    });
  }
  casillaFondo.addEventListener('change', () => ((op.fondo = casillaFondo.checked), guardarJSON(CLAVE, op)));
  document.addEventListener('click', (e) => {
    const el = e.target as Element;
    const ba = el.closest<HTMLButtonElement>('button[data-acorde]');
    if (ba) {
      op.acorde = ba.dataset.acorde!;
      op.opcion = acorde().opciones[0].id;
      return pintar();
    }
    const bo = el.closest<HTMLButtonElement>('button[data-opcion]');
    if (bo) {
      op.opcion = bo.dataset.opcion!;
      return pintar();
    }
    const bz = el.closest<HTMLButtonElement>('button[data-zona]');
    if (bz) {
      op.zona = bz.dataset.zona as Zona['tipo'];
      pintar();
    }
  });

  conectarAudio((boton) => {
    const n = notas();
    const z = zona();
    const celula = op.figura === 'grupos-3' ? [0, 1, 2] : op.figura === 'grupos-4' ? [0, 1, 2, 3] : op.figura === 'saltos' ? [0, 2] : null;
    const lista: NotaMastil[] = celula ? secuenciaZona(n, z, celula) : recorrido(n, z, opcion().notas[0].replace(/^[b#]+/, ''));
    const { eventos, duracion } = eventosArpegio(lista, tempo());
    if (op.fondo) eventos.push(...fondoAcorde(tonica, acorde(), duracion));
    const paso = duracion / (lista.length + 2);
    let marcado = -1;
    const marcar = (k: number) => {
      if (k === marcado) return;
      marcado = k;
      caja.querySelector('.sonando')?.classList.remove('sonando');
      const x = lista[k];
      if (x) caja.querySelector(`.nota[data-midi="${x.midi}"][data-cuerda="${x.cuerda}"]`)?.classList.add('sonando');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion,
      bucle: () => boton.dataset.audio === 'bucle',
      alProgresar: (t) => marcar(Math.min(lista.length - 1, Math.floor(t / paso))),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((t) => {
    tonica = t;
    for (const el of document.querySelectorAll('[data-tonica-texto]')) el.textContent = t;
    pintar();
  });
  pintar();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.5rem;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.5rem;
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .grupo-botones .etiqueta {
    margin-right: 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    font-weight: 700;
  }
  .campo select {
    width: auto;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  .opciones-penta {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 0.5rem;
  }
  .opciones-penta :global(.opcion-penta) {
    display: grid;
    gap: 0.35rem;
    width: 100%;
    height: 100%;
    padding: 0.65rem 0.8rem;
    text-align: left;
    font: inherit;
    color: var(--texto);
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    cursor: pointer;
  }
  .opciones-penta :global(.opcion-penta:hover) {
    border-color: var(--acento);
  }
  .opciones-penta :global(.opcion-penta[aria-pressed='true']) {
    border-color: var(--acento);
    box-shadow: 0 0 0 1px var(--acento);
    background: var(--acento-suave);
  }
  .opciones-penta :global(.cabeza) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 1.05rem;
  }
  .opciones-penta :global(.nivel) {
    padding: 0 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    color: var(--texto-suave);
  }
  .opciones-penta :global(.relativa) {
    font-size: 0.82rem;
  }
  .opciones-penta :global(.grados) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .opciones-penta :global(.grado) {
    min-width: 2rem;
    padding: 0.05rem 0.35rem;
    text-align: center;
    font-weight: 700;
    border-radius: var(--radio);
  }
  /* Como en el mástil: notas del acorde rellenas, tensiones en blanco con borde. */
  .opciones-penta :global(.grado.acorde) {
    color: var(--sobre-acento);
    background: var(--acento); /* COLOR: nota del acorde en la pentatónica */
    border: 1px solid var(--acento);
  }
  .opciones-penta :global(.grado.tension) {
    background: var(--fondo);
    border: 1px solid var(--texto-suave); /* COLOR: tensión en la pentatónica */
  }
  .opciones-penta :global(.sonido) {
    font-size: 0.85rem;
    line-height: 1.45;
  }
  .titulo-escala {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }
  /* El mástil no cabe en el móvil: se desplaza en horizontal dentro de su caja. */
  .mastil-caja {
    overflow-x: auto;
    padding: 0.25rem 0.5rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .leyenda {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
  }
</style>
