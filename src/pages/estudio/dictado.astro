---
// Dictado melódico: llamada y respuesta (sección Oído y técnica). El texto está en
// src/data/estudio/dictado.md; aquí va el ejercicio (lib/dictado.ts): suena una frase
// de un compás y en el siguiente se toca igual, con frases nuevas en cada vuelta.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import { Content, getHeadings } from '../../data/estudio/dictado.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { ASPECTOS, CONTEXTOS, DIFICULTADES, ESTILOS_DICTADO, POSICIONES } from '../../lib/dictado.ts';
import { porOrden } from '../../lib/orden.ts';

const indice = getHeadings().filter((h) => h.depth === 2);
const progresiones = porOrden(await getCollection('progresiones')).map(({ id, data }) => ({
  id,
  nombre: data.nombre,
  pulsos: data.pulsos,
  compases: data.compases,
}));
const datos = JSON.stringify(progresiones).replace(/</g, '\\u003c');
const AYUDAS = [
  ['oido', 'De oído', 'El mástil y las notas, ocultos: solo el oído. «Ver la frase» la enseña si te atascas.'],
  ['respuesta', 'En tu turno', 'Escuchas sin mirar y, en tu compás, ves las notas y cuál toca en cada momento.'],
  ['siempre', 'A la vista', 'La frase a la vista todo el rato, con la nota que suena marcada.'],
];
---

<Base titulo="Dictado melódico">
  <SelectorTonica clave="dictado">
    <label>Sonido
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{i.nombre}</option>)}</select>
    </label>
    <Tempo clave="dictado" inicial={80} />
  </SelectorTonica>

  <section class="ejemplo" aria-label="Ejercicio">
    <div class="opciones">
      <label class="campo">Contexto
        <select data-contexto>
          <optgroup label="Vamps y cadencias">
            {CONTEXTOS.map((c) => <option value={c.id}>{c.nombre}</option>)}
          </optgroup>
          <optgroup label="Progresiones" data-grupo-progresiones></optgroup>
        </select>
      </label>
      <label class="campo">Lenguaje
        <select data-aspecto>{ASPECTOS.map((a) => <option value={a.id} title={a.descripcion}>{a.nombre}</option>)}</select>
      </label>
      <label class="campo">Dificultad
        <select data-dificultad>{DIFICULTADES.map((d) => <option value={d.id} title={d.descripcion}>{d.nombre}</option>)}</select>
      </label>
      <label class="campo">Posición
        <select data-posicion>{POSICIONES.map((p) => <option value={p}>Traste {p}</option>)}</select>
      </label>
    </div>
    <div class="opciones">
      <label class="campo">Ayuda
        <select data-ayuda>{AYUDAS.map(([id, nombre, desc]) => <option value={id} title={desc}>{nombre}</option>)}</select>
      </label>
      <label class="campo">Rótulo
        <select data-rotulo>
          <option value="grado">Grado</option>
          <option value="nota">Nota</option>
          <option value="orden">Orden</option>
        </select>
      </label>
      <label class="campo">Acompañamiento
        <select data-acompanamiento>{ESTILOS_DICTADO.map((e) => <option value={e.id}>{e.nombre}</option>)}</select>
      </label>
      <label class="campo">Cada frase
        <select data-veces>
          <option value="1">Una vez</option>
          <option value="2">Dos veces</option>
          <option value="3">Tres veces</option>
        </select>
      </label>
      <label class="casilla"><input type="checkbox" data-swing /> Swing</label>
      <label class="casilla"><input type="checkbox" data-metronomo /> Clic en 2 y 4</label>
    </div>
    <p class="descripcion" data-descripcion></p>

    <div class="panel" data-panel>
      <div class="estado">
        <p class="fase" data-fase aria-live="polite">Pulsa «Empezar»</p>
        <p class="compas"><span class="acordes" data-acordes></span> <span class="suave" data-progreso></span></p>
      </div>
      <ol class="pulsos" data-pulsos aria-hidden="true"></ol>
      <ol class="frase" data-frase></ol>
      <div class="mastil-caja" data-mastil></div>
    </div>
    <p class="suave leyenda">
      <span class="muestra acorde">nota del acorde</span> <span class="muestra tension">tensión</span>
      <span class="muestra escala">de la escala</span> <span class="muestra cromatica">cromática o blue note</span>. Tablatura: la 1ª cuerda
      arriba; la zona en color es la posición donde está la frase.
    </p>

    <div class="botones-audio">
      <button type="button" data-audio="bucle" aria-pressed="false" title="Llamada y respuesta sin parar, con una frase nueva en cada vuelta">▶ Empezar</button>
      <button type="button" data-audio="escuchar" aria-pressed="false" title="La frase actual una vez, sin compás de respuesta">↺ Escuchar la frase</button>
      <button type="button" class="boton" data-otra title="Cambia la frase (si está sonando, en la vuelta siguiente)">↻ Otra frase</button>
      <button type="button" class="boton" data-revelar title="Enseña la frase actual en el mástil">👁 Ver la frase</button>
      <button type="button" data-detener>■ Detener</button>
    </div>
  </section>

  <nav class="indice" aria-label="En esta página">
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>

  <script type="application/json" id="datos-dictado" set:html={datos} />
</Base>

<script>
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { mastilSVG } from '../../lib/arpegios.ts';
  import { SOSTENIDOS } from '../../lib/audio.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica, mostrarZona, type Reproduccion } from '../../lib/cliente.ts';
  import {
    ASPECTOS,
    CONTEXTOS,
    DIFICULTADES,
    ESTILOS_DICTADO,
    generarFrase,
    notasMastilFrase,
    secuenciaDictado,
    trastesPosicion,
    type Aspecto,
    type Dificultad,
    type EstiloDictado,
    type FraseDictado,
    type Rotulo,
  } from '../../lib/dictado.ts';
  import { analizarProgresion, aplicarCambiosProgresiones, type AcordeGrado, type CambiosProgresiones, type Progresion } from '../../lib/progresiones.ts';

  // Las progresiones de la sección Progresiones, con lo editado en este navegador.
  const base: Progresion[] = JSON.parse(document.getElementById('datos-dictado')!.textContent!);
  const progresiones = aplicarCambiosProgresiones(base, leerJSON<CambiosProgresiones>('progresiones:cambios') ?? {}).filter((p) => {
    try {
      analizarProgresion(p.compases);
      return true;
    } catch {
      return false;
    }
  });

  type Ayuda = 'oido' | 'respuesta' | 'siempre';
  interface Opciones {
    contexto: string;
    aspecto: Aspecto;
    dificultad: Dificultad;
    posicion: number;
    ayuda: Ayuda;
    rotulo: Rotulo;
    acompanamiento: EstiloDictado;
    veces: number;
    swing: boolean;
    metronomo: boolean;
  }
  const CLAVE = 'dictado:opciones';
  const op: Opciones = {
    contexto: 'ii-v-i',
    aspecto: 'arpegios',
    dificultad: 'facil',
    posicion: 5,
    ayuda: 'respuesta',
    rotulo: 'grado',
    acompanamiento: 'acorde',
    veces: 1,
    swing: true,
    metronomo: false,
    ...leerJSON<Partial<Opciones>>(CLAVE),
  };
  if (!ASPECTOS.some((a) => a.id === op.aspecto)) op.aspecto = 'arpegios';
  if (!DIFICULTADES.some((d) => d.id === op.dificultad)) op.dificultad = 'facil';
  if (!['oido', 'respuesta', 'siempre'].includes(op.ayuda)) op.ayuda = 'respuesta';
  if (!ESTILOS_DICTADO.some((e) => e.id === op.acompanamiento)) op.acompanamiento = 'acorde';
  op.posicion = Math.min(12, Math.max(1, Math.round(op.posicion) || 5));
  op.veces = Math.min(3, Math.max(1, Math.round(op.veces) || 1));

  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('dictado:sonido');
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const selContexto = $<HTMLSelectElement>('[data-contexto]');
  const selAspecto = $<HTMLSelectElement>('[data-aspecto]');
  const selDificultad = $<HTMLSelectElement>('[data-dificultad]');
  const selAyuda = $<HTMLSelectElement>('[data-ayuda]');
  const selPosicion = $<HTMLSelectElement>('[data-posicion]');
  const selRotulo = $<HTMLSelectElement>('[data-rotulo]');
  const selAcomp = $<HTMLSelectElement>('[data-acompanamiento]');
  const selVeces = $<HTMLSelectElement>('[data-veces]');
  const casillaSwing = $<HTMLInputElement>('[data-swing]');
  const casillaClic = $<HTMLInputElement>('[data-metronomo]');
  const descripcion = $('[data-descripcion]');
  const panel = $('[data-panel]');
  const fase = $('[data-fase]');
  const textoAcordes = $('[data-acordes]');
  const progreso = $('[data-progreso]');
  const filaPulsos = $('[data-pulsos]');
  const filaFrase = $('[data-frase]');
  const caja = $('[data-mastil]');
  const botonRevelar = $<HTMLButtonElement>('[data-revelar]');

  $('[data-grupo-progresiones]').innerHTML = progresiones.map((p) => `<option value="prog:${esc(p.id)}">${esc(p.nombre)}</option>`).join('');
  const contextoValido = (id: string) => [...selContexto.options].some((o) => o.value === id);
  if (!contextoValido(op.contexto)) op.contexto = 'ii-v-i';
  selContexto.value = op.contexto;
  selAspecto.value = op.aspecto;
  selDificultad.value = op.dificultad;
  selAyuda.value = op.ayuda;
  selPosicion.value = String(op.posicion);
  selRotulo.value = op.rotulo;
  selAcomp.value = op.acompanamiento;
  selVeces.value = String(op.veces);
  casillaSwing.checked = op.swing;
  casillaClic.checked = op.metronomo;

  /** Compases del contexto elegido (ya analizados) y sus pulsos por compás. */
  function contexto(): { nombre: string; descripcion: string; compases: AcordeGrado[][]; pulsos: number } {
    if (op.contexto.startsWith('prog:')) {
      const p = progresiones.find((x) => `prog:${x.id}` === op.contexto)!;
      return { nombre: p.nombre, descripcion: 'Progresión del catálogo de Progresiones, compás a compás.', compases: analizarProgresion(p.compases), pulsos: p.pulsos ?? 4 };
    }
    const c = CONTEXTOS.find((x) => x.id === op.contexto)!;
    return { nombre: c.nombre, descripcion: c.descripcion, compases: analizarProgresion(c.compases), pulsos: 4 };
  }

  // --- Estado del ejercicio ---------------------------------------------------------
  let tonica = 'C';
  /** Compás del contexto en el que estamos y cuántas veces ha sonado ya la frase. */
  let k = 0;
  let repeticion = 0;
  let frase!: FraseDictado;
  /** La frase se ha enseñado con «Ver la frase» (hasta que cambie). */
  let revelada = false;
  /** Ha cambiado algo (opciones, tónica, «Otra frase»): la vuelta siguiente usa la frase nueva sin avanzar. */
  let pendiente = false;
  let sonando = false;

  function generar() {
    const c = contexto();
    k = k % c.compases.length;
    frase = generarFrase(tonica, c.compases[k], op.aspecto, op.dificultad, op.posicion, 1 + Math.floor(Math.random() * 1e9), c.pulsos);
    revelada = false;
  }

  /** Frase nueva: en el compás siguiente del contexto (`avanzar`) o en el mismo. */
  function nueva(avanzar: boolean) {
    if (avanzar) k++;
    repeticion = 0;
    generar();
  }

  // --- Dibujo -------------------------------------------------------------------------
  type Fase = 'parado' | 'cuenta' | 'llamada' | 'respuesta';
  let dibujada = '';
  let marcada = -1;

  const visible = (f: Fase) => revelada || op.ayuda === 'siempre' || (op.ayuda === 'respuesta' && f === 'respuesta');

  /** Pinta la frase `f` en la fase dada, con la nota `actual` marcada y el pulso `pulso` (0…) encendido. */
  function pintar(f: FraseDictado, estado: Fase, actual = -1, pulso = -1) {
    const ver = visible(estado);
    const clave = `${f.notas.map((n) => n.midi).join(',')}|${f.posicion}|${ver}|${op.rotulo}|${estado}`;
    if (clave !== dibujada) {
      dibujada = clave;
      marcada = -1;
      const c = contexto();
      textoAcordes.textContent = f.acordes.map((a) => a.simbolo).join('  ');
      progreso.textContent = c.compases.length > 1 ? `compás ${(k % c.compases.length) + 1} de ${c.compases.length}` : '';
      fase.textContent =
        estado === 'cuenta' ? 'Preparado…' : estado === 'llamada' ? '👂 Escucha' : estado === 'respuesta' ? '🎸 Tu turno' : sonando ? '' : 'Pulsa «Empezar»';
      panel.dataset.estado = estado;
      const pulsos = f.corcheas / 2;
      filaPulsos.style.setProperty('--n', String(f.corcheas));
      filaPulsos.innerHTML = Array.from({ length: f.corcheas }, (_, c) => `<li data-c="${c}">${c % 2 ? 'y' : c / 2 + 1}</li>`).join('');
      filaFrase.style.setProperty('--n', String(f.corcheas));
      filaFrase.innerHTML = ver
        ? f.notas
            .map(
              (n, i) => `<li class="nota-frase ${n.tipo}" data-i="${i}" style="grid-column: ${n.inicio + 1} / span ${n.dur}">
                <span class="nota">${esc(n.nota)}</span><span class="grado">${esc(n.grado)}</span></li>`,
            )
            .join('')
        : `<li class="oculta" style="grid-column: 1 / span ${pulsos * 2}">${op.ayuda === 'oido' ? 'De oído: la frase no se ve' : 'Escucha: la verás en tu turno'}</li>`;
      caja.innerHTML = mastilSVG(ver ? notasMastilFrase(f, op.rotulo) : [], { tipo: 'trastes', ...trastesPosicion(f.posicion) });
      mostrarZona(caja);
      botonRevelar.disabled = ver;
    }
    // Nota que suena (llamada) o que toca tocar (respuesta), y el pulso.
    if (actual !== marcada) {
      marcada = actual;
      filaFrase.querySelector('.sonando-ahora')?.classList.remove('sonando-ahora');
      caja.querySelector('.sonando')?.classList.remove('sonando');
      const n = f.notas[actual];
      if (n && ver) {
        filaFrase.querySelector(`[data-i="${actual}"]`)?.classList.add('sonando-ahora');
        caja.querySelector(`.nota[data-midi="${n.midi}"][data-cuerda="${n.cuerda}"]`)?.classList.add('sonando');
      }
    }
    for (const li of filaPulsos.children) li.classList.toggle('activo', Number((li as HTMLElement).dataset.c) === pulso);
  }

  function pintarOpciones() {
    // El título del selector explica la opción elegida (las de las opciones no siempre se ven).
    for (const s of [selAspecto, selDificultad, selAyuda]) s.title = s.selectedOptions[0]?.title ?? '';
    const a = ASPECTOS.find((x) => x.id === op.aspecto)!;
    const c = contexto();
    descripcion.innerHTML = `<strong>${esc(c.nombre)}:</strong> ${esc(c.descripcion)} <strong>${esc(a.nombre)}:</strong> ${esc(a.descripcion)}`;
    guardarJSON(CLAVE, op);
  }

  /** Algo ha cambiado: frase nueva ya (parado) o en la vuelta siguiente (sonando). */
  function cambio(reiniciar = false) {
    if (reiniciar) k = 0;
    nueva(false);
    pendiente = sonando;
    pintarOpciones();
    if (!sonando) pintar(frase, 'parado');
  }

  selContexto.addEventListener('change', () => ((op.contexto = selContexto.value), cambio(true)));
  selAspecto.addEventListener('change', () => ((op.aspecto = selAspecto.value as Aspecto), cambio()));
  selDificultad.addEventListener('change', () => ((op.dificultad = selDificultad.value as Dificultad), cambio()));
  selAyuda.addEventListener('change', () => {
    op.ayuda = selAyuda.value as Ayuda;
    pintarOpciones();
    if (!sonando) pintar(frase, 'parado');
  });
  selPosicion.addEventListener('change', () => ((op.posicion = Number(selPosicion.value)), cambio()));
  selRotulo.addEventListener('change', () => {
    op.rotulo = selRotulo.value as Rotulo;
    guardarJSON(CLAVE, op);
    if (!sonando) pintar(frase, 'parado');
  });
  selAcomp.addEventListener('change', () => ((op.acompanamiento = selAcomp.value as EstiloDictado), guardarJSON(CLAVE, op)));
  selVeces.addEventListener('change', () => ((op.veces = Number(selVeces.value)), guardarJSON(CLAVE, op)));
  casillaSwing.addEventListener('change', () => ((op.swing = casillaSwing.checked), guardarJSON(CLAVE, op)));
  casillaClic.addEventListener('change', () => ((op.metronomo = casillaClic.checked), guardarJSON(CLAVE, op)));
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    if (b.hasAttribute('data-otra')) {
      cambio();
    } else if (b.hasAttribute('data-revelar')) {
      revelada = true;
      if (!sonando) pintar(frase, 'parado');
    }
  });

  // --- Audio --------------------------------------------------------------------------

  /** Una vuelta (cuenta opcional, llamada y respuesta) de la frase actual, con su marcado. */
  function vuelta(conCuenta: boolean, soloLlamada = false): Pick<Reproduccion, 'eventos' | 'duracion' | 'alProgresar' | 'instrumento'> {
    const f = frase;
    const sostenido = SOSTENIDOS.includes(instrumento());
    const s = secuenciaDictado(f, tonica, tempo(), {
      swing: op.swing ? 0.62 : 0.5,
      acompanamiento: op.acompanamiento,
      metronomo: op.metronomo,
      cuenta: conCuenta,
      soloLlamada,
      sostenido,
    });
    const pulso = 60 / tempo();
    return {
      eventos: s.eventos,
      duracion: s.duracion,
      instrumento: instrumento(),
      alProgresar: (t) => {
        if (t < s.llamada) return pintar(f, 'cuenta', -1, Math.floor(t / pulso) * 2);
        const enLlamada = t < s.llamada + s.compas;
        const x = enLlamada ? t - s.llamada : t - s.llamada - s.compas;
        const i = s.notas.findIndex((n) => x >= n.inicio && x < n.fin);
        // Pulso encendido, en corcheas (el tiempo entero: 0, 2, 4…).
        pintar(f, enLlamada ? 'llamada' : 'respuesta', i, Math.min(f.corcheas - 2, Math.floor(x / pulso) * 2));
      },
    };
  }

  conectarAudio((boton) => {
    sonando = true;
    const terminar = () => {
      sonando = false;
      pintar(frase, 'parado');
    };
    if (boton.dataset.audio === 'escuchar') return { ...vuelta(false, true), alTerminar: terminar };
    const r: Reproduccion = {
      ...vuelta(true),
      bucle: () => true,
      otraVuelta: () => {
        if (pendiente) pendiente = false;
        else if (++repeticion >= op.veces) nueva(true);
        Object.assign(r, vuelta(false));
      },
      alTerminar: terminar,
    };
    return r;
  });

  conectarTonica((t) => {
    tonica = t;
    cambio();
  });
  // Sin tónica guardada ni en la dirección, conectarTonica no avisa: se empieza en C.
  if (!frase) cambio();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.5rem;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-bottom: 0.75rem;
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    font-weight: 700;
  }
  .campo select {
    width: auto;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  .casilla {
    margin: 0;
  }
  .descripcion {
    margin: 0 0 0.75rem;
    max-width: 52rem;
  }
  .panel {
    padding: 0.75rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .estado {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.5rem;
  }
  .fase {
    margin: 0;
    min-height: 1.6em;
    font-size: 1.35rem;
    font-weight: 700;
  }
  .panel[data-estado='respuesta'] .fase {
    color: var(--acento); /* COLOR: aviso de «Tu turno» en el dictado */
  }
  .compas {
    margin: 0;
  }
  .acordes {
    font-size: 1.15rem;
    font-weight: 700;
    white-space: pre;
  }
  /* El compás en corcheas: pulsos arriba y las notas debajo, cada una en su corchea y con su duración. */
  .pulsos,
  .frase {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n, 8), minmax(0, 1fr));
    gap: 0 0.2rem;
  }
  .pulsos :global(li) {
    text-align: center;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--texto-suave);
    border-radius: var(--radio);
  }
  .pulsos :global(li.activo) {
    background: var(--acento-suave); /* COLOR: pulso que suena en el dictado */
    color: var(--texto);
  }
  .frase {
    min-height: 3.4rem;
    margin: 0.3rem 0 0.6rem;
  }
  .frase :global(.nota-frase) {
    display: grid;
    justify-items: start;
    gap: 0.1rem;
    min-width: 0;
  }
  .frase :global(.nota-frase .nota) {
    display: block;
    width: 100%;
    padding: 0.2rem 0.3rem;
    font-weight: 700;
    background: var(--fondo);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .frase :global(.nota-frase .grado) {
    padding-left: 0.3rem;
    font-size: 0.72rem;
    color: var(--texto-suave);
  }
  .frase :global(.oculta) {
    align-self: center;
    text-align: center;
    padding: 0.7rem;
    color: var(--texto-suave);
    border: 1px dashed var(--borde);
    border-radius: var(--radio);
  }
  .muestra {
    display: inline-block;
