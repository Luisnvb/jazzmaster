---
// Mástil por capas (sección Estudio). El texto está en src/data/estudio/capas.md; aquí,
// el mástil con una zona CAGED y sus capas una sobre otra (lib/capas.ts).
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import { Content, getHeadings } from '../../data/estudio/capas.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { CUALIDADES_CAPAS, FORMAS_CAGED } from '../../lib/capas.ts';

const indice = getHeadings().filter((h) => h.depth === 2);
---

<Base titulo="Mástil por capas">
  <SelectorTonica clave="capas" etiqueta="Raíz">
    <label>Sonido
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{i.nombre}</option>)}</select>
    </label>
    <Tempo clave="capas" inicial={90} />
  </SelectorTonica>

  <section class="ejemplo" aria-label="Mástil por capas">
    <div class="opciones">
      <div class="grupo-botones" role="group" aria-label="Cualidad">
        {CUALIDADES_CAPAS.map((c) => <button type="button" class="boton" data-cualidad={c.id} aria-pressed="false">{c.nombre}</button>)}
      </div>
      <div class="grupo-botones" role="group" aria-label="Forma CAGED">
        <span class="etiqueta">Forma</span>
        {FORMAS_CAGED.map((f) => <button type="button" class="boton forma" data-forma={f.letra} aria-pressed="false">{f.letra}</button>)}
      </div>
      <button type="button" class="boton" data-sortear title="Raíz, cualidad y forma al azar; vuelve a la primera capa">🎲 Sortear</button>
    </div>

    <p class="titulo-capas" data-titulo></p>

    <ol class="capas" data-capas aria-label="Capas"></ol>

    <div class="mastil-caja" data-mastil></div>

    <div class="pie">
      <div class="paso">
        <button type="button" class="boton" data-paso="-1" title="Capa anterior (←)">← Anterior</button>
        <span class="contador" data-contador></span>
        <button type="button" class="boton" data-paso="1" title="Capa siguiente (→)">Siguiente →</button>
      </div>
      <div class="grupo-botones" role="group" aria-label="Escala" data-escalas></div>
      <div class="grupo-botones" role="group" aria-label="Cuerdas" data-voicings></div>
      <div class="grupo-botones" role="group" aria-label="Vista">
        <button type="button" class="boton" data-acumular aria-pressed="false" title="Las capas anteriores siguen a la vista, atenuadas">Acumular capas</button>
        <button type="button" class="boton" data-rotulo aria-pressed="false" title="Nombre de la nota en vez del grado">Notas</button>
      </div>
    </div>
    <p class="pista" data-pista></p>

    <div class="botones-audio">
      <button type="button" data-audio="una" aria-pressed="false">▶ Tocar la capa</button>
      <button type="button" data-audio="bucle" aria-pressed="false" title="Suena sin parar hasta pulsar Detener">∞ Bucle</button>
      <button type="button" data-detener>■ Detener</button>
    </div>
    <p class="suave leyenda">
      Tablatura: la 1ª cuerda arriba. La zona sombreada es la forma CAGED. La raíz, en color; en la pentatónica y la escala, las
      notas que no son del acorde van huecas. Las flechas del teclado pasan de capa.
    </p>
  </section>

  <nav class="indice" aria-label="En esta página">
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>
</Base>

<script>
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import {
    CUALIDADES_CAPAS,
    FORMAS_CAGED,
    capas,
    cualidadCapas,
    cuerdasVoicing,
    eventosCapa,
    mastilCapasSVG,
    simboloCapas,
    zonaCaged,
    type LetraCaged,
  } from '../../lib/capas.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica, mostrarZona } from '../../lib/cliente.ts';

  interface Opciones {
    cualidad: string;
    forma: LetraCaged;
    capa: number;
    acumular: boolean;
    notas: boolean;
    /** Escala elegida en cada cualidad (índice). */
    escalas: Record<string, number>;
  }
  const CLAVE = 'capas:opciones';
  const op: Opciones = { cualidad: 'mayor', forma: 'E', capa: 0, acumular: true, notas: false, escalas: {}, ...leerJSON<Partial<Opciones>>(CLAVE) };
  if (!FORMAS_CAGED.some((f) => f.letra === op.forma)) op.forma = 'E';
  let raiz = 'C';
  /** Voicing destacado en la capa actual (tríadas): undefined = todos. No se guarda. */
  let voicing: number | undefined;
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('capas:sonido');

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const caja = $('[data-mastil]');
  const lista = $('[data-capas]');

  const cualidad = () => cualidadCapas(op.cualidad);
  const escala = () => op.escalas[op.cualidad] ?? 0;
  const actuales = () => capas(raiz, cualidad(), op.forma, escala());

  function pintar(centrar = false) {
    const c = cualidad();
    const todas = actuales();
    op.capa = Math.min(Math.max(op.capa, 0), todas.length - 1);
    const capa = todas[op.capa];
    const z = zonaCaged(raiz, op.forma);

    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-cualidad]')) b.setAttribute('aria-pressed', String(b.dataset.cualidad === c.id));
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-forma]')) {
      b.setAttribute('aria-pressed', String(b.dataset.forma === op.forma));
      b.title = `Forma de ${b.dataset.forma}: desde el traste ${zonaCaged(raiz, b.dataset.forma as LetraCaged).cejilla}`;
    }
    $('[data-titulo]').innerHTML =
      `<strong>${esc(simboloCapas(raiz, c))}</strong> · forma de ${op.forma} · trastes ${z.desde}–${z.hasta}`;

    lista.innerHTML = todas
      .map(
        (x, k) =>
          `<li><button type="button" class="chip${k < op.capa ? ' hecha' : ''}" data-capa="${k}" aria-pressed="${k === op.capa}">` +
          `<span class="numero">${k + 1}</span> ${esc(x.nombre)}</button></li>`,
      )
      .join('');
    $('[data-contador]').textContent = `Capa ${op.capa + 1} de ${todas.length}`;
    $<HTMLButtonElement>('[data-paso="-1"]').disabled = op.capa === 0;
    $<HTMLButtonElement>('[data-paso="1"]').disabled = op.capa === todas.length - 1;
    $('[data-pista]').innerHTML = `<strong>${esc(capa.nombre)}.</strong> ${esc(capa.pista)}`;

    const escalas = $('[data-escalas]');
    escalas.hidden = capa.id !== 'escala' || c.escalas.length < 2;
    escalas.innerHTML = c.escalas
      .map((e, k) => `<button type="button" class="boton" data-escala="${k}" aria-pressed="${k === escala()}">${esc(e.nombre)}</button>`)
      .join('');
    if (voicing !== undefined && !capa.formas[voicing]) voicing = undefined;
    const voicings = $('[data-voicings]');
    voicings.hidden = capa.formas.length < 2;
    voicings.innerHTML =
      `<button type="button" class="boton" data-voicing="" aria-pressed="${voicing === undefined}">Todas</button>` +
      capa.formas
        .map((f, k) => `<button type="button" class="boton" data-voicing="${k}" aria-pressed="${k === voicing}">${cuerdasVoicing(f)}</button>`)
        .join('');
    $('[data-acumular]').setAttribute('aria-pressed', String(op.acumular));
    $('[data-rotulo]').setAttribute('aria-pressed', String(op.notas));

    caja.innerHTML = mastilCapasSVG(todas, op.capa, z, op.acumular, op.notas ? 'nota' : 'grado', voicing);
    if (centrar) mostrarZona(caja);
    guardarJSON(CLAVE, op);
  }

  const azar = <T,>(xs: readonly T[]) => xs[Math.floor(Math.random() * xs.length)];

  function sortear() {
    op.cualidad = azar(CUALIDADES_CAPAS).id;
    op.forma = azar(FORMAS_CAGED).letra;
    op.capa = 0;
    const tonicas = [...document.querySelectorAll<HTMLButtonElement>('[data-tonica]')];
    // Cambiar la tónica repinta; si sale la misma, se repinta aquí.
    const nueva = azar(tonicas);
    if (nueva.dataset.tonica !== raiz) nueva.click();
    else pintar(true);
  }

  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    const d = b.dataset;
    if (d.cualidad) op.cualidad = d.cualidad;
    else if (d.forma) op.forma = d.forma as LetraCaged;
    else if (d.capa) [op.capa, voicing] = [Number(d.capa), undefined];
    else if (d.paso) [op.capa, voicing] = [op.capa + Number(d.paso), undefined];
    else if (d.voicing !== undefined) voicing = d.voicing === '' ? undefined : Number(d.voicing);
    else if (d.escala) op.escalas = { ...op.escalas, [op.cualidad]: Number(d.escala) };
    else if ('acumular' in d) op.acumular = !op.acumular;
    else if ('rotulo' in d) op.notas = !op.notas;
    else if ('sortear' in d) return sortear();
    else return;
    pintar(Boolean(d.forma || d.cualidad));
  });

  document.addEventListener('keydown', (e) => {
    if (e.altKey || e.ctrlKey || e.metaKey) return;
    if ((e.target as Element).closest('input, select, textarea, [contenteditable]')) return;
    const paso = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
    if (!paso) return;
    const n = actuales().length;
    const nueva = Math.min(Math.max(op.capa + paso, 0), n - 1);
    if (nueva === op.capa) return;
    e.preventDefault();
    op.capa = nueva;
    voicing = undefined;
    pintar();
  });

  conectarAudio((boton) => {
    const capa = actuales()[op.capa];
    const { eventos, pasos, duracion } = eventosCapa(capa, tempo(), voicing);
    let marcado = -1;
    const marcar = (k: number) => {
      if (k === marcado) return;
      marcado = k;
      for (const x of caja.querySelectorAll('.sonando')) x.classList.remove('sonando');
      for (const n of pasos[k]?.notas ?? []) caja.querySelector(`.nota[data-midi="${n.midi}"][data-cuerda="${n.cuerda}"]`)?.classList.add('sonando');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion,
      bucle: () => boton.dataset.audio === 'bucle',
      alProgresar: (t) => marcar(pasos.findIndex((p) => t >= p.inicio && t < p.fin)),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((t) => {
    raiz = t;
    pintar(true);
  });
  pintar(true);
</script>

<style>
  .ejemplo {
    margin: 0 0 1.5rem;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-bottom: 0.9rem;
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .grupo-botones[hidden] {
    display: none;
  }
  .grupo-botones .etiqueta {
    margin-right: 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .grupo-botones .forma {
    min-width: 2.6rem;
    padding: 0;
  }
  .titulo-capas {
    margin: 0 0 0.6rem;
    font-size: 1.1rem;
  }

  /* Las capas, como fichas numeradas: las ya vistas, marcadas; la actual, rellena. */
  .capas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
  }
  .capas :global(.chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem 0.3rem 0.35rem;
    font: inherit;
    font-size: 0.88rem;
    color: var(--texto);
    background: var(--fondo);
    border: 1px solid var(--borde);
    border-radius: 999px;
    cursor: pointer;
  }
  .capas :global(.chip:hover) {
    border-color: var(--acento);
  }
  .capas :global(.chip .numero) {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    border-radius: 50%;
    background: var(--superficie-2);
  }
  .capas :global(.chip.hecha .numero) {
    background: var(--acento-suave); /* COLOR: capas ya vistas */
    color: var(--acento);
  }
  .capas :global(.chip[aria-pressed='true']) {
    background: var(--acento);
    border-color: var(--acento);
    color: var(--sobre-acento);
  }
  .capas :global(.chip[aria-pressed='true'] .numero) {
    background: var(--sobre-acento);
    color: var(--acento);
  }

  /* El mástil no cabe en el móvil: se desplaza en horizontal dentro de su caja. */
  .mastil-caja {
    overflow-x: auto;
    padding: 0.5rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .mastil-caja :global(.nota.anterior) {
    opacity: 0.28;
  }
  .mastil-caja :global(.forma) {
    fill: none;
    stroke: var(--acento); /* COLOR: línea que une las notas de cada tríada o acorde */
    stroke-width: 3;
    stroke-linejoin: round;
    opacity: 0.55;
  }

  .pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.5rem;
    margin-top: 0.75rem;
  }
  .paso {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .contador {
    min-width: 6.5rem;
    text-align: center;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .pista {
    max-width: 48rem;
    min-height: 3em;
    margin: 0.7rem 0 0.4rem;
  }
  .leyenda {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    max-width: 48rem;
  }
</style>
