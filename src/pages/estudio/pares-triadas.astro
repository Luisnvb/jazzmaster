---
// Pares de tríadas (sección Estudio). El texto está en src/data/estudio/pares-triadas.md;
// aquí va el mapa del mástil con las dos tríadas del par (lib/pares-triadas.ts).
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import { Content, getHeadings } from '../../data/estudio/pares-triadas.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { PARES } from '../../lib/pares-triadas.ts';

const indice = getHeadings().filter((h) => h.depth === 2);
const CUERDAS = [6, 5, 4, 3, 2, 1];
const FIGURAS = [
  ['sube', 'Sube (las dos tríadas hacia arriba)'],
  ['baja', 'Baja (cada tríada hacia abajo)'],
  ['alterna', 'A sube, B baja'],
  ['escala', 'Escala de seis notas'],
];
---

<Base titulo="Pares de tríadas">
  <SelectorTonica clave="estudio-pares">
    <label>Sonido
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{i.nombre}</option>)}</select>
    </label>
    <Tempo clave="estudio-pares" inicial={90} />
  </SelectorTonica>

  <section class="ejemplo" aria-label="Mapa del par de tríadas">
    <div class="opciones">
      <label class="campo">Acorde
        <select data-par>{PARES.map((p) => <option value={p.id}>{p.acorde} · {p.escala}</option>)}</select>
      </label>
      <div class="grupo-botones" role="group" aria-label="Zona">
        <button type="button" class="boton" data-zona="todo" aria-pressed="false">Todo</button>
        <button type="button" class="boton" data-zona="posicion" aria-pressed="false">Posición</button>
        <button type="button" class="boton" data-zona="cuerda" aria-pressed="false">Una cuerda</button>
        <button type="button" class="boton" data-zona="dos-cuerdas" aria-pressed="false">Dos cuerdas</button>
      </div>
      <label class="campo" data-solo="posicion">Desde el traste
        <select data-desde>{Array.from({ length: 12 }, (_, i) => <option value={i + 1}>{i + 1}</option>)}</select>
      </label>
      <label class="campo" data-solo="cuerda">Cuerda
        <select data-cuerda>{CUERDAS.map((c) => <option value={6 - c}>{c}ª</option>)}</select>
      </label>
      <label class="campo" data-solo="dos-cuerdas">Cuerdas
        <select data-dos-cuerdas>{CUERDAS.slice(0, 5).map((c) => <option value={6 - c}>{c}ª y {c - 1}ª</option>)}</select>
      </label>
      <label class="campo">Figura
        <select data-figura>{FIGURAS.map(([v, n]) => <option value={v}>{n}</option>)}</select>
      </label>
      <label class="casilla"><input type="checkbox" data-pedal /> Nota pedal (tónica)</label>
    </div>
    <p class="titulo-escala" data-titulo></p>
    <div class="mastil-caja" data-mastil></div>
    <p class="suave nota-par" data-nota></p>
    <p class="suave leyenda">Tablatura: la 1ª cuerda arriba. Rellenas, la tríada A; en blanco, la tríada B. Los números son grados sobre el acorde; la raíz del acorde, en color.</p>
    <div class="botones-audio">
      <button type="button" data-audio="una" aria-pressed="false">▶ Tocar</button>
      <button type="button" data-audio="bucle" aria-pressed="false" title="Suena sin parar hasta pulsar Detener">∞ Bucle</button>
      <button type="button" data-detener>■ Detener</button>
    </div>
  </section>

  <nav class="indice" aria-label="En esta página">
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>

</Base>

<script>
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { eventosArpegio, mastilSVG, recorrido, type NotaMastil, type Zona } from '../../lib/arpegios.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica } from '../../lib/cliente.ts';
  import { PARES, letrasTriada, lineaPar, nombreTriada, notasPar, type Figura, type Triada } from '../../lib/pares-triadas.ts';
  import { parseNota, pitchClass } from '../../lib/teoria.ts';

  interface Opciones {
    par: string;
    zona: Zona['tipo'];
    desde: number;
    cuerda: number;
    dosCuerdas: number;
    figura: Figura | 'escala';
    pedal: boolean;
  }
  const CLAVE = 'estudio-pares:opciones';
  const op: Opciones = {
    par: 'lidio',
    zona: 'posicion',
    desde: 7,
    cuerda: 5,
    dosCuerdas: 4,
    figura: 'sube',
    pedal: false,
    ...leerJSON<Partial<Opciones>>(CLAVE),
  };
  if (!PARES.some((p) => p.id === op.par)) op.par = PARES[0].id;
  let tonica = 'C';
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('estudio-pares:sonido');

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const selects = {
    par: $<HTMLSelectElement>('[data-par]'),
    desde: $<HTMLSelectElement>('[data-desde]'),
    cuerda: $<HTMLSelectElement>('[data-cuerda]'),
    dosCuerdas: $<HTMLSelectElement>('[data-dos-cuerdas]'),
    figura: $<HTMLSelectElement>('[data-figura]'),
  };
  const casillaPedal = $<HTMLInputElement>('[data-pedal]');
  for (const [k, sel] of Object.entries(selects)) sel.value = String(op[k as keyof typeof selects]);
  casillaPedal.checked = op.pedal;
  const caja = $('[data-mastil]');
  const titulo = $('[data-titulo]');
  const nota = $('[data-nota]');

  const par = () => PARES.find((p) => p.id === op.par)!;
  const zona = (): Zona =>
    op.zona === 'posicion'
      ? { tipo: 'posicion', desde: op.desde }
      : op.zona === 'cuerda'
        ? { tipo: 'cuerda', cuerda: op.cuerda }
        : op.zona === 'dos-cuerdas'
          ? { tipo: 'dos-cuerdas', cuerda: op.dosCuerdas }
          : { tipo: 'todo' };
  const notas = () => notasPar(tonica, par());

  const triada = (letra: string, t: Triada) =>
    `<span class="triada">${letra}: <strong>${esc(nombreTriada(tonica, t))}</strong> (${esc(letrasTriada(tonica, t).join(' '))} · ${esc(t.notas.join(' '))})</span>`;

  function pintar() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-zona]')) b.setAttribute('aria-pressed', String(b.dataset.zona === op.zona));
    for (const el of document.querySelectorAll<HTMLElement>('[data-solo]')) el.hidden = el.dataset.solo !== op.zona;
    const p = par();
    titulo.innerHTML = `<strong>${esc(tonica)}${esc(p.acorde)}</strong> · ${esc(p.escala)} ${triada('A', p.a)} ${triada('B', p.b)}`;
    nota.textContent = p.nota;
    caja.innerHTML = mastilSVG(notas(), zona());
    guardarJSON(CLAVE, op);
  }

  for (const [k, sel] of Object.entries(selects)) {
    sel.addEventListener('change', () => {
      const v = sel.value;
      (op as unknown as Record<string, unknown>)[k] = ['desde', 'cuerda', 'dosCuerdas'].includes(k) ? Number(v) : v;
      pintar();
    });
  }
  casillaPedal.addEventListener('change', () => {
    op.pedal = casillaPedal.checked;
    guardarJSON(CLAVE, op);
  });
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-zona]');
    if (!b) return;
    op.zona = b.dataset.zona as Zona['tipo'];
    pintar();
  });

  conectarAudio((boton) => {
    const n = notas();
    const z = zona();
    let lista: NotaMastil[] = op.figura === 'escala' ? recorrido(n, z, '1') : lineaPar(n, z, op.figura);
    // Si en la zona no caben tres notas seguidas de cada tríada, suena la escala.
    if (lista.length === 0) lista = recorrido(n, z, '1');
    // La raíz del acorde como pedal, entre E2 y D#3 (el registro más grave de la guitarra).
    const pedal = op.pedal ? 40 + ((pitchClass(parseNota(tonica)) - 4 + 12) % 12) : undefined;
    const { eventos, duracion } = eventosArpegio(lista, tempo(), false, pedal);
    const paso = duracion / (lista.length + 2);
    let marcado = -1;
    const marcar = (k: number) => {
      if (k === marcado) return;
      marcado = k;
      caja.querySelector('.sonando')?.classList.remove('sonando');
      const x = lista[k];
      if (x) caja.querySelector(`.nota[data-midi="${x.midi}"][data-cuerda="${x.cuerda}"]`)?.classList.add('sonando');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion,
      bucle: () => boton.dataset.audio === 'bucle',
      alProgresar: (t) => marcar(Math.min(lista.length - 1, Math.floor(t / paso))),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((t) => {
    tonica = t;
    pintar();
  });
  pintar();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.5rem;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-bottom: 0.75rem;
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    font-weight: 700;
  }
  .campo select {
    width: auto;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .titulo-escala {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }
  /* El mástil no cabe en el móvil: se desplaza en horizontal dentro de su caja. */
  .mastil-caja {
    overflow-x: auto;
    padding: 0.5rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .titulo-escala .triada {
    margin-left: 1rem;
    font-size: 1rem;
  }
  .nota-par {
    margin: 0 0 0.6rem;
  }
  .leyenda {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
  }
</style>
