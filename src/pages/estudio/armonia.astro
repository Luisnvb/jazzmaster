---
// Armonía funcional (sección Estudio). El texto está en src/data/estudio/armonia.md;
// aquí van la tabla de funciones y el analizador de progresiones (lib/armonia.ts).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import { Content, getHeadings } from '../../data/estudio/armonia.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { porOrden } from '../../lib/orden.ts';

const indice = getHeadings().filter((h) => h.depth === 2);
const progresiones = porOrden(await getCollection('progresiones')).map(({ id, data }) => ({
  id,
  nombre: data.nombre,
  pulsos: data.pulsos,
  compases: data.compases,
}));
const datos = JSON.stringify(progresiones).replace(/</g, '\\u003c');
---

<Base titulo="Armonía funcional">
  <SelectorTonica clave="armonia">
    <label>Sonido
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{i.nombre}</option>)}</select>
    </label>
    <Tempo clave="armonia" inicial={100} />
  </SelectorTonica>

  <section class="ejemplo" aria-labelledby="titulo-funciones">
    <div class="cabecera-bloque">
      <h2 id="titulo-funciones">Funciones en la tonalidad</h2>
      <div class="grupo-botones" role="group" aria-label="Modo">
        <button type="button" class="boton" data-modo-tabla="mayor" aria-pressed="false">Mayor</button>
        <button type="button" class="boton" data-modo-tabla="menor" aria-pressed="false">Menor</button>
      </div>
    </div>
    <div class="funciones" data-funciones></div>
  </section>

  <section class="ejemplo" aria-labelledby="titulo-analisis">
    <div class="cabecera-bloque">
      <h2 id="titulo-analisis">Analizar una progresión</h2>
    </div>
    <div class="opciones">
      <label class="campo">Progresión
        <select data-progresion></select>
      </label>
      <div class="grupo-botones" role="group" aria-label="Modo del análisis">
        <button type="button" class="boton" data-modo-analisis="auto" aria-pressed="false" title="Mayor o menor según la tónica de la progresión">Automático</button>
        <button type="button" class="boton" data-modo-analisis="mayor" aria-pressed="false">Mayor</button>
        <button type="button" class="boton" data-modo-analisis="menor" aria-pressed="false">Menor</button>
      </div>
    </div>
    <div class="analisis" data-analisis></div>
    <ul class="notas-analisis" data-notas></ul>
    <div class="botones-audio">
      <button type="button" data-audio="una" aria-pressed="false">▶ Tocar</button>
      <button type="button" data-audio="bucle" aria-pressed="false" title="Suena sin parar hasta pulsar Detener">∞ Bucle</button>
      <button type="button" data-detener>■ Detener</button>
    </div>
  </section>

  <nav class="indice" aria-label="En esta página">
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>

  <script type="application/json" id="datos-armonia" set:html={datos} />
</Base>

<script>
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { DIATONICOS, analizarSecuencia, modoProbable, type Modo } from '../../lib/armonia.ts';
  import { SOSTENIDOS } from '../../lib/audio.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica } from '../../lib/cliente.ts';
  import { analizarProgresion, aplicarCambiosProgresiones, parseAcordeGrado, secuenciaProgresion, simboloEn, type CambiosProgresiones, type Progresion } from '../../lib/progresiones.ts';

  const NOMBRE: Record<string, string> = { T: 'Tónica', SD: 'Subdominante', D: 'Dominante', '?': 'Otra' };

  // Las progresiones de la sección Progresiones, con lo editado en este navegador.
  const base: Progresion[] = JSON.parse(document.getElementById('datos-armonia')!.textContent!);
  const progresiones = aplicarCambiosProgresiones(base, leerJSON<CambiosProgresiones>('progresiones:cambios') ?? {}).filter((p) => {
    try {
      analizarProgresion(p.compases);
      return true;
    } catch {
      return false;
    }
  });

  interface Opciones {
    modoTabla: Modo;
    progresion: string;
    modoAnalisis: Modo | 'auto';
  }
  const CLAVE = 'armonia:opciones';
  const op: Opciones = { modoTabla: 'mayor', progresion: 'turnaround-dominantes', modoAnalisis: 'auto', ...leerJSON<Partial<Opciones>>(CLAVE) };
  let tonica = 'C';
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('armonia:sonido');

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const selector = $<HTMLSelectElement>('[data-progresion]');
  selector.innerHTML = progresiones.map((p) => `<option value="${esc(p.id)}">${esc(p.nombre)}</option>`).join('');
  if (!progresiones.some((p) => p.id === op.progresion)) op.progresion = progresiones[0]?.id ?? '';
  selector.value = op.progresion;
  const zonaAnalisis = $('[data-analisis]');

  const progresion = () => progresiones.find((p) => p.id === op.progresion)!;
  const compases = () => analizarProgresion(progresion().compases);
  const modoAnalisis = (): Modo => (op.modoAnalisis === 'auto' ? modoProbable(compases().flat()) : op.modoAnalisis);

  function pintarTabla() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-modo-tabla]')) b.setAttribute('aria-pressed', String(b.dataset.modoTabla === op.modoTabla));
    $('[data-funciones]').innerHTML = (['T', 'SD', 'D'] as const)
      .map(
        (f) => `<div class="columna funcion-${f}">
          <h3><span class="insignia funcion-${f}">${f}</span> ${NOMBRE[f]}</h3>
          <ul>${DIATONICOS[op.modoTabla][f]
            .map((t) => `<li><strong>${esc(simboloEn(tonica, parseAcordeGrado(t)))}</strong> <span class="suave">${esc(t)}</span></li>`)
            .join('')}</ul>
        </div>`,
      )
      .join('');
  }

  function pintarAnalisis() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-modo-analisis]')) b.setAttribute('aria-pressed', String(b.dataset.modoAnalisis === op.modoAnalisis));
    if (!progresiones.length) return;
    const c = compases();
    const modo = modoAnalisis();
    const analisis = analizarSecuencia(c.flat(), modo);
    let k = 0;
    zonaAnalisis.innerHTML =
      `<p class="modo-detectado">En ${esc(tonica)} ${modo}${op.modoAnalisis === 'auto' ? ' (detectado)' : ''}.</p>` +
      `<div class="compases-analisis">${c
        .map(
          (acordes) =>
            `<div class="compas-analisis">${acordes
              .map((a) => {
                const r = analisis[k];
                const html = `<span class="acorde-analisis funcion-${r.funcion === '?' ? 'otra' : r.funcion}" data-k="${k}" title="${esc(r.nota)}">
                  <span class="insignia funcion-${r.funcion === '?' ? 'otra' : r.funcion}">${r.funcion}</span>
                  <span class="simbolo">${esc(simboloEn(tonica, a))}</span>
                  <span class="papel">${esc(r.papel)}</span></span>`;
                k++;
                return html;
              })
              .join('')}</div>`,
        )
        .join('')}</div>`;
    // Lo que significa cada papel que aparece (una vez cada uno).
    const vistos = new Map(analisis.map((r) => [r.papel, r]));
    $('[data-notas]').innerHTML = [...vistos.values()].map((r) => `<li><strong>${esc(r.papel)}</strong> (${NOMBRE[r.funcion]}): ${esc(r.nota)}</li>`).join('');
  }

  function pintar() {
    pintarTabla();
    pintarAnalisis();
    guardarJSON(CLAVE, op);
  }

  selector.addEventListener('change', () => ((op.progresion = selector.value), pintar()));
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    if (b.dataset.modoTabla) op.modoTabla = b.dataset.modoTabla as Modo;
    else if (b.dataset.modoAnalisis) op.modoAnalisis = b.dataset.modoAnalisis as Opciones['modoAnalisis'];
    else return;
    pintar();
  });

  conectarAudio((boton) => {
    const p = progresion();
    const { eventos, tramos, duracion } = secuenciaProgresion(tonica, compases(), tempo(), p.pulsos ?? 4, { sostenido: SOSTENIDOS.includes(instrumento()) });
    let marcado = -1;
    const marcar = (k: number) => {
      if (k === marcado) return;
      marcado = k;
      zonaAnalisis.querySelector('.sonando-ahora')?.classList.remove('sonando-ahora');
      if (k >= 0) zonaAnalisis.querySelector(`[data-k="${k}"]`)?.classList.add('sonando-ahora');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion,
      bucle: () => boton.dataset.audio === 'bucle',
      alProgresar: (t) => marcar(tramos.findIndex((x) => t >= x.inicio && t < x.fin)),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((t) => {
    tonica = t;
    pintar();
  });
  pintar();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.75rem;
  }
  .cabecera-bloque {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.75rem;
  }
  .cabecera-bloque h2 {
    margin: 0;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-bottom: 0.75rem;
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    font-weight: 700;
  }
  .campo select {
    width: auto;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .funciones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0.5rem;
  }
  .funciones :global(.columna) {
    padding: 0.75rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .funciones :global(h3) {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
  .funciones :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.25rem;
  }
  /* Insignias de función: T en blanco, SD con borde, D rellena (de reposo a tensión). */
  :global(.insignia) {
    display: inline-block;
    min-width: 2.2em;
    padding: 0 0.35em;
    font-size: 0.78rem;
    font-weight: 700;
    text-align: center;
    border-radius: var(--radio);
    border: 2px solid var(--acento);
  }
  :global(.insignia.funcion-T) {
    background: var(--fondo); /* COLOR: función tónica */
    color: var(--acento);
  }
  :global(.insignia.funcion-SD) {
    background: var(--acento-suave); /* COLOR: función subdominante */
    color: var(--texto);
  }
  :global(.insignia.funcion-D) {
    background: var(--acento); /* COLOR: función dominante */
    color: var(--sobre-acento);
  }
  :global(.insignia.funcion-otra) {
    border-color: var(--borde);
  }
  .analisis :global(.modo-detectado) {
    margin: 0 0 0.5rem;
    color: var(--texto-suave);
  }
  .analisis :global(.compases-analisis) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
    border-left: 2px solid var(--texto-suave);
  }
  .analisis :global(.compas-analisis) {
    display: flex;
    border-right: 2px solid var(--texto-suave);
    border-bottom: 1px solid var(--borde);
  }
  .analisis :global(.acorde-analisis) {
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    margin: 0.2rem;
    padding: 0.4rem 0.2rem;
    border-radius: var(--radio);
    text-align: center;
  }
  .analisis :global(.acorde-analisis.sonando-ahora) {
    background: var(--acento-suave);
    box-shadow: 0 0 0 2px var(--acento);
  }
  .analisis :global(.simbolo) {
    font-weight: 700;
    font-size: 1.1rem;
    overflow-wrap: anywhere;
  }
  .analisis :global(.papel) {
    font-size: 0.75rem;
    color: var(--acento);
    overflow-wrap: anywhere;
  }
  .notas-analisis {
    margin: 0.75rem 0 0;
    padding-left: 1.2rem;
    font-size: 0.88rem;
  }
  .notas-analisis :global(li) {
    margin: 0.2rem 0;
  }
</style>
