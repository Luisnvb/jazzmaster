---
// Tríadas (sección Estudio). El texto está en src/data/estudio/triadas.md; el ejemplo
// (inversiones o progresión, cerradas o abiertas, con diagramas) es components/EjemploDrop.astro.
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import EjemploDrop from '../../components/EjemploDrop.astro';
import { Content, getHeadings } from '../../data/estudio/triadas.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';

const indice = getHeadings().filter((h) => h.depth === 2);
---

<Base titulo="Tríadas">
  <SelectorTonica clave="triadas">
    <label>Sonido
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{i.nombre}</option>)}</select>
    </label>
    <Tempo clave="triadas" inicial={80} />
  </SelectorTonica>

  <EjemploDrop
    clave="triadas"
    tipos={['triada', 'triada-abierta']}
    cualidades={[
      ['I', 'Mayor'],
      ['Im', 'Menor'],
      ['I°', 'Disminuida'],
      ['I+', 'Aumentada'],
      ['Isus4', 'Sus4'],
    ]}
  />

  <nav class="indice" aria-label="En esta página">
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>
</Base>
