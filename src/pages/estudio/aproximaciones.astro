---
// Aproximaciones cromáticas (sección Estudio). El texto está en
// src/data/estudio/aproximaciones.md; aquí va el ejemplo (lib/aproximaciones.ts).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import { Content, getHeadings } from '../../data/estudio/aproximaciones.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { PATRONES } from '../../lib/aproximaciones.ts';
import { porOrden } from '../../lib/orden.ts';

const indice = getHeadings().filter((h) => h.depth === 2);
const progresiones = porOrden(await getCollection('progresiones')).map(({ id, data }) => ({
  id,
  nombre: data.nombre,
  pulsos: data.pulsos,
  compases: data.compases,
}));
const datos = JSON.stringify(progresiones).replace(/</g, '\\u003c');
// Acordes para practicar sobre uno solo (grado I con cada calidad).
const CUALIDADES = [
  ['Imaj7', 'maj7'],
  ['Im7', 'm7'],
  ['I7', '7'],
  ['Im7b5', 'm7b5'],
  ['I°7', '°7'],
  ['ImMaj7', 'mMaj7'],
  ['I7sus4', '7sus4'],
];
---

<Base titulo="Aproximaciones cromáticas">
  <SelectorTonica clave="aproximaciones">
    <label>Sonido
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{i.nombre}</option>)}</select>
    </label>
    <Tempo clave="aproximaciones" inicial={80} />
  </SelectorTonica>

  <section class="ejemplo" aria-label="Ejemplo">
    <div class="opciones">
      <div class="grupo-botones" role="group" aria-label="Objetivos">
        <span class="etiqueta">Objetivos</span>
        <button type="button" class="boton" data-fuente="acorde" aria-pressed="false">Notas de un acorde</button>
        <button type="button" class="boton" data-fuente="progresion" aria-pressed="false">Progresión</button>
      </div>
      <label class="campo" data-solo="acorde">Acorde
        <select data-cualidad>{CUALIDADES.map(([v, n]) => <option value={v}>{n}</option>)}</select>
      </label>
      <label class="campo" data-solo="progresion">Progresión
        <select data-progresion></select>
      </label>
      <label class="campo">Patrón
        <select data-patron>{PATRONES.map((p) => <option value={p.id}>{p.nombre}</option>)}</select>
      </label>
      <label class="casilla"><input type="checkbox" data-con-acorde /> Con acorde de fondo</label>
    </div>
    <p class="descripcion" data-descripcion></p>
    <ol class="tramos" data-tramos></ol>
    <p class="suave leyenda">
      En cada recuadro, las notas que llevan a su objetivo: <span class="muestra cromatica">cromática</span>
      <span class="muestra escala">de la escala</span> <span class="muestra objetivo">objetivo</span>. Las aproximaciones suenan en las
      últimas corcheas del compás anterior y el objetivo en el tiempo 1.
    </p>
    <div class="botones-audio">
      <button type="button" data-audio="una" aria-pressed="false">▶ Tocar</button>
      <button type="button" data-audio="bucle" aria-pressed="false" title="Suena sin parar hasta pulsar Detener">∞ Bucle</button>
      <button type="button" data-detener>■ Detener</button>
    </div>
  </section>

  <nav class="indice" aria-label="En esta página">
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>

  <script type="application/json" id="datos-aprox" set:html={datos} />
</Base>

<script>
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { SOSTENIDOS } from '../../lib/audio.ts';
  import { PATRONES, notasAproximacion, objetivosAcorde, objetivosProgresion, secuenciaAproximacion, type Objetivo } from '../../lib/aproximaciones.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica } from '../../lib/cliente.ts';
  import { analizarProgresion, aplicarCambiosProgresiones, parseAcordeGrado, type CambiosProgresiones, type Progresion } from '../../lib/progresiones.ts';

  // Las progresiones de la sección Progresiones, con lo editado en este navegador.
  const base: Progresion[] = JSON.parse(document.getElementById('datos-aprox')!.textContent!);
  const progresiones = aplicarCambiosProgresiones(base, leerJSON<CambiosProgresiones>('progresiones:cambios') ?? {}).filter((p) => {
    try {
      analizarProgresion(p.compases);
      return true;
    } catch {
      return false;
    }
  });

  interface Opciones {
    fuente: 'acorde' | 'progresion';
    cualidad: string;
    progresion: string;
    patron: string;
    acorde: boolean;
  }
  const CLAVE = 'aproximaciones:opciones';
  const op: Opciones = {
    fuente: 'acorde',
    cualidad: 'Imaj7',
    progresion: 'ii-v-i-mayor',
    patron: 'cromatica-abajo',
    acorde: true,
    ...leerJSON<Partial<Opciones>>(CLAVE),
  };
  let tonica = 'C';
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('aproximaciones:sonido');

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const selCualidad = $<HTMLSelectElement>('[data-cualidad]');
  const selProgresion = $<HTMLSelectElement>('[data-progresion]');
  const selPatron = $<HTMLSelectElement>('[data-patron]');
  const casillaAcorde = $<HTMLInputElement>('[data-con-acorde]');
  const lista = $('[data-tramos]');
  const descripcion = $('[data-descripcion]');
  selProgresion.innerHTML = progresiones.map((p) => `<option value="${esc(p.id)}">${esc(p.nombre)}</option>`).join('');
  if (!progresiones.some((p) => p.id === op.progresion)) op.progresion = progresiones[0]?.id ?? '';
  if (!PATRONES.some((p) => p.id === op.patron)) op.patron = PATRONES[0].id;
  selCualidad.value = op.cualidad;
  selProgresion.value = op.progresion;
  selPatron.value = op.patron;
  casillaAcorde.checked = op.acorde;

  const patron = () => PATRONES.find((p) => p.id === op.patron)!;
  const progresion = () => progresiones.find((p) => p.id === op.progresion);

  /** Objetivos y cuántos pulsos dura cada uno. */
  function material(): { objetivos: Objetivo[]; pulsos: number[] } {
    const p = progresion();
    if (op.fuente === 'progresion' && p) {
      const compases = analizarProgresion(p.compases);
      const porCompas = p.pulsos ?? 4;
      return { objetivos: objetivosProgresion(tonica, compases), pulsos: compases.flatMap((c) => c.map(() => porCompas / c.length)) };
    }
    const objetivos = objetivosAcorde(tonica, parseAcordeGrado(op.cualidad));
    return { objetivos, pulsos: objetivos.map(() => 4) };
  }

  function pintar() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-fuente]')) b.setAttribute('aria-pressed', String(b.dataset.fuente === op.fuente));
    for (const el of document.querySelectorAll<HTMLElement>('[data-solo]')) el.hidden = el.dataset.solo !== op.fuente;
    const { objetivos } = material();
    descripcion.innerHTML = `<strong>${esc(patron().nombre)}:</strong> ${esc(patron().descripcion)}`;
    lista.innerHTML = objetivos
      .map((o, i) => {
        const notas = notasAproximacion(o, patron());
        return `<li class="tramo" data-indice="${i}">
          <span class="simbolo">${esc(o.simbolo)}</span>
          <span class="notas">${notas
            .map((n) => `<span class="nota ${n.tipo}">${esc(n.nota)}${n.tipo === 'objetivo' ? `<small>${esc(o.grado)}</small>` : ''}</span>`)
            .join('<span class="flecha" aria-hidden="true">→</span>')}</span>
        </li>`;
      })
      .join('');
    guardarJSON(CLAVE, op);
  }

  selCualidad.addEventListener('change', () => ((op.cualidad = selCualidad.value), pintar()));
  selProgresion.addEventListener('change', () => ((op.progresion = selProgresion.value), pintar()));
  selPatron.addEventListener('change', () => ((op.patron = selPatron.value), pintar()));
  casillaAcorde.addEventListener('change', () => {
    op.acorde = casillaAcorde.checked;
    guardarJSON(CLAVE, op);
  });
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-fuente]');
    if (!b) return;
    op.fuente = b.dataset.fuente as Opciones['fuente'];
    pintar();
  });

  conectarAudio((boton) => {
    const { objetivos, pulsos } = material();
    const { eventos, tramos, duracion } = secuenciaAproximacion(objetivos, pulsos, patron(), tempo(), {
      acorde: op.acorde,
      sostenido: SOSTENIDOS.includes(instrumento()),
    });
    let marcado = -1;
    const marcar = (k: number) => {
      if (k === marcado) return;
      marcado = k;
      lista.querySelector('.sonando-ahora')?.classList.remove('sonando-ahora');
      if (k >= 0) lista.querySelector(`[data-indice="${k}"]`)?.classList.add('sonando-ahora');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion,
      bucle: () => boton.dataset.audio === 'bucle',
      alProgresar: (t) => marcar(tramos.findIndex((x) => t >= x.inicio && t < x.fin)),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((t) => {
    tonica = t;
    pintar();
  });
  pintar();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.5rem;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.5rem;
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .grupo-botones .etiqueta {
    margin-right: 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }
  .campo {
    min-width: 0;
    max-width: 100%;
  }
  .campo select {
    width: auto;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  .descripcion {
    margin: 0 0 0.5rem;
  }
  .tramos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 0.5rem;
  }
  .tramos :global(.tramo) {
    display: grid;
    gap: 0.4rem;
    padding: 0.6rem 0.75rem;
    background: var(--tarjeta);
    border: 1px solid var(--borde);
    border-radius: var(--radio-tarjeta);
  }
  .tramos :global(.tramo.sonando-ahora) {
    background: var(--acento-suave);
    border-color: var(--acento);
    box-shadow: 0 0 0 1px var(--acento);
  }
  .tramos :global(.simbolo) {
    font-weight: 700;
    font-size: 1.15rem;
  }
  .tramos :global(.notas) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }
  .tramos :global(.flecha) {
    color: var(--texto-suave);
    font-size: 0.8rem;
  }
  :global(.tramos .nota),
  .muestra {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    padding: 0.1rem 0.45rem;
    font-weight: 700;
    background: var(--fondo);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  :global(.tramos .nota small) {
    font-size: 0.72rem;
    font-weight: 600;
  }
  /* Tipos de nota: cromática (borde de acento), de la escala (borde discontinuo) y objetivo (relleno). */
  :global(.tramos .nota.cromatica),
  .muestra.cromatica {
    border: 2px solid var(--acento); /* COLOR: nota de aproximación cromática */
  }
  :global(.tramos .nota.escala),
  .muestra.escala {
    border: 2px dashed var(--texto-suave); /* COLOR: nota de aproximación de la escala */
  }
  :global(.tramos .nota.objetivo),
  .muestra.objetivo {
    background: var(--acento); /* COLOR: nota objetivo */
    border-color: var(--acento);
    color: var(--sobre-acento);
  }
  .leyenda {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    line-height: 1.9;
  }
</style>
