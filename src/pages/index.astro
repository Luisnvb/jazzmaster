---
import Base from '../layouts/Base.astro';
import { ruta } from '../lib/rutas.ts';

const secciones = [
  { href: ruta('intervalos'), nombre: 'Intervalos', lema: 'Fichas, audio y entrenador de oído' },
  { href: ruta('escalas'), nombre: 'Escalas', lema: 'Diccionario por tipo de acorde' },
  { href: ruta('acordes'), nombre: 'Acordes', lema: 'Voicings con sus grados' },
  { href: ruta('repertorio'), nombre: 'Repertorio', lema: 'Cifrados, letras y notas' },
];
---

<Base titulo="Inicio">
  <h1>Práctica de guitarra</h1>
  <ul class="portada">
    {
      secciones.map((s, i) => (
        <li>
          <a href={s.href}>
            <span class="kicker">{String(i + 1).padStart(2, '0')}</span>
            <span class="nombre">{s.nombre}</span>
            <span class="lema">{s.lema}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .portada {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
  }
  .portada a {
    display: grid;
    align-content: space-between;
    gap: 1.5rem;
    min-height: 22rem;
    padding: 1.75rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    color: var(--texto);
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }
  .portada .nombre {
    font-family: var(--fuente-titulo);
    font-size: clamp(3rem, 4vw, 5rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .portada .lema {
    color: var(--texto-suave);
    font-size: 1.05rem;
  }
  .portada a:hover {
    background: var(--acento);
    border-color: var(--acento);
    color: var(--sobre-acento);
  }
  .portada a:hover .kicker,
  .portada a:hover .lema {
    color: var(--sobre-acento);
  }
</style>
