---
// Portada: cada sección (lib/secciones.ts) con sus páginas, como en el menú de la
// guitarra, y debajo una cita al azar (src/data/citas.yaml). En pantalla grande se ven
// todas en columnas, sin la barra de secciones de la cabecera; en el móvil van
// plegadas. Las páginas favoritas salen las primeras de cada lista
// (lib/paginas-favoritas.ts, desde layouts/Base.astro). Bajo Herramientas van el botón
// del Registro de práctica (empieza, pausa y termina una sesión con la última actividad
// elegida, lib/registro.ts) y las notas y los documentos favoritos de Apuntes
// (lib/apuntes.ts).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MenuSecciones from '../components/MenuSecciones.astro';
import { porOrden } from '../lib/orden.ts';
import { ruta } from '../lib/rutas.ts';

const citas = porOrden(await getCollection('citas')).map(({ data }) => ({
  texto: data.texto,
  autor: data.autor,
  idioma: data.idioma,
  traduccion: data.traduccion ?? '',
}));
// JSON dentro de <script>: se escapa "<" para que ningún texto pueda cerrar la etiqueta.
const datos = JSON.stringify(citas).replace(/</g, '\\u003c');
---

<Base titulo="Inicio" encabezado="JAZZMASTER" conBarra={false}>
  <Fragment slot="encabezado">JAZZ<span class="master">MASTER</span></Fragment>
  <h2 class="visualmente-oculto">Secciones</h2>
  <div class="portada" data-portada>
    <MenuSecciones columnas>
      <div slot="herramientas" class="bajo-herramientas">
        <div class="registro-rapido" aria-label="Registro de práctica" role="group">
          <div data-registro-parado>
            <button type="button" class="boton principal pequeno" data-registro-empezar>▶ Registrar práctica</button>
            <a class="actividad" href={ruta('herramientas/registro')} data-registro-ultima title="Cambiar la actividad en el Registro de práctica"></a>
          </div>
          <div data-registro-activo hidden>
            <div class="reloj-rapido"><span class="punto" aria-hidden="true"></span><span data-registro-reloj>0:00:00</span></div>
            <a class="actividad" href={ruta('herramientas/registro')} data-registro-actividad></a>
            <div class="botones-rapido">
              <button type="button" class="boton pequeno" data-registro-pausar>❚❚ Pausar</button>
              <button type="button" class="boton principal pequeno" data-registro-terminar>■ Terminar</button>
            </div>
          </div>
          <p class="aviso-registro" data-registro-aviso role="status"></p>
        </div>
        <div class="favoritos" data-favoritos hidden></div>
      </div>
    </MenuSecciones>
  </div>
  <figure class="cita" data-cita hidden>
    <blockquote><p data-cita-texto></p></blockquote>
    <p class="traduccion" lang="es" data-cita-traduccion hidden></p>
    <figcaption data-cita-autor></figcaption>
  </figure>
  <script type="application/json" id="datos-portada" set:html={datos} />
</Base>

<script>
  import { borrar, esc, guardarJSON, leerJSON } from '../lib/almacen.ts';
  import { anclaDocumento, leerDocumentos, leerNotas, nuevoId, ordenar, tituloDe } from '../lib/apuntes.ts';
  import {
    alternarPausa,
    cerrarSesion,
    duracion,
    empezarSesion,
    enCursoValido,
    ordenarSesiones,
    reloj,
    segundosEnCurso,
    sesionesValidas,
    ultimaActividad,
  } from '../lib/registro.ts';
  import { ruta } from '../lib/rutas.ts';

  interface Cita {
    texto: string;
    autor: string;
    idioma: string;
    traduccion: string;
  }
  const citas: Cita[] = JSON.parse(document.getElementById('datos-portada')!.textContent!);

  // Una cita al azar en cada visita.
  const cita = citas[Math.floor(Math.random() * citas.length)];
  if (cita) {
    const caja = document.querySelector<HTMLElement>('[data-cita]')!;
    caja.querySelector<HTMLElement>('[data-cita-texto]')!.textContent = cita.texto;
    caja.querySelector('blockquote')!.lang = cita.idioma;
    // Si no está en inglés, debajo va la traducción.
    const traduccion = caja.querySelector<HTMLElement>('[data-cita-traduccion]')!;
    traduccion.textContent = cita.traduccion;
    traduccion.hidden = cita.idioma === 'en' || !cita.traduccion;
    caja.querySelector<HTMLElement>('[data-cita-autor]')!.textContent = cita.autor;
    caja.hidden = false;
  }

  // Bajo Herramientas: las notas favoritas (a su página) y los documentos favoritos (a su
  // tarjeta en la lista de Apuntes).
  function pintarFavoritos() {
    const notas = ordenar(leerNotas().filter((n) => n.favorita)).map((n) => ({
      href: `${ruta('apuntes/nota')}?id=${encodeURIComponent(n.id)}`,
      nombre: tituloDe(n),
    }));
    const documentos = ordenar(leerDocumentos().filter((d) => d.favorita)).map((d) => ({
      href: `${ruta('apuntes')}#${anclaDocumento(d.id)}`,
      nombre: d.titulo,
    }));
    const caja = document.querySelector<HTMLElement>('[data-favoritos]')!;
    const lista = [...notas, ...documentos];
    caja.hidden = lista.length === 0;
    caja.innerHTML = `<ul>${lista.map((e) => `<li><a href="${esc(e.href)}">★ ${esc(e.nombre)}</a></li>`).join('')}</ul>`;
  }
  // Registro de práctica: las mismas claves que la página del registro, así el
  // cronómetro es el mismo aquí y allí.
  const EN_CURSO = 'registro:en-curso';
  const $r = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const avisoRegistro = $r('[data-registro-aviso]');

  function pintarRegistro() {
    const e = enCursoValido(leerJSON(EN_CURSO));
    $r('[data-registro-parado]').hidden = !!e;
    $r('[data-registro-activo]').hidden = !e;
    if (!e) {
      const [, actividad] = ultimaActividad(leerJSON('registro:ultima'));
      $r('[data-registro-ultima]').textContent = `Actividad: ${actividad}`;
      return;
    }
    $r('[data-registro-reloj]').textContent = reloj(segundosEnCurso(e, Date.now()));
    $r('[data-registro-actividad]').textContent = e.actividad;
    $r('[data-registro-activo]').classList.toggle('pausado', e.desde === null);
    $r('[data-registro-pausar]').textContent = e.desde === null ? '▶ Seguir' : '❚❚ Pausar';
  }

  $r('[data-registro-empezar]').addEventListener('click', () => {
    guardarJSON(EN_CURSO, empezarSesion(Date.now(), ultimaActividad(leerJSON('registro:ultima'))));
    avisoRegistro.textContent = '';
    pintarRegistro();
  });
  $r('[data-registro-pausar]').addEventListener('click', () => {
    const e = enCursoValido(leerJSON(EN_CURSO));
    if (e) guardarJSON(EN_CURSO, alternarPausa(e, Date.now()));
    pintarRegistro();
  });
  $r('[data-registro-terminar]').addEventListener('click', () => {
    const e = enCursoValido(leerJSON(EN_CURSO));
    if (!e) return pintarRegistro();
    const s = cerrarSesion(e, Date.now(), nuevoId('s'));
    if (s) {
      const sesiones = ordenarSesiones([s, ...sesionesValidas(leerJSON('registro:sesiones'))]);
      avisoRegistro.textContent = guardarJSON('registro:sesiones', sesiones) ? `Guardada: ${duracion(s.segundos)}.` : 'No se ha podido guardar.';
    } else avisoRegistro.textContent = 'Menos de 5 s: no se guarda.';
    borrar(EN_CURSO);
    pintarRegistro();
  });
  setInterval(pintarRegistro, 1000);
  pintarRegistro();

  pintarFavoritos();
  // Si se cambian en otra pestaña, o al volver con «atrás».
  addEventListener('storage', () => {
    pintarFavoritos();
    pintarRegistro();
  });
  addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    pintarFavoritos();
    pintarRegistro();
  });

  // Pantalla grande: todas las secciones abiertas y sin plegar; en el móvil, plegadas.
  const grande = matchMedia('(min-width: 60rem)');
  const desplegables = [...document.querySelectorAll<HTMLDetailsElement>('[data-portada] details')];
  const ajustar = () => desplegables.forEach((d) => (d.open = grande.matches));
  grande.addEventListener('change', ajustar);
  ajustar();
  for (const d of desplegables) {
    d.querySelector('summary')!.addEventListener('click', (e) => {
      if (grande.matches) e.preventDefault();
    });
  }
</script>

<style>
  .master {
    color: var(--acento);
  }
  .cita {
    max-width: var(--ancho-texto);
    margin: 0 0 2rem;
  }
  .cita blockquote {
    margin: 0;
    font-family: var(--fuente-titulo);
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.45;
  }
  .cita blockquote p {
    margin: 0;
  }
  .cita blockquote p::before {
    content: '«';
  }
  .cita blockquote p::after {
    content: '»';
  }
  .cita .traduccion {
    margin: 0.35rem 0 0;
    font-size: 0.95rem;
    color: var(--texto-suave);
  }
  .cita figcaption {
    margin-top: 0.4rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .cita figcaption::before {
    content: '— ';
  }
  /* El hueco entre las secciones y la cita va aquí (los márgenes de ambos se solapan). */
  .portada {
    margin-bottom: 6rem;
  }
  /* En la portada, la línea de cada lista de páginas va en el color de acento. */
  .portada :global(.paginas) {
    border-left-color: var(--acento);
  }
  .registro-rapido {
    margin: 0 0 0.75rem;
  }
  .registro-rapido .pequeno {
    padding: 0.3rem 0.6rem;
    font-size: 0.85rem;
  }
  .registro-rapido .actividad {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--texto-suave);
    text-decoration: none;
  }
  .registro-rapido .actividad:hover {
    color: var(--acento);
  }
  .reloj-rapido {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.4rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  /* COLOR: el registro está contando */
  .punto {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--acento);
    animation: latido 1.2s ease-in-out infinite;
  }
  .pausado .reloj-rapido {
    color: var(--texto-suave);
  }
  .pausado .punto {
    background: var(--texto-suave);
    animation: none;
  }
  @keyframes latido {
    50% {
      opacity: 0.25;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .punto {
      animation: none;
    }
  }
  .botones-rapido {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.4rem;
  }
  .aviso-registro {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    color: var(--texto-suave);
  }
  .aviso-registro:empty {
    display: none;
  }
  .favoritos {
    margin: 0 0 0.75rem;
    padding: 0 0 0 1rem;
    border-left: 0.2rem solid var(--acento);
  }
  .favoritos :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .favoritos :global(a) {
    display: block;
    padding: 0.3rem 0;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--texto-suave);
    text-decoration: none;
  }
  .favoritos :global(a:hover) {
    color: var(--acento);
  }
  @media (max-width: 59.99rem) {
    .portada {
      max-width: 36rem;
    }
  }
</style>
