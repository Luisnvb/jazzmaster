---
// Portada: cada sección (lib/secciones.ts) con sus páginas. En pantalla grande se ven
// todas; en el móvil van plegadas en un desplegable.
// Las páginas favoritas salen las primeras de cada lista (lib/paginas-favoritas.ts,
// desde layouts/Base.astro).
import Base from '../layouts/Base.astro';
import { SECCIONES } from '../lib/secciones.ts';
---

<Base titulo="Inicio" encabezado="JazzMaster">
  <h2 class="visualmente-oculto">Secciones</h2>
  <ul class="secciones">
    {
      SECCIONES.map((s, i) => (
        <li class="seccion">
          <details>
            <summary>
              <span class="kicker">{String(i + 1).padStart(2, '0')}</span>
              <a class="nombre" href={s.href}>
                {s.nombre}
              </a>
              <span class="cuenta">
                {s.partes.length} {s.partes.length === 1 ? 'página' : 'páginas'}
                <span class="flecha" aria-hidden="true">▾</span>
              </span>
            </summary>
            <ul class="paginas" data-lista-paginas>
              {s.partes.map((p) => (
                <li data-pagina={p.href}>
                  <a href={p.href} title={p.lema}>
                    {p.nombre}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      ))
    }
  </ul>
</Base>

<script>
  // Pantalla grande: todas las secciones abiertas y sin plegar; en el móvil, plegadas.
  const grande = matchMedia('(min-width: 60rem)');
  const desplegables = [...document.querySelectorAll<HTMLDetailsElement>('.secciones details')];
  const ajustar = () => desplegables.forEach((d) => (d.open = grande.matches));
  grande.addEventListener('change', ajustar);
  ajustar();
  for (const d of desplegables) {
    d.querySelector('summary')!.addEventListener('click', (e) => {
      if (grande.matches && !(e.target as Element).closest('a')) e.preventDefault();
    });
  }
</script>

<style>
  .secciones,
  .paginas {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .secciones {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0.75rem;
    align-items: start;
    margin-bottom: 2rem;
  }
  .seccion {
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-top: 0.25rem solid var(--acento);
    border-radius: var(--radio);
  }
  summary {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .kicker {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .nombre {
    font-family: var(--fuente-titulo);
    font-weight: 600;
    font-size: clamp(1.25rem, 1.5vw, 1.6rem);
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--texto);
    text-decoration: none;
  }
  .nombre:hover {
    color: var(--acento);
  }
  .cuenta {
    margin-left: auto;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--texto-suave);
    white-space: nowrap;
  }
  .flecha {
    display: inline-block;
    margin-left: 0.2rem;
    transition: transform 0.15s;
  }
  details[open] .flecha {
    transform: rotate(180deg);
  }
  summary:hover .cuenta {
    color: var(--acento);
  }
  .paginas {
    padding: 0.35rem 0;
    border-top: 1px solid var(--borde);
  }
  .paginas a {
    display: block;
    padding: 0.3rem 1rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--texto-suave);
    text-decoration: none;
  }
  .paginas a:hover {
    color: var(--acento);
    background: var(--fondo);
  }
  /* Pantalla grande: nada que plegar, así que sin contador ni flecha. */
  @media (min-width: 60rem) {
    summary {
      cursor: default;
    }
    .cuenta {
      display: none;
    }
  }
  .paginas :global(.favorita) > a::before {
    content: '★ ';
    color: var(--acento);
  }
</style>
