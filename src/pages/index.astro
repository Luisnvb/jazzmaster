---
import Base from '../layouts/Base.astro';

const secciones = [
  { href: '/intervalos', nombre: 'Intervalos' },
  { href: '/escalas', nombre: 'Escalas' },
  { href: '/acordes', nombre: 'Acordes' },
  { href: '/repertorio', nombre: 'Repertorio' },
];
---

<Base titulo="Inicio">
  <h1>Práctica de guitarra</h1>
  <ul class="portada">
    {secciones.map((s) => <li><a href={s.href}>{s.nombre}</a></li>)}
  </ul>
</Base>

<style>
  .portada {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .portada a {
    display: block;
    padding: 1.5rem 1.25rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: 0.75rem;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--texto);
    text-decoration: none;
  }
</style>
