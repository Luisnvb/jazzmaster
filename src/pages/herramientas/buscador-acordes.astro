---
// Buscador de acordes (sección Herramientas): escribes unas notas (la primera es el
// bajo) y dice qué acorde forman, con las otras lecturas posibles debajo
// (lib/buscador-acordes.ts). También desde el mástil: se pulsa un traste por cuerda y
// el bajo es la nota más grave. Se recuerda lo último y se puede enlazar con ?notas=
// (C,E,G) o ?trastes= (x,3,5,4,5,x, de 6ª a 1ª).
import Base from '../../layouts/Base.astro';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { ruta } from '../../lib/rutas.ts';
import { TONICAS } from '../../lib/teoria.ts';
---

<Base titulo="Buscador de acordes">
  <div class="centrada">
    <div class="modos" role="group" aria-label="Cómo buscar">
      <button type="button" class="boton" data-modo="notas" aria-pressed="true">Escribir notas</button>
      <button type="button" class="boton" data-modo="mastil" aria-pressed="false">En el mástil</button>
    </div>

    <p class="intro" data-solo-modo="notas">
      Escribe las notas del acorde de grave a agudo, separadas por espacios o comas: la primera es el <strong>bajo</strong>.
      Valen <code>C Eb G Bb</code>, <code>do mib sol sib</code> o <code>c, d#, f♯</code>. También puedes ir pulsando las notas.
    </p>
    <p class="intro" data-solo-modo="mastil" hidden>
      Pulsa un traste en cada cuerda que suene (0 es la cuerda al aire, a la izquierda de la cejuela); pulsarlo otra vez la
      apaga. El <strong>bajo</strong> es la nota más grave.
    </p>

    <section class="buscador" aria-label="Buscador">
      <div data-solo-modo="mastil" hidden>
        <div class="mastil-caja" data-mastil></div>
        <div class="acciones-mastil">
          <span class="suave" data-trastes-texto></span>
          <button type="button" class="boton" data-limpiar-mastil>Limpiar mástil</button>
        </div>
      </div>
      <div class="entrada" data-solo-modo="notas">
        <label class="campo" for="notas">Notas</label>
        <input id="notas" type="text" autocomplete="off" spellcheck="false" placeholder="C E G Bb" data-notas />
        <button type="button" class="boton" data-borrar>Borrar</button>
      </div>
      <div class="teclas" role="group" aria-label="Añadir o quitar notas" data-solo-modo="notas">
        {TONICAS.map((t) => <button type="button" class="boton" data-nota={t} aria-pressed="false">{t}</button>)}
      </div>

      <div class="caja-resultado">
        <div class="resultado" data-resultado aria-live="polite"></div>
        <div class="diagrama-voicing" data-diagrama hidden></div>
      </div>
      <div class="botones-audio">
        <label>Sonido
          <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{i.nombre}</option>)}</select>
        </label>
        <button type="button" data-audio="bloque" aria-pressed="false">▶ En bloque</button>
        <button type="button" data-audio="arpegio" aria-pressed="false">▶ Arpegiado</button>
        <button type="button" data-detener>■ Detener</button>
      </div>

      <h2 class="titulo-otras" data-otras-titulo hidden>Otras lecturas</h2>
      <ul class="otras" data-otras></ul>
    </section>

    <p class="nota-pie">
      El nombre depende del bajo: <code>A C E G</code> es Am7, pero <code>C A E G</code> se lee antes como C6 (y Am7/C queda
      entre las otras lecturas). Sin 3ª, el acorde se nombra como sus o se avisa de que falta. Los nombres siguen las mismas
      reglas que <a href={ruta('estudio/slash')}>Acordes slash</a>.
    </p>
  </div>
</Base>

<script>
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { SOSTENIDOS } from '../../lib/audio.ts';
  import { mastilSVG, TRASTES, type NotaMastil } from '../../lib/arpegios.ts';
  import {
    alternarTraste,
    buscarAcordes,
    buscarEnMastil,
    gradosDeTrastes,
    leerNota,
    leerNotas,
    midisAcorde,
    nombrarIntervalo,
    sinTrastes,
    trastesValidos,
    type Candidato,
    type TrastesMastil,
  } from '../../lib/buscador-acordes.ts';
  import { conectarAudio, conectarInstrumento } from '../../lib/cliente.ts';
  import { diagramaSVG } from '../../lib/diagrama.ts';
  import { AFINACION, type Evento } from '../../lib/secuencias.ts';
  import { pitchClass } from '../../lib/teoria.ts';

  const CLAVE = 'herramientas:buscador-acordes';
  const CLAVE_MASTIL = 'herramientas:buscador-acordes-mastil';
  const CLAVE_MODO = 'herramientas:buscador-acordes-modo';
  type Modo = 'notas' | 'mastil';
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const entrada = $<HTMLInputElement>('[data-notas]');
  const resultado = $('[data-resultado]');
  const otras = $('[data-otras]');
  const otrasTitulo = $('[data-otras-titulo]');
  const caja = $('[data-mastil]');
  const diagrama = $('[data-diagrama]');
  const trastesTexto = $('[data-trastes-texto]');
  const instrumento = conectarInstrumento('herramientas:sonido');

  const parametros = new URLSearchParams(location.search);
  const notasEnlace = parametros.get('notas');
  const trastesEnlace = parametros.get('trastes');
  const guardada = leerJSON<unknown>(CLAVE);
  entrada.value = notasEnlace ?? (typeof guardada === 'string' ? guardada : 'C E G Bb');
  let trastes: TrastesMastil = trastesValidos(
    trastesEnlace
      ? trastesEnlace.split(',').map((t) => (/^\d+$/.test(t.trim()) ? Number(t) : 'x'))
      : (leerJSON<unknown>(CLAVE_MASTIL) ?? ['x', 3, 2, 0, 1, 0]),
  );
  let modo: Modo = trastesEnlace ? 'mastil' : notasEnlace ? 'notas' : leerJSON<Modo>(CLAVE_MODO) === 'mastil' ? 'mastil' : 'notas';

  const chips = (c: Candidato) =>
    c.notas.map((n) => `<span class="chip${n.grado === '1' ? ' raiz' : ''}"><strong>${esc(n.nota)}</strong> <span class="grado">${esc(n.grado)}</span></span>`).join('');

  function pintarMastil(mejor: Candidato | undefined) {
    const grados = mejor ? gradosDeTrastes(trastes, mejor) : [];
    const notas: NotaMastil[] = [];
    for (let c = 0; c < 6; c++) {
      for (let t = 0; t <= TRASTES; t++) {
        const midi = AFINACION[c] + t;
        notas.push(
          trastes[c] === t
            ? { cuerda: c, traste: t, midi, grado: grados[c] ?? '', nota: '', rotulo: grados[c] || '●', clase: 'marcada', atenuada: false }
            : { cuerda: c, traste: t, midi, grado: '', nota: '', rotulo: '', clase: 'hueco-nota', atenuada: false },
        );
      }
    }
    caja.innerHTML = mastilSVG(notas);
    trastesTexto.textContent = `De 6ª a 1ª: ${trastes.map((t) => (t === 'x' ? '×' : t)).join(' ')}`;
    const suena = trastes.some((t) => t !== 'x');
    diagrama.hidden = !suena;
    diagrama.innerHTML = suena ? diagramaSVG({ trastes, grados: grados.length ? grados : trastes.map(() => '') }) : '';
  }

  function pintar() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-modo]')) b.setAttribute('aria-pressed', String(b.dataset.modo === modo));
    for (const el of document.querySelectorAll<HTMLElement>('[data-solo-modo]')) el.hidden = el.dataset.soloModo !== modo;
    let notas: string[];
    let errores: string[] = [];
    let candidatos: Candidato[];
    if (modo === 'mastil') {
      ({ notas, candidatos } = buscarEnMastil(trastes));
      pintarMastil(candidatos[0]);
    } else {
      ({ notas, errores } = leerNotas(entrada.value));
      candidatos = buscarAcordes(notas);
      diagrama.hidden = true;
    }
    const pcs = new Set(notas.map((n) => pitchClass(leerNota(n)!)));
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-nota]')) b.setAttribute('aria-pressed', String(pcs.has(pitchClass(leerNota(b.dataset.nota!)!))));
    const aviso = errores.length ? `<p class="aviso">No entiendo: ${errores.map((e) => `<code>${esc(e)}</code>`).join(', ')}</p>` : '';
    if (!candidatos.length) {
      const texto =
        notas.length === 0
          ? modo === 'mastil'
            ? 'Pulsa trastes en al menos tres cuerdas (con tres notas distintas).'
            : 'Escribe o pulsa al menos tres notas distintas.'
          : notas.length === 1
            ? `Solo una nota: <strong>${esc(notas[0])}</strong>. Faltan dos más para un acorde.`
            : `<strong>${esc(notas[0])}–${esc(notas[1])}</strong>: ${esc(nombrarIntervalo(notas[0], notas[1]))}. Con dos notas es un intervalo; añade otra para formar un acorde.`;
      resultado.innerHTML = `<p class="vacio">${texto}</p>${aviso}`;
      otras.innerHTML = '';
      otrasTitulo.hidden = true;
    } else {
      const [mejor, ...resto] = candidatos;
      resultado.innerHTML = `
        <div class="simbolo">${esc(mejor.simbolo)}</div>
        <div class="detalle suave">${mejor.fundamental ? 'Raíz en el bajo' : `Raíz ${esc(mejor.raiz)}, con ${esc(notas[0])} en el bajo`}${mejor.sinTercera ? ' · sin 3ª' : ''}</div>
        <div class="chips" aria-label="Notas y grados">${chips(mejor)}</div>${aviso}`;
      otras.innerHTML = resto.map((c) => `<li><span class="simbolo-otro">${esc(c.simbolo)}</span><span class="chips">${chips(c)}</span></li>`).join('');
      otrasTitulo.hidden = resto.length === 0;
    }
    guardarJSON(CLAVE, entrada.value);
    guardarJSON(CLAVE_MASTIL, trastes);
    guardarJSON(CLAVE_MODO, modo);
  }

  caja.addEventListener('click', (e) => {
    const g = (e.target as Element).closest<SVGGElement>('.nota');
    if (!g) return;
    const cuerda = Number(g.dataset.cuerda);
    trastes = alternarTraste(trastes, cuerda, Number(g.dataset.midi) - AFINACION[cuerda]);
    pintar();
  });
  $('[data-limpiar-mastil]').addEventListener('click', () => {
    trastes = sinTrastes();
    pintar();
  });
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-modo]')) {
    b.addEventListener('click', () => {
      modo = b.dataset.modo as Modo;
      pintar();
    });
  }

  entrada.addEventListener('input', pintar);
  $('[data-borrar]').addEventListener('click', () => {
    entrada.value = '';
    pintar();
    entrada.focus();
  });
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-nota]');
    if (!b) return;
    const pc = pitchClass(leerNota(b.dataset.nota!)!);
    const { notas } = leerNotas(entrada.value);
    const sin = notas.filter((n) => pitchClass(leerNota(n)!) !== pc);
    entrada.value = (sin.length < notas.length ? sin : [...notas, b.dataset.nota!]).join(' ');
    pintar();
  });

  conectarAudio((boton) => {
    // En el mástil suena el voicing tal cual; con notas escritas, el bajo abajo y el resto encima.
    const midis = modo === 'mastil' ? buscarEnMastil(trastes).midis : midisAcorde(leerNotas(entrada.value).notas);
    const sostenido = SOSTENIDOS.includes(instrumento());
    const eventos: Evento[] =
      boton.dataset.audio === 'arpegio'
        ? midis.map((midi, i) => ({ midi, inicio: i * 0.3, duracion: (midis.length - i) * 0.3 + 2 }))
        : midis.map((midi, i) => ({ midi, inicio: sostenido ? 0 : i * 0.015, duracion: 2.5 }));
    return { eventos, instrumento: instrumento() };
  });

  pintar();
</script>

<style>
  /* Toda la herramienta en una columna centrada en la página. */
  .centrada {
    max-width: 52rem;
    margin: 0 auto;
  }
  .intro,
  .nota-pie {
    max-width: var(--ancho-texto);
  }
  .nota-pie {
    margin-top: 2rem;
    font-size: 0.92rem;
    color: var(--texto-suave);
  }
  .entrada {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    max-width: 40rem;
    margin-bottom: 0.6rem;
  }
  .entrada .campo {
    font-weight: 700;
  }
  .entrada input {
    flex: 1 1 12rem;
    min-width: 0;
    margin: 0;
    font-size: 1.15rem;
  }
  .teclas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    max-width: 40rem;
    margin-bottom: 1rem;
  }
  .teclas .boton {
    min-width: 2.8rem;
  }
  .modos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 1rem;
  }
  .mastil-caja {
    overflow-x: auto;
    padding: 0.25rem 0.5rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .mastil-caja :global(.nota) {
    cursor: pointer;
  }
  .mastil-caja :global(.nota.hueco-nota circle) {
    fill: transparent;
  }
  .mastil-caja :global(.nota.hueco-nota:hover circle) {
    fill: var(--acento-suave); /* COLOR: traste bajo el ratón */
  }
  .acciones-mastil {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0.5rem 0 1rem;
    font-size: 0.9rem;
  }
  .caja-resultado {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem 1.25rem;
    margin: 0 0 0.75rem;
  }
  .diagrama-voicing {
    width: 9.5rem;
  }
  .resultado {
    display: grid;
    gap: 0.4rem;
    flex: 1 1 18rem;
    max-width: 40rem;
    margin: 0;
    padding: 0.9rem 1.1rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-top: 0.3rem solid var(--acento);
    border-radius: var(--radio);
  }
  .resultado :global(.simbolo) {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .resultado :global(.vacio),
  .resultado :global(.aviso) {
    margin: 0;
  }
  .resultado :global(.aviso) {
    color: var(--texto-suave);
    font-size: 0.9rem;
  }
  .buscador :global(.chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .buscador :global(.chip) {
    padding: 0.1rem 0.5rem;
    background: var(--fondo);
    border: 1px solid var(--texto-suave);
    border-radius: var(--radio);
  }
  .buscador :global(.chip .grado) {
    color: var(--texto-suave);
    font-weight: 700;
  }
  .buscador :global(.chip.raiz) {
    color: var(--sobre-acento);
    background: var(--acento); /* COLOR: la raíz del acorde */
    border-color: var(--acento);
  }
  .buscador :global(.chip.raiz .grado) {
    color: inherit;
  }
  .titulo-otras {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.05rem;
  }
  .otras {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    max-width: 40rem;
  }
  .otras :global(li) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    padding: 0.5rem 0.75rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .otras :global(.simbolo-otro) {
    min-width: 7rem;
    font-size: 1.15rem;
    font-weight: 800;
  }
</style>
