---
// Ruta de aprendizaje: las etapas y pasos de lib/ruta.ts, cada uno con su página de la
// web. El progreso (pasos hechos) se marca aquí o en la propia página (aviso de
// layouts/Base.astro) y se guarda en este navegador.
import Base from '../layouts/Base.astro';
import { ETAPAS, PASOS } from '../lib/ruta.ts';
import { PAGINAS } from '../lib/secciones.ts';
import { ruta } from '../lib/rutas.ts';

const pagina = (direccion: string) => {
  const p = PAGINAS.find((x) => x.href === ruta(direccion));
  if (!p) throw new Error(`Ruta de aprendizaje: la página «${direccion}» no está en lib/secciones.ts`);
  return p;
};
const idPaso = (direccion: string) => `paso-${direccion.replace(/\//g, '-')}`;
---

<Base titulo="Ruta de aprendizaje">
  <p class="lema">
    Un orden para recorrer la web: {ETAPAS.length} etapas y {PASOS.length} pasos, de los cimientos al sonido moderno.
    Cada paso te lleva a una página y dice cuándo darlo por bueno. Márcalo como hecho aquí o en la propia página;
    el progreso se guarda en este navegador.
  </p>

  <section class="siguiente" aria-labelledby="siguiente-titulo" data-siguiente>
    <div class="siguiente-cabecera">
      <h2 id="siguiente-titulo">Siguiente paso</h2>
      <p class="progreso-total" data-progreso-total></p>
    </div>
    <div class="barra" aria-hidden="true"><span data-barra-total></span></div>
    <div data-siguiente-contenido></div>
  </section>

  <nav class="indice" aria-label="Etapas">
    {
      ETAPAS.map((e, i) => (
        <a href={`#etapa-${e.id}`}>
          {i + 1}. {e.nombre} <span class="cuenta-etapa" data-cuenta-indice={e.id} />
        </a>
      ))
    }
  </nav>

  {
    ETAPAS.map((e, i) => (
      <section class="etapa" id={`etapa-${e.id}`} aria-labelledby={`titulo-${e.id}`}>
        <div class="etapa-cabecera">
          <h2 id={`titulo-${e.id}`}>
            <span class="numero">{i + 1}</span> {e.nombre}
          </h2>
          <span class="cuenta" data-cuenta-etapa={e.id}>
            0 / {e.pasos.length}
          </span>
        </div>
        <p class="objetivo">{e.objetivo}</p>
        <ol class="pasos">
          {e.pasos.map((p) => {
            const pg = pagina(p.direccion);
            const numero = PASOS.find((x) => x.direccion === p.direccion)!.numero;
            return (
              <li class="tarjeta paso" id={idPaso(p.direccion)} data-paso={p.direccion}>
                <div class="paso-cabecera">
                  <span class="paso-numero">{numero}</span>
                  <a class="paso-nombre" href={pg.href}>
                    {pg.nombre}
                  </a>
                  <label class="hecho">
                    <input type="checkbox" data-marcar={p.direccion} /> Hecho
                  </label>
                </div>
                <p class="tarea">{p.tarea}</p>
                <p class="meta">
                  <strong>Lo tienes cuando:</strong> {p.meta}
                </p>
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }

  <p class="reiniciar">
    <button type="button" class="boton peligro" data-reiniciar>Empezar de cero</button>
  </p>

  <script
    type="application/json"
    id="datos-ruta"
    set:html={JSON.stringify(
      Object.fromEntries(PASOS.map((p) => [p.direccion, { href: pagina(p.direccion).href, nombre: pagina(p.direccion).nombre, id: idPaso(p.direccion) }])),
    ).replace(/</g, '\\u003c')}
  />
</Base>

<script>
  import { esc } from '../lib/almacen.ts';
  import { ETAPAS, PASOS, hechosDeEtapa, progresoRuta, siguientePaso } from '../lib/ruta.ts';

  const datos: Record<string, { href: string; nombre: string; id: string }> = JSON.parse(
    document.getElementById('datos-ruta')!.textContent!,
  );
  const progreso = progresoRuta();
  const contenido = document.querySelector<HTMLElement>('[data-siguiente-contenido]')!;

  function pintar() {
    const { hechos } = progreso;
    for (const caja of document.querySelectorAll<HTMLInputElement>('[data-marcar]')) {
      caja.checked = hechos.has(caja.dataset.marcar!);
      caja.closest('.paso')!.classList.toggle('hecho-ya', caja.checked);
    }
    for (const e of ETAPAS) {
      const n = hechosDeEtapa(e, hechos);
      const texto = `${n} / ${e.pasos.length}`;
      const cuenta = document.querySelector(`[data-cuenta-etapa="${e.id}"]`)!;
      cuenta.textContent = n === e.pasos.length ? `✓ ${texto}` : texto;
      cuenta.classList.toggle('completa', n === e.pasos.length);
      document.querySelector(`[data-cuenta-indice="${e.id}"]`)!.textContent = n ? `(${texto})` : '';
    }
    const total = PASOS.filter((p) => hechos.has(p.direccion)).length;
    document.querySelector('[data-progreso-total]')!.textContent = `${total} de ${PASOS.length} pasos hechos`;
    document.querySelector<HTMLElement>('[data-barra-total]')!.style.width = `${(100 * total) / PASOS.length}%`;

    const sig = siguientePaso(hechos);
    document.querySelectorAll('.paso.siguiente-paso').forEach((el) => el.classList.remove('siguiente-paso'));
    if (!sig) {
      contenido.innerHTML = `<p class="fin">Ruta completa. Vuelve a cualquier etapa para repasar, o empieza de cero.</p>`;
      return;
    }
    const d = datos[sig.direccion];
    document.getElementById(d.id)!.classList.add('siguiente-paso');
    contenido.innerHTML = `
      <p class="sig-etapa">Paso ${sig.numero} · Etapa ${ETAPAS.indexOf(sig.etapa) + 1}: ${esc(sig.etapa.nombre)}</p>
      <p class="sig-nombre"><a href="${d.href}">${esc(d.nombre)}</a></p>
      <p class="sig-tarea">${esc(sig.tarea)}</p>
      <p class="sig-meta"><strong>Lo tienes cuando:</strong> ${esc(sig.meta)}</p>
      <div class="sig-botones">
        <a class="boton principal" href="${d.href}">Ir a la página</a>
        <button type="button" class="boton" data-hecho-siguiente="${esc(sig.direccion)}">Marcar como hecho</button>
        <a class="boton" href="#${d.id}">Ver en la ruta</a>
      </div>`;
  }

  document.addEventListener('change', (e) => {
    const caja = (e.target as Element).closest<HTMLInputElement>('[data-marcar]');
    if (caja) progreso.marcar(caja.dataset.marcar!, caja.checked);
  });
  contenido.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-hecho-siguiente]');
    if (b) progreso.marcar(b.dataset.hechoSiguiente!, true);
  });

  // Empezar de cero: pide una segunda pulsación para confirmar.
  const reiniciar = document.querySelector<HTMLButtonElement>('[data-reiniciar]')!;
  let espera: number | undefined;
  reiniciar.addEventListener('click', () => {
    if (espera === undefined) {
      reiniciar.textContent = '¿Seguro? Pulsa otra vez para borrar el progreso';
      espera = window.setTimeout(() => {
        reiniciar.textContent = 'Empezar de cero';
        espera = undefined;
      }, 4000);
      return;
    }
    clearTimeout(espera);
    espera = undefined;
    reiniciar.textContent = 'Empezar de cero';
    progreso.reiniciar();
  });

  document.addEventListener('ruta-cambiada', pintar);
  pintar();
</script>

<style>
  .lema {
    max-width: var(--ancho-texto);
    margin: 0 auto 1.25rem;
    color: var(--texto-suave);
  }
  .siguiente {
    max-width: var(--ancho-texto);
    margin: 0 auto 1.5rem;
    padding: 1rem 1.2rem 1.1rem;
    background: var(--tarjeta);
    border: 1px solid var(--borde);
    border-top: 0.25rem solid var(--acento);
    border-radius: var(--radio-tarjeta);
  }
  .siguiente-cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1rem;
  }
  .siguiente h2 {
    margin: 0;
    font-size: 1.1rem;
  }
  .progreso-total {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .barra {
    height: 0.35rem;
    margin: 0.6rem 0 0.9rem;
    background: var(--fondo);
    border-radius: 999px;
    overflow: hidden;
  }
  .barra span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--acento);
    transition: width 0.3s;
  }
  .siguiente :global(p) {
    margin: 0.25rem 0;
  }
  .siguiente :global(.sig-etapa) {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .siguiente :global(.sig-nombre) {
    font-family: var(--fuente-titulo);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.15;
  }
  .siguiente :global(.sig-nombre a) {
    color: var(--texto);
    text-decoration: none;
  }
  .siguiente :global(.sig-nombre a:hover) {
    color: var(--acento);
  }
  .siguiente :global(.sig-botones) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }
  .siguiente :global(a.boton) {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .cuenta-etapa {
    font-weight: 400;
    color: var(--texto-suave);
  }
  .etapa {
    max-width: var(--ancho-texto);
    margin: 2rem auto 0;
    padding-top: 1rem;
    border-top: 1px solid var(--borde);
  }
  .etapa-cabecera {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .etapa h2 {
    margin: 0;
  }
  .etapa .numero {
    color: var(--acento);
  }
  .cuenta {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--texto-suave);
    white-space: nowrap;
  }
  .cuenta.completa {
    color: var(--bien);
  }
  .objetivo {
    margin: 0.3rem 0 0.9rem;
    color: var(--texto-suave);
  }
  .pasos {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .paso {
    padding: 0.75rem 1rem 0.8rem;
  }
  .paso.siguiente-paso {
    border-color: var(--acento);
    box-shadow: inset 0.25rem 0 0 var(--acento);
  }
  .paso.hecho-ya .paso-nombre,
  .paso.hecho-ya .tarea,
  .paso.hecho-ya .meta {
    opacity: 0.6;
  }
  .paso-cabecera {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .paso-numero {
    flex: 0 0 auto;
    min-width: 1.6rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .paso-nombre {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--texto);
    text-decoration: none;
  }
  .paso-nombre:hover {
    color: var(--acento);
  }
  .hecho {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--texto-suave);
    white-space: nowrap;
    cursor: pointer;
  }
  .hecho input {
    margin: 0;
    accent-color: var(--acento);
    width: 1.05rem;
    height: 1.05rem;
  }
  .tarea,
  .meta {
    margin: 0.3rem 0 0 2.2rem;
  }
  .meta {
    font-size: 0.92rem;
    color: var(--texto-suave);
  }
  .reiniciar {
    max-width: var(--ancho-texto);
    margin: 2.5rem auto 0;
  }
  @media (max-width: 40rem) {
    .tarea,
    .meta {
      margin-left: 0;
    }
  }
</style>
