---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Buscador from '../../components/Buscador.astro';

const canciones = (await getCollection('repertorio')).sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, 'es'));
---

<Base titulo="Repertorio">
  <h1>Repertorio</h1>
  <Buscador placeholder="Buscar por título o autor…" />
  <ul class="lista-tarjetas">
    {
      canciones.map(({ id, data }) => (
        <li data-buscar={`${data.titulo} ${data.autor}`}>
          <a class="tarjeta cancion" href={`/repertorio/${id}`}>
            <span class="titulo">{data.titulo}</span>
            <span class="suave">
              {data.autor}
              {data.tonalidad && ` · ${data.tonalidad}`}
              {data.instrumental && ' · Instrumental'}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<script>
  import { conectarBuscador } from '../../lib/cliente.ts';
  conectarBuscador();
</script>

<style>
  .cancion {
    display: grid;
    text-decoration: none;
    color: var(--texto);
  }
  .titulo {
    font-size: 1.15rem;
    font-weight: 700;
  }
</style>
