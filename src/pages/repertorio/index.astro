---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const canciones = (await getCollection('repertorio')).sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, 'es'));
---

<Base titulo="Repertorio">
  <h1>Repertorio</h1>
  <ul>
    {
      canciones.map((c) => (
        <li>
          <a href={`/repertorio/${c.id}`}>{c.data.titulo}</a> — {c.data.autor}
        </li>
      ))
    }
  </ul>
</Base>
