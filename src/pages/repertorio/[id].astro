---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FichaCancion from '../../components/FichaCancion.astro';
import type { Cancion } from '../../lib/cancion.ts';
import { validarCmb } from '../../lib/cmb.ts';

export async function getStaticPaths() {
  const canciones = await getCollection('repertorio');
  const cifrados = await getCollection('cifrados');
  return canciones.map((cancion) => ({
    params: { id: cancion.id },
    props: { cancion, cifrado: cifrados.find((c) => c.id === cancion.id) },
  }));
}

const { cancion: entrada, cifrado } = Astro.props;
const { data } = entrada;

// El .cmb.json se comprueba entero al compilar: si está mal, la compilación falla y dice dónde.
let cmb = null;
if (cifrado) {
  try {
    cmb = validarCmb(cifrado.data);
  } catch (error) {
    throw new Error(`src/content/repertorio/${entrada.id}.cmb.json: ${(error as Error).message}`);
  }
}

const cancion: Cancion = {
  id: entrada.id,
  titulo: data.titulo,
  autor: data.autor,
  instrumental: data.instrumental,
  tonalidad: data.tonalidad ?? null,
  tempo: data.tempo ?? cmb?.tempoBpm ?? null,
  compas: data.compas ?? (cmb?.timeSigLabel || null),
  estructura: data.estructura ?? null,
  estilo: data.estilo ?? (cmb?.style || null),
  enlaces: data.enlaces,
  notas: data.notas ?? null,
  letra: entrada.body?.trim() ?? '',
  cifrado: cmb,
};
---

<Base titulo={data.titulo} encabezado="Repertorio" conH1={false}>
  <FichaCancion cancion={cancion} />
</Base>
