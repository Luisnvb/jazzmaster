---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const canciones = await getCollection('repertorio');
  return canciones.map((cancion) => ({ params: { id: cancion.id }, props: { cancion } }));
}

const { cancion } = Astro.props;
const { data } = cancion;
const { Content } = await render(cancion);
const tieneLetra = !data.instrumental && cancion.body?.trim();
---

<Base titulo={data.titulo}>
  <h1>{data.titulo}</h1>
  <p>{data.autor}</p>
  {data.secciones.map((s) => <p><strong>{s.nombre}</strong> {s.acordes}</p>)}
  {tieneLetra && <Content />}
</Base>
