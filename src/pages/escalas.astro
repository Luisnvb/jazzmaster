---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SelectorTonica from '../components/SelectorTonica.astro';
import Buscador from '../components/Buscador.astro';
import Tempo from '../components/Tempo.astro';
import { notasDeFormula } from '../lib/teoria.ts';
import { porOrden } from '../lib/orden.ts';
import { INSTRUMENTOS } from '../lib/audio.ts';

const grupos = porOrden(await getCollection('grupos'));
const escalas = porOrden(await getCollection('escalas'));
const tonica = 'C';
---

<Base titulo="Escalas">
  <SelectorTonica clave="escalas">
    <label>Arpegio
      <select data-filtro-arpegio>
        <option value="">Todos</option>
        {grupos.map((g) => <option value={g.id}>{g.data.nombre}</option>)}
      </select>
    </label>
    <label>Sonido
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{i.nombre}</option>)}</select>
    </label>
    <Tempo clave="escalas" />
  </SelectorTonica>
  <Buscador placeholder="Buscar escala…" />
  <button type="button" class="boton" data-restaurar-eliminados hidden>Restaurar eliminados</button>

  {
    grupos.map((g) => {
      const delGrupo = escalas.filter((e) => e.data.grupo.id === g.id);
      return (
        <section id={`grupo-${g.id}`} data-grupo-busqueda>
            <div class="cabecera-grupo">
            <h2>
              <span data-tonica-texto>{tonica}</span>{g.data.simbolo}
              {g.data.descripcion && <span class="descripcion">{g.data.descripcion}</span>}
            </h2>
            <p class="arpegio suave">
              Arpegio:{' '}
              <span class="formula">{g.data.arpegio.join(' ')}</span> →{' '}
              <strong data-formula={JSON.stringify(g.data.arpegio)}>{notasDeFormula(tonica, g.data.arpegio).join(' ')}</strong>
              <button
                type="button"
                class="arpegio-boton"
                data-audio="arpegio"
                data-formula-audio={JSON.stringify(g.data.arpegio)}
                aria-pressed="false"
                aria-label={`Tocar arpegio ${g.data.nombre}`}
              >
                ▶
            </button>
          </p>
          </div>
          <ul class="lista-tarjetas">
            {delGrupo.map(({ id, data }) => (
              <li class="tarjeta" data-buscar={`${data.nombre} ${g.data.nombre}`} data-eliminable={id} data-nombre={data.nombre}>
                <h3>{data.nombre}</h3>
                <ol class="notas" data-formula-tabla={JSON.stringify(data.formula)}>
                  {notasDeFormula(tonica, data.formula).map((nota, i) => (
                    <li>
                      <span class="grado">{data.formula[i]}</span>
                      <span class="nota">{nota}</span>
                    </li>
                  ))}
                </ol>
                <div class="botones-audio">
                  <button type="button" data-audio="escala-ascendente" data-formula-audio={JSON.stringify(data.formula)} aria-pressed="false">
                    Escala ↑
                  </button>
                  <button type="button" data-audio="escala-descendente" data-formula-audio={JSON.stringify(data.formula)} aria-pressed="false">
                    Escala ↓
                  </button>
                  {data.formula.length === 7 && (
                    <button type="button" data-audio="por-grado" data-formula-audio={JSON.stringify(data.formula)} aria-pressed="false">
                      Arpegios por grado
                    </button>
                  )}
                  <button type="button" data-audio="continuo" data-formula-audio={JSON.stringify(data.formula)} aria-pressed="false" title="Sube y baja sin parar hasta pulsar Detener">
                    ∞ Continuo
                  </button>
                  <button type="button" data-detener>■ Detener</button>
                  <button type="button" class="eliminar" data-eliminar aria-label={`Eliminar ${data.nombre}`}>Eliminar</button>
                </div>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</Base>

<script>
  import { conectarAudio, conectarBuscador, conectarFiltroArpegio, conectarInstrumento, conectarTempo, conectarTonica } from '../lib/cliente.ts';
  import { conectarEliminados } from '../lib/eliminados.ts';
  import { secuenciaArpegio, secuenciaArpegiosPorGrado, secuenciaEscala, secuenciaEscalaContinua } from '../lib/secuencias.ts';
  import { notasDeFormula } from '../lib/teoria.ts';

  let tonicaActual = 'C';
  const tempo = conectarTempo();

  const instrumento = conectarInstrumento('escalas:sonido');
  const secuencia = (boton: HTMLButtonElement) => {
    const formula: string[] = JSON.parse(boton.dataset.formulaAudio!);
    switch (boton.dataset.audio) {
      case 'escala-ascendente':
        return secuenciaEscala(tonicaActual, formula, 'ascendente', tempo());
      case 'escala-descendente':
        return secuenciaEscala(tonicaActual, formula, 'descendente', tempo());
      case 'por-grado':
        return secuenciaArpegiosPorGrado(tonicaActual, formula, tempo());
      default:
        return secuenciaArpegio(tonicaActual, formula, tempo());
    }
  };
  conectarAudio((boton) => {
    if (boton.dataset.audio === 'continuo') {
      const { eventos, vuelta } = secuenciaEscalaContinua(tonicaActual, JSON.parse(boton.dataset.formulaAudio!), tempo());
      return { eventos, instrumento: instrumento(), bucle: () => true, duracion: vuelta };
    }
    return { eventos: secuencia(boton), instrumento: instrumento() };
  });

  conectarBuscador();
  // Selector de arpegio: muestra solo el grupo elegido.
  conectarFiltroArpegio('arpegio:escalas', (grupo) => {
    for (const s of document.querySelectorAll<HTMLElement>('section[data-grupo-busqueda]')) {
      s.classList.toggle('fuera-de-filtro', grupo !== '' && s.id !== `grupo-${grupo}`);
    }
  });
  conectarEliminados('escalas');
  conectarTonica((tonica) => {
    tonicaActual = tonica;
    for (const el of document.querySelectorAll('[data-tonica-texto]')) el.textContent = tonica;
    for (const el of document.querySelectorAll<HTMLElement>('[data-formula]')) {
      el.textContent = notasDeFormula(tonica, JSON.parse(el.dataset.formula!)).join(' ');
    }
    for (const tabla of document.querySelectorAll<HTMLElement>('[data-formula-tabla]')) {
      const notas = notasDeFormula(tonica, JSON.parse(tabla.dataset.formulaTabla!));
      tabla.querySelectorAll('.nota').forEach((el, i) => (el.textContent = notas[i]));
    }
  });
</script>

<style>
  /* En escritorio cada grupo es una fila: cabecera a la izquierda, escalas a la derecha. */
  section[data-grupo-busqueda] {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 2.5rem;
    padding: 1.25rem 0 1.5rem;
    border-top: 1px solid var(--borde);
  }
  @media (min-width: 75rem) {
    section[data-grupo-busqueda] {
      grid-template-columns: 14rem minmax(0, 1fr);
      align-items: start;
    }
    .cabecera-grupo {
      position: sticky;
      top: calc(var(--cabecera-alto) + 5.5rem);
    }
  }
  h2 {
    margin: 0 0 0.5rem;
    font-size: 1.6rem;
  }
  .descripcion {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--fuente);
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--texto-suave);
  }
  .arpegio {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    margin: 0 0 1rem;
  }
  .formula {
    font-family: var(--fuente-mono);
    font-size: 0.85rem;
  }
  .arpegio strong {
    color: var(--texto);
    font-family: var(--fuente-mono);
  }
  .arpegio-boton {
    width: 2.6rem;
    height: 2.6rem;
    font: inherit;
    color: var(--texto);
    background: transparent;
    border: 1px solid var(--borde);
    border-radius: 50%;
    cursor: pointer;
  }
  .arpegio-boton:hover {
    border-color: var(--acento);
    color: var(--acento);
  }
  .arpegio-boton.sonando {
    background: var(--acento);
    border-color: var(--acento);
    color: var(--sobre-acento);
  }
  .lista-tarjetas {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }
  h3 {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
  }
  .notas {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.25rem;
    text-align: center;
    border-top: 1px solid var(--borde);
    border-bottom: 1px solid var(--borde);
  }
  .notas li {
    display: grid;
  }
  .grado {
    font-family: var(--fuente-mono);
    font-size: 0.75rem;
    color: var(--acento);
  }
  .nota {
    font-size: 1.1rem;
    font-weight: 700;
  }
</style>
