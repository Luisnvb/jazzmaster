---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SelectorTonica from '../components/SelectorTonica.astro';
import Tempo from '../components/Tempo.astro';
import { porOrden } from '../lib/orden.ts';
import { TONICAS } from '../lib/teoria.ts';
import { INSTRUMENTOS } from '../lib/audio.ts';

const grupos = porOrden(await getCollection('grupos')).map(({ id, data }) => ({
  id,
  nombre: data.nombre,
  simbolo: data.simbolo,
  arpegio: data.arpegio,
}));
const voicings = porOrden(await getCollection('acordes')).map(({ id, data }) => ({
  id,
  grupo: data.grupo.id,
  nombre: data.nombre,
  tonica: data.tonica,
  trastes: data.trastes,
  grados: data.grados,
  ...(data.dedos ? { dedos: data.dedos } : {}),
  ...(data.notas ? { notas: data.notas } : {}),
}));
// JSON dentro de <script>: se escapa "<" para que ningún texto pueda cerrar la etiqueta.
const datos = JSON.stringify({ grupos, voicings }).replace(/</g, '\\u003c');
---

<Base titulo="Acordes">
  <h1>Acordes</h1>
  <SelectorTonica clave="acordes">
    <label>Arpegio
      <select data-filtro-arpegio>
        <option value="">Todos</option>
        {grupos.map((g) => <option value={g.id}>{g.nombre}</option>)}
      </select>
    </label>
    <label>Sonido
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{i.nombre}</option>)}</select>
    </label>
  </SelectorTonica>
  <Tempo clave="acordes" />

  <div class="barra-edicion">
    <button type="button" class="boton" data-modo-edicion aria-pressed="false">Editar</button>
    <span class="suave aviso-local" data-aviso-local hidden>Con cambios guardados en este navegador.</span>
  </div>
  <div class="herramientas" data-herramientas hidden>
    <button type="button" class="boton principal" data-nuevo>+ Nuevo voicing</button>
    <button type="button" class="boton" data-exportar>Exportar YAML</button>
    <button type="button" class="boton" data-importar>Importar</button>
    <button type="button" class="boton peligro" data-restaurar>Descartar cambios</button>
    <p class="suave ayuda">
      Los cambios se guardan en este navegador. Para llevarlos al repositorio, exporta y sustituye
      <code>src/data/acordes.yaml</code> por el archivo descargado.
    </p>
  </div>

  <div data-lista></div>

  <dialog class="dialogo" data-dialogo>
    <form method="dialog" data-formulario>
      <h2 data-dialogo-titulo>Voicing</h2>
      <div class="campos">
        <label>Tipo
          <select name="grupo">{grupos.map((g) => <option value={g.id}>{g.nombre}</option>)}</select>
        </label>
        <label>Nombre <input name="nombre" required placeholder="Shell, Drop 2…" /></label>
        <label>Tónica de los trastes
          <select name="tonica">{TONICAS.map((t) => <option value={t}>{t}</option>)}</select>
        </label>
      </div>
      <div data-editor-trastes></div>
      <label class="bloque">Notas <textarea name="notas" rows="2"></textarea></label>
      <ul class="errores" data-errores></ul>
      <div class="acciones">
        <button type="button" class="boton" data-cancelar>Cancelar</button>
        <button type="submit" class="boton principal" value="guardar">Guardar</button>
      </div>
    </form>
  </dialog>

  <script type="application/json" id="datos-acordes" set:html={datos} />
</Base>

<script>
  import { aplicarCambios, aVoicing, moverEnGrupo, ordenarPorIds, erroresVoicing, gradosSugeridos, nuevoIdVoicing, voicingsAYaml, type Cambios, type Voicing } from '../lib/acordes-datos.ts';
  import { borrar, descargar, elegirArchivo, esc, guardarJSON, leerJSON } from '../lib/almacen.ts';
  import { conectarAudio, conectarFiltroArpegio, conectarInstrumento, conectarTempo, conectarTonica } from '../lib/cliente.ts';
  import { diagramaSVG } from '../lib/diagrama.ts';
  import { editorTrastes, type EditorTrastes } from '../lib/editor-trastes.ts';
  import { secuenciaVoicing, secuenciaVoicingContinua, type ModoVoicing } from '../lib/secuencias.ts';
  import { SOSTENIDOS } from '../lib/audio.ts';
  import { notaDeGrado, formatNota } from '../lib/teoria.ts';
  import { cuerdaDelBajo, transportar, type Traste } from '../lib/voicings.ts';

  interface Grupo {
    id: string;
    nombre: string;
    simbolo: string;
    arpegio: string[];
  }

  const CLAVE = 'acordes:cambios';
  // Orden elegido en la web (ids de todos los voicings); vacío = el del repositorio.
  const CLAVE_ORDEN = 'acordes:orden';
  const { grupos, voicings: base }: { grupos: Grupo[]; voicings: Voicing[] } = JSON.parse(
    document.getElementById('datos-acordes')!.textContent!,
  );
  const grupoPorId = Object.fromEntries(grupos.map((g) => [g.id, g]));

  let cambios: Cambios = leerJSON<Cambios>(CLAVE) ?? {};
  let orden: string[] = leerJSON<string[]>(CLAVE_ORDEN) ?? [];
  let lista = ordenarPorIds(aplicarCambios(base, cambios), orden);
  let tonicaActual = 'C';
  let editando = false;
  /** Grupo elegido en el selector de arpegio ('' = todos). */
  let filtro = '';
  const tempo = conectarTempo();

  const contenedor = document.querySelector<HTMLElement>('[data-lista]')!;
  const avisoLocal = document.querySelector<HTMLElement>('[data-aviso-local]')!;
  const herramientas = document.querySelector<HTMLElement>('[data-herramientas]')!;
  const botonEdicion = document.querySelector<HTMLButtonElement>('[data-modo-edicion]')!;

  const conAlAire = (v: Voicing) => v.trastes.includes(0);
  /** Trastes del voicing en la tónica elegida (los que tienen cuerdas al aire no se mueven). */
  const trastesEn = (v: Voicing): Traste[] => (conAlAire(v) ? v.trastes : transportar(v.trastes, v.tonica, tonicaActual));
  const tonicaDe = (v: Voicing) => (conAlAire(v) ? v.tonica : tonicaActual);

  function tarjeta(v: Voicing): string {
    const t = tonicaDe(v);
    const tocados = v.grados.filter(Boolean);
    const hermanos = lista.filter((x) => x.grupo === v.grupo);
    const posicion = hermanos.indexOf(v);
    const notas = tocados.map((g) => formatNota(notaDeGrado(t, g))).join(' ');
    return `
      <li class="tarjeta voicing" data-id="${esc(v.id)}">
        <div class="diagrama-caja">${diagramaSVG({ trastes: trastesEn(v), grados: v.grados })}</div>
        <div class="info">
          <h3>${esc(t)}${esc(grupoPorId[v.grupo]?.simbolo ?? '')}</h3>
          <p class="subtitulo suave">${esc(v.nombre)} · bajo en ${cuerdaDelBajo(v.trastes)}ª</p>
          <dl class="detalle">
            <dt>Grados</dt><dd>${esc(tocados.join(' '))}</dd>
            <dt>Notas</dt><dd>${esc(notas)}</dd>
          </dl>
          ${conAlAire(v) ? '<p class="aviso suave">Con cuerdas al aire: no se transporta.</p>' : ''}
          ${v.notas ? `<p class="comentario">${esc(v.notas)}</p>` : ''}
        </div>
        <div class="botones-audio">
          <button type="button" data-audio="rasgueo" aria-pressed="false">Rasgueo</button>
          <button type="button" data-audio="arpegiado" aria-pressed="false">Arpegiado</button>
          <button type="button" data-audio="continuo" aria-pressed="false" title="Suena sin parar hasta pulsar Detener">∞ Continuo</button>
          <button type="button" data-detener>■ Detener</button>
          ${editando ? '' : '<button type="button" class="eliminar" data-borrar>Eliminar</button>'}
        </div>
        ${
          editando
            ? `<div class="botones-edicion">
                <button type="button" class="boton" data-editar>Editar</button>
                <button type="button" class="boton" data-mover="-1" title="Mover antes" aria-label="Mover antes" ${posicion === 0 ? 'disabled' : ''}>◀</button>
                <button type="button" class="boton" data-mover="1" title="Mover después" aria-label="Mover después" ${posicion === hermanos.length - 1 ? 'disabled' : ''}>▶</button>
                <button type="button" class="boton" data-duplicar>Duplicar</button>
                <button type="button" class="boton peligro" data-borrar>Borrar</button>
              </div>`
            : ''
        }
      </li>`;
  }

  function pintar() {
    contenedor.innerHTML = grupos
      .filter((g) => !filtro || g.id === filtro)
      .map((g) => {
        const vs = lista.filter((v) => v.grupo === g.id);
        if (vs.length === 0 && !editando) return '';
        return `
          <section id="grupo-${g.id}">
            <h2>${esc(g.nombre)}</h2>
            ${vs.length ? `<ul class="lista-tarjetas voicings">${vs.map(tarjeta).join('')}</ul>` : '<p class="suave">Sin voicings.</p>'}
            ${editando ? `<button type="button" class="boton" data-nuevo="${g.id}">+ Voicing ${esc(g.nombre)}</button>` : ''}
          </section>`;
      })
      .join('');
    avisoLocal.hidden = Object.keys(cambios).length === 0 && orden.length === 0;
  }

  function guardar(nuevos: Cambios) {
    cambios = nuevos;
    if (Object.keys(cambios).length) guardarJSON(CLAVE, cambios);
    else borrar(CLAVE);
    lista = ordenarPorIds(aplicarCambios(base, cambios), orden);
    pintar();
  }

  const porId = (id: string) => lista.find((v) => v.id === id)!;

  // --- Diálogo de edición ---------------------------------------------------

  const dialogo = document.querySelector<HTMLDialogElement>('[data-dialogo]')!;
  const formulario = document.querySelector<HTMLFormElement>('[data-formulario]')!;
  const errores = document.querySelector<HTMLElement>('[data-errores]')!;
  const campo = (nombre: string) => formulario.elements.namedItem(nombre) as HTMLInputElement | HTMLSelectElement;
  let editor: EditorTrastes;
  let editandoId: string | null = null;

  function abrir(v: Voicing, id: string | null) {
    editandoId = id;
    document.querySelector('[data-dialogo-titulo]')!.textContent = id ? 'Editar voicing' : 'Nuevo voicing';
    campo('grupo').value = v.grupo;
    campo('nombre').value = v.nombre;
    campo('tonica').value = v.tonica;
    campo('notas').value = v.notas ?? '';
    errores.innerHTML = '';
    editor = editorTrastes(document.querySelector('[data-editor-trastes]')!, {
      trastes: v.trastes,
      grados: v.grados,
      gradosEditables: true,
      calcularGrados: (t) => gradosSugeridos(campo('tonica').value, t, grupoPorId[campo('grupo').value]?.arpegio ?? []),
    });
    dialogo.showModal();
  }

  campo('tonica').addEventListener('change', () => editor.recalcular());
  campo('grupo').addEventListener('change', () => editor.recalcular());
  document.querySelector('[data-cancelar]')!.addEventListener('click', () => dialogo.close());

  formulario.addEventListener('submit', (e) => {
    const { trastes, grados } = editor.valor();
    const v: Voicing = {
      id: editandoId ?? '',
      grupo: campo('grupo').value,
      nombre: campo('nombre').value.trim(),
      tonica: campo('tonica').value,
      trastes,
      grados: grados.map((g, c) => (trastes[c] === 'x' ? '' : g)),
      ...(campo('notas').value.trim() ? { notas: campo('notas').value.trim() } : {}),
    };
    const anterior = editandoId ? porId(editandoId) : null;
    if (anterior?.dedos) v.dedos = anterior.dedos;
    const lista_errores = erroresVoicing(v, grupos.map((g) => g.id));
    if (lista_errores.length) {
      e.preventDefault();
      errores.innerHTML = lista_errores.map((x) => `<li>${esc(x)}</li>`).join('');
      return;
    }
    if (!editandoId) v.id = nuevoIdVoicing(v, lista.map((x) => x.id).concat(base.map((x) => x.id)));
    guardar({ ...cambios, [v.id]: v });
  });

  // --- Botones ----------------------------------------------------------------

  botonEdicion.addEventListener('click', () => {
    editando = !editando;
    botonEdicion.setAttribute('aria-pressed', String(editando));
    botonEdicion.textContent = editando ? 'Terminar' : 'Editar';
    herramientas.hidden = !editando;
    pintar();
  });

  const vacio = (grupo: string): Voicing => ({
    id: '',
    grupo,
    nombre: '',
    tonica: 'C',
    trastes: ['x', 3, 'x', 'x', 'x', 'x'],
    grados: ['', '1', '', '', '', ''],
  });

  document.addEventListener('click', async (e) => {
    const el = (e.target as Element).closest<HTMLElement>('button');
    if (!el) return;
    const id = el.closest<HTMLElement>('[data-id]')?.dataset.id;
    if (el.dataset.nuevo !== undefined) abrir(vacio(el.dataset.nuevo || grupos[0].id), null);
    else if (el.hasAttribute('data-editar') && id) abrir(porId(id), id);
    else if (el.dataset.mover && id) {
      lista = moverEnGrupo(lista, id, Number(el.dataset.mover) as -1 | 1);
      orden = lista.map((v) => v.id);
      guardarJSON(CLAVE_ORDEN, orden);
      pintar();
    } else if (el.hasAttribute('data-duplicar') && id) abrir({ ...porId(id), nombre: `${porId(id).nombre} (copia)` }, null);
    else if (el.hasAttribute('data-borrar') && id) {
      if (!confirm(`¿Borrar el voicing "${porId(id).nombre}"?`)) return;
      const nuevos = { ...cambios };
      if (base.some((v) => v.id === id)) nuevos[id] = null;
      else delete nuevos[id];
      guardar(nuevos);
    } else if (el.hasAttribute('data-exportar')) {
      descargar('acordes.yaml', voicingsAYaml(lista), 'text/yaml');
    } else if (el.hasAttribute('data-importar')) {
      const archivo = await elegirArchivo('.yaml,.yml,.json');
      if (!archivo) return;
      try {
        const { parse } = await import('yaml');
        const datos = parse(archivo.texto);
        if (!Array.isArray(datos)) throw new Error('El archivo debe ser una lista de voicings.');
        const importados = datos.map(aVoicing);
        const malos = importados.flatMap((v) => erroresVoicing(v, grupos.map((g) => g.id)).map((x) => `${v.id}: ${x}`));
        if (malos.length) throw new Error(malos.slice(0, 5).join('\n'));
        if (!confirm(`Se sustituirán los voicings por los ${importados.length} del archivo. ¿Seguir?`)) return;
        // Los del repositorio que no están en el archivo se marcan como borrados.
        const nuevos: Cambios = Object.fromEntries(base.map((v) => [v.id, null]));
        for (const v of importados) nuevos[v.id] = v;
        for (const v of base) {
          const igual = importados.find((x) => x.id === v.id);
          if (igual && JSON.stringify(igual) === JSON.stringify(v)) delete nuevos[v.id];
        }
        guardar(nuevos);
      } catch (error) {
        alert(`No se pudo importar: ${(error as Error).message}`);
      }
    } else if (el.hasAttribute('data-restaurar')) {
      if (confirm('¿Descartar todos los cambios hechos en este navegador y volver a los voicings del repositorio?')) {
        orden = [];
        borrar(CLAVE_ORDEN);
        guardar({});
      }
    }
  });

  const instrumento = conectarInstrumento('acordes:sonido');
  conectarAudio((boton) => {
    const v = porId(boton.closest<HTMLElement>('[data-id]')!.dataset.id!);
    if (boton.dataset.audio === 'continuo') {
      const { eventos, vuelta } = secuenciaVoicingContinua(trastesEn(v), tempo(), SOSTENIDOS.includes(instrumento()));
      return vuelta === null
        ? { eventos, instrumento: instrumento() }
        : { eventos, instrumento: instrumento(), bucle: () => true, duracion: vuelta };
    }
    return { eventos: secuenciaVoicing(trastesEn(v), boton.dataset.audio as ModoVoicing, tempo()), instrumento: instrumento() };
  });

  conectarFiltroArpegio('arpegio:acordes', (grupo) => {
    filtro = grupo;
    pintar();
  });

  conectarTonica((tonica) => {
    tonicaActual = tonica;
    pintar();
  });
  pintar();
  // Los enlaces del repertorio llevan #grupo-…: la lista se pinta aquí, así que se busca a mano.
  if (location.hash) document.getElementById(location.hash.slice(1))?.scrollIntoView();
</script>

<style>
  .barra-edicion {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.75rem 0 0;
  }
  .herramientas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.75rem 0 0;
  }
  .ayuda {
    flex-basis: 100%;
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
  }
  .aviso-local {
    font-size: 0.85rem;
  }
  :global(.voicing) {
    display: grid;
    grid-template-columns: minmax(0, 9.5rem) 1fr;
    gap: 0.75rem;
    align-items: start;
    padding: 0.75rem;
  }
  :global(.voicing .botones-audio),
  :global(.voicing .botones-edicion) {
    grid-column: 1 / -1;
    margin-top: 0;
  }
  :global(.botones-edicion) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  :global(.botones-edicion .boton[data-mover]) {
    flex: 0 0 2.6rem;
    padding: 0;
  }
  :global(.botones-edicion .boton) {
    flex: 1 1 auto;
    padding: 0 0.7rem;
  }
  :global(.voicing h3) {
    margin: 0;
    font-size: 1.4rem;
  }
  :global(.voicing .subtitulo) {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
  }
  :global(.voicing .detalle) {
    margin: 0.5rem 0 0;
  }
  :global(.voicing .detalle dt) {
    color: var(--texto-suave);
    font-size: 0.75rem;
  }
  :global(.voicing .detalle dd) {
    margin: 0 0 0.35rem;
    font-weight: 700;
    word-spacing: 0.15rem;
  }
  :global(.voicing .aviso),
  :global(.voicing .comentario) {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
  }
  :global(section > .boton[data-nuevo]) {
    margin-top: 0.75rem;
  }
  .campos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .errores {
    color: var(--mal);
    font-weight: 600;
    padding-left: 1.25rem;
  }
  :global(.voicings) {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
  :global([data-lista] > section) {
    padding-top: 0.5rem;
    border-top: 1px solid var(--borde);
  }
  :global(.voicing h3) {
    font-family: var(--fuente-titulo);
    font-weight: 400;
    font-size: 1.35rem;
    line-height: 1;
  }
  :global(.voicing .subtitulo),
  :global(.voicing .detalle dt) {
    font-family: var(--fuente-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  :global(.voicing .detalle dd) {
    font-family: var(--fuente-mono);
  }
  .barra-edicion {
    margin-top: 0;
  }
</style>
