---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SelectorTonica from '../components/SelectorTonica.astro';
import { porOrden } from '../lib/orden.ts';
import { ruta } from '../lib/rutas.ts';
import { formatNota, notaBajoGrado, notasDeFormula } from '../lib/teoria.ts';

const intervalos = porOrden(await getCollection('intervalos'));
const tonica = 'C';
---

<Base titulo="Intervalos">
  <h1>Intervalos</h1>
  <a class="entrenador tarjeta" href={ruta('intervalos/entrenador')}><span>Entrenador de oído</span><span aria-hidden="true">→</span></a>
  <SelectorTonica clave="intervalos" etiqueta="Nota de partida" />
  <button type="button" class="boton restaurar" data-restaurar-eliminados hidden>Restaurar eliminados</button>

  <ul class="lista-tarjetas">
    {
      intervalos.map(({ id, data }) => {
        const [desde, hasta] = notasDeFormula(tonica, ['1', data.grado]);
        const abajo = formatNota(notaBajoGrado(tonica, data.grado));
        return (
          <li class="tarjeta intervalo" data-eliminable={id} data-nombre={data.nombre}>
            <div class="cabecera">
              <h2>{data.nombre}</h2>
              <span class="semitonos">{data.semitonos} st</span>
            </div>
            <p class="ejemplo" data-grado={data.grado}>
              <span>↑ <span data-desde>{desde}</span> → <span data-hasta>{hasta}</span></span>
              <span>↓ <span data-desde>{desde}</span> → <span data-abajo>{abajo}</span></span>
            </p>
            <p class="caracter">{data.caracter}</p>
            <dl class="referencias">
              <dt>↑ Ascendente</dt>
              <dd>{data.ascendente.length ? data.ascendente.join(' · ') : <span class="suave">—</span>}</dd>
              <dt>↓ Descendente</dt>
              <dd>{data.descendente.length ? data.descendente.join(' · ') : <span class="suave">—</span>}</dd>
            </dl>
            <div class="botones-audio">
              <button type="button" data-audio="ascendente" data-grado={data.grado} aria-pressed="false">↑ Ascendente</button>
              <button type="button" data-audio="descendente" data-grado={data.grado} aria-pressed="false">↓ Descendente</button>
              <button type="button" data-audio="armonico" data-grado={data.grado} aria-pressed="false">Armónico</button>
              <button type="button" class="eliminar" data-eliminar aria-label={`Eliminar ${data.nombre}`}>Eliminar</button>
            </div>
          </li>
        );
      })
    }
  </ul>
</Base>

<script>
  import { conectarAudio, conectarTonica } from '../lib/cliente.ts';
  import { conectarEliminados } from '../lib/eliminados.ts';
  import { secuenciaIntervalo, type ModoIntervalo } from '../lib/secuencias.ts';
  import { formatNota, notaBajoGrado, notasDeFormula } from '../lib/teoria.ts';

  let tonicaActual = 'C';

  conectarTonica((tonica) => {
    tonicaActual = tonica;
    for (const el of document.querySelectorAll<HTMLElement>('.ejemplo[data-grado]')) {
      const grado = el.dataset.grado!;
      const [desde, hasta] = notasDeFormula(tonica, ['1', grado]);
      for (const d of el.querySelectorAll('[data-desde]')) d.textContent = desde;
      el.querySelector('[data-hasta]')!.textContent = hasta;
      el.querySelector('[data-abajo]')!.textContent = formatNota(notaBajoGrado(tonica, grado));
    }
  });

  conectarEliminados('intervalos');

  conectarAudio((boton) =>
    secuenciaIntervalo(tonicaActual, boton.dataset.grado!, boton.dataset.audio as ModoIntervalo),
  );
</script>

<style>
  .entrenador {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    padding: 1.5rem 1.75rem;
    background: var(--violeta);
    border-color: var(--violeta);
    color: #fff;
    font-family: var(--fuente-titulo);
    font-size: 2.2rem;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
  }
  .entrenador:hover {
    border-color: var(--acento);
  }
  .restaurar {
    margin-bottom: 1rem;
  }
  .lista-tarjetas {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 27rem), 1fr));
  }
  .cabecera {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .cabecera h2 {
    margin: 0;
    font-size: 2rem;
  }
  .semitonos {
    font-family: var(--fuente-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--acento);
    white-space: nowrap;
  }
  .ejemplo {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 0.5rem 0;
    font-family: var(--fuente-mono);
    font-size: 1.1rem;
    font-weight: 700;
  }
  .caracter {
    margin: 0.25rem 0 1rem;
    font-size: 1.1rem;
    color: var(--texto-suave);
  }
  .referencias {
    margin: 0;
    padding-top: 0.75rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 1rem;
    border-top: 1px solid var(--borde);
  }
  .referencias dt {
    font-family: var(--fuente-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--texto-suave);
    padding-top: 0.2rem;
    white-space: nowrap;
  }
  .referencias dd {
    margin: 0;
  }
</style>
