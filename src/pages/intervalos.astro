---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SelectorTonica from '../components/SelectorTonica.astro';
import { porOrden } from '../lib/orden.ts';
import { formatNota, notaBajoGrado, notasDeFormula } from '../lib/teoria.ts';

const intervalos = porOrden(await getCollection('intervalos'));
const tonica = 'C';
---

<Base titulo="Intervalos">
  <h1>Intervalos</h1>
  <a class="entrenador tarjeta" href="/intervalos/entrenador">🎧 Entrenador de oído →</a>
  <SelectorTonica clave="intervalos" etiqueta="Nota de partida" />

  <ul class="lista-tarjetas">
    {
      intervalos.map(({ data }) => {
        const [desde, hasta] = notasDeFormula(tonica, ['1', data.grado]);
        const abajo = formatNota(notaBajoGrado(tonica, data.grado));
        return (
          <li class="tarjeta intervalo">
            <div class="cabecera">
              <h2>{data.nombre}</h2>
              <span class="semitonos">{data.semitonos} st</span>
            </div>
            <p class="ejemplo" data-grado={data.grado}>
              <span>↑ <span data-desde>{desde}</span> → <span data-hasta>{hasta}</span></span>
              <span>↓ <span data-desde>{desde}</span> → <span data-abajo>{abajo}</span></span>
            </p>
            <p class="caracter">{data.caracter}</p>
            <dl class="referencias">
              <dt>↑ Ascendente</dt>
              <dd>{data.ascendente.length ? data.ascendente.join(' · ') : <span class="suave">—</span>}</dd>
              <dt>↓ Descendente</dt>
              <dd>{data.descendente.length ? data.descendente.join(' · ') : <span class="suave">—</span>}</dd>
            </dl>
            <div class="botones-audio">
              <button type="button" data-audio="ascendente" data-grado={data.grado} aria-pressed="false">↑ Ascendente</button>
              <button type="button" data-audio="descendente" data-grado={data.grado} aria-pressed="false">↓ Descendente</button>
              <button type="button" data-audio="armonico" data-grado={data.grado} aria-pressed="false">Armónico</button>
            </div>
          </li>
        );
      })
    }
  </ul>
</Base>

<script>
  import { conectarAudio, conectarTonica } from '../lib/cliente.ts';
  import { secuenciaIntervalo, type ModoIntervalo } from '../lib/secuencias.ts';
  import { formatNota, notaBajoGrado, notasDeFormula } from '../lib/teoria.ts';

  let tonicaActual = 'C';

  conectarTonica((tonica) => {
    tonicaActual = tonica;
    for (const el of document.querySelectorAll<HTMLElement>('.ejemplo[data-grado]')) {
      const grado = el.dataset.grado!;
      const [desde, hasta] = notasDeFormula(tonica, ['1', grado]);
      for (const d of el.querySelectorAll('[data-desde]')) d.textContent = desde;
      el.querySelector('[data-hasta]')!.textContent = hasta;
      el.querySelector('[data-abajo]')!.textContent = formatNota(notaBajoGrado(tonica, grado));
    }
  });

  conectarAudio((boton) =>
    secuenciaIntervalo(tonicaActual, boton.dataset.grado!, boton.dataset.audio as ModoIntervalo),
  );
</script>

<style>
  .entrenador {
    display: block;
    margin-bottom: 1rem;
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
  }
  .cabecera {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .cabecera h2 {
    margin: 0;
    font-size: 1.35rem;
  }
  .semitonos {
    color: var(--texto-suave);
    font-weight: 600;
    white-space: nowrap;
  }
  .ejemplo {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: 0.25rem 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--acento);
  }
  .caracter {
    margin: 0.25rem 0 0.75rem;
    font-style: italic;
  }
  .referencias {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
  }
  .referencias dt {
    color: var(--texto-suave);
    font-size: 0.85rem;
    padding-top: 0.1rem;
    white-space: nowrap;
  }
  .referencias dd {
    margin: 0;
  }
</style>
