---
// Portada de una sección: sus páginas (lib/secciones.ts), con las favoritas primero.
import Base from '../../layouts/Base.astro';
import Mosaico from '../../components/Mosaico.astro';
import { SECCIONES, type Seccion } from '../../lib/secciones.ts';

export function getStaticPaths() {
  return SECCIONES.map((seccion) => ({ params: { id: seccion.id }, props: { seccion } }));
}

const { seccion } = Astro.props as { seccion: Seccion };
---

<Base titulo={seccion.nombre}>
  <p class="lema">{seccion.lema}. Marca con ☆ (junto al título de cada página) las que más uses: salen las primeras aquí y en el menú.</p>
  <Mosaico secciones={seccion.partes} numerar={false} />
</Base>

<style>
  .lema {
    max-width: 48rem;
    margin: 0 0 1.25rem;
    color: var(--texto-suave);
  }
</style>
