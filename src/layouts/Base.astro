---
import '../styles/global.css';

interface Props {
  titulo: string;
}

const { titulo } = Astro.props;

const secciones = [
  { href: '/intervalos', nombre: 'Intervalos' },
  { href: '/escalas', nombre: 'Escalas' },
  { href: '/acordes', nombre: 'Acordes' },
  { href: '/repertorio', nombre: 'Repertorio' },
];
const ruta = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#b5541c" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/iconos/apple-touch-icon.png" />
    <title>{titulo} · Práctica</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <nav class="barra" aria-label="Secciones">
      {
        secciones.map((s) => (
          <a href={s.href} aria-current={ruta.startsWith(s.href) ? 'page' : undefined}>
            {s.nombre}
          </a>
        ))
      }
    </nav>
  </body>
</html>

<script>
  // Modo sin conexión: solo en la web compilada (en desarrollo la caché estorbaría).
  if (import.meta.env.PROD && 'serviceWorker' in navigator) {
    navigator.serviceWorker.register(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sw.js`).catch(console.error);
  }
</script>

<style>
  .barra {
    position: fixed;
    inset: auto 0 0 0;
    height: var(--barra-alto);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--superficie);
    border-top: 1px solid var(--borde);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .barra a {
    display: grid;
    place-items: center;
    color: var(--texto-suave);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .barra a[aria-current='page'] {
    color: var(--acento);
  }
</style>
