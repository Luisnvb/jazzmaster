---
import '../styles/global.css';
import { archivo, ruta } from '../lib/rutas.ts';
import { SECCIONES, paginaActual, seccionActual } from '../lib/secciones.ts';

interface Props {
  /** Título de la pestaña. */
  titulo: string;
  /** Título que se ve en la cabecera, junto a la navegación (por defecto, `titulo`). */
  encabezado?: string;
  /** Si el título de la cabecera es el <h1> de la página (las fichas de canción tienen el suyo). */
  conH1?: boolean;
}

const { titulo, encabezado = titulo, conH1 = true } = Astro.props;
const Titulo = conH1 ? 'h1' : 'p';

// Con barra final para comparar igual "/acordes" y "/acordes/" con ruta('acordes').
const actual = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const seccion = seccionActual(actual);
// Página de las secciones en la que estamos: se puede marcar como favorita (solo en
// la propia página, no en las que cuelgan de ella, como cada canción del Repertorio).
const pagina = paginaActual(actual);
const favoritable = pagina && pagina.href === actual ? pagina : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <!-- COLOR: barra del navegador en el móvil (igual que --fondo en global.css) -->
    <meta name="theme-color" content="#ffffff" />
    <link rel="manifest" href={archivo('manifest.webmanifest')} />
    <link rel="icon" href={archivo('favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={archivo('iconos/apple-touch-icon.png')} />
    <title>{titulo} · JAZZMASTER</title>
  </head>
  <body>
    <header class="cabecera">
      <div class="cabecera-dentro">
        <div class="titulo-caja">
          <a class="guitarra" href={ruta('')} title="Inicio">
            <img src={archivo('iconos/guitarra.png')} alt="Inicio" width="120" height="120" />
          </a>
          <Titulo class="titulo-seccion">{encabezado}</Titulo>
          {
            favoritable && (
              <button
                type="button"
                class="favorito favorito-pagina"
                data-favorito-pagina={favoritable.href}
                aria-pressed="false"
                aria-label={`Página favorita: ${favoritable.nombre}`}
                title="Marcar como favorita: sale la primera en el menú de su sección y en la portada"
              >
                ☆
              </button>
            )
          }
        </div>
        <nav aria-label="Secciones">
          <a href={ruta('')} aria-current={actual === ruta('') ? 'page' : undefined}>Inicio</a>
          {
            SECCIONES.map((s) => (
              <div class="multiple">
                <a href={s.href} aria-current={s === seccion ? 'page' : undefined} aria-haspopup="true">
                  {s.nombre} <span aria-hidden="true">▾</span>
                </a>
                <ul class="desplegable" data-lista-paginas>
                  {s.partes.map((p) => (
                    <li data-pagina={p.href}>
                      <a href={p.href} aria-current={p === pagina ? 'page' : undefined}>
                        {p.nombre}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
        <button
          type="button"
          class="hamburguesa"
          aria-expanded="false"
          aria-controls="menu-movil"
          aria-label="Menú de secciones"
          data-hamburguesa
        >
          <span aria-hidden="true"></span>
        </button>
      </div>
      <nav id="menu-movil" class="menu-movil" aria-label="Secciones (móvil)" hidden data-menu-movil>
        <a class="menu-inicio" href={ruta('')} aria-current={actual === ruta('') ? 'page' : undefined}>Inicio</a>
        {
          SECCIONES.map((s) => (
            <details open={s === seccion}>
              <summary>{s.nombre}</summary>
              <ul data-lista-paginas>
                <li>
                  <a href={s.href} aria-current={actual === s.href ? 'page' : undefined}>
                    Todas las de {s.nombre}
                  </a>
                </li>
                {s.partes.map((p) => (
                  <li data-pagina={p.href}>
                    <a href={p.href} aria-current={p === pagina ? 'page' : undefined}>
                      {p.nombre}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<script>
  import { archivo } from '../lib/rutas.ts';
  import { aplicarFavoritas, paginasFavoritas } from '../lib/paginas-favoritas.ts';
  import { vigilarTitulos } from '../lib/titulos.ts';

  // Modo sin conexión: solo en la web compilada (en desarrollo la caché estorbaría).
  if (import.meta.env.PROD && 'serviceWorker' in navigator) {
    navigator.serviceWorker.register(archivo('sw.js')).catch(console.error);
  }

  // Títulos en mayúsculas: el cifrado que pintan los scripts se deja como está.
  vigilarTitulos();

  // Título de la cabecera: si no cabe en una línea, pasa a dos (.largo) y, si en dos
  // tampoco (móvil estrecho), a una letra más pequeña (.muy-largo).
  const titulo = document.querySelector<HTMLElement>('.titulo-seccion');
  if (titulo) {
    const noCabe = () =>
      titulo.scrollWidth > titulo.clientWidth + 1 || titulo.scrollHeight > titulo.clientHeight + 2;
    const ajustarTitulo = () => {
      titulo.classList.remove('largo', 'muy-largo');
      if (noCabe()) titulo.classList.add('largo');
      if (noCabe()) titulo.classList.add('muy-largo');
    };
    new ResizeObserver(ajustarTitulo).observe(titulo.closest('.cabecera-dentro')!);
    document.fonts?.ready.then(ajustarTitulo);
  }

  // Navegación del móvil: menú hamburguesa en lugar de la barra de secciones.
  const hamburguesa = document.querySelector<HTMLButtonElement>('[data-hamburguesa]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu-movil]')!;
  const abrirMenu = (abrir: boolean) => {
    hamburguesa.setAttribute('aria-expanded', String(abrir));
    menu.hidden = !abrir;
    document.body.classList.toggle('menu-abierto', abrir);
  };
  hamburguesa.addEventListener('click', () => abrirMenu(hamburguesa.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      abrirMenu(false);
      hamburguesa.focus();
    }
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (!menu.hidden && !menu.contains(t) && !hamburguesa.contains(t)) abrirMenu(false);
  });
  // Al volver con «atrás» (caché del navegador), el menú no debe seguir abierto.
  addEventListener('pageshow', () => abrirMenu(false));
  // Si la ventana se ensancha hasta la barra de escritorio, se cierra.
  matchMedia('(min-width: 78.01rem)').addEventListener('change', (e) => e.matches && abrirMenu(false));

  // Páginas favoritas: la estrella de la cabecera y el orden de los menús y listas.
  const favoritas = paginasFavoritas();
  const estrella = document.querySelector<HTMLButtonElement>('[data-favorito-pagina]');
  const pintarEstrella = () => {
    if (!estrella) return;
    const si = favoritas.tiene(estrella.dataset.favoritoPagina!);
    estrella.setAttribute('aria-pressed', String(si));
    estrella.textContent = si ? '★' : '☆';
    estrella.title = si ? 'Quitar de favoritas' : 'Marcar como favorita: sale la primera en el menú de su sección y en la portada';
  };
  estrella?.addEventListener('click', () => {
    favoritas.alternar(estrella.dataset.favoritoPagina!);
    pintarEstrella();
    aplicarFavoritas();
    document.dispatchEvent(new CustomEvent('favoritas-cambiadas'));
  });
  pintarEstrella();
  aplicarFavoritas();
</script>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--fondo);
    color: var(--texto);
    border-bottom: 1px solid var(--borde);
  }
  .cabecera-dentro {
    max-width: var(--ancho);
    height: var(--cabecera-alto);
    margin: 0 auto;
    padding: 0 var(--margen);
    display: flex;
    align-items: center;
    gap: 3rem;
  }
  /* El título ocupa el sitio libre y la navegación va al extremo derecho: así no se
     mueve al cambiar de página y los títulos largos caben. */
  .titulo-caja {
    flex: 1 1 18rem;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  /* La guitarra de la web (la del favicon), delante del título. */
  .guitarra {
    flex: 0 0 auto;
    display: block;
    width: 2.4rem;
    height: 2.4rem;
    margin-right: 0.2rem;
    border-radius: var(--radio);
    transition: transform 0.15s;
  }
  .guitarra:hover {
    transform: rotate(-8deg);
  }
  .guitarra img {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* La estrella va junto al título, no en una esquina como en las tarjetas. */
  .favorito-pagina {
    position: static;
    flex: 0 0 auto;
  }
  .titulo-seccion {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--fuente-titulo);
    font-weight: 600;
    font-size: 1.6rem;
    line-height: 1.3;
    padding-right: 0.3em;
    white-space: nowrap;
    color: var(--texto);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  /* Si aun así no cabe en una línea (lo decide el script), pasa a dos, más pequeño. */
  .titulo-seccion.largo {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    font-size: 1.15rem;
    line-height: 1.12;
    white-space: normal;
    overflow-wrap: break-word;
    padding-block: 0.1em;
  }
  .titulo-seccion.muy-largo {
    font-size: 0.98rem;
  }
  nav[aria-label='Secciones'] {
    flex: 0 0 auto;
    display: flex;
    align-items: stretch;
    height: 100%;
    gap: 2.25rem;
  }
  nav[aria-label='Secciones'] > a,
  .multiple > a {
    display: flex;
    align-items: center;
    border-bottom: 0.25rem solid transparent;
    border-top: 0.25rem solid transparent;
    font-family: var(--fuente);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--texto-suave);
    text-decoration: none;
    white-space: nowrap;
  }
  nav[aria-label='Secciones'] > a:hover,
  .multiple > a:hover {
    color: var(--texto);
  }
  nav[aria-label='Secciones'] > a[aria-current='page'],
  .multiple > a[aria-current='page'] {
    color: var(--texto);
    border-bottom-color: var(--acento);
  }
  .multiple > a span {
    margin-left: 0.35rem;
    font-size: 0.7rem;
  }

  /* Sección múltiple: desplegable al pasar el ratón o con el teclado */
  .multiple {
    position: relative;
    display: flex;
  }
  .desplegable {
    position: absolute;
    top: 100%;
    left: -1rem;
    min-width: 14rem;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
    background: var(--fondo);
    border: 1px solid var(--borde);
    border-top: 0.25rem solid var(--acento);
    box-shadow: 0 0.5rem 1.5rem var(--sombra);
    display: none;
  }
  .multiple:hover .desplegable,
  .multiple:focus-within .desplegable {
    display: block;
  }
  .desplegable a {
    display: block;
    padding: 0.6rem 1rem;
    font-family: var(--fuente);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--texto-suave);
    text-decoration: none;
  }
  .desplegable a:hover {
    color: var(--acento);
    background: var(--superficie);
  }
  /* Las dos últimas secciones abren el menú hacia la izquierda, para no salirse. */
  .multiple:nth-last-child(-n + 2) .desplegable {
    left: auto;
    right: -1rem;
  }
  /* Menús largos (Improvisación): desplazables si no caben en la pantalla. */
  .desplegable {
    max-height: calc(100vh - var(--cabecera-alto) - 1rem);
    overflow-y: auto;
  }
  .desplegable a[aria-current='page'] {
    color: var(--acento);
  }
  .hamburguesa,
  .menu-movil {
    display: none;
  }
  /* Móvil: la barra de secciones no cabe; se cambia por un menú hamburguesa. */
  @media (max-width: 78rem) {
    .cabecera-dentro {
      gap: 1rem;
    }
    .titulo-caja {
      flex: 1 1 auto;
    }
    .titulo-seccion {
      font-size: 1.5rem;
    }
    nav[aria-label='Secciones'] {
      display: none;
    }
    .hamburguesa {
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      width: 2.6rem;
      height: 2.6rem;
      padding: 0;
      border: 1px solid var(--borde);
      border-radius: var(--radio);
      background: var(--fondo);
      color: var(--texto);
      cursor: pointer;
    }
    /* Las tres rayas: la del medio es el span y las otras dos, ::before y ::after; al abrir, una X. */
    .hamburguesa span {
      position: relative;
      display: block;
      width: 1.25rem;
      height: 2px;
      background: currentColor;
      transition: background 0.15s;
    }
    .hamburguesa span::before,
    .hamburguesa span::after {
      content: '';
      position: absolute;
      left: 0;
      width: 100%;
      height: 2px;
      background: currentColor;
      transition: transform 0.15s;
    }
    .hamburguesa span::before {
      transform: translateY(-0.4rem);
    }
    .hamburguesa span::after {
      transform: translateY(0.4rem);
    }
    .hamburguesa[aria-expanded='true'] span {
      background: transparent;
    }
    .hamburguesa[aria-expanded='true'] span::before {
      transform: rotate(45deg);
    }
    .hamburguesa[aria-expanded='true'] span::after {
      transform: rotate(-45deg);
    }
    .menu-movil:not([hidden]) {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      max-height: calc(100dvh - var(--cabecera-alto));
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 0.25rem var(--margen) 1rem;
      background: var(--fondo);
      border-bottom: 0.25rem solid var(--acento);
      box-shadow: 0 0.75rem 1.5rem var(--sombra-fuerte);
    }
    .menu-movil a,
    .menu-movil summary {
      display: block;
      padding: 0.75rem 0;
      font-family: var(--fuente);
      font-size: 1rem;
      font-weight: 700;
      color: var(--texto);
      text-decoration: none;
    }
    .menu-movil > a,
    .menu-movil details {
      border-bottom: 1px solid var(--borde);
    }
    .menu-movil summary {
      cursor: pointer;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .menu-movil summary::-webkit-details-marker {
      display: none;
    }
    .menu-movil summary::after {
      content: '▾';
      font-size: 0.8rem;
      color: var(--texto-suave);
      transition: transform 0.15s;
    }
    .menu-movil details[open] summary::after {
      transform: rotate(180deg);
    }
    .menu-movil ul {
      margin: 0 0 0.75rem;
      padding: 0 0 0 1rem;
      list-style: none;
      border-left: 0.2rem solid var(--borde);
    }
    .menu-movil ul a {
      padding: 0.55rem 0;
      font-weight: 600;
      color: var(--texto-suave);
    }
    .menu-movil a:hover,
    .menu-movil summary:hover,
    .menu-movil a[aria-current='page'] {
      color: var(--acento);
    }
    /* Con el menú abierto, la página de detrás no se desplaza. */
    :global(body.menu-abierto) {
      overflow: hidden;
    }
  }
  /* Móvil estrecho: título más pequeño y, si es largo («Entrenador de intervalos»), en dos líneas. */
  @media (max-width: 40rem) {
    .titulo-seccion {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      font-size: 1.2rem;
      line-height: 1.12;
      white-space: normal;
      overflow-wrap: break-word;
      padding-block: 0.1em;
    }
    .guitarra {
      width: 2rem;
      height: 2rem;
    }
  }
</style>
