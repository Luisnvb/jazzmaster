---
import '../styles/global.css';
import { archivo, ruta } from '../lib/rutas.ts';
import { SECCIONES, agrupar, esActual } from '../lib/secciones.ts';

interface Props {
  /** Título de la pestaña. */
  titulo: string;
  /** Título que se ve en la cabecera, junto a la navegación (por defecto, `titulo`). */
  encabezado?: string;
  /** Si el título de la cabecera es el <h1> de la página (las fichas de canción tienen el suyo). */
  conH1?: boolean;
}

const { titulo, encabezado = titulo, conH1 = true } = Astro.props;
const Titulo = conH1 ? 'h1' : 'p';

// Con barra final para comparar igual "/acordes" y "/acordes/" con ruta('acordes').
const actual = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
// Sección múltiple en la que estamos (para la barra de sus partes).
const multiple = SECCIONES.find((s) => s.partes && esActual(s, actual));
// Sus grupos y el de la página actual: la barra muestra los grupos y abre ese.
const gruposMultiple = multiple ? agrupar(multiple.partes!) : [];
const grupoActual = gruposMultiple.find((g) => g.partes.some((p) => esActual(p, actual)));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <!-- COLOR: barra del navegador en el móvil (igual que --fondo en global.css) -->
    <meta name="theme-color" content="#ffffff" />
    <link rel="manifest" href={archivo('manifest.webmanifest')} />
    <link rel="icon" href={archivo('favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={archivo('iconos/apple-touch-icon.png')} />
    <title>{titulo} · Trastero251</title>
  </head>
  <body>
    <header class="cabecera">
      <div class="cabecera-dentro">
        <Titulo class="titulo-seccion">{encabezado}</Titulo>
        <nav aria-label="Secciones">
          <a href={ruta('')} aria-current={actual === ruta('') ? 'page' : undefined}>Inicio</a>
          {
            SECCIONES.map((s) =>
              s.partes ? (
                <div class="multiple">
                  <a href={s.href} aria-current={esActual(s, actual) ? 'page' : undefined} aria-haspopup="true">
                    {s.nombre} <span aria-hidden="true">▾</span>
                  </a>
                  <ul class:list={['desplegable', { 'con-grupos': agrupar(s.partes).length > 1 }]}>
                    {agrupar(s.partes).map((g) => (
                      <li>
                        {g.nombre && <a class="desplegable-grupo" href={`${s.href}#${g.id}`}>{g.nombre}</a>}
                        <ul>
                          {g.partes.map((p) => (
                            <li>
                              <a href={p.href}>{p.nombre}</a>
                            </li>
                          ))}
                        </ul>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <a href={s.href} aria-current={esActual(s, actual) ? 'page' : undefined}>
                  {s.nombre}
                </a>
              ),
            )
          }
        </nav>
        <label class="nav-movil">
          <span class="visualmente-oculto">Ir a la sección</span>
          <select data-nav-movil>
            <option value={ruta('')} selected={actual === ruta('')}>Inicio</option>
            {
              SECCIONES.map((s) =>
                s.partes ? (
                  <>
                    <optgroup label={s.nombre}>
                      <option value={s.href} selected={actual === s.href}>{s.nombre}</option>
                    </optgroup>
                    {agrupar(s.partes).map((g) => (
                      <optgroup label={g.nombre ? `${s.nombre} · ${g.nombre}` : s.nombre}>
                        {g.partes.map((p) => (
                          <option value={p.href} selected={esActual(p, actual)}>{p.nombre}</option>
                        ))}
                      </optgroup>
                    ))}
                  </>
                ) : (
                  <option value={s.href} selected={esActual(s, actual)}>{s.nombre}</option>
                ),
              )
            }
          </select>
        </label>
      </div>
    </header>
    {
      multiple && (
        <nav class="partes" aria-label={multiple.nombre}>
          <div class="cabecera-dentro">
            <a class="partes-titulo" href={multiple.href}>{multiple.nombre}</a>
            {gruposMultiple.map((g) =>
              g.nombre && gruposMultiple.length > 1 ? (
                <span class:list={['partes-grupo', { abierto: g === grupoActual }]}>
                  <a class="partes-grupo-nombre" href={`${multiple.href}#${g.id}`}>{g.nombre}</a>
                  {g === grupoActual &&
                    g.partes.map((p) => (
                      <a href={p.href} aria-current={esActual(p, actual) ? 'page' : undefined}>
                        {p.nombre}
                      </a>
                    ))}
                </span>
              ) : (
                g.partes.map((p) => (
                  <a href={p.href} aria-current={esActual(p, actual) ? 'page' : undefined}>
                    {p.nombre}
                  </a>
                ))
              ),
            )}
          </div>
        </nav>
      )
    }
    <main>
      <slot />
    </main>
  </body>
</html>

<script>
  import { archivo } from '../lib/rutas.ts';

  // Modo sin conexión: solo en la web compilada (en desarrollo la caché estorbaría).
  if (import.meta.env.PROD && 'serviceWorker' in navigator) {
    navigator.serviceWorker.register(archivo('sw.js')).catch(console.error);
  }

  // Navegación del móvil: un desplegable en lugar de la barra de secciones.
  document.querySelector<HTMLSelectElement>('[data-nav-movil]')?.addEventListener('change', (e) => {
    location.href = (e.target as HTMLSelectElement).value;
  });
</script>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--fondo);
    color: var(--texto);
    border-bottom: 1px solid var(--borde);
  }
  .cabecera-dentro {
    max-width: var(--ancho);
    height: var(--cabecera-alto);
    margin: 0 auto;
    padding: 0 var(--margen);
    display: flex;
    align-items: center;
    gap: 3rem;
  }
  .titulo-seccion {
    margin: 0;
    padding: 0;
    border: 0;
    /* Ancho fijo para que la navegación no se mueva al cambiar de página. */
    flex: 0 0 16rem;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--fuente);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--texto);
  }
  nav[aria-label='Secciones'] {
    display: flex;
    align-items: stretch;
    height: 100%;
    gap: 2.25rem;
  }
  nav[aria-label='Secciones'] > a,
  .multiple > a {
    display: flex;
    align-items: center;
    border-bottom: 0.25rem solid transparent;
    border-top: 0.25rem solid transparent;
    font-family: var(--fuente);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--texto-suave);
    text-decoration: none;
    white-space: nowrap;
  }
  nav[aria-label='Secciones'] > a:hover,
  .multiple > a:hover {
    color: var(--texto);
  }
  nav[aria-label='Secciones'] > a[aria-current='page'],
  .multiple > a[aria-current='page'] {
    color: var(--texto);
    border-bottom-color: var(--acento);
  }
  .multiple > a span {
    margin-left: 0.35rem;
    font-size: 0.7rem;
  }

  /* Sección múltiple: desplegable al pasar el ratón o con el teclado */
  .multiple {
    position: relative;
    display: flex;
  }
  .desplegable {
    position: absolute;
    top: 100%;
    left: -1rem;
    min-width: 14rem;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
    background: var(--fondo);
    border: 1px solid var(--borde);
    border-top: 0.25rem solid var(--acento);
    box-shadow: 0 0.5rem 1.5rem var(--sombra);
    display: none;
  }
  .multiple:hover .desplegable,
  .multiple:focus-within .desplegable {
    display: block;
  }
  .desplegable a {
    display: block;
    padding: 0.6rem 1rem;
    font-family: var(--fuente);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--texto-suave);
    text-decoration: none;
  }
  .desplegable a:hover {
    color: var(--acento);
    background: var(--superficie);
  }
  .desplegable ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Con grupos, una columna por grupo. */
  .desplegable.con-grupos {
    /* Es ancho: se abre hacia la izquierda para no salirse de la pantalla. */
    left: auto;
    right: -1rem;
    grid-template-columns: repeat(4, minmax(12rem, auto));
    gap: 0 0.5rem;
    padding: 0.75rem 0.5rem;
  }
  .multiple:hover .desplegable.con-grupos,
  .multiple:focus-within .desplegable.con-grupos {
    display: grid;
  }
  .desplegable a.desplegable-grupo {
    padding-bottom: 0.35rem;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto);
  }

  /* Partes de la sección múltiple actual */
  .partes {
    background: var(--superficie);
    border-bottom: 1px solid var(--borde);
  }
  /* Con muchas partes, los enlaces pasan a una segunda fila en lugar de partirse. */
  .partes .cabecera-dentro {
    height: auto;
    min-height: 2.5rem;
    flex-wrap: wrap;
    gap: 0.35rem 1.6rem;
    padding-top: 0.45rem;
    padding-bottom: 0.45rem;
  }
  .nav-movil {
    display: none;
  }
  /* Móvil: la barra de secciones no cabe; se cambia por un desplegable. */
  @media (max-width: 78rem) {
    .cabecera-dentro {
      gap: 1rem;
    }
    .titulo-seccion {
      flex: 1 1 auto;
      min-width: 0;
      font-size: 1.15rem;
    }
    nav[aria-label='Secciones'],
    .partes {
      display: none;
    }
    .nav-movil {
      display: block;
      flex: 0 0 auto;
    }
    .nav-movil select {
      width: auto;
      min-height: 2.4rem;
      padding-right: 1.8rem;
      font-weight: 700;
      font-size: 0.95rem;
    }
  }
  /* Móvil estrecho: el desplegable mide lo que su opción más larga («Disminuida y tonos
     enteros») y dejaba al título en dos letras. Se limita para que el título se lea. */
  @media (max-width: 40rem) {
    .nav-movil {
      flex: 0 1 auto;
      min-width: 0;
      max-width: 45%;
    }
    .nav-movil select {
      width: 100%;
      max-width: 100%;
      text-overflow: ellipsis;
    }
    .titulo-seccion {
      font-size: 1.05rem;
    }
  }
  .partes a {
    white-space: nowrap;
    font-family: var(--fuente);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--texto-suave);
    text-decoration: none;
  }
  .partes a:hover,
  .partes a[aria-current='page'] {
    color: var(--acento);
  }
  .partes .partes-titulo {
    color: var(--texto);
  }
  /* Grupos: solo el de la página actual muestra sus páginas. */
  .partes-grupo {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1.1rem;
  }
  .partes-grupo.abierto {
    padding: 0.1rem 0.75rem;
    background: var(--superficie-2);
    border-radius: var(--radio);
  }
  .partes .partes-grupo-nombre {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .partes .abierto .partes-grupo-nombre {
    color: var(--texto);
  }
</style>
