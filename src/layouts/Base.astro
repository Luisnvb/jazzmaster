---
import '../styles/global.css';
import { archivo, ruta } from '../lib/rutas.ts';
import { SECCIONES, esActual } from '../lib/secciones.ts';
import { PALETA_ACENTO } from '../lib/acento.ts';

interface Props {
  /** Título de la pestaña. */
  titulo: string;
  /** Título que se ve en la cabecera, junto a la navegación (por defecto, `titulo`). */
  encabezado?: string;
  /** Si el título de la cabecera es el <h1> de la página (las fichas de canción tienen el suyo). */
  conH1?: boolean;
}

const { titulo, encabezado = titulo, conH1 = true } = Astro.props;
const Titulo = conH1 ? 'h1' : 'p';

// Con barra final para comparar igual "/acordes" y "/acordes/" con ruta('acordes').
const actual = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
// Sección múltiple en la que estamos (para la barra de sus partes).
const multiple = SECCIONES.find((s) => s.partes && esActual(s, actual));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="manifest" href={archivo('manifest.webmanifest')} />
    <link rel="icon" href={archivo('favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={archivo('iconos/apple-touch-icon.png')} />
    <title>{titulo} · Práctica</title>
    <script is:inline define:vars={{ paleta: PALETA_ACENTO }}>
      // Color de acento de esta sesión: se elige al abrir la pestaña (distinto del
      // de la sesión anterior) y se mantiene al cambiar de página. Va en <head>
      // para que no se vea el color por defecto un instante.
      let acento = null;
      try {
        acento = sessionStorage.getItem('acento');
      } catch {}
      if (!paleta.includes(acento)) {
        let anterior = null;
        try {
          anterior = localStorage.getItem('acento:ultimo');
        } catch {}
        const opciones = paleta.filter((c) => c !== anterior);
        acento = opciones[Math.floor(Math.random() * opciones.length)];
        try {
          sessionStorage.setItem('acento', acento);
          localStorage.setItem('acento:ultimo', acento);
        } catch {}
      }
      document.documentElement.style.setProperty('--acento', acento);
    </script>
  </head>
  <body>
    <header class="cabecera">
      <div class="cabecera-dentro">
        <Titulo class="titulo-seccion">{encabezado}</Titulo>
        <nav aria-label="Secciones">
          <a href={ruta('')} aria-current={actual === ruta('') ? 'page' : undefined}>Inicio</a>
          {
            SECCIONES.map((s) =>
              s.partes ? (
                <div class="multiple">
                  <a href={s.href} aria-current={esActual(s, actual) ? 'page' : undefined} aria-haspopup="true">
                    {s.nombre} <span aria-hidden="true">▾</span>
                  </a>
                  <ul class="desplegable">
                    {s.partes.map((p) => (
                      <li>
                        <a href={p.href}>{p.nombre}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <a href={s.href} aria-current={esActual(s, actual) ? 'page' : undefined}>
                  {s.nombre}
                </a>
              ),
            )
          }
        </nav>
        <label class="nav-movil">
          <span class="visualmente-oculto">Ir a la sección</span>
          <select data-nav-movil>
            <option value={ruta('')} selected={actual === ruta('')}>Inicio</option>
            {
              SECCIONES.map((s) =>
                s.partes ? (
                  <optgroup label={s.nombre}>
                    <option value={s.href} selected={actual.startsWith(s.href)}>{s.nombre}</option>
                    {s.partes.map((p) => (
                      <option value={p.href} selected={esActual(p, actual)}>{p.nombre}</option>
                    ))}
                  </optgroup>
                ) : (
                  <option value={s.href} selected={esActual(s, actual)}>{s.nombre}</option>
                ),
              )
            }
          </select>
        </label>
      </div>
    </header>
    {
      multiple && (
        <nav class="partes" aria-label={multiple.nombre}>
          <div class="cabecera-dentro">
            <a class="partes-titulo" href={multiple.href}>{multiple.nombre}</a>
            {multiple.partes!.map((p) => (
              <a href={p.href} aria-current={esActual(p, actual) ? 'page' : undefined}>
                {p.nombre}
              </a>
            ))}
          </div>
        </nav>
      )
    }
    <main>
      <slot />
    </main>
  </body>
</html>

<script>
  import { archivo } from '../lib/rutas.ts';

  // Modo sin conexión: solo en la web compilada (en desarrollo la caché estorbaría).
  if (import.meta.env.PROD && 'serviceWorker' in navigator) {
    navigator.serviceWorker.register(archivo('sw.js')).catch(console.error);
  }

  // Navegación del móvil: un desplegable en lugar de la barra de secciones.
  document.querySelector<HTMLSelectElement>('[data-nav-movil]')?.addEventListener('change', (e) => {
    location.href = (e.target as HTMLSelectElement).value;
  });
</script>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--fondo);
    color: var(--texto);
    border-bottom: 1px solid var(--borde);
  }
  .cabecera-dentro {
    max-width: var(--ancho);
    height: var(--cabecera-alto);
    margin: 0 auto;
    padding: 0 var(--margen);
    display: flex;
    align-items: center;
    gap: 3rem;
  }
  .titulo-seccion {
    margin: 0;
    padding: 0;
    border: 0;
    /* Ancho fijo para que la navegación no se mueva al cambiar de página. */
    flex: 0 0 16rem;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--fuente);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--texto);
  }
  nav[aria-label='Secciones'] {
    display: flex;
    align-items: stretch;
    height: 100%;
    gap: 2.25rem;
  }
  nav[aria-label='Secciones'] > a,
  .multiple > a {
    display: flex;
    align-items: center;
    border-bottom: 0.25rem solid transparent;
    border-top: 0.25rem solid transparent;
    font-family: var(--fuente);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--texto-suave);
    text-decoration: none;
    white-space: nowrap;
  }
  nav[aria-label='Secciones'] > a:hover,
  .multiple > a:hover {
    color: var(--texto);
  }
  nav[aria-label='Secciones'] > a[aria-current='page'],
  .multiple > a[aria-current='page'] {
    color: var(--texto);
    border-bottom-color: var(--acento);
  }
  .multiple > a span {
    margin-left: 0.35rem;
    font-size: 0.7rem;
  }

  /* Sección múltiple: desplegable al pasar el ratón o con el teclado */
  .multiple {
    position: relative;
    display: flex;
  }
  .desplegable {
    position: absolute;
    top: 100%;
    left: -1rem;
    min-width: 14rem;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
    background: var(--fondo);
    border: 1px solid var(--borde);
    border-top: 0.25rem solid var(--acento);
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.08);
    display: none;
  }
  .multiple:hover .desplegable,
  .multiple:focus-within .desplegable {
    display: block;
  }
  .desplegable a {
    display: block;
    padding: 0.6rem 1rem;
    font-family: var(--fuente);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--texto-suave);
    text-decoration: none;
  }
  .desplegable a:hover {
    color: var(--acento);
    background: var(--superficie);
  }

  /* Partes de la sección múltiple actual */
  .partes {
    background: var(--superficie);
    border-bottom: 1px solid var(--borde);
  }
  .partes .cabecera-dentro {
    height: 2.5rem;
    gap: 2rem;
  }
  .nav-movil {
    display: none;
  }
  /* Móvil: la barra de secciones no cabe; se cambia por un desplegable. */
  @media (max-width: 70rem) {
    .cabecera-dentro {
      gap: 1rem;
    }
    .titulo-seccion {
      flex: 1 1 auto;
      min-width: 0;
      font-size: 1.15rem;
    }
    nav[aria-label='Secciones'],
    .partes {
      display: none;
    }
    .nav-movil {
      display: block;
      flex: 0 0 auto;
    }
    .nav-movil select {
      width: auto;
      min-height: 2.4rem;
      padding-right: 1.8rem;
      font-weight: 700;
      font-size: 0.95rem;
    }
  }
  .partes a {
    font-family: var(--fuente);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--texto-suave);
    text-decoration: none;
  }
  .partes a:hover,
  .partes a[aria-current='page'] {
    color: var(--acento);
  }
  .partes .partes-titulo {
    color: var(--texto);
  }
</style>
