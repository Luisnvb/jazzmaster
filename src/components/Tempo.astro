---
interface Props {
  /** Clave con la que se recuerda el tempo (una por sección). */
  clave: string;
  inicial?: number;
}

const { clave, inicial = 100 } = Astro.props;
---

<label class="tempo">
  <span>Tempo <strong data-tempo-valor>{inicial}</strong> BPM</span>
  <input type="range" min="40" max="240" step="5" value={inicial} data-tempo data-clave={clave} />
</label>

<style>
  .tempo {
    display: grid;
    grid-template-columns: auto minmax(0, 28rem);
    justify-content: start;
    align-items: center;
    gap: 1.25rem;
    margin: 0 0 1rem;
  }
  .tempo strong {
    color: var(--texto);
    display: inline-block;
    min-width: 3ch;
    text-align: right;
    font-size: 1rem;
  }
  /* Dentro de la barra de tónica (SelectorTonica): compacto y sin margen. */
  :global(.extra) .tempo {
    grid-template-columns: auto 9rem;
    gap: 0.6rem;
    margin: 0;
  }
  :global(.extra) .tempo input {
    width: 9rem;
    min-height: 2.2rem;
  }
  input {
    width: 100%;
    accent-color: var(--acento);
    min-height: 2.5rem;
  }
</style>
