---
interface Props {
  /** Clave con la que se recuerda el tempo (una por sección). */
  clave: string;
  inicial?: number;
}

const { clave, inicial = 100 } = Astro.props;
---

<label class="tempo">
  <span>Tempo <strong data-tempo-valor>{inicial}</strong> BPM</span>
  <input type="range" min="40" max="240" step="5" value={inicial} data-tempo data-clave={clave} />
</label>

<style>
  .tempo {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1rem;
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    color: var(--texto-suave);
  }
  .tempo strong {
    color: var(--texto);
    display: inline-block;
    min-width: 2ch;
    text-align: right;
  }
  input {
    width: 100%;
    accent-color: var(--acento);
    min-height: 2.5rem;
  }
</style>
