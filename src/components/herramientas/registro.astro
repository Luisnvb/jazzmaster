---
// Registro de práctica (sección Herramientas): cronómetro por actividad (las páginas de
// la web, por secciones, u «Otra»), resumen de hoy, la semana y la racha, minutos de
// los últimos 14 días y reparto por sección (lib/registro.ts). Todo en localStorage
// (registro:sesiones, registro:en-curso); el cronómetro sigue contando aunque se
// cierre la página. Se exporta e importa como JSON. Textos en i18n/registro.ts; lo usan
// pages/herramientas/registro.astro y pages/en/tools/practice-log.astro. Lo guardado es igual
// en los dos idiomas: la actividad se guarda con el nombre español de la página.
import Base from '../../layouts/Base.astro';
import { SECCIONES, secciones as seccionesEn } from '../../lib/secciones.ts';
import type { Idioma } from '../../i18n/idiomas.ts';
import { REGISTRO } from '../../i18n/registro.ts';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const T = REGISTRO[idioma];
// Mismo orden en los dos idiomas: el valor es el nombre español; el texto, el del idioma.
const traducidas = seccionesEn(idioma);
const secciones = SECCIONES.map((s, i) => ({
  id: s.id,
  nombre: traducidas[i].nombre,
  paginas: s.partes.map((p, j) => ({ valor: p.nombre, texto: traducidas[i].partes[j].nombre })),
}));
const datos = JSON.stringify(secciones.map((s) => ({ id: s.id, nombre: s.nombre }))).replace(/</g, '\\u003c');
const opciones = (prefijo: string) =>
  secciones.map((s) => ({ etiqueta: s.nombre, opciones: s.paginas.map((p) => ({ valor: `${s.id}|${p.valor}`, texto: p.texto })) })).concat([
    { etiqueta: T.fueraWeb, opciones: [{ valor: 'otra|', texto: `${T.otra}${prefijo}` }] },
  ]);
---

<Base titulo={T.titulo}>
  <div class="centrada">
    <section class="cronometro tarjeta" aria-labelledby="cronometro-titulo">
      <h2 id="cronometro-titulo">{T.cronometro}</h2>
      <div class="campos">
        <label class="bloque">{T.quePracticas}
          <select data-actividad>
            {opciones('…').map((g) => <optgroup label={g.etiqueta}>{g.opciones.map((o) => <option value={o.valor}>{o.texto}</option>)}</optgroup>)}
          </select>
        </label>
        <label class="bloque" data-otra hidden>{T.actividad}
          <input data-otra-texto maxlength="80" autocomplete="off" placeholder={T.actividadEjemplo} />
        </label>
        <label class="bloque">{T.notaOpcional}
          <input data-nota maxlength="200" autocomplete="off" placeholder={T.notaEjemplo} />
        </label>
      </div>
      <div class="reloj" data-reloj aria-live="off">0:00:00</div>
      <div class="botones">
        <button type="button" class="boton principal" data-empezar>{T.empezar}</button>
        <button type="button" class="boton" data-pausar hidden>{T.pausar}</button>
        <button type="button" class="boton principal" data-terminar hidden>{T.terminar}</button>
        <button type="button" class="boton" data-descartar hidden>{T.descartar}</button>
      </div>
      <p class="aviso" data-aviso role="status"></p>
    </section>

    <section aria-labelledby="resumen-titulo">
      <h2 id="resumen-titulo">{T.resumen}</h2>
      <div class="cifras">
        <div class="cifra"><span class="etiqueta">{T.hoy}</span><strong data-hoy>0 s</strong></div>
        <div class="cifra"><span class="etiqueta">{T.ultimos7}</span><strong data-semana>0 s</strong></div>
        <div class="cifra"><span class="etiqueta">{T.ultimos30}</span><strong data-mes>0 s</strong></div>
        <div class="cifra"><span class="etiqueta">{T.racha}</span><strong data-racha>0 {T.dias}</strong></div>
      </div>

      <h3>{T.minutosDia} <span class="suave">{T.ultimos14}</span></h3>
      <div class="grafico" data-grafico role="list" aria-label={T.graficoAyuda}></div>

      <h3>{T.porSeccion} <span class="suave">{T.ultimos30Par}</span></h3>
      <ul class="reparto" data-reparto></ul>
      <p class="vacio" data-sin-reparto hidden>{T.sinReparto}</p>
    </section>

    <section aria-labelledby="sesiones-titulo">
      <h2 id="sesiones-titulo">{T.sesiones}</h2>
      <details class="a-mano">
        <summary>{T.aMano}</summary>
        <form class="formulario" data-a-mano>
          <label class="bloque">{T.diaCampo} <input type="date" name="dia" required /></label>
          <label class="bloque">{T.minutos} <input type="number" name="minutos" min="1" max="600" value="30" required /></label>
          <label class="bloque">{T.que}
            <select name="actividad">
              {opciones('').map((g) => <optgroup label={g.etiqueta}>{g.opciones.map((o) => <option value={o.valor}>{o.texto}</option>)}</optgroup>)}
            </select>
          </label>
          <label class="bloque">{T.nota} <input name="nota" maxlength="200" autocomplete="off" /></label>
          <button type="submit" class="boton principal">{T.anadir}</button>
        </form>
      </details>
      <ul class="sesiones" data-sesiones></ul>
      <p class="vacio" data-sin-sesiones hidden>{T.sinSesiones}</p>
      <button type="button" class="boton" data-mas hidden>{T.verMas}</button>

      <h3>{T.copia}</h3>
      <p class="suave">{T.copiaTexto}</p>
      <div class="botones">
        <button type="button" class="boton" data-exportar>{T.exportar}</button>
        <button type="button" class="boton" data-importar>{T.importar}</button>
      </div>
    </section>

    <script type="application/json" id="datos-registro" set:html={datos} />
  </div>
</Base>

<script>
  import { descargar, elegirArchivo, esc, guardarJSON, leerJSON, borrar } from '../../lib/almacen.ts';
  import { nuevoId } from '../../lib/apuntes.ts';
  import { nombreActividad } from '../../lib/secciones.ts';
  import { formatear, idiomaValido, LOCALE, plural } from '../../i18n/idiomas.ts';
  import { INTERFAZ } from '../../i18n/interfaz.ts';
  import { REGISTRO } from '../../i18n/registro.ts';

  const idioma = idiomaValido(document.documentElement.lang);
  const T = REGISTRO[idioma];
  const I = INTERFAZ[idioma];
  /** La actividad guardada (nombre español de la página), en el idioma de la página. */
  const actividadVisible = (a: string) => nombreActividad(a, idioma);
  import {
    actividadDeValor,
    alternarPausa,
    cerrarSesion,
    diaDe,
    duracion,
    empezarSesion,
    enCursoValido,
    ordenarSesiones,
    racha,
    reloj,
    reparto,
    sesionesValidas,
    totalDesde,
    totalesPorDia,
    ultimosDias,
    unirSesiones,
    type EnCurso,
    type Sesion,
  } from '../../lib/registro.ts';

  const CLAVE = 'registro:sesiones';
  const CLAVE_EN_CURSO = 'registro:en-curso';
  const secciones: { id: string; nombre: string }[] = JSON.parse(document.getElementById('datos-registro')!.textContent!);
  const nombreSeccion = (id: string) => secciones.find((s) => s.id === id)?.nombre ?? T.otra;

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const selActividad = $<HTMLSelectElement>('[data-actividad]');
  const otra = $('[data-otra]');
  const otraTexto = $<HTMLInputElement>('[data-otra-texto]');
  const nota = $<HTMLInputElement>('[data-nota]');
  const relojEl = $('[data-reloj]');
  const aviso = $('[data-aviso]');
  const tituloOriginal = document.title;

  let sesiones: Sesion[] = ordenarSesiones(sesionesValidas(leerJSON(CLAVE)));
  let enCurso: EnCurso | null = enCursoValido(leerJSON(CLAVE_EN_CURSO));
  let visibles = 30;

  /** La actividad elegida: [sección, nombre]. */
  const elegida = (valor = selActividad.value, libre = otraTexto.value) => actividadDeValor(valor, libre);
  const valorDe = (seccion: string, actividad: string) => (seccion === 'otra' ? 'otra|' : `${seccion}|${actividad}`);

  // Lo último elegido, para la próxima vez.
  const ultima = leerJSON<{ valor: string; libre: string }>('registro:ultima');
  const elegir = (valor: string, libre: string) => {
    if ([...selActividad.options].some((o) => o.value === valor)) selActividad.value = valor;
    otraTexto.value = libre;
    otra.hidden = !selActividad.value.startsWith('otra|');
  };
  if (enCurso) {
    elegir(valorDe(enCurso.seccion, enCurso.actividad), enCurso.seccion === 'otra' ? enCurso.actividad : '');
    nota.value = enCurso.nota;
  } else if (ultima) elegir(ultima.valor, ultima.libre);
  else elegir(selActividad.value, '');

  const guardarSesiones = () => {
    if (!guardarJSON(CLAVE, sesiones)) aviso.textContent = I.noGuardado;
  };
  const guardarEnCurso = () => (enCurso ? guardarJSON(CLAVE_EN_CURSO, enCurso) : borrar(CLAVE_EN_CURSO));

  // --- Cronómetro -----------------------------------------------------------------

  function pintarCronometro() {
    const segundos = enCurso ? enCurso.acumulado + (enCurso.desde === null ? 0 : (Date.now() - enCurso.desde) / 1000) : 0;
    relojEl.textContent = reloj(segundos);
    relojEl.classList.toggle('pausado', !!enCurso && enCurso.desde === null);
    $('[data-empezar]').hidden = !!enCurso;
    $('[data-pausar]').hidden = !enCurso;
    $('[data-pausar]').textContent = enCurso?.desde === null ? T.seguir : T.pausar;
    $('[data-terminar]').hidden = !enCurso;
    $('[data-descartar]').hidden = !enCurso;
    document.title = enCurso?.desde != null ? `${reloj(segundos)} · ${tituloOriginal}` : tituloOriginal;
  }

  const actualizarActividad = () => {
    otra.hidden = !selActividad.value.startsWith('otra|');
    guardarJSON('registro:ultima', { valor: selActividad.value, libre: otraTexto.value });
    if (!enCurso) return;
    [enCurso.seccion, enCurso.actividad] = elegida();
    enCurso.nota = nota.value;
    guardarEnCurso();
  };
  selActividad.addEventListener('change', actualizarActividad);
  otraTexto.addEventListener('input', actualizarActividad);
  nota.addEventListener('input', actualizarActividad);

  $('[data-empezar]').addEventListener('click', () => {
    const ahora = Date.now();
    enCurso = empezarSesion(ahora, elegida(), nota.value);
    aviso.textContent = '';
    guardarEnCurso();
    pintarCronometro();
  });
  $('[data-pausar]').addEventListener('click', () => {
    if (!enCurso) return;
    enCurso = alternarPausa(enCurso, Date.now());
    guardarEnCurso();
    pintarCronometro();
  });
  $('[data-terminar]').addEventListener('click', () => {
    if (!enCurso) return;
    const s = cerrarSesion(enCurso, Date.now(), nuevoId('s'));
    if (s) {
      sesiones = ordenarSesiones([s, ...sesiones]);
      guardarSesiones();
      aviso.textContent = formatear(T.guardada, { actividad: actividadVisible(s.actividad), duracion: duracion(s.segundos) });
    } else aviso.textContent = T.muyCorta;
    enCurso = null;
    nota.value = '';
    guardarEnCurso();
    pintarCronometro();
    pintarResumen();
  });
  const descartar = $<HTMLButtonElement>('[data-descartar]');
  descartar.addEventListener('click', () => {
    // Segunda pulsación para confirmar, como en Apuntes.
    if (descartar.dataset.confirmar !== 'si') {
      descartar.dataset.confirmar = 'si';
      descartar.textContent = I.seguro;
      setTimeout(() => {
        delete descartar.dataset.confirmar;
        descartar.textContent = T.descartar;
      }, 4000);
      return;
    }
    delete descartar.dataset.confirmar;
    descartar.textContent = T.descartar;
    enCurso = null;
    guardarEnCurso();
    aviso.textContent = T.descartada;
    pintarCronometro();
  });
  setInterval(() => enCurso?.desde != null && pintarCronometro(), 1000);
  // Si se cambia en otra pestaña.
  addEventListener('storage', (e) => {
    if (e.key === CLAVE_EN_CURSO) {
      enCurso = enCursoValido(leerJSON(CLAVE_EN_CURSO));
      pintarCronometro();
    }
    if (e.key === CLAVE) {
      sesiones = ordenarSesiones(sesionesValidas(leerJSON(CLAVE)));
      pintarResumen();
    }
  });

  // --- Resumen, gráfico y lista ------------------------------------------------------

  const fechaCorta = new Intl.DateTimeFormat(LOCALE[idioma], { weekday: 'short', day: 'numeric', month: 'short' });
  const fechaLarga = new Intl.DateTimeFormat(LOCALE[idioma], { weekday: 'long', day: 'numeric', month: 'long' });
  const hora = new Intl.DateTimeFormat(LOCALE[idioma], { hour: '2-digit', minute: '2-digit' });
  const deDia = (dia: string) => new Date(`${dia}T12:00:00`);

  function pintarResumen() {
    const hoy = new Date();
    const dias14 = ultimosDias(hoy, 14);
    const hoyTxt = dias14[13];
    $('[data-hoy]').textContent = duracion(totalDesde(sesiones, hoyTxt));
    $('[data-semana]').textContent = duracion(totalDesde(sesiones, dias14[7]));
    const desde30 = ultimosDias(hoy, 30)[0];
    $('[data-mes]').textContent = duracion(totalDesde(sesiones, desde30));
    const r = racha(sesiones, hoy);
    $('[data-racha]').textContent = `${r} ${plural(r, T.dia, T.dias)}`;

    // Gráfico: una barra por día, en minutos; la escala la marca el día de más práctica.
    const totales = totalesPorDia(sesiones, dias14);
    const max = Math.max(...totales, 60 * 30);
    $('[data-grafico]').innerHTML = dias14
      .map((dia, i) => {
        const min = Math.round(totales[i] / 60);
        const alto = totales[i] ? Math.max(2, (totales[i] / max) * 100) : 0;
        const d = deDia(dia);
        const etiqueta = `${fechaLarga.format(d)}: ${totales[i] ? duracion(totales[i]) : T.sinPractica}`;
        const esHoy = dia === hoyTxt;
        return `<div class="dia${esHoy ? ' hoy' : ''}" role="listitem" tabindex="0" aria-label="${esc(etiqueta)}" data-tip="${esc(etiqueta)}">
          <span class="valor">${esHoy && min ? `${min}′` : ''}</span>
          <span class="barra" style="height:${alto.toFixed(1)}%"></span>
          <span class="eje">${esc(fechaCorta.format(d).split(' ')[0].replace('.', ''))}<br />${d.getDate()}</span>
        </div>`;
      })
      .join('');

    // Reparto por sección.
    const porSeccion = reparto(sesiones, desde30, 'seccion');
    const total = porSeccion.reduce((t, x) => t + x.segundos, 0);
    $('[data-sin-reparto]').hidden = porSeccion.length > 0;
    $('[data-reparto]').innerHTML = porSeccion
      .map(
        (x) => `<li>
          <span class="nombre">${esc(nombreSeccion(x.clave))}</span>
          <span class="pista"><span class="relleno" style="width:${((x.segundos / porSeccion[0].segundos) * 100).toFixed(1)}%"></span></span>
          <span class="cuanto">${esc(duracion(x.segundos))} <span class="suave">· ${Math.round((x.segundos / total) * 100)} %</span></span>
        </li>`,
      )
      .join('');

    // Lista de sesiones.
    $('[data-sin-sesiones]').hidden = sesiones.length > 0;
    $('[data-mas]').hidden = sesiones.length <= visibles;
    $('[data-sesiones]').innerHTML = sesiones
      .slice(0, visibles)
      .map((s) => {
        const d = new Date(s.inicio);
        return `<li class="sesion">
          <div class="cuando">${esc(fechaCorta.format(d))} · ${esc(hora.format(d))}</div>
          <div class="que"><strong>${esc(actividadVisible(s.actividad))}</strong> <span class="suave">${s.seccion === 'otra' ? '' : `· ${esc(nombreSeccion(s.seccion))}`}</span>${s.nota ? `<div class="nota-sesion">${esc(s.nota)}</div>` : ''}</div>
          <div class="duracion">${esc(duracion(s.segundos))}</div>
          <button type="button" class="boton pequeno" data-borrar="${esc(s.id)}" aria-label="${esc(formatear(T.borrarSesion, { actividad: actividadVisible(s.actividad) }))}">${T.borrar}</button>
        </li>`;
      })
      .join('');
  }

  $('[data-sesiones]').addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-borrar]');
    if (!b) return;
    if (b.dataset.confirmar !== 'si') {
      b.dataset.confirmar = 'si';
      b.textContent = T.seguroCorto;
      setTimeout(() => {
        if (b.isConnected) {
          delete b.dataset.confirmar;
          b.textContent = T.borrar;
        }
      }, 4000);
      return;
    }
    sesiones = sesiones.filter((s) => s.id !== b.dataset.borrar);
    guardarSesiones();
    pintarResumen();
  });
  $('[data-mas]').addEventListener('click', () => {
    visibles += 30;
    pintarResumen();
  });

  const formulario = $<HTMLFormElement>('[data-a-mano]');
  (formulario.elements.namedItem('dia') as HTMLInputElement).value = diaDe(new Date());
  formulario.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(formulario);
    const dia = String(f.get('dia'));
    const minutos = Number(f.get('minutos'));
    if (!/^\d{4}-\d{2}-\d{2}$/.test(dia) || !(minutos > 0)) return;
    const [seccion, actividad] = elegida(String(f.get('actividad')), 'Otra');
    const s: Sesion = { id: nuevoId('s'), inicio: deDia(dia).toISOString(), segundos: Math.round(minutos * 60), seccion, actividad };
    const texto = String(f.get('nota') ?? '').trim();
    if (texto) s.nota = texto;
    sesiones = ordenarSesiones([s, ...sesiones]);
    guardarSesiones();
    (formulario.elements.namedItem('nota') as HTMLInputElement).value = '';
    aviso.textContent = '';
    pintarResumen();
  });

  $('[data-exportar]').addEventListener('click', () => {
    descargar(`jazzmaster-registro-${diaDe(new Date())}.json`, JSON.stringify({ tipo: 'jazzmaster-registro', version: 1, sesiones }, null, 2));
  });
  $('[data-importar]').addEventListener('click', async () => {
    const archivo = await elegirArchivo('.json,application/json');
    if (!archivo) return;
    try {
      const datos = JSON.parse(archivo.texto);
      const nuevas = sesionesValidas(Array.isArray(datos) ? datos : datos?.sesiones);
      if (!nuevas.length) throw new Error('sin sesiones');
      sesiones = unirSesiones(sesiones, nuevas);
      guardarSesiones();
      pintarResumen();
      aviso.textContent = formatear(T.importadas, { n: nuevas.length, archivo: archivo.nombre });
    } catch {
      aviso.textContent = formatear(T.noEsRegistro, { archivo: archivo.nombre });
    }
  });

  pintarCronometro();
  pintarResumen();
</script>

<style>
  /* Toda la herramienta en una columna centrada en la página. */
  .centrada {
    max-width: 44rem;
    margin: 0 auto;
  }
  section + section {
    margin-top: 2rem;
  }
  .cronometro {
    max-width: 44rem;
  }
  .cronometro h2 {
    margin-top: 0;
  }
  .campos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.5rem 1rem;
  }
  .reloj {
    margin: 0.75rem 0;
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .reloj.pausado {
    color: var(--texto-suave);
  }
  .botones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .aviso {
    min-height: 1.3em;
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--texto-suave);
  }
  .cifras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: 0.5rem;
    max-width: 44rem;
  }
  .cifra {
    display: grid;
    gap: 0.2rem;
    padding: 0.7rem 0.9rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .cifra .etiqueta {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .cifra strong {
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
  }
  h3 {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.05rem;
  }
  /* Gráfico: una sola serie (minutos por día) en el color de acento, sin leyenda. */
  .grafico {
    display: grid;
    grid-template-columns: repeat(14, minmax(0, 1fr));
    gap: 2px;
    max-width: 44rem;
    height: 11rem;
    padding-bottom: 2.4rem;
    position: relative;
    border-bottom: 1px solid var(--borde);
  }
  .grafico :global(.dia) {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    height: 100%;
    outline: none;
  }
  .grafico :global(.barra) {
    display: block;
    width: min(70%, 1.6rem);
    background: var(--acento); /* COLOR: minutos de práctica */
    border-radius: 4px 4px 0 0;
  }
  .grafico :global(.dia:not(.hoy) .barra) {
    opacity: 0.75;
  }
  .grafico :global(.valor) {
    min-height: 1.2em;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .grafico :global(.eje) {
    position: absolute;
    top: 100%;
    margin-top: 0.3rem;
    font-size: 0.7rem;
    line-height: 1.15;
    text-align: center;
    color: var(--texto-suave);
  }
  .grafico :global(.dia.hoy .eje) {
    color: var(--texto);
    font-weight: 700;
  }
  /* Tooltip al pasar o con el foco: el día y lo practicado. */
  .grafico :global(.dia:hover .barra),
  .grafico :global(.dia:focus-visible .barra) {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--fondo), 0 0 0 4px var(--acento);
