---
// Buscador de escalas (sección Herramientas): escribes notas, un acorde o varios
// acordes seguidos y dice qué escalas del diccionario (escalas.yaml) los contienen,
// primero las de la raíz del acorde (lib/buscador-escalas.ts, lib/cifrado-acorde.ts).
// Se recuerda lo último y se puede enlazar con ?q=Dm7%20G7. Textos en
// i18n/buscador-escalas.ts; lo usan pages/herramientas/buscador-escalas.astro y
// pages/en/tools/scale-finder.astro (con los nombres en inglés de escalas.yaml).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tempo from '../../components/Tempo.astro';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { porOrden } from '../../lib/orden.ts';
import { enlacePagina } from '../../lib/secciones.ts';
import { formatear, type Idioma } from '../../i18n/idiomas.ts';
import { INTERFAZ, nombreSonido } from '../../i18n/interfaz.ts';
import { BUSCADOR_ESCALAS } from '../../i18n/buscador-escalas.ts';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const T = BUSCADOR_ESCALAS[idioma];
const I = INTERFAZ[idioma];
const en = idioma === 'en';
const grupos = porOrden(await getCollection('grupos')).map((g) => ({ id: g.id, nombre: (en && g.data.en?.nombre) || g.data.nombre }));
const escalas = porOrden(await getCollection('escalas')).map((e) => ({
  id: e.id,
  nombre: (en && e.data.en?.nombre) || e.data.nombre,
  grupo: e.data.grupo.id,
  formula: e.data.formula,
}));
const diccionario = enlacePagina('escalas', idioma);
const datos = JSON.stringify({ grupos, escalas, diccionario }).replace(/</g, '\\u003c');
const EJEMPLOS = ['Dm7', 'G7alt', 'Cmaj7#11', 'Dm7 G7 Cmaj7', 'Bm7b5 E7b9 Am6', 'C E G Bb D'];
---

<Base titulo={T.titulo}>
  <p class="intro" set:html={formatear(T.intro, { diccionario })} />

  <section class="buscador" aria-label={T.buscador}>
    <div class="entrada">
      <label class="campo" for="consulta">{T.notasAcordes}</label>
      <input id="consulta" type="text" autocomplete="off" spellcheck="false" placeholder="Dm7 G7 · C E G Bb" data-consulta />
    </div>
    <div class="ejemplos">
      <span class="suave">{T.ejemplos}</span>
      {EJEMPLOS.map((e) => <button type="button" class="boton pequeno" data-ejemplo={e}>{e}</button>)}
    </div>
    <label class="casilla"><input type="checkbox" data-solo-raiz /> {T.soloRaiz}</label>

    <div class="leido" data-leido aria-live="polite"></div>

    <div class="controles">
      <label>{I.sonido}
        <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{nombreSonido(i, idioma)}</option>)}</select>
      </label>
      <Tempo clave="buscador-escalas" inicial={140} />
    </div>
    <ul class="resultados" data-resultados></ul>
    <button type="button" class="boton" data-mas hidden>{T.verTodas}</button>
  </section>

  <script type="application/json" id="datos-escalas" set:html={datos} />
</Base>

<script>
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { tocar } from '../../lib/audio.ts';
  import { buscarEscalas, claveNotas, leerEntrada, type Coincidencia, type EscalaDatos } from '../../lib/buscador-escalas.ts';
  import { conectarInstrumento, conectarTempo } from '../../lib/cliente.ts';
  import { secuenciaEscala } from '../../lib/secuencias.ts';
  import { parseNota, pitchClass } from '../../lib/teoria.ts';
  import { formatear, idiomaValido } from '../../i18n/idiomas.ts';
  import { BUSCADOR_ESCALAS } from '../../i18n/buscador-escalas.ts';

  const idioma = idiomaValido(document.documentElement.lang);
  const T = BUSCADOR_ESCALAS[idioma];
  /** Nombre de una escala tras la tónica: «D dórico» en español, «D Dorian» en inglés. */
  const nombreEscala = (nombre: string) => (idioma === 'en' ? nombre : nombre.toLowerCase());

  const { grupos, escalas, diccionario }: { grupos: { id: string; nombre: string }[]; escalas: EscalaDatos[]; diccionario: string } = JSON.parse(
    document.getElementById('datos-escalas')!.textContent!,
  );
  const CLAVE = 'herramientas:buscador-escalas';
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const entrada = $<HTMLInputElement>('[data-consulta]');
  const soloRaiz = $<HTMLInputElement>('[data-solo-raiz]');
  const lista = $('[data-resultados]');
  const mas = $('[data-mas]');
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('herramientas:buscador-escalas-sonido');

  const guardado = leerJSON<{ texto?: string; soloRaiz?: boolean }>(CLAVE) ?? {};
  entrada.value = new URLSearchParams(location.search).get('q') ?? (typeof guardado.texto === 'string' ? guardado.texto : 'Dm7');
  soloRaiz.checked = guardado.soloRaiz === true;

  const MOSTRAR = 24;
  let todas = false;
  let resultados: Coincidencia[] = [];
  const bonito = (n: string) => n.replace(/([A-G])##/g, '$1𝄪').replace(/([A-G])#/g, '$1♯').replace(/([A-G])bb/g, '$1𝄫').replace(/([A-G])b/g, '$1♭');
  const nombreGrupo = (id: string) => grupos.find((g) => g.id === id)?.nombre ?? id;

  function pintar() {
    const e = leerEntrada(entrada.value);
    resultados = buscarEscalas(e, escalas, soloRaiz.checked);
    const pcs = new Set(e.notas.map((n) => pitchClass(parseNota(n))));
    const aviso = e.errores.length ? formatear(T.noEntiendo, { trozos: e.errores.map((x) => `<code>${esc(x)}</code>`).join(', ') }) : '';
    $('[data-leido]').innerHTML =
      e.notas.length < 2
        ? `<p>${T.faltan}${aviso}</p>`
        : `<p><strong>${e.acordes.length ? `${e.acordes.length === 1 ? T.acorde : T.acordes} ${esc(e.acordes.join(' '))}` : T.notas}:</strong> ${esc(bonito(e.notas.join(' ')))}${
            e.raiz ? formatear(T.raiz, { nota: esc(bonito(e.raiz)) }) : formatear(T.primera, { nota: esc(bonito(e.notas[0])) })
          } · <strong>${resultados.length}</strong> ${resultados.length === 1 ? T.escala : T.escalas}${aviso}</p>`;

    // Escalas con las mismas notas que otra de más arriba (modos de la misma escala madre).
    const primeras = new Map<string, Coincidencia>();
    const visibles = todas ? resultados : resultados.slice(0, MOSTRAR);
    lista.innerHTML = visibles
      .map((c, i) => {
        const clave = claveNotas(c);
        const igual = primeras.get(clave);
        if (!igual) primeras.set(clave, c);
        const notas = c.notas
          .map((n) => `<span class="nota${pcs.has(pitchClass(parseNota(n))) ? ' dada' : ''}">${esc(bonito(n))}</span>`)
          .join('');
        return `<li class="escala${c.enLaRaiz ? ' en-raiz' : ''}">
          <div class="cabeza">
            <strong class="titulo">${esc(bonito(c.tonica))} ${esc(nombreEscala(c.escala.nombre))}</strong>
            <span class="suave">${formatear(T.sobre, { grupo: esc(nombreGrupo(c.escala.grupo)) })}${c.extra ? formatear(T.anade, { n: c.extra, notas: c.extra === 1 ? T.nota : T.notasPlural }) : T.soloEsas}</span>
          </div>
          <div class="notas">${notas}</div>
          ${igual ? `<div class="suave igual">${formatear(T.mismas, { escala: `${esc(bonito(igual.tonica))} ${esc(nombreEscala(igual.escala.nombre))}` })}</div>` : ''}
          <div class="acciones">
            <button type="button" class="boton pequeno" data-tocar="${i}">${T.oir}</button>
            <a href="${esc(`${diccionario}#grupo-${c.escala.grupo}`)}">${T.enDiccionario}</a>
          </div>
        </li>`;
      })
      .join('');
    mas.hidden = todas || resultados.length <= MOSTRAR;
    mas.textContent = formatear(T.verTodasN, { n: resultados.length });
    guardarJSON(CLAVE, { texto: entrada.value, soloRaiz: soloRaiz.checked });
  }

  entrada.addEventListener('input', () => {
    todas = false;
    pintar();
  });
  soloRaiz.addEventListener('change', pintar);
  mas.addEventListener('click', () => {
    todas = true;
    pintar();
  });
  document.addEventListener('click', (e) => {
    const el = e.target as Element;
    const ej = el.closest<HTMLButtonElement>('[data-ejemplo]');
    if (ej) {
      entrada.value = ej.dataset.ejemplo!;
      todas = false;
      return pintar();
    }
    const t = el.closest<HTMLButtonElement>('[data-tocar]');
    if (t) {
      const c = resultados[Number(t.dataset.tocar)];
      void tocar(secuenciaEscala(c.tonica, c.escala.formula, 'ascendente', tempo()), undefined, instrumento());
    }
  });

  pintar();
</script>

<style>
  .intro {
    max-width: var(--ancho-texto);
  }
  .entrada {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    max-width: 40rem;
    margin-bottom: 0.5rem;
  }
  .entrada .campo {
    font-weight: 700;
  }
  .entrada input {
    flex: 1 1 14rem;
    min-width: 0;
    margin: 0;
    font-size: 1.15rem;
  }
  .ejemplos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }
  .pequeno,
  .resultados :global(.pequeno) {
    padding: 0.2rem 0.6rem;
    font-size: 0.85rem;
  }
  .casilla {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
  }
  .leido {
    max-width: 44rem;
  }
  .controles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin: 0 0 0.75rem;
  }
  .controles :global(.tempo) {
    margin: 0;
  }
  .resultados {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }
  .resultados :global(.escala) {
    display: grid;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  /* COLOR: escalas que empiezan en la raíz del acorde */
  .resultados :global(.escala.en-raiz) {
    border-left: 0.3rem solid var(--acento);
  }
  .resultados :global(.cabeza) {
    display: grid;
    gap: 0.1rem;
  }
  .resultados :global(.titulo) {
    font-size: 1.1rem;
  }
  .resultados :global(.cabeza .suave),
  .resultados :global(.igual) {
    font-size: 0.85rem;
  }
  .resultados :global(.notas) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .resultados :global(.nota) {
    min-width: 2.1rem;
    padding: 0.05rem 0.4rem;
    text-align: center;
    font-weight: 700;
    color: var(--texto-suave);
    background: var(--fondo);
    border: 1px dashed var(--texto-suave);
    border-radius: var(--radio);
  }
  /* COLOR: notas que estaban en lo escrito */
  .resultados :global(.nota.dada) {
    color: var(--sobre-acento);
    background: var(--acento);
    border: 1px solid var(--acento);
  }
  .resultados :global(.acciones) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
  }
</style>
