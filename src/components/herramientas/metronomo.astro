---
// Metrónomo (sección Herramientas): tempo con botones, deslizador y tap tempo; compás
// de 1 a 12 pulsos con el acento de cada uno (se cambia pulsándolo), subdivisiones con
// swing, subida progresiva y compases en silencio (lib/metronomo.ts). Suena compás a
// compás en bucle, así los cambios se oyen en el compás siguiente. Textos en
// i18n/metronomo.ts; lo usan pages/herramientas/metronomo.astro y pages/en/tools/metronome.astro.
import Base from '../../layouts/Base.astro';
import { BPM_MAX, BPM_MIN, PULSOS_MAX, SUBDIVISIONES } from '../../lib/metronomo.ts';
import { formatear, type Idioma } from '../../i18n/idiomas.ts';
import { METRONOMO } from '../../i18n/metronomo.ts';

interface Props {
  idioma: Idioma;
}
const T = METRONOMO[Astro.props.idioma];
---

<Base titulo={T.titulo}>
  <div class="centrada">
    <section class="metronomo" aria-label={T.titulo}>
      <div class="tempo-grande">
        <button type="button" class="boton" data-sumar="-5" aria-label={formatear(T.bajar, { n: 5 })}>−5</button>
        <button type="button" class="boton" data-sumar="-1" aria-label={formatear(T.bajar, { n: 1 })}>−1</button>
        <div class="cifra-tempo">
          <strong data-bpm-texto>100</strong>
          <span>BPM</span>
        </div>
        <button type="button" class="boton" data-sumar="1" aria-label={formatear(T.subir, { n: 1 })}>+1</button>
        <button type="button" class="boton" data-sumar="5" aria-label={formatear(T.subir, { n: 5 })}>+5</button>
      </div>
      <input class="deslizador" type="range" min={BPM_MIN} max={BPM_MAX} step="1" value="100" aria-label={T.tempo} data-bpm />

      <div class="pulsos" data-pulsos aria-label={T.pulsosAyuda}></div>
      <p class="leyenda suave">{T.leyenda} <span class="muestra fuerte"></span> {T.acento} · <span class="muestra debil"></span> {T.normal} · <span class="muestra mudo"></span> {T.enSilencio}</p>

      <div class="botones-audio principal">
        <button type="button" data-audio="metronomo" aria-pressed="false">{T.empezar}</button>
        <button type="button" data-detener>{T.parar}</button>
        <button type="button" class="boton" data-tap title={T.tapAyuda}>{T.tap}</button>
        <span class="estado" data-estado aria-live="polite"></span>
      </div>

      <div class="ajustes">
        <fieldset>
          <legend>{T.compas}</legend>
          <label class="campo">{T.pulsos}
            <select data-num-pulsos>{Array.from({ length: PULSOS_MAX }, (_, i) => <option value={i + 1}>{i + 1}</option>)}</select>
          </label>
          <div class="grupo-botones" role="group" aria-label={T.subdivision}>
            {SUBDIVISIONES.map((s, i) => <button type="button" class="boton" data-subdivision={s.id} aria-pressed="false">{T.subdivisiones[i]}</button>)}
          </div>
          <label class="campo" data-solo-corcheas>Swing <input type="range" min="50" max="75" step="1" data-swing /> <span data-swing-texto></span></label>
          <div class="grupo-botones" role="group" aria-label={T.acentosRapidos}>
            <span class="etiqueta">{T.acentos}</span>
            <button type="button" class="boton" data-patron="uno">{T.enUno}</button>
            <button type="button" class="boton" data-patron="dos-cuatro">{T.dosCuatro}</button>
            <button type="button" class="boton" data-patron="iguales">{T.iguales}</button>
          </div>
        </fieldset>

        <fieldset>
          <legend><label><input type="checkbox" data-subida-activa /> {T.subida}</label></legend>
          <p class="frase">
            {T.subida1} <input type="number" min="1" max="40" data-subida="paso" aria-label={T.subidaPaso} /> {T.subida2}
            <input type="number" min="1" max="64" data-subida="cada" aria-label={T.subidaCada} /> {T.subida3}
            <input type="number" min={BPM_MIN} max={BPM_MAX} data-subida="hasta" aria-label={T.subidaHasta} /> {T.subida4}
          </p>
        </fieldset>

        <fieldset>
          <legend><label><input type="checkbox" data-silencio-activo /> {T.silencio}</label></legend>
          <p class="frase">
            {T.silencio1} <input type="number" min="1" max="16" data-silencio="suenan" aria-label={T.silencioSuenan} /> {T.silencio2}
            <input type="number" min="1" max="16" data-silencio="callan" aria-label={T.silencioCallan} /> {T.silencio3}
          </p>
        </fieldset>
      </div>
    </section>
  </div>
</Base>

<script>
  import { guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { conectarAudio, type Reproduccion } from '../../lib/cliente.ts';
  import {
    acentosIniciales,
    bpmDeToques,
    cambiarPulsos,
    compasEnSilencio,
    eventosCompas,
    limitarBpm,
    opcionesValidas,
    pulsoEn,
    siguienteAcento,
    tempoEnCompas,
    type Acento,
    type Subdivision,
  } from '../../lib/metronomo.ts';

  import { formatear, idiomaValido } from '../../i18n/idiomas.ts';
  import { METRONOMO } from '../../i18n/metronomo.ts';

  const T = METRONOMO[idiomaValido(document.documentElement.lang)];
  const CLAVE = 'herramientas:metronomo';
  const op = opcionesValidas(leerJSON(CLAVE));
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const deslizador = $<HTMLInputElement>('[data-bpm]');
  const bpmTexto = $('[data-bpm-texto]');
  const cajaPulsos = $('[data-pulsos]');
  const estado = $('[data-estado]');
  const selPulsos = $<HTMLSelectElement>('[data-num-pulsos]');
  const swing = $<HTMLInputElement>('[data-swing]');
  const empezar = $<HTMLButtonElement>('[data-audio="metronomo"]');

  let sonando = false;
  let pulsoActual = -1;
  let callado = false;

  const NOMBRES: Record<Acento, string> = { fuerte: T.acento, debil: T.normal, mudo: T.enSilencio };

  function pintarPulsos() {
    cajaPulsos.innerHTML = op.acentos
      .map(
        (a, i) =>
          `<button type="button" class="pulso ${a}${i === pulsoActual ? ' activo' : ''}${callado ? ' callado' : ''}" data-pulso="${i}" aria-label="${formatear(T.pulso, { n: i + 1, acento: NOMBRES[a] })}">${i + 1}</button>`,
      )
      .join('');
  }

  function pintar() {
    deslizador.value = String(op.bpm);
    bpmTexto.textContent = String(op.bpm);
    selPulsos.value = String(op.acentos.length);
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-subdivision]')) b.setAttribute('aria-pressed', String(Number(b.dataset.subdivision) === op.subdivision));
    swing.value = String(op.swing);
    $('[data-swing-texto]').textContent = op.swing === 50 ? T.recto : `${op.swing} %`;
    $('[data-solo-corcheas]').hidden = op.subdivision !== 2;
    $<HTMLInputElement>('[data-subida-activa]').checked = op.subida.activa;
    $<HTMLInputElement>('[data-silencio-activo]').checked = op.silencio.activo;
    for (const i of document.querySelectorAll<HTMLInputElement>('[data-subida]')) i.value = String(op.subida[i.dataset.subida as 'paso' | 'cada' | 'hasta']);
    for (const i of document.querySelectorAll<HTMLInputElement>('[data-silencio]')) i.value = String(op.silencio[i.dataset.silencio as 'suenan' | 'callan']);
    pintarPulsos();
    guardarJSON(CLAVE, op);
  }

  const ponerBpm = (bpm: number) => {
    op.bpm = limitarBpm(bpm);
    pintar();
  };

  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-sumar]')) b.addEventListener('click', () => ponerBpm(op.bpm + Number(b.dataset.sumar)));
  deslizador.addEventListener('input', () => ponerBpm(Number(deslizador.value)));
  selPulsos.addEventListener('change', () => {
    op.acentos = cambiarPulsos(op.acentos, Number(selPulsos.value));
    pintar();
  });
  swing.addEventListener('input', () => {
    op.swing = Number(swing.value);
    pintar();
  });
  cajaPulsos.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-pulso]');
    if (!b) return;
    const i = Number(b.dataset.pulso);
    op.acentos[i] = siguienteAcento(op.acentos[i]);
    pintar();
  });
  document.addEventListener('click', (e) => {
    const el = e.target as Element;
    const s = el.closest<HTMLButtonElement>('[data-subdivision]');
    if (s) {
      op.subdivision = Number(s.dataset.subdivision) as Subdivision;
      return pintar();
    }
    const p = el.closest<HTMLButtonElement>('[data-patron]');
    if (p) {
      const n = op.acentos.length;
      op.acentos =
        p.dataset.patron === 'uno'
          ? acentosIniciales(n)
          : p.dataset.patron === 'dos-cuatro'
            ? Array.from({ length: n }, (_, i) => (i % 2 === 1 ? 'fuerte' : 'debil'))
            : Array.from({ length: n }, () => 'debil');
      pintar();
    }
  });
  $<HTMLInputElement>('[data-subida-activa]').addEventListener('change', (e) => {
    op.subida.activa = (e.target as HTMLInputElement).checked;
    pintar();
  });
  $<HTMLInputElement>('[data-silencio-activo]').addEventListener('change', (e) => {
    op.silencio.activo = (e.target as HTMLInputElement).checked;
    pintar();
  });
  // Los números se aplican al salir del campo (o con Intro), ya saneados.
  for (const i of document.querySelectorAll<HTMLInputElement>('[data-subida], [data-silencio]')) {
    i.addEventListener('change', () => {
      const valor = Number(i.value);
      if (i.dataset.subida) Object.assign(op.subida, { [i.dataset.subida]: valor });
      else Object.assign(op.silencio, { [i.dataset.silencio!]: valor });
      Object.assign(op, opcionesValidas(op));
      pintar();
    });
  }

  // Tap tempo: con el botón o la tecla T.
  let toques: number[] = [];
  const tap = () => {
    const ahora = performance.now();
    toques = [...toques.filter((t) => ahora - t < 6000), ahora];
    const bpm = bpmDeToques(toques);
    if (bpm) ponerBpm(bpm);
  };
  $('[data-tap]').addEventListener('click', tap);
  const escribiendo = (e: KeyboardEvent) => (e.target as Element).closest('input, select, textarea');
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey || escribiendo(e)) return;
    if (e.key === 't' || e.key === 'T') tap();
    // Espacio: empezar o parar (salvo sobre un botón, que ya lo pulsa).
    if (e.key === ' ' && !(e.target as Element).closest('button')) {
      e.preventDefault();
      (sonando ? $<HTMLButtonElement>('[data-detener]') : empezar).click();
    }
  });

  conectarAudio(() => {
    let compas = 0;
    sonando = true;
    const r: Reproduccion = { eventos: [], instrumento: 'piano', bucle: () => true, duracion: 1 };
    const preparar = () => {
      const bpm = tempoEnCompas(op, compas);
      const mudo = compasEnSilencio(op, compas);
      const { eventos, duracion, pulsos } = eventosCompas(op, bpm, mudo);
      const numero = compas + 1;
      Object.assign(r, {
        eventos,
        duracion,
        alProgresar: (s: number) => {
          const p = pulsoEn(pulsos, s);
          if (p === pulsoActual && callado === mudo) return;
          pulsoActual = p;
          callado = mudo;
          pintarPulsos();
          estado.textContent = formatear(T.estado, { n: numero, bpm }) + (mudo ? T.estadoSilencio : '');
        },
      });
      compas++;
    };
    preparar();
    r.otraVuelta = preparar;
    r.alTerminar = () => {
      sonando = false;
      pulsoActual = -1;
      callado = false;
      estado.textContent = '';
      pintarPulsos();
    };
    return r;
  });

  pintar();
</script>

<style>
  /* Toda la herramienta en una columna centrada en la página. */
  .centrada {
    max-width: 44rem;
    margin: 0 auto;
  }
  .metronomo {
    max-width: 44rem;
  }
  .tempo-grande {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
  }
  .tempo-grande .boton {
    min-width: 3rem;
  }
  .cifra-tempo {
    display: grid;
    justify-items: center;
    min-width: 7rem;
  }
  .cifra-tempo strong {
    font-size: 3.5rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .cifra-tempo span {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .deslizador {
    width: 100%;
    margin: 0 0 1.25rem;
  }
  .pulsos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .pulsos :global(.pulso) {
    width: 3rem;
    height: 3rem;
    font: inherit;
    font-weight: 800;
    color: var(--texto);
    background: var(--superficie);
    border: 2px solid var(--texto-suave);
    border-radius: 50%;
    cursor: pointer;
    transition: transform 0.05s;
  }
  /* COLOR: pulso con acento */
  .pulsos :global(.pulso.fuerte) {
    border-color: var(--acento);
    border-width: 4px;
  }
  .pulsos :global(.pulso.mudo) {
    color: var(--texto-suave);
    border-style: dashed;
    opacity: 0.6;
  }
  /* COLOR: pulso que suena */
  .pulsos :global(.pulso.activo) {
    color: var(--sobre-acento);
    background: var(--acento);
    transform: scale(1.1);
  }
  .pulsos :global(.pulso.activo.callado) {
    color: var(--texto);
    background: var(--acento-suave);
  }
  .leyenda {
    margin: 0.6rem 0 1rem;
    text-align: center;
    font-size: 0.85rem;
  }
  .muestra {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    vertical-align: -0.1rem;
    border-radius: 50%;
    border: 2px solid var(--texto-suave);
  }
  .muestra.fuerte {
    border: 3px solid var(--acento);
  }
  .muestra.mudo {
    border-style: dashed;
  }
  .principal {
    align-items: center;
    justify-content: center;
  }
  .estado {
    flex-basis: 100%;
    min-height: 1.4em;
    text-align: center;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .ajustes {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  fieldset {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.25rem;
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  legend {
    padding: 0 0.3rem;
    font-weight: 700;
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }
  .campo select {
    width: auto;
    margin: 0;
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .grupo-botones .etiqueta {
    margin-right: 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .frase {
    margin: 0;
    line-height: 2.2;
  }
  .frase input {
    width: 4.2rem;
    margin: 0 0.2rem;
    display: inline-block;
  }
</style>
