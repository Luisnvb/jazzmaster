---
import { TONICAS } from '../lib/teoria.ts';

interface Props {
  /** Clave con la que se recuerda la elección (una por sección). */
  clave: string;
  etiqueta?: string;
}

const { clave, etiqueta = 'Tónica' } = Astro.props;
// Controles extra de la página (arpegio, sonido…) que van en la misma barra fija.
const conExtra = Astro.slots.has('default');
const inicial = 'C';
---

<div class="selector" data-selector-tonica data-clave={clave} role="group" aria-label={etiqueta}>
  <span class="etiqueta">{etiqueta}</span>
  <div class="botones">
    {
      TONICAS.map((t) => (
        <button type="button" data-tonica={t} aria-pressed={t === inicial ? 'true' : 'false'}>
          {t}
        </button>
      ))
    }
  </div>
  {
    conExtra && (
      <div class="extra">
        <slot />
      </div>
    )
  }
</div>

<style>
  .selector {
    position: sticky;
    top: var(--cabecera-alto);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0 calc(-1 * var(--margen)) 1.25rem;
    padding: 0.75rem var(--margen);
    background: color-mix(in srgb, var(--fondo) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--borde);
  }
  .etiqueta {
    font-family: var(--fuente);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--texto-suave);
    white-space: nowrap;
  }
  .extra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-left: auto;
  }
  .extra :global(label:not(.casilla)) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }
  .extra :global(select) {
    width: auto;
    min-width: 9rem;
    min-height: 2.2rem;
    margin: 0;
  }
  .botones {
    flex: 0 1 auto;
    display: grid;
    grid-template-columns: repeat(13, minmax(2.6rem, 3.6rem));
    gap: 0.35rem;
  }
  button {
    min-height: 2.4rem;
    font-family: var(--fuente);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--texto);
    background: transparent;
    border: 1px solid var(--borde);
    border-radius: 999px;
    cursor: pointer;
    padding: 0;
  }
  button:hover {
    border-color: var(--acento);
  }
  button[aria-pressed='true'] {
    background: var(--acento);
    border-color: var(--acento);
    color: var(--sobre-acento);
  }
  @media (max-width: 60rem) {
    .selector {
      display: block;
    }
    .etiqueta {
      display: block;
      margin-bottom: 0.4rem;
    }
    .botones {
      grid-template-columns: repeat(7, 1fr);
    }
  }
</style>
