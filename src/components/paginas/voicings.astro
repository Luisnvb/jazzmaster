---
// Lista de voicings (los de src/data/acordes.yaml, con edición en el navegador). La usan
// dos páginas: Voicings (/acordes/), sin los de cuerdas al aire, y Cuerdas al aire
// (/acordes/al-aire/), solo con ellos. Comparten cambios, orden y favoritos. En inglés,
// /en/chords/ y /en/chords/open-strings/ (textos en i18n/voicings.ts; nombres y notas
// de cada voicing en su campo `en` de acordes.yaml).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../SelectorTonica.astro';
import Tempo from '../Tempo.astro';
import { porOrden } from '../../lib/orden.ts';
import { TONICAS } from '../../lib/teoria.ts';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import type { Idioma } from '../../i18n/idiomas.ts';
import { INTERFAZ, nombreSonido } from '../../i18n/interfaz.ts';
import { VOICINGS } from '../../i18n/voicings.ts';

interface Props {
  /** true: solo los voicings con cuerdas al aire; false: solo los que no las tienen. */
  alAire: boolean;
  idioma: Idioma;
}
const { alAire, idioma } = Astro.props;
const T = VOICINGS[idioma];
const I = INTERFAZ[idioma];
const ingles = idioma === 'en';

const grupos = porOrden(await getCollection('grupos')).map(({ id, data }) => ({
  id,
  nombre: (ingles && data.en?.nombre) || data.nombre,
  simbolo: data.simbolo,
  arpegio: data.arpegio,
}));
const voicings = porOrden(await getCollection('acordes')).map(({ id, data }) => ({
  id,
  grupo: data.grupo.id,
  nombre: data.nombre,
  tonica: data.tonica,
  trastes: data.trastes,
  grados: data.grados,
  ...(data.dedos ? { dedos: data.dedos } : {}),
  ...(data.notas ? { notas: data.notas } : {}),
  ...(data.en ? { en: data.en } : {}),
}));
// JSON dentro de <script>: se escapa "<" para que ningún texto pueda cerrar la etiqueta.
const datos = JSON.stringify({ grupos, voicings }).replace(/</g, '\\u003c');
---

<Base titulo={alAire ? T.tituloAlAire : T.titulo}>
  {alAire && <p class="intro suave">{T.introAlAire}</p>}
  <SelectorTonica clave="acordes" conTonica={!alAire} idioma={idioma}>
    {
      alAire && (
        <label>{T.nota}
          <select data-filtro-nota>
            <option value="">{T.todas}</option>
            {TONICAS.map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>
      )
    }
    <label>{T.arpegio}
      <select data-filtro-arpegio>
        <option value="">{I.todos}</option>
        {grupos.map((g) => <option value={g.id}>{g.nombre}</option>)}
      </select>
    </label>
    <label>{I.sonido}
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{nombreSonido(i, idioma)}</option>)}</select>
    </label>
    <Tempo clave="acordes" />
  </SelectorTonica>

  <div class="barra-edicion">
    <button type="button" class="boton" data-modo-edicion aria-pressed="false">{T.editar}</button>
    <span class="suave aviso-local" data-aviso-local hidden>{T.avisoLocal}</span>
  </div>
  <div class="herramientas" data-herramientas hidden>
    <button type="button" class="boton principal" data-nuevo>{T.nuevo}</button>
    <button type="button" class="boton" data-exportar>{T.exportar}</button>
    <button type="button" class="boton" data-importar>{T.importar}</button>
    <button type="button" class="boton peligro" data-restaurar>{T.descartar}</button>
    <p class="suave ayuda" set:html={T.ayudaEdicion} />
  </div>

  <div data-lista></div>

  <dialog class="dialogo" data-dialogo>
    <form method="dialog" data-formulario>
      <h2 data-dialogo-titulo>{T.voicing}</h2>
      <div class="campos">
        <label>{T.tipo}
          <select name="grupo">{grupos.map((g) => <option value={g.id}>{g.nombre}</option>)}</select>
        </label>
        <label>{T.nombre} <input name="nombre" required placeholder={T.nombreEjemplo} /></label>
        <label>{T.tonicaTrastes}
          <select name="tonica">{TONICAS.map((t) => <option value={t}>{t}</option>)}</select>
        </label>
      </div>
      <div data-editor-trastes></div>
      <label class="bloque">{T.notas} <textarea name="notas" rows="2"></textarea></label>
      <p class="suave nota-pagina">{T.notaPagina}</p>
      <ul class="errores" data-errores></ul>
      <div class="acciones">
        <button type="button" class="boton" data-cancelar>{T.cancelar}</button>
        <button type="submit" class="boton principal" value="guardar">{T.guardar}</button>
      </div>
    </form>
  </dialog>

  <script type="application/json" id="datos-acordes" data-al-aire={String(alAire)} set:html={datos} />
</Base>

<script>
  import { aplicarCambios, aVoicing, limpiarEn, moverEnGrupo, ordenarPorIds, erroresVoicing, gradosSugeridos, nuevoIdVoicing, voicingsAYaml, type Cambios, type Voicing } from '../../lib/acordes-datos.ts';
  import { formatear, idiomaValido } from '../../i18n/idiomas.ts';
  import { INTERFAZ } from '../../i18n/interfaz.ts';
  import { VOICINGS } from '../../i18n/voicings.ts';
  import { borrar, descargar, elegirArchivo, esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { conectarAudio, conectarFiltroArpegio, conectarInstrumento, conectarTempo, conectarTonica } from '../../lib/cliente.ts';
  import { diagramaSVG } from '../../lib/diagrama.ts';
  import { botonFavorito, favoritos, favoritosPrimero } from '../../lib/favoritos.ts';
  import { editorTrastes, type EditorTrastes } from '../../lib/editor-trastes.ts';
  import { secuenciaVoicing, secuenciaVoicingContinua, type ModoVoicing } from '../../lib/secuencias.ts';
  import { SOSTENIDOS } from '../../lib/audio.ts';
  import { notaDeGrado, formatNota, parseNota, pitchClass } from '../../lib/teoria.ts';
  import { transportar, type Traste } from '../../lib/voicings.ts';

  interface Grupo {
    id: string;
    nombre: string;
    simbolo: string;
    arpegio: string[];
  }

  const idioma = idiomaValido(document.documentElement.lang);
  const ingles = idioma === 'en';
  const T = VOICINGS[idioma];
  const I = INTERFAZ[idioma];
  /** Nombre y notas del voicing en el idioma de la página (el inglés, si lo tiene). */
  const nombreDe = (v: Voicing) => (ingles && v.en?.nombre) || v.nombre;
  const notasDe = (v: Voicing) => (ingles && v.en?.notas) || v.notas;
  const CLAVE = 'acordes:cambios';
  // Orden elegido en la web (ids de todos los voicings); vacío = el del repositorio.
  const CLAVE_ORDEN = 'acordes:orden';
  const elDatos = document.getElementById('datos-acordes')!;
  const { grupos, voicings: base }: { grupos: Grupo[]; voicings: Voicing[] } = JSON.parse(elDatos.textContent!);
  /** Página de Cuerdas al aire (solo esos voicings) o de Voicings (todos los demás). */
  const paginaAlAire = elDatos.dataset.alAire === 'true';
  const grupoPorId = Object.fromEntries(grupos.map((g) => [g.id, g]));

  let cambios: Cambios = leerJSON<Cambios>(CLAVE) ?? {};
  let orden: string[] = leerJSON<string[]>(CLAVE_ORDEN) ?? [];
  let lista = ordenarPorIds(aplicarCambios(base, cambios), orden);
  let tonicaActual = 'C';
  let editando = false;
  /** Grupo elegido en el selector de arpegio ('' = todos). */
  let filtro = '';
  const tempo = conectarTempo();
  const favs = favoritos('acordes');
  // Cuerda de la tónica elegida en cada grupo (grupo → '6'…'1', 'sin'; sin entrada = todas).
  const CLAVE_CUERDA = 'acordes:cuerda-tonica';
  const cuerdaElegida: Record<string, string> = leerJSON<Record<string, string>>(CLAVE_CUERDA) ?? {};

  const contenedor = document.querySelector<HTMLElement>('[data-lista]')!;
  const avisoLocal = document.querySelector<HTMLElement>('[data-aviso-local]')!;
  const herramientas = document.querySelector<HTMLElement>('[data-herramientas]')!;
  const botonEdicion = document.querySelector<HTMLButtonElement>('[data-modo-edicion]')!;

  const conAlAire = (v: Voicing) => v.trastes.includes(0);
  /** Los voicings que salen en esta página. */
  const deEstaPagina = (v: Voicing) => conAlAire(v) === paginaAlAire;
  /** Sonido (0–11) de una nota escrita, o null si no se entiende. */
  const sonido = (nota: string) => {
    try {
      return pitchClass(parseNota(nota));
    } catch {
      return null;
    }
  };
  // Cuerdas al aire: filtro por la tónica del voicing (no transporta). '' = todas.
  const CLAVE_NOTA = 'acordes:al-aire:nota';
  const selectorNota = document.querySelector<HTMLSelectElement>('[data-filtro-nota]');
  let filtroNota = paginaAlAire ? (leerJSON<string>(CLAVE_NOTA) ?? '') : '';
  if (selectorNota) {
    if (![...selectorNota.options].some((o) => o.value === filtroNota)) filtroNota = '';
    selectorNota.value = filtroNota;
    selectorNota.addEventListener('change', () => {
      filtroNota = selectorNota.value;
      if (filtroNota) guardarJSON(CLAVE_NOTA, filtroNota);
      else borrar(CLAVE_NOTA);
      pintar();
    });
  }
  /** Si el voicing pasa el filtro de nota (enarmónicos incluidos: Gb cuenta como F#). */
  const pasaNota = (v: Voicing) => editando || !filtroNota || sonido(v.tonica) === sonido(filtroNota);
  /** Cuerda de la tónica más grave ('6'…'1'), o 'sin' si el voicing no la lleva. */
  const cuerdaTonica = (v: Voicing) => {
    const c = v.grados.findIndex((g, i) => g === '1' && v.trastes[i] !== 'x');
    return c === -1 ? 'sin' : String(6 - c);
  };
  const ordinal = (c: string) => (ingles ? `${c}${['', 'st', 'nd', 'rd'][Number(c)] ?? 'th'}` : `${c}ª`);
  const nombreCuerda = (c: string) => (c === 'sin' ? T.sinTonica : formatear(T.tonicaEn, { cuerda: ordinal(c) }));
  /** Trastes del voicing en la tónica elegida (los que tienen cuerdas al aire no se mueven). */
  const trastesEn = (v: Voicing): Traste[] => (conAlAire(v) ? v.trastes : transportar(v.trastes, v.tonica, tonicaActual));
  const tonicaDe = (v: Voicing) => (conAlAire(v) ? v.tonica : tonicaActual);

  /** Notas que solo dicen de dónde sale el voicing ("De: …"): no se muestran en la ficha. */
  const esProcedencia = (notas: string) => /^(De|From):/.test(notas.trim());

  /**
   * Nombre con la tónica delante (Cuerdas al aire, donde no se transporta): pegada si el
   * nombre es un cifrado ("maj7" → "Emaj7", "m9/G" → "Em9/G"); si no, separada ("E · Drop 2").
   */
  const conTonica = (tonica: string, nombre: string) =>
    /^(maj|m|add|sus|dim|aug|alt|[0-9b#+°ø/])/.test(nombre) && !/\s/.test(nombre) ? `${tonica}${nombre}` : `${tonica} · ${nombre}`;

  function tarjeta(v: Voicing): string {
    const t = tonicaDe(v);
    const tocados = v.grados.filter(Boolean);
    const hermanos = lista.filter((x) => x.grupo === v.grupo && deEstaPagina(x));
    const posicion = hermanos.indexOf(v);
    const notas = tocados.map((g) => formatNota(notaDeGrado(t, g))).join(' ');
    const nombre = nombreDe(v);
    const comentario = notasDe(v);
    return `
      <li class="tarjeta voicing" data-id="${esc(v.id)}">
        <div class="diagrama-caja">${diagramaSVG({ trastes: trastesEn(v), grados: v.grados })}</div>
        ${editando ? '' : botonFavorito(favs.tiene(v.id), nombre, idioma)}
        <div class="info">
          <h3>${esc(paginaAlAire ? conTonica(t, nombre) : nombre)}</h3>
          <dl class="detalle">
            <dt>${T.grados}</dt><dd>${esc(tocados.join(' '))}</dd>
            <dt>${T.notasVoicing}</dt><dd>${esc(notas)}</dd>
          </dl>
          ${comentario && !esProcedencia(comentario) ? `<p class="comentario">${esc(comentario)}</p>` : ''}
        </div>
        <div class="botones-audio">
          <button type="button" data-audio="rasgueo" aria-pressed="false">${T.rasgueo}</button>
          <button type="button" data-audio="arpegiado" aria-pressed="false">${T.arpegiado}</button>
          <button type="button" data-audio="continuo" aria-pressed="false" title="${T.continuoAyuda}">${T.continuo}</button>
          <button type="button" data-detener>${I.detener}</button>
          ${editando ? '' : `<button type="button" class="eliminar" data-borrar>${I.eliminar}</button>`}
        </div>
        ${
          editando
            ? `<div class="botones-edicion">
                <button type="button" class="boton" data-editar>${T.editar}</button>
                <button type="button" class="boton" data-mover="-1" title="${T.moverAntes}" aria-label="${T.moverAntes}" ${posicion === 0 ? 'disabled' : ''}>◀</button>
                <button type="button" class="boton" data-mover="1" title="${T.moverDespues}" aria-label="${T.moverDespues}" ${posicion === hermanos.length - 1 ? 'disabled' : ''}>▶</button>
                <button type="button" class="boton" data-duplicar>${T.duplicar}</button>
                <button type="button" class="boton peligro" data-borrar>${T.borrar}</button>
              </div>`
            : ''
        }
      </li>`;
  }

  function pintar() {
    // Cuerdas al aire: en el selector de nota, cuántos voicings hay de cada una.
    if (selectorNota) {
      const delaPagina = lista.filter(deEstaPagina);
      for (const o of selectorNota.options) {
        if (!o.value) continue;
        const n = delaPagina.filter((v) => sonido(v.tonica) === sonido(o.value)).length;
        o.textContent = n ? `${o.value} (${n})` : o.value;
        o.disabled = n === 0 && o.value !== filtroNota;
      }
    }
    contenedor.innerHTML = grupos
      .filter((g) => !filtro || g.id === filtro)
      .map((g) => {
        const todos = lista.filter((v) => v.grupo === g.id && deEstaPagina(v) && pasaNota(v));
        if (todos.length === 0 && !editando) return '';
        // Selector de la cuerda de la tónica, con las que hay en el grupo (de grave a aguda).
        const cuerdas = [...new Set(todos.map(cuerdaTonica))].sort((a, b) => (a === 'sin' ? 1 : b === 'sin' ? -1 : Number(b) - Number(a)));
        const elegida = cuerdas.includes(cuerdaElegida[g.id]) ? cuerdaElegida[g.id] : '';
        // En edición se ven todos en su orden (para poder moverlos); si no, favoritos primero.
        const filtrados = todos.filter((v) => editando || !elegida || cuerdaTonica(v) === elegida);
        const vs = editando ? filtrados : favoritosPrimero(filtrados, (v) => favs.tiene(v.id));
        const selector =
          cuerdas.length > 1 && !editando
            ? `<label class="cuerda-tonica"><span class="visualmente-oculto">${T.cuerdaTonica}</span>
                <select data-cuerda-tonica="${g.id}">
                  <option value="">${T.todasCuerdas}</option>
                  ${cuerdas.map((c) => `<option value="${c}" ${c === elegida ? 'selected' : ''}>${nombreCuerda(c)}</option>`).join('')}
                </select></label>`
            : '';
        return `
          <section id="grupo-${g.id}">
            <div class="titulo-grupo"><h2>${esc(g.nombre)}</h2>${selector}</div>
            ${vs.length ? `<ul class="lista-tarjetas voicings">${vs.map(tarjeta).join('')}</ul>` : `<p class="suave">${T.sinVoicings}</p>`}
            ${editando ? `<button type="button" class="boton" data-nuevo="${g.id}">${formatear(T.nuevoDe, { grupo: esc(g.nombre) })}</button>` : ''}
          </section>`;
      })
      .join('');
    if (!contenedor.innerHTML.trim() && filtroNota) contenedor.innerHTML = `<p class="suave">${T.sinNota}</p>`;
    avisoLocal.hidden = Object.keys(cambios).length === 0 && orden.length === 0;
  }

  function guardar(nuevos: Cambios) {
    cambios = nuevos;
    if (Object.keys(cambios).length) guardarJSON(CLAVE, cambios);
    else borrar(CLAVE);
    lista = ordenarPorIds(aplicarCambios(base, cambios), orden);
    pintar();
  }

  const porId = (id: string) => lista.find((v) => v.id === id)!;

  // --- Diálogo de edición ---------------------------------------------------

  const dialogo = document.querySelector<HTMLDialogElement>('[data-dialogo]')!;
  const formulario = document.querySelector<HTMLFormElement>('[data-formulario]')!;
  const errores = document.querySelector<HTMLElement>('[data-errores]')!;
  const campo = (nombre: string) => formulario.elements.namedItem(nombre) as HTMLInputElement | HTMLSelectElement;
  let editor: EditorTrastes;
  let editandoId: string | null = null;

  function abrir(v: Voicing, id: string | null) {
    editandoId = id;
    document.querySelector('[data-dialogo-titulo]')!.textContent = id ? T.editarVoicing : T.nuevoVoicing;
    campo('grupo').value = v.grupo;
    // En inglés se editan el nombre y las notas ingleses (los españoles se conservan).
    campo('nombre').value = nombreDe(v);
    campo('tonica').value = v.tonica;
    campo('notas').value = (ingles ? v.en?.notas : v.notas) ?? '';
    errores.innerHTML = '';
    editor = editorTrastes(document.querySelector('[data-editor-trastes]')!, {
      trastes: v.trastes,
      grados: v.grados,
      gradosEditables: true,
      idioma,
      calcularGrados: (t) => gradosSugeridos(campo('tonica').value, t, grupoPorId[campo('grupo').value]?.arpegio ?? []),
    });
    dialogo.showModal();
  }

  campo('tonica').addEventListener('change', () => editor.recalcular());
  campo('grupo').addEventListener('change', () => editor.recalcular());
  document.querySelector('[data-cancelar]')!.addEventListener('click', () => dialogo.close());

  formulario.addEventListener('submit', (e) => {
    const { trastes, grados } = editor.valor();
    const anterior = editandoId ? porId(editandoId) : null;
    const nombre = campo('nombre').value.trim();
    const notas = campo('notas').value.trim();
    // En inglés, el nombre escrito es el inglés si cambia el español (o el de los dos si es nuevo).
    const nombreEs = ingles ? anterior?.nombre || nombre : nombre;
    const notasEs = ingles ? anterior?.notas : notas;
    const en = limpiarEn(ingles ? { nombre: nombre !== nombreEs ? nombre : '', notas } : anterior?.en);
    const v: Voicing = {
      id: editandoId ?? '',
      grupo: campo('grupo').value,
      nombre: nombreEs,
      tonica: campo('tonica').value,
      trastes,
      grados: grados.map((g, c) => (trastes[c] === 'x' ? '' : g)),
      ...(notasEs ? { notas: notasEs } : {}),
      ...(en ? { en } : {}),
    };
    if (anterior?.dedos) v.dedos = anterior.dedos;
    const lista_errores = erroresVoicing(v, grupos.map((g) => g.id), idioma);
    if (lista_errores.length) {
      e.preventDefault();
      errores.innerHTML = lista_errores.map((x) => `<li>${esc(x)}</li>`).join('');
      return;
    }
    if (!editandoId) v.id = nuevoIdVoicing(v, lista.map((x) => x.id).concat(base.map((x) => x.id)));
    guardar({ ...cambios, [v.id]: v });
  });

  // --- Botones ----------------------------------------------------------------

  botonEdicion.addEventListener('click', () => {
    editando = !editando;
    botonEdicion.setAttribute('aria-pressed', String(editando));
    botonEdicion.textContent = editando ? T.terminar : T.editar;
    herramientas.hidden = !editando;
    pintar();
  });

  // En Cuerdas al aire, el voicing nuevo empieza con la 5ª al aire (A) para que se quede en esta página.
  const vacio = (grupo: string): Voicing => ({
    id: '',
    grupo,
    nombre: '',
    tonica: paginaAlAire ? 'A' : 'C',
    trastes: ['x', paginaAlAire ? 0 : 3, 'x', 'x', 'x', 'x'],
    grados: ['', '1', '', '', '', ''],
  });

  document.addEventListener('click', async (e) => {
    const el = (e.target as Element).closest<HTMLElement>('button');
    if (!el) return;
    const id = el.closest<HTMLElement>('[data-id]')?.dataset.id;
    if (el.hasAttribute('data-favorito') && id) {
      favs.alternar(id);
      pintar();
      return;
    }
    if (el.dataset.nuevo !== undefined) abrir(vacio(el.dataset.nuevo || grupos[0].id), null);
    else if (el.hasAttribute('data-editar') && id) abrir(porId(id), id);
    else if (el.dataset.mover && id) {
      lista = moverEnGrupo(lista, id, Number(el.dataset.mover) as -1 | 1, deEstaPagina);
      orden = lista.map((v) => v.id);
      guardarJSON(CLAVE_ORDEN, orden);
      pintar();
    } else if (el.hasAttribute('data-duplicar') && id) {
      const original = porId(id);
      const copia = (n: string) => formatear(T.copia, { nombre: n });
      abrir({ ...original, nombre: copia(original.nombre), ...(original.en ? { en: { ...original.en, ...(original.en.nombre ? { nombre: copia(original.en.nombre) } : {}) } } : {}) }, null);
    }
    else if (el.hasAttribute('data-borrar') && id) {
      if (!confirm(formatear(T.confirmarBorrar, { nombre: nombreDe(porId(id)) }))) return;
      const nuevos = { ...cambios };
      if (base.some((v) => v.id === id)) nuevos[id] = null;
      else delete nuevos[id];
      guardar(nuevos);
    } else if (el.hasAttribute('data-exportar')) {
      descargar('acordes.yaml', voicingsAYaml(lista), 'text/yaml');
    } else if (el.hasAttribute('data-importar')) {
      const archivo = await elegirArchivo('.yaml,.yml,.json');
      if (!archivo) return;
      try {
        const { parse } = await import('yaml');
        const datos = parse(archivo.texto);
        if (!Array.isArray(datos)) throw new Error(T.listaArchivo);
        const importados = datos.map(aVoicing);
        const malos = importados.flatMap((v) => erroresVoicing(v, grupos.map((g) => g.id), idioma).map((x) => `${v.id}: ${x}`));
        if (malos.length) throw new Error(malos.slice(0, 5).join('\n'));
        if (!confirm(formatear(T.confirmarImportar, { n: importados.length }))) return;
        // Los del repositorio que no están en el archivo se marcan como borrados.
        const nuevos: Cambios = Object.fromEntries(base.map((v) => [v.id, null]));
        for (const v of importados) nuevos[v.id] = v;
        for (const v of base) {
          const igual = importados.find((x) => x.id === v.id);
          if (igual && JSON.stringify(igual) === JSON.stringify(v)) delete nuevos[v.id];
        }
        guardar(nuevos);
      } catch (error) {
        alert(formatear(T.noImportado, { error: (error as Error).message }));
      }
    } else if (el.hasAttribute('data-restaurar')) {
      if (confirm(T.confirmarDescartar)) {
        orden = [];
        borrar(CLAVE_ORDEN);
        guardar({});
      }
    }
  });

  const instrumento = conectarInstrumento('acordes:sonido');
  conectarAudio((boton) => {
    const v = porId(boton.closest<HTMLElement>('[data-id]')!.dataset.id!);
    if (boton.dataset.audio === 'continuo') {
      const { eventos, vuelta } = secuenciaVoicingContinua(trastesEn(v), tempo(), SOSTENIDOS.includes(instrumento()));
      return vuelta === null
        ? { eventos, instrumento: instrumento() }
        : { eventos, instrumento: instrumento(), bucle: () => true, duracion: vuelta };
    }
    return { eventos: secuenciaVoicing(trastesEn(v), boton.dataset.audio as ModoVoicing, tempo()), instrumento: instrumento() };
  });

  contenedor.addEventListener('change', (e) => {
    const sel = (e.target as Element).closest<HTMLSelectElement>('select[data-cuerda-tonica]');
    if (!sel) return;
    if (sel.value) cuerdaElegida[sel.dataset.cuerdaTonica!] = sel.value;
    else delete cuerdaElegida[sel.dataset.cuerdaTonica!];
    guardarJSON(CLAVE_CUERDA, cuerdaElegida);
    pintar();
  });

  conectarFiltroArpegio('arpegio:acordes', (grupo) => {
    filtro = grupo;
    pintar();
  });

  conectarTonica((tonica) => {
    tonicaActual = tonica;
    pintar();
  });
  pintar();
  // Los enlaces del repertorio llevan #grupo-…: la lista se pinta aquí, así que se busca a mano.
  if (location.hash) document.getElementById(location.hash.slice(1))?.scrollIntoView();
</script>

