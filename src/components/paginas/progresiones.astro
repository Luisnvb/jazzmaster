---
// Progresiones en grados (progresiones.yaml), en cualquier tono y con edición en el navegador.
// La usan pages/progresiones.astro y pages/en/progressions.astro (textos en
// i18n/progresiones.ts; nombre y descripción ingleses en el campo `en` de cada progresión).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../SelectorTonica.astro';
import Tempo from '../Tempo.astro';
import { porOrden } from '../../lib/orden.ts';
import { SUFIJOS } from '../../lib/progresiones.ts';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { formatear, type Idioma } from '../../i18n/idiomas.ts';
import { INTERFAZ, nombreSonido } from '../../i18n/interfaz.ts';
import { PROGRESIONES } from '../../i18n/progresiones.ts';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const T = PROGRESIONES[idioma];
const I = INTERFAZ[idioma];

const progresiones = porOrden(await getCollection('progresiones')).map(({ id, data }) => ({
  id,
  nombre: data.nombre,
  ...(data.descripcion ? { descripcion: data.descripcion } : {}),
  ...(data.en ? { en: data.en } : {}),
  ...(data.pulsos ? { pulsos: data.pulsos } : {}),
  compases: data.compases,
}));
// JSON dentro de <script>: se escapa "<" para que ningún texto pueda cerrar la etiqueta.
const datos = JSON.stringify(progresiones).replace(/</g, '\\u003c');
---

<Base titulo={T.titulo}>
  <SelectorTonica clave="progresiones" idioma={idioma}>
    <Tempo clave="progresiones" inicial={120} />
    <label>{I.sonido}
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{nombreSonido(i, idioma)}</option>)}</select>
    </label>
    <label class="casilla"><input type="checkbox" data-metronomo /> {T.metronomo}</label>
    <button type="button" class="boton" data-bucle aria-pressed="false" title={T.bucleAyuda}>{T.bucle}</button>
  </SelectorTonica>

  <div class="barra-edicion">
    <button type="button" class="boton" data-modo-edicion aria-pressed="false">{T.editar}</button>
    <button type="button" class="boton principal" data-nueva>{T.nueva}</button>
    <span class="suave aviso-local" data-aviso-local hidden>{T.avisoLocal}</span>
  </div>
  <div class="herramientas" data-herramientas hidden>
    <button type="button" class="boton" data-exportar>{T.exportar}</button>
    <button type="button" class="boton peligro" data-restaurar>{T.descartar}</button>
    <p class="suave ayuda" set:html={T.ayudaEdicion} />
  </div>

  <div class="lista-progresiones" data-lista></div>

  <dialog class="dialogo" data-dialogo>
    <form method="dialog" data-formulario>
      <h2 data-dialogo-titulo>{T.progresion}</h2>
      <div class="campos">
        <label>{T.nombre} <input name="nombre" required placeholder={T.nombreEjemplo} /></label>
        <label>{T.pulsos} <input name="pulsos" type="number" min="1" max="12" value="4" /></label>
      </div>
      <label class="bloque">{T.descripcion} <input name="descripcion" placeholder={T.opcional} /></label>
      <label class="bloque"
        >{T.compases}
        <textarea name="compases" rows="3" placeholder="IIm7 V7 | Imaj7 | VIm7 | IIm7 V7"></textarea>
      </label>
      <p class="suave ayuda">{formatear(T.ayudaCifrado, { sufijos: SUFIJOS.join(' · ') })}</p>
      <div class="vista-previa" data-vista-previa></div>
      <ul class="errores" data-errores></ul>
      <div class="acciones">
        <button type="button" class="boton" data-cancelar>{T.cancelar}</button>
        <button type="submit" class="boton principal" value="guardar">{T.guardar}</button>
      </div>
    </form>
  </dialog>

  <script type="application/json" id="datos-progresiones" set:html={datos} />
</Base>

<script>
  import { borrar, descargar, esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { formatear, idiomaValido } from '../../i18n/idiomas.ts';
  import { INTERFAZ } from '../../i18n/interfaz.ts';
  import { PROGRESIONES } from '../../i18n/progresiones.ts';
  import { INSTRUMENTOS, SOSTENIDOS, type Instrumento } from '../../lib/audio.ts';
  import { conectarAudio, conectarTempo, conectarTonica } from '../../lib/cliente.ts';
  import {
    analizarProgresion,
    aplicarCambiosProgresiones,
    compasesDeTexto,
    mensajeError,
    progresionesAYaml,
    secuenciaProgresion,
    simboloEn,
    textoDeCompases,
    type CambiosProgresiones,
    type Progresion,
  } from '../../lib/progresiones.ts';

  const idioma = idiomaValido(document.documentElement.lang);
  const ingles = idioma === 'en';
  const T = PROGRESIONES[idioma];
  const I = INTERFAZ[idioma];
  /** Nombre y descripción en el idioma de la página (los ingleses, si los tiene). */
  const nombreDe = (p: Progresion) => (ingles && p.en?.nombre) || p.nombre;
  const descripcionDe = (p: Progresion) => (ingles && p.en ? p.en.descripcion : p.descripcion);
  const CLAVE = 'progresiones:cambios';
  const base: Progresion[] = JSON.parse(document.getElementById('datos-progresiones')!.textContent!);

  let cambios: CambiosProgresiones = leerJSON<CambiosProgresiones>(CLAVE) ?? {};
  let lista = aplicarCambiosProgresiones(base, cambios);
  let tonicaActual = 'C';
  let editando = false;
  const tempo = conectarTempo();

  const contenedor = document.querySelector<HTMLElement>('[data-lista]')!;
  const avisoLocal = document.querySelector<HTMLElement>('[data-aviso-local]')!;
  const herramientas = document.querySelector<HTMLElement>('[data-herramientas]')!;
  const botonEdicion = document.querySelector<HTMLButtonElement>('[data-modo-edicion]')!;

  const porId = (id: string) => lista.find((p) => p.id === id)!;

  function htmlCompases(p: Progresion, tonica: string): string {
    const compases = analizarProgresion(p.compases);
    return `<div class="compases">${compases
      .map(
        (acordes, i) =>
          `<div class="compas" style="--n:${acordes.length}">${acordes
            .map(
              (a, j) =>
                `<span class="acorde" data-compas="${i}" data-acorde="${j}"><span class="simbolo">${esc(simboloEn(tonica, a))}</span><span class="grado">${esc(a.texto)}</span></span>`,
            )
            .join('')}</div>`,
      )
      .join('')}</div>`;
  }

  function tarjeta(p: Progresion): string {
    let cuerpo: string;
    try {
      cuerpo = htmlCompases(p, tonicaActual);
    } catch (error) {
      cuerpo = `<p class="errores">${esc(mensajeError(error, idioma))}</p>`;
    }
    const descripcion = descripcionDe(p);
    return `
      <article class="tarjeta progresion" data-id="${esc(p.id)}">
        <header>
          <h2>${esc(nombreDe(p))}</h2>
          ${descripcion ? `<p class="suave">${esc(descripcion)}</p>` : ''}
        </header>
        ${cuerpo}
        <div class="botones-audio">
          <button type="button" data-audio="progresion" aria-pressed="false">${T.tocar}</button>
          <button type="button" data-audio="continuo" aria-pressed="false" title="${T.continuoAyuda}">${T.continuo}</button>
          <button type="button" data-detener>${I.detener}</button>
          ${editando ? `<button type="button" data-editar>${T.editar}</button><button type="button" data-duplicar>${T.duplicar}</button>` : ''}
          <button type="button" class="eliminar" data-borrar>${I.eliminar}</button>
        </div>
      </article>`;
  }

  function pintar() {
    contenedor.innerHTML = lista.length ? lista.map(tarjeta).join('') : `<p class="suave">${T.sinProgresiones}</p>`;
    avisoLocal.hidden = Object.keys(cambios).length === 0;
    herramientas.hidden = !editando;
    botonEdicion.setAttribute('aria-pressed', String(editando));
  }

  function guardar(nuevos: CambiosProgresiones) {
    cambios = nuevos;
    if (Object.keys(cambios).length) guardarJSON(CLAVE, cambios);
    else borrar(CLAVE);
    lista = aplicarCambiosProgresiones(base, cambios);
    pintar();
  }

  // --- Diálogo de edición ---------------------------------------------------

  const dialogo = document.querySelector<HTMLDialogElement>('[data-dialogo]')!;
  const formulario = document.querySelector<HTMLFormElement>('[data-formulario]')!;
  const errores = document.querySelector<HTMLElement>('[data-errores]')!;
  const vistaPrevia = document.querySelector<HTMLElement>('[data-vista-previa]')!;
  const campo = (nombre: string) => formulario.elements.namedItem(nombre) as HTMLInputElement | HTMLTextAreaElement;
  let editandoId: string | null = null;

  function leerFormulario(): Progresion {
    const pulsos = Number(campo('pulsos').value) || 4;
    const descripcion = campo('descripcion').value.trim();
    return {
      id: editandoId ?? '',
      nombre: campo('nombre').value.trim(),
      ...(descripcion ? { descripcion } : {}),
      ...(pulsos !== 4 ? { pulsos } : {}),
      compases: compasesDeTexto(campo('compases').value),
    };
  }

  function comprobar(): string[] {
    const p = leerFormulario();
    const lista: string[] = [];
    if (!p.nombre) lista.push(T.faltaNombre);
    try {
      vistaPrevia.innerHTML = htmlCompases(p, tonicaActual);
    } catch (error) {
      // Mientras se escribe, el motivo sale en lugar de la vista previa (no desaparece sin más).
      vistaPrevia.innerHTML = `<p class="errores">${esc(mensajeError(error, idioma))}</p>`;
      lista.push(mensajeError(error, idioma));
    }
    return lista;
  }

  function abrir(p: Progresion, id: string | null) {
    editandoId = id;
    document.querySelector('[data-dialogo-titulo]')!.textContent = id ? T.editarProgresion : T.nuevaProgresion;
    // En inglés se editan el nombre y la descripción ingleses (los españoles se conservan).
    campo('nombre').value = nombreDe(p);
    campo('descripcion').value = descripcionDe(p) ?? '';
    campo('pulsos').value = String(p.pulsos ?? 4);
    campo('compases').value = textoDeCompases(p.compases);
    errores.innerHTML = '';
    comprobar();
    dialogo.showModal();
  }

  formulario.addEventListener('input', () => {
    comprobar();
    errores.innerHTML = '';
  });

  formulario.addEventListener('submit', (e) => {
    const lista = comprobar();
    if (lista.length) {
      e.preventDefault();
      errores.innerHTML = lista.map((m) => `<li>${esc(m)}</li>`).join('');
      return;
    }
    const p = leerFormulario();
    const id = editandoId ?? `local-${Date.now().toString(36)}`;
    const anterior = editandoId ? porId(editandoId) : undefined;
    if (ingles) {
      // En inglés, lo escrito es la versión inglesa; la española se conserva (o, si es nueva, es la misma).
      const en = { nombre: p.nombre, ...(p.descripcion ? { descripcion: p.descripcion } : {}) };
      const { descripcion: _, ...resto } = p;
      const descripcion = anterior ? anterior.descripcion : p.descripcion;
      guardar({ ...cambios, [id]: { ...resto, nombre: anterior?.nombre || p.nombre, ...(descripcion ? { descripcion } : {}), en, id } });
      return;
    }
    // En español, la versión inglesa no se edita: se conserva la que tuviera.
    const en = anterior?.en;
    guardar({ ...cambios, [id]: { ...p, ...(en ? { en } : {}), id } });
  });

  document.querySelector('[data-cancelar]')!.addEventListener('click', () => dialogo.close());

  // --- Botones ----------------------------------------------------------------

  document.addEventListener('click', (e) => {
    const el = (e.target as Element).closest<HTMLElement>('button');
    if (!el) return;
    const id = el.closest<HTMLElement>('[data-id]')?.dataset.id;
    if (el.hasAttribute('data-modo-edicion')) {
      editando = !editando;
      pintar();
    } else if (el.hasAttribute('data-nueva')) {
      abrir({ id: '', nombre: '', compases: [] }, null);
    } else if (el.hasAttribute('data-editar') && id) {
      abrir(porId(id), id);
    } else if (el.hasAttribute('data-duplicar') && id) {
      const original = porId(id);
      const copia = (n: string) => formatear(T.copia, { nombre: n });
      abrir({ ...original, nombre: copia(original.nombre), ...(original.en ? { en: { ...original.en, nombre: copia(original.en.nombre) } } : {}) }, null);
    } else if (el.hasAttribute('data-borrar') && id) {
      if (!confirm(formatear(T.confirmarBorrar, { nombre: nombreDe(porId(id)) }))) return;
      const nuevos = { ...cambios };
      if (base.some((p) => p.id === id)) nuevos[id] = null;
      else delete nuevos[id];
      guardar(nuevos);
    } else if (el.hasAttribute('data-exportar')) {
      descargar('progresiones.yaml', progresionesAYaml(lista), 'text/yaml');
    } else if (el.hasAttribute('data-restaurar')) {
      if (confirm(T.confirmarDescartar)) guardar({});
    }
  });

  // Sonido y metrónomo, recordados en este navegador; el bucle, solo en esta visita.
  const selInstrumento = document.querySelector<HTMLSelectElement>('[data-instrumento]')!;
  const casillaMetronomo = document.querySelector<HTMLInputElement>('[data-metronomo]')!;
  const botonBucle = document.querySelector<HTMLButtonElement>('[data-bucle]')!;
  const sonido = leerJSON<{ instrumento?: Instrumento; metronomo?: boolean }>('progresiones:sonido') ?? {};
  if (INSTRUMENTOS.some((i) => i.id === sonido.instrumento)) selInstrumento.value = sonido.instrumento!;
  casillaMetronomo.checked = sonido.metronomo === true;
  const guardarSonido = () =>
    guardarJSON('progresiones:sonido', { instrumento: selInstrumento.value, metronomo: casillaMetronomo.checked });
  selInstrumento.addEventListener('change', guardarSonido);
  casillaMetronomo.addEventListener('change', guardarSonido);
  const enBucle = () => botonBucle.getAttribute('aria-pressed') === 'true';
  botonBucle.addEventListener('click', () => botonBucle.setAttribute('aria-pressed', String(!enBucle())));

  conectarAudio((boton) => {
    const tarjetaEl = boton.closest<HTMLElement>('[data-id]')!;
    const p = porId(tarjetaEl.dataset.id!);
    const instrumento = selInstrumento.value as Instrumento;
    const { eventos, tramos, duracion } = secuenciaProgresion(tonicaActual, analizarProgresion(p.compases), tempo(), p.pulsos ?? 4, {
      metronomo: casillaMetronomo.checked,
      sostenido: SOSTENIDOS.includes(instrumento),
    });
    let marcado = -1;
    const marcar = (k: number) => {
      if (k === marcado) return;
      marcado = k;
      tarjetaEl.querySelector('.acorde.sonando-ahora')?.classList.remove('sonando-ahora');
      const t = tramos[k];
      if (t) tarjetaEl.querySelector(`.acorde[data-compas="${t.compas}"][data-acorde="${t.acorde}"]`)?.classList.add('sonando-ahora');
    };
    return {
      eventos,
      instrumento,
      bucle: boton.dataset.audio === 'continuo' ? () => true : enBucle,
      duracion,
      alProgresar: (s) => marcar(tramos.findIndex((t) => s >= t.inicio && s < t.fin)),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((tonica) => {
    tonicaActual = tonica;
    pintar();
  });
  pintar();
</script>

<style>
  .barra-edicion {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .herramientas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
  }
  .ayuda {
    flex-basis: 100%;
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
  }
  .aviso-local {
    font-size: 0.85rem;
  }
  .lista-progresiones {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 30rem), 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  :global(.progresion header h2) {
    margin: 0;
    font-size: 1.25rem;
  }
  :global(.progresion header p) {
    margin: 0.4rem 0 1rem;
  }
  /* La tarjeta es un contenedor: los compases se reparten según su ancho. */
  :global(.progresion) {
    container-type: inline-size;
  }
  :global(.compases) {
    --cols: 4;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    border-left: 2px solid var(--texto-suave);
  }
  /* Tarjeta estrecha (móvil): dos compases por línea para que no se pisen los acordes. */
  @container (max-width: 24rem) {
    :global(.compases) {
      --cols: 2;
    }
  }
  :global(.compases .compas) {
    display: flex;
    min-height: 3.75rem;
    border-right: 2px solid var(--texto-suave);
    border-bottom: 1px solid var(--borde);
  }
  :global(.compases .acorde) {
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.15rem;
    margin: 0.15rem;
    padding: 0.35rem 0.1rem;
    border-radius: var(--radio);
    text-align: center;
  }
  /* El cifrado encoge con el espacio de cada acorde (ancho de la tarjeta, compases
     por línea y acordes en el compás); si aun así no cabe, parte la línea en vez de pisar al vecino. */
  :global(.compases .simbolo) {
    font-size: clamp(0.8rem, calc((100cqi / var(--cols) / var(--n, 1) - 0.8rem) / 3.3), 1.15rem);
    font-weight: 700;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }
  :global(.compases .grado) {
    font-family: var(--fuente);
    font-size: 0.75rem;
    line-height: 1.15;
    color: var(--acento);
    overflow-wrap: anywhere;
  }
  :global(.compases .acorde.sonando-ahora) {
    background: var(--acento-suave);
    box-shadow: 0 0 0 2px var(--acento);
  }
  .campos {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 0.75rem;
  }
  /* Contenedor, como la tarjeta: en el diálogo estrecho (móvil) también salen dos compases por línea. */
  .vista-previa {
    margin: 0.75rem 0;
    container-type: inline-size;
  }
  .errores {
    color: var(--mal);
    font-weight: 600;
    padding-left: 1.25rem;
  }
  /* El error de la vista previa se pinta desde el script: el estilo con ámbito no le llega. */
  .vista-previa :global(.errores) {
    margin: 0;
    padding: 0;
    color: var(--mal);
    font-size: 0.85rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
