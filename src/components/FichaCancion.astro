---
// Ficha de canción (vista y edición). La pinta el navegador a partir de los datos
// del repositorio y de lo editado en este navegador (localStorage).
import { getCollection } from 'astro:content';
import type { Cancion } from '../lib/cancion.ts';
import { ruta } from '../lib/rutas.ts';
import { porOrden } from '../lib/orden.ts';
import { INSTRUMENTOS } from '../lib/audio.ts';

interface Props {
  /** Canción del repositorio; null en la página de canciones creadas en el navegador. */
  cancion: Cancion | null;
}

const { cancion } = Astro.props;
const grupos = Object.fromEntries((await getCollection('grupos')).map((g) => [g.id, g.data.nombre]));
const voicings = porOrden(await getCollection('acordes')).map(({ id, data }) => ({
  id,
  grupo: data.grupo.id,
  nombre: data.nombre,
  tonica: data.tonica,
  trastes: data.trastes,
  grados: data.grados,
}));
// JSON dentro de <script>: se escapa "<" para que ningún texto pueda cerrar la etiqueta.
const datos = JSON.stringify({ cancion, grupos, voicings }).replace(/</g, '\\u003c');
---

<a class="volver" href={ruta('repertorio')}>← Repertorio</a>
<div data-cabecera>
  <h1>{cancion?.titulo ?? 'Canción'}</h1>
</div>

<div class="barra-ficha" data-barra></div>
<div class="controles-audio" data-controles-audio hidden>
  <label class="control">Tempo
    <input type="range" min="40" max="320" step="1" data-tempo-ficha />
    <span class="valor-tempo"><strong data-tempo-ficha-valor></strong> BPM</span>
  </label>
  <button type="button" class="boton" data-tempo-original hidden title="Volver al tempo de la ficha">↺ Original</button>
  <label class="casilla"><input type="checkbox" data-metronomo /> Metrónomo</label>
  <button type="button" class="boton" data-bucle aria-pressed="false" title="Al acabar, vuelve a empezar">⟲ Bucle</button>
  <label class="control">Sonido
    <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{i.nombre}</option>)}</select>
  </label>
</div>
<div class="aviso suave" data-aviso hidden></div>
<form class="meta" data-meta hidden onsubmit="return false"></form>

<div class="ficha-cuerpo">
  <div class="ficha-principal">
    <h2>Cifrado</h2>
    <div data-cifrado></div>
    <div class="panel" data-panel hidden></div>
  </div>
  <aside class="ficha-lateral" data-resto></aside>
</div>
<div class="ficha-abajo" data-ficha-abajo></div>
<section class="impro" data-improvisacion hidden></section>

<div id="menu-acorde" class="menu-acorde" popover>
  <p class="menu-titulo" data-menu-titulo></p>
  <button type="button" class="boton" data-audio="acorde" aria-pressed="false">Escuchar</button>
  <a data-menu-voicings href={ruta('acordes')}>Voicings</a>
  <a data-menu-escalas href={ruta('escalas')}>Escalas</a>
  <a data-menu-capas href={ruta('estudio/capas')} data-base={ruta('estudio/capas')}>Mástil por capas</a>
  <a data-menu-arpegio href={ruta('estudio/arpegios')} data-base={ruta('estudio/arpegios')}>Arpegio</a>
</div>

<script type="application/json" id="datos-ficha" set:html={datos} />

<script>
  import { iniciarFicha } from '../lib/ficha-cancion.ts';
  iniciarFicha();
</script>

<style is:global>
  .ficha-cuerpo {
    display: grid;
    gap: 0 3rem;
  }
  @media (min-width: 85rem) {
    .ficha-cuerpo {
      grid-template-columns: minmax(0, 1fr) 26rem;
      align-items: start;
    }
    .ficha-lateral {
      position: sticky;
      top: calc(var(--cabecera-alto) + 1rem);
      max-height: calc(100dvh - var(--cabecera-alto) - 2rem);
      overflow-y: auto;
    }
  }
  .ficha-lateral:empty {
    display: none;
  }
  /* Sin letra: una sola columna centrada. */
  .ficha-cuerpo.sin-letra {
    grid-template-columns: minmax(0, 80rem);
    justify-content: center;
  }
  .ficha-cuerpo.sin-letra .ficha-lateral {
    position: static;
    max-height: none;
  }
  .ficha-lateral h2:first-child {
    margin-top: 3rem;
  }
  .volver {
    display: inline-block;
    padding: 0.5rem 0;
    text-decoration: none;
    font-weight: 600;
  }
  [data-cabecera] h1 {
    margin-bottom: 0;
  }
  .autor {
    margin: 0 0 1rem;
    font-size: 1.25rem;
  }
  .ficha {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ficha div {
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    padding: 0.5rem 1rem;
  }
  .ficha dt {
    font-family: var(--fuente);
    font-size: 0.82rem;
    color: var(--texto-suave);
  }
  .ficha dd {
    margin: 0;
    font-weight: 700;
    font-size: 1.05rem;
  }
  .ficha-abajo {
    margin-top: 2rem;
  }
  .ficha-abajo:empty {
    display: none;
  }
  @media (min-width: 40.01rem) {
    .ficha-abajo {
      display: none;
    }
  }
  @media (max-width: 40rem) {
    .ficha-arriba {
      display: none;
    }
    .autor {
      margin-bottom: 0;
    }
    /* Controles de audio a todo el ancho, sin desbordar. */
    /* (div. para ganar a las reglas generales, que van después) */
    div.controles-audio {
      width: auto;
    }
    div.controles-audio .control:has(input[type='range']) {
      flex: 1 1 100%;
    }
    div.controles-audio input[type='range'] {
      flex: 1 1 auto;
      width: auto;
      min-width: 0;
    }
  }
  .barra-ficha {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 0;
  }
  .controles-audio {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin: 0.75rem 0 0;
    padding: 0.6rem 0.9rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    width: fit-content;
  }
  .controles-audio .control {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .controles-audio input[type='range'] {
    width: 14rem;
    accent-color: var(--acento);
  }
  .valor-tempo {
    min-width: 6.5ch;
    text-align: right;
  }
  .valor-tempo strong {
    color: var(--texto);
    font-size: 1rem;
  }
  .controles-audio select {
    width: auto;
    min-height: 2.2rem;
  }
  .aviso {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
  }
  .meta {
    margin: 1rem 0 0;
    padding: 0.75rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: 0.75rem;
  }
  .meta .campos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.5rem;
  }
  .meta .casillas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0.75rem 0 0;
  }
  .meta summary {
    cursor: pointer;
    font-weight: 700;
    margin-top: 0.75rem;
  }

  /* Cifrado */
  .cifrado {
    display: grid;
    gap: 0.6rem;
  }
  .cifrado .linea {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    border-left: 2px solid var(--texto-suave);
  }
  /* En el móvil, para que ningún cifrado se corte con «…» ni los diagramas queden diminutos:
     dos compases por fila y uno en las líneas con algún compás de 3 o más acordes
     (Pyramid Song), con el cifrado algo más pequeño. */
  @media (max-width: 40rem) {
    .cifrado .linea {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cifrado .linea:has(.celdas > .celda:nth-child(3)) {
      grid-template-columns: minmax(0, 1fr);
    }
    .celda .simbolo {
      font-size: 1.05rem;
    }
  }
  .compas {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 3rem;
    padding: 0.2rem 0.25rem 0.3rem;
    border-right: 2px solid var(--texto-suave);
    border-bottom: 1px solid var(--borde);
  }
  .compas.rep-ini {
    border-left: 5px double var(--texto);
  }
  .compas.rep-fin {
    border-right: 5px double var(--texto);
  }
  .compas.rep-ini::before,
  .compas.rep-fin::after {
    content: '⁚';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
  }
  .compas.rep-ini::before {
    left: 0.1rem;
  }
  .compas.rep-fin::after {
    right: 0.1rem;
  }
  .compas.con-final {
    border-top: 2px solid var(--texto-suave);
  }
  .marcas {
    display: flex;
    gap: 0.3rem;
    align-items: center;
    min-height: 1.3rem;
  }
  .seccion-marca {
    padding: 0 0.35rem;
    border: 2px solid var(--acento);
    border-radius: 0.3rem;
    color: var(--acento);
    font-weight: 800;
    font-size: 0.85rem;
  }
  .final-marca {
    font-size: 0.85rem;
    font-weight: 700;
  }
  .metrica {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .celdas {
    display: flex;
    align-items: stretch;
    gap: 0.15rem;
  }
  .celda {
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 0.2rem;
    padding: 0.3rem 0.1rem;
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    border-radius: 0.4rem;
    cursor: pointer;
  }
  .celda .simbolo {
    font-weight: 700;
    font-size: 1.3rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  .celda.enlazada .simbolo {
    border-bottom: 2px dotted var(--acento);
  }
  .celda .diagrama {
    max-width: 8rem;
  }
  .cifrado.editando .celda {
    outline: 1px dashed var(--borde);
  }
  /* Acorde que suena durante la reproducción */
  /* Atenuado (fondo translúcido) para que el acorde y su diagrama se lean bien. */
  .celda.sonando-ahora {
    background: var(--acento-suave);
    box-shadow: 0 0 0 2px var(--acento);
  }
  .celda.sel {
    background: color-mix(in srgb, var(--acento) 18%, transparent); /* COLOR: acorde seleccionado en el editor (acento al 18 %) */
    outline: 2px solid var(--acento) !important;
  }

  /* Panel de edición del acorde elegido */
  .panel {
    position: sticky;
    bottom: 1rem;
    z-index: 2;
    margin-top: 1rem;
    max-height: 80dvh;
    overflow-y: auto;
    padding: 1.25rem 1.5rem;
    background: var(--superficie);
    border: 2px solid var(--acento);
    border-radius: 0.75rem;
    box-shadow: 0 0.5rem 2rem var(--sombra-fuerte);
  }
  .panel h3 {
    margin: 0;
    font-size: 1.15rem;
  }
  .panel .fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 0.85rem;
  }
  .panel .fila > label {
    flex: 1 1 7rem;
  }
  /* La raíz cabe en poco («F#»); la calidad necesita sitio para «Semidisminuido». */
  .panel .fila > label:has([data-campo='raiz']) {
    flex: 0 1 5.5rem;
  }
  .panel .fila > label:has([data-campo='tipo']) {
    flex: 1 1 11rem;
  }
  /* En el móvil y en pantallas bajas, el panel deja ver más cifrado por encima. */
  @media (max-width: 40rem), (max-height: 50rem) {
    .panel {
      max-height: 65dvh;
    }
  }
  .panel .paso {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .panel .paso output {
    min-width: 3.2rem;
    text-align: center;
    font-weight: 800;
  }
  .panel .cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .panel .vista {
    display: grid;
    grid-template-columns: minmax(0, 13rem) 1fr;
    gap: 1.5rem;
    align-items: start;
    margin-top: 0.85rem;
  }
  .panel .vista .simbolo-grande {
    font-size: 2rem;
    font-weight: 800;
    margin: 0;
  }
  .panel fieldset {
    margin: 1rem 0 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--borde);
    border-radius: 0.5rem;
  }
  .panel legend {
    font-weight: 700;
    font-size: 0.85rem;
  }
  @media (max-width: 40rem) {
    .panel {
      padding: 0.75rem;
    }
    /* El diagrama encima y centrado: al lado de los controles quedaba diminuto. */
    .panel .vista {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }
    .panel .vista > div:first-child {
      justify-self: center;
      width: min(10rem, 60%);
    }
  }

  .menu-acorde {
    width: min(22rem, calc(100vw - 2rem));
    padding: 1rem;
    color: var(--texto);
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: 0.75rem;
    box-shadow: 0 0.5rem 2rem var(--sombra-fuerte);
  }
  .menu-acorde::backdrop {
    background: var(--velo);
  }
  .menu-titulo {
    margin: 0 0 0.75rem;
    font-size: 1.2rem;
    font-weight: 700;
  }
  .menu-acorde .boton {
    width: 100%;
  }
  .menu-acorde a {
    display: block;
    padding: 0.75rem 1rem;
    margin-top: 0.5rem;
    border: 1px solid var(--borde);
    border-radius: 0.5rem;
    font-weight: 700;
    text-decoration: none;
  }
  .letra {
    font-size: 1.1rem;
    line-height: 1.6;
  }
  .letra p {
    margin: 0 0 1rem;
    white-space: pre-line;
  }
  .enlaces {
    padding-left: 1.25rem;
  }
  .enlaces li {
    margin-bottom: 0.5rem;
  }
  .notas {
    white-space: pre-line;
  }

  /* Improvisación */
  .impro {
    max-width: 80rem;
    margin: 3rem auto 0;
    padding-top: 1rem;
    border-top: 1px solid var(--borde);
  }
  /* Con letra, el cifrado ocupa todo el ancho: la sección se alinea con él en vez de centrarse. */
  .ficha-cuerpo:not(.sin-letra) ~ .impro {
    max-width: none;
  }
  .impro h3 {
    margin: 2rem 0 0.75rem;
    font-size: 1.1rem;
  }
  .impro-enfoque {
    max-width: 48rem;
    margin: 0 0 1.5rem;
    font-size: 1.05rem;
    line-height: 1.55;
  }
  .impro-tramos,
  .impro-estrategias {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .impro-tramo,
  .impro-estrategia {
    padding: 0.9rem 1rem;
    background: var(--tarjeta);
    border: 1px solid var(--borde);
    border-radius: var(--radio-tarjeta);
  }
  .impro-tramo {
    border-top: 0.3rem solid var(--acento);
  }
  .impro-cabeza {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .impro-acorde {
    font-size: 1.5rem;
    font-weight: 800;
  }
  .impro-compases {
    flex: none;
    white-space: nowrap;
    font-size: 0.8rem;
    color: var(--texto-suave);
  }
  .impro-escalas {
    display: grid;
    gap: 0.35rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }
  .impro-escalas a {
    font-weight: 700;
    text-decoration: none;
  }
  .impro-escalas a:hover {
    text-decoration: underline;
  }
  .impro-notas {
    display: block;
    font-size: 0.85rem;
    color: var(--texto-suave);
    letter-spacing: 0.02em;
  }
  .impro-guia {
    margin: 0.75rem 0 0;
    font-size: 0.92rem;
  }
  .impro-guia span {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--texto-suave);
    margin-right: 0.35rem;
  }
  .impro-consejo {
    margin: 0.6rem 0 0;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .impro-estrategia h4 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
  }
  .impro-estrategia p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    white-space: pre-line;
  }
  .impro-ejercicios {
    max-width: 48rem;
    padding-left: 1.4rem;
    line-height: 1.55;
  }
  .impro-ejercicios li {
    margin-bottom: 0.5rem;
  }
  .impro-estudio {
    padding-left: 1.25rem;
  }
  .impro-estudio li {
    margin-bottom: 0.4rem;
  }
  .impro-estudio a {
    font-weight: 700;
  }
</style>
