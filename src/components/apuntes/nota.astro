---
// Una nota de los Apuntes: /apuntes/nota/?id=n-…  Arriba, los enlaces a todas las
// notas para saltar de una a otra; se guarda sola mientras se escribe. Textos en
// i18n/apuntes.ts; lo usan pages/apuntes/nota.astro y pages/en/notes/note.astro.
import Base from '../../layouts/Base.astro';
import { ruta } from '../../lib/rutas.ts';
import type { Idioma } from '../../i18n/idiomas.ts';
import { APUNTES } from '../../i18n/apuntes.ts';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const T = APUNTES[idioma];
const lista = ruta(idioma === 'en' ? 'en/notes' : 'apuntes');
// La misma nota en el otro idioma (el ?id= lo añade la cabecera).
const otroIdioma = ruta(idioma === 'en' ? 'apuntes/nota' : 'en/notes/note');
---

<Base titulo={T.nota} encabezado={T.titulo} conH1={false} otroIdioma={otroIdioma}>
  <nav class="indice-notas" aria-label={T.tusApuntes} data-indice-notas></nav>

  <p class="volver"><a href={lista}>{T.todos}</a></p>

  <article class="tarjeta nota" data-nota hidden>
    <div class="nota-cabecera">
      <h1 class="visualmente-oculto" data-titulo-oculto>{T.nota}</h1>
      <input class="nota-titulo" data-titulo maxlength="120" placeholder={T.tituloCampo} aria-label={T.tituloNota} autocomplete="off" />
      <span data-estrella></span>
    </div>
    <textarea class="nota-texto" data-texto aria-label={T.textoNota} placeholder={T.escribeAqui}></textarea>
    <div class="nota-pie">
      <span class="estado" data-estado role="status"></span>
      <button type="button" class="boton peligro" data-borrar>{T.eliminarNota}</button>
    </div>
  </article>

  <p class="no-encontrada" data-no-encontrada hidden>
    {T.noEncontrada} <a href={lista}>{T.volver}</a>.
  </p>
</Base>

<script>
  import {
    anclaDocumento,
    cambiarNota,
    conConfirmacion,
    guardarNotas,
    htmlIndiceNotas,
    leerDocumentos,
    leerNotas,
    tituloDe,
  } from '../../lib/apuntes.ts';
  import { botonFavorito } from '../../lib/favoritos.ts';
  import { ruta } from '../../lib/rutas.ts';
  import { idiomaValido } from '../../i18n/idiomas.ts';
  import { APUNTES } from '../../i18n/apuntes.ts';

  const idioma = idiomaValido(document.documentElement.lang);
  const T = APUNTES[idioma];
  const lista = ruta(idioma === 'en' ? 'en/notes' : 'apuntes');
  const id = new URLSearchParams(location.search).get('id') ?? '';
  const hrefNota = (x: string) => `${ruta(idioma === 'en' ? 'en/notes/note' : 'apuntes/nota')}?id=${encodeURIComponent(x)}`;
  const indice = document.querySelector<HTMLElement>('[data-indice-notas]')!;
  const articulo = document.querySelector<HTMLElement>('[data-nota]')!;
  const titulo = document.querySelector<HTMLInputElement>('[data-titulo]')!;
  const texto = document.querySelector<HTMLTextAreaElement>('[data-texto]')!;
  const estrella = document.querySelector<HTMLElement>('[data-estrella]')!;
  const estado = document.querySelector<HTMLElement>('[data-estado]')!;

  const hrefDocumento = (x: string) => `${lista}#${anclaDocumento(x)}`;
  const pintarIndice = () => (indice.innerHTML = htmlIndiceNotas(leerNotas(), hrefNota, id, leerDocumentos(), hrefDocumento, idioma));
  const pintarCabecera = () => {
    const n = leerNotas().find((x) => x.id === id);
    if (!n) return;
    const nombre = tituloDe(n, idioma);
    document.title = `${nombre} · JAZZMASTER`;
    document.querySelector('[data-titulo-oculto]')!.textContent = nombre;
    estrella.innerHTML = botonFavorito(n.favorita, nombre, idioma);
  };

  const nota = leerNotas().find((x) => x.id === id);
  pintarIndice();
  if (!nota) {
    document.querySelector<HTMLElement>('[data-no-encontrada]')!.hidden = false;
  } else {
    articulo.hidden = false;
    titulo.value = nota.titulo;
    texto.value = nota.texto;
    pintarCabecera();

    // El cuadro de texto crece con lo escrito.
    const ajustarAlto = () => {
      texto.style.height = 'auto';
      texto.style.height = `${texto.scrollHeight + 2}px`;
    };
    ajustarAlto();

    // Guardado automático, medio segundo después de dejar de escribir.
    let espera: number | undefined;
    const guardar = () => {
      cambiarNota(id, { titulo: titulo.value.trim(), texto: texto.value });
      estado.textContent = T.guardado;
      pintarIndice();
      pintarCabecera();
    };
    const alEscribir = () => {
      estado.textContent = T.sinGuardar;
      clearTimeout(espera);
      espera = window.setTimeout(guardar, 500);
    };
    titulo.addEventListener('input', alEscribir);
    texto.addEventListener('input', () => {
      ajustarAlto();
      alEscribir();
    });
    // Al salir de la página, lo pendiente se guarda ya.
    addEventListener('pagehide', () => {
      if (estado.textContent === T.sinGuardar) guardar();
    });

    estrella.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('[data-favorito]')) return;
      const n = leerNotas().find((x) => x.id === id);
      if (n) cambiarNota(id, { favorita: !n.favorita });
      pintarCabecera();
      pintarIndice();
    });

    conConfirmacion(
      document.querySelector<HTMLButtonElement>('[data-borrar]')!,
      () => {
        clearTimeout(espera);
        guardarNotas(leerNotas().filter((x) => x.id !== id));
        location.href = lista;
      },
      T.seguroBorrar,
    );

    if (!nota.titulo && !nota.texto) titulo.focus();
  }
</script>

<style>
  .volver {
    margin: 0 0 0.75rem;
    font-weight: 700;
  }
  .volver a {
    text-decoration: none;
  }
  .nota {
    max-width: 52rem;
    padding: 0.9rem 1rem 1rem;
  }
  .nota[hidden] {
    display: none;
  }
  .nota-cabecera {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nota-cabecera :global(.favorito) {
    position: static;
  }
  .nota .nota-titulo {
    font-family: var(--fuente-titulo);
    font-size: 1.5rem;
    font-weight: 600;
    border-color: transparent;
    background: transparent;
    padding-left: 0.2rem;
  }
  .nota .nota-titulo:focus {
    border-color: var(--acento);
    background: var(--fondo);
  }
  .nota .nota-texto {
    min-height: 18rem;
    margin-top: 0.6rem;
    line-height: 1.55;
    resize: none;
    overflow: hidden;
  }
  .nota-pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
  }
  .estado {
    font-size: 0.82rem;
    color: var(--texto-suave);
  }
</style>
