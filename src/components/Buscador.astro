---
import type { Idioma } from '../i18n/idiomas.ts';
import { INTERFAZ } from '../i18n/interfaz.ts';

interface Props {
  placeholder: string;
  idioma?: Idioma;
}

const { placeholder, idioma = 'es' } = Astro.props;
---

<input class="buscador" type="search" data-buscador placeholder={placeholder} aria-label={placeholder} autocomplete="off" />
<p class="sin-resultados" data-sin-resultados hidden>{INTERFAZ[idioma].sinResultados}</p>

<style>
  .buscador {
    width: 100%;
    max-width: 40rem;
    min-height: 3rem;
    padding: 0 1.25rem;
    font: inherit;
    font-size: 1.05rem;
    color: var(--texto);
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }
  .buscador:focus {
    border-color: var(--acento);
    outline: none;
  }
  .sin-resultados {
    color: var(--texto-suave);
  }
</style>
