---
// Ejemplo interactivo de las páginas Tríadas, Drop 2 y Drop 3 (lib/drop.ts): las
// inversiones de un acorde en un grupo de cuerdas o una progresión encadenada, con
// diagramas y audio. La página pone el selector de tónica (con [data-instrumento] y el tempo).
import { getCollection } from 'astro:content';
import { gruposDe, type TipoDrop } from '../lib/drop.ts';
import { porOrden } from '../lib/orden.ts';
import { formatear, type Idioma } from '../i18n/idiomas.ts';
import { INTERFAZ } from '../i18n/interfaz.ts';
import { DROP } from '../i18n/estudio/drop.ts';

interface Props {
  idioma?: Idioma;
  /** Clave con la que se recuerdan las opciones y el sonido. */
  clave: string;
  /** Tipos de voicing que se ofrecen (cada uno con sus grupos de cuerdas). */
  tipos: TipoDrop[];
  /** Acordes del modo Inversiones: [grado en romanos, nombre]. */
  cualidades?: [string, string][];
  /** Si "Raíz en el bajo" empieza marcado. */
  fundamental?: boolean;
  /** En el móvil, selectores en vez de las filas de botones (Tríadas). */
  selectoresMovil?: boolean;
}
const idioma = Astro.props.idioma ?? 'es';
const T = DROP[idioma];
const I = INTERFAZ[idioma];
const NOMBRE_TIPO = T.tipos as Record<TipoDrop, string>;
/** Nombre de un grupo de cuerdas: «Cuerdas 6-4-3 (abierta)». */
const nombreGrupo = (g: { id: string; tipo: TipoDrop }) =>
  formatear(T.grupo, { cuerdas: g.id.split('').join('-') }) + (g.tipo === 'triada-abierta' ? T.abierta : '');
const progresiones = porOrden(await getCollection('progresiones')).map(({ id, data }) => ({
  id,
  nombre: (idioma === 'en' && data.en?.nombre) || data.nombre,
  pulsos: data.pulsos,
  compases: data.compases,
}));
const datos = JSON.stringify(progresiones).replace(/</g, '\\u003c');
const {
  clave,
  tipos,
  fundamental = false,
  selectoresMovil = false,
  cualidades = [
    ['Imaj7', 'maj7'],
    ['I7', '7'],
    ['Im7', 'm7'],
    ['Im7b5', 'm7b5'],
    ['I°7', '°7'],
    ['I6', '6'],
    ['Im6', 'm6'],
    ['ImMaj7', 'mMaj7'],
    ['I7sus4', '7sus4'],
  ],
} = Astro.props;
const grupos = gruposDe(...tipos);
---

<section class:list={['ejemplo', { 'con-selectores': selectoresMovil }]} aria-label={T.ejemplo} data-ejemplo-drop={clave} data-fundamental-inicial={String(fundamental)} data-grupos={grupos.map((g) => g.id).join(',')}>
  <div class="opciones">
    <div class="grupo-botones" role="group" aria-label={T.queVer}>
      <button type="button" class="boton" data-modo="inversiones" aria-pressed="false">{T.inversiones}</button>
      <button type="button" class="boton" data-modo="progresion" aria-pressed="false">{T.progresion}</button>
    </div>
    <label class="campo" data-solo="inversiones">{T.acorde}
      <select data-cualidad>{cualidades.map(([v, n]) => <option value={v}>{n}</option>)}</select>
    </label>
    <label class="campo" data-solo="progresion">{T.progresion}
      <select data-progresion></select>
    </label>
    {
      tipos.length > 1 &&
        tipos.map((t) => (
          <div class="grupo-botones" role="group" aria-label={formatear(T.cuerdasDe, { tipo: NOMBRE_TIPO[t] })}>
            <span class="etiqueta">{NOMBRE_TIPO[t]}</span>
            {gruposDe(t).map((g) => (
              <button type="button" class="boton" data-grupo={g.id} aria-pressed="false" title={nombreGrupo(g)}>
                {g.id.split('').join('-')}
              </button>
            ))}
          </div>
        ))
    }
    <div class="grupo-botones" role="group" aria-label={T.cuerdas} hidden={tipos.length > 1}>
      {tipos.length === 1 && grupos.map((g) => <button type="button" class="boton" data-grupo={g.id} aria-pressed="false" title={nombreGrupo(g)}>{g.id.split('').join('-')}</button>)}
      {
        grupos.length === 2 && (
          <button type="button" class="boton" data-grupo="ambos" data-solo="progresion" aria-pressed="false" title={T.ambosAyuda}>
            {T.ambos}
          </button>
        )
      }
    </div>
    <div class="grupo-botones" role="group" aria-label={T.zona} data-solo="progresion">
      <span class="etiqueta">{T.empezarEn}</span>
      <button type="button" class="boton" data-zona="3" aria-pressed="false">{T.grave}</button>
      <button type="button" class="boton" data-zona="7" aria-pressed="false">{T.media}</button>
      <button type="button" class="boton" data-zona="11" aria-pressed="false">{T.aguda}</button>
    </div>
    {
      selectoresMovil && (
        <Fragment>
          <label class="campo solo-movil primero">{T.queVer}
            <select data-sel-modo>
              <option value="inversiones">{T.inversiones}</option>
              <option value="progresion">{T.progresion}</option>
            </select>
          </label>
          <label class="campo solo-movil">{T.cuerdas}
            <select data-sel-grupo>
              {tipos.length > 1
                ? tipos.map((t) => (
                    <optgroup label={NOMBRE_TIPO[t]}>
                      {gruposDe(t).map((g) => <option value={g.id}>{g.id.split('').join('-')}</option>)}
                    </optgroup>
                  ))
                : grupos.map((g) => <option value={g.id}>{g.id.split('').join('-')}</option>)}
              {grupos.length === 2 && <option value="ambos">{T.ambos}</option>}
            </select>
          </label>
          <label class="campo solo-movil" data-solo="progresion">{T.empezarEn}
            <select data-sel-zona>
              <option value="3">{T.grave}</option>
              <option value="7">{T.media}</option>
              <option value="11">{T.aguda}</option>
            </select>
          </label>
        </Fragment>
      )
    }
    <label class="casilla" data-solo="progresion"><input type="checkbox" data-fundamental /> {T.fundamental}</label>
  </div>
  <ol class="voicings-drop" data-voicings></ol>
  <div class="botones-audio">
    <button type="button" data-audio="una" aria-pressed="false">{T.tocar}</button>
    <button type="button" data-audio="bucle" aria-pressed="false" title={T.bucleAyuda}>{T.bucle}</button>
    <button type="button" data-detener>{I.detener}</button>
  </div>
  <script type="application/json" data-progresiones-drop set:html={datos} />
</section>

<script>
  import { formatear, idiomaValido } from '../i18n/idiomas.ts';
  import { DROP } from '../i18n/estudio/drop.ts';
  import { esc, guardarJSON, leerJSON } from '../lib/almacen.ts';
  import { SOSTENIDOS } from '../lib/audio.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica } from '../lib/cliente.ts';
  import { diagramaSVG } from '../lib/diagrama.ts';
  import { dropProgresion, escaleraInversiones, eventosDrop, type Drop, type IdGrupo } from '../lib/drop.ts';
  import { analizarProgresion, aplicarCambiosProgresiones, parseAcordeGrado, type CambiosProgresiones, type Progresion } from '../lib/progresiones.ts';

  const T = DROP[idiomaValido(document.documentElement.lang)];
  const raiz = document.querySelector<HTMLElement>('[data-ejemplo-drop]')!;
  const clave = raiz.dataset.ejemploDrop!;
  const gruposTipo = raiz.dataset.grupos!.split(',') as IdGrupo[];

  // Las progresiones de la sección Progresiones, con lo editado en este navegador.
  const base: Progresion[] = JSON.parse(raiz.querySelector('[data-progresiones-drop]')!.textContent!);
  const progresiones = aplicarCambiosProgresiones(base, leerJSON<CambiosProgresiones>('progresiones:cambios') ?? {}).filter((p) => {
    try {
      analizarProgresion(p.compases);
      return true;
    } catch {
      return false;
    }
  });

  interface Opciones {
    modo: 'inversiones' | 'progresion';
    cualidad: string;
    progresion: string;
    /** Un grupo de cuerdas, o 'ambos' (solo en progresión). */
    grupo: string;
    zona: number;
    fundamental: boolean;
  }
  const CLAVE = `${clave}:opciones`;
  const op: Opciones = {
    modo: 'inversiones',
    cualidad: 'Imaj7',
    progresion: 'ii-v-i-mayor',
    grupo: gruposTipo[0],
    zona: 7,
    fundamental: raiz.dataset.fundamentalInicial === 'true',
    ...leerJSON<Partial<Opciones>>(CLAVE),
  };
  if (op.grupo !== 'ambos' && !gruposTipo.includes(op.grupo as IdGrupo)) op.grupo = gruposTipo[0];
  let tonica = 'C';
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento(`${clave}:sonido`);

  const $ = <T extends HTMLElement>(s: string) => raiz.querySelector<T>(s)!;
  const selCualidad = $<HTMLSelectElement>('[data-cualidad]');
  const selProgresion = $<HTMLSelectElement>('[data-progresion]');
  const casillaFundamental = $<HTMLInputElement>('[data-fundamental]');
  selProgresion.innerHTML = progresiones.map((p) => `<option value="${esc(p.id)}">${esc(p.nombre)}</option>`).join('');
  if (!progresiones.some((p) => p.id === op.progresion)) op.progresion = progresiones[0]?.id ?? '';
  // Si la opción guardada no está entre los acordes de esta página, la primera.
  if (![...selCualidad.options].some((o) => o.value === op.cualidad)) op.cualidad = selCualidad.options[0].value;
  selCualidad.value = op.cualidad;
  selProgresion.value = op.progresion;
  casillaFundamental.checked = op.fundamental;
  const lista = $('[data-voicings]');
  const progresion = () => progresiones.find((p) => p.id === op.progresion)!;
  /** Grupos de cuerdas que se usan ahora ('ambos' solo vale en progresión). */
  const grupos = (): IdGrupo[] =>
    op.grupo === 'ambos' ? (op.modo === 'progresion' ? gruposTipo : [gruposTipo[0]]) : [op.grupo as IdGrupo];

  /** Voicings que se muestran y cuántos pulsos suena cada uno. */
  function calcular(): { voicings: Drop[]; pulsos: number[] } {
    if (op.modo === 'progresion') {
      const compases = analizarProgresion(progresion().compases);
      const porCompas = progresion().pulsos ?? 4;
      return {
        voicings: dropProgresion(tonica, compases, grupos(), op.zona, op.fundamental),
        pulsos: compases.flatMap((c) => c.map(() => porCompas / c.length)),
      };
    }
    const voicings = escaleraInversiones(tonica, parseAcordeGrado(op.cualidad), grupos()[0]);
    return { voicings, pulsos: voicings.map(() => 2) };
  }

  function pintar() {
    const pulsado = (sel: string, activo: (b: HTMLButtonElement) => boolean) => {
      for (const b of raiz.querySelectorAll<HTMLButtonElement>(sel)) b.setAttribute('aria-pressed', String(activo(b)));
    };
    pulsado('[data-modo]', (b) => b.dataset.modo === op.modo);
    pulsado('[data-grupo]', (b) => b.dataset.grupo === (op.modo === 'inversiones' && op.grupo === 'ambos' ? gruposTipo[0] : op.grupo));
    pulsado('[data-zona]', (b) => Number(b.dataset.zona) === op.zona);
    for (const el of raiz.querySelectorAll<HTMLElement>('[data-solo]')) el.hidden = el.dataset.solo !== op.modo;
    // Selectores del móvil (solo en Tríadas): reflejan lo mismo que los botones.
    const sel = (s: string) => raiz.querySelector<HTMLSelectElement>(s);
    const selModo = sel('[data-sel-modo]');
    if (selModo) selModo.value = op.modo;
    const selGrupo = sel('[data-sel-grupo]');
    if (selGrupo) {
      const ambos = selGrupo.querySelector<HTMLOptionElement>('option[value="ambos"]');
      if (ambos) ambos.disabled = op.modo !== 'progresion';
      selGrupo.value = op.modo === 'inversiones' && op.grupo === 'ambos' ? gruposTipo[0] : op.grupo;
    }
    const selZona = sel('[data-sel-zona]');
    if (selZona) selZona.value = String(op.zona);
    try {
      lista.innerHTML = calcular()
        .voicings.map(
          (d, i) => `<li class="voicing-drop" data-indice="${i}">
            <span class="simbolo">${esc(d.simbolo)}</span>
            <span class="detalle">${esc(T.inversionesNombres[d.inversion] ?? d.inversion)} · ${esc(formatear(T.arriba, { grado: d.arriba }))}</span>
            ${diagramaSVG({ trastes: d.trastes, grados: d.grados })}
          </li>`,
        )
        .join('');
    } catch (error) {
      // Los avisos de lib/drop.ts están en español; en inglés, el suyo.
      const mensaje = (error as Error).message;
      lista.innerHTML = `<li class="suave">${esc(T === DROP.es ? mensaje : T.noCabe)}</li>`;
    }
    guardarJSON(CLAVE, op);
  }

  selCualidad.addEventListener('change', () => ((op.cualidad = selCualidad.value), pintar()));
  selProgresion.addEventListener('change', () => ((op.progresion = selProgresion.value), pintar()));
  casillaFundamental.addEventListener('change', () => ((op.fundamental = casillaFundamental.checked), pintar()));
  raiz.addEventListener('change', (e) => {
    const s = e.target as HTMLSelectElement;
    if ('selModo' in s.dataset) op.modo = s.value as Opciones['modo'];
    else if ('selGrupo' in s.dataset) op.grupo = s.value;
    else if ('selZona' in s.dataset) op.zona = Number(s.value);
    else return;
    pintar();
  });
  raiz.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    if (b.dataset.modo) op.modo = b.dataset.modo as Opciones['modo'];
    else if (b.dataset.grupo) op.grupo = b.dataset.grupo;
    else if (b.dataset.zona) op.zona = Number(b.dataset.zona);
    else return;
    pintar();
  });

  conectarAudio((boton) => {
    const { voicings, pulsos } = calcular();
    const { eventos, tramos, duracion } = eventosDrop(voicings, pulsos, tempo(), SOSTENIDOS.includes(instrumento()));
    let marcado = -1;
    const marcar = (k: number) => {
      if (k === marcado) return;
      marcado = k;
      lista.querySelector('.sonando-ahora')?.classList.remove('sonando-ahora');
      if (k >= 0) lista.querySelector(`[data-indice="${k}"]`)?.classList.add('sonando-ahora');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion,
      bucle: () => boton.dataset.audio === 'bucle',
      alProgresar: (t) => marcar(tramos.findIndex((x) => t >= x.inicio && t < x.fin)),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((t) => {
    tonica = t;
    pintar();
  });
  pintar();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.5rem;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.5rem;
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    font-weight: 700;
  }
  .campo select {
    width: auto;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  /* Tríadas en el móvil: selectores en vez de las filas de botones. */
  .campo.solo-movil {
    display: none;
  }
  @media (max-width: 40rem) {
    .con-selectores .opciones > .grupo-botones {
      display: none;
    }
    .con-selectores .campo.solo-movil {
      display: flex;
    }
    /* «Qué ver» va el primero, donde estaban sus botones. */
    .con-selectores .primero {
      order: -1;
    }
  }
  .grupo-botones .etiqueta {
    margin-right: 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .voicings-drop {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 10rem), 1fr));
    gap: 0.5rem;
  }
  .voicings-drop :global(.voicing-drop) {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    padding: 0.6rem 0.4rem 0.4rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .voicings-drop :global(.voicing-drop.sonando-ahora) {
    background: var(--acento-suave);
    border-color: var(--acento);
    box-shadow: 0 0 0 1px var(--acento);
  }
  .voicings-drop :global(.simbolo) {
    font-weight: 700;
    font-size: 1.15rem;
  }
  .voicings-drop :global(.detalle) {
    font-size: 0.75rem;
    color: var(--texto-suave);
    text-align: center;
  }
  .voicings-drop :global(.diagrama) {
    max-width: 9rem;
    margin-top: 0.25rem;
  }
</style>
