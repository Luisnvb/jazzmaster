---
// Shell voicings (sección Estudio). El texto está en src/data/estudio/shells.md;
// aquí va el ejemplo (lib/shells.ts) con las progresiones de la web y sus diagramas. En
// inglés, shells.en.md e i18n/estudio/shells.ts; lo usan pages/estudio/shells.astro y
// pages/en/study/shells.astro.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import * as es from '../../data/estudio/shells.md';
import * as en from '../../data/estudio/shells.en.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { porOrden } from '../../lib/orden.ts';
import type { Idioma } from '../../i18n/idiomas.ts';
import { INTERFAZ, nombreSonido } from '../../i18n/interfaz.ts';
import { SHELLS } from '../../i18n/estudio/shells.ts';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const T = SHELLS[idioma];
const I = INTERFAZ[idioma];
const { Content, getHeadings } = idioma === 'en' ? en : es;
const indice = getHeadings().filter((h) => h.depth === 2);
const progresiones = porOrden(await getCollection('progresiones')).map(({ id, data }) => ({
  id,
  nombre: (idioma === 'en' && data.en?.nombre) || data.nombre,
  pulsos: data.pulsos,
  compases: data.compases,
}));
const datos = JSON.stringify(progresiones).replace(/</g, '\\u003c');
---

<Base titulo={T.titulo}>
  <SelectorTonica clave="shells" idioma={idioma}>
    <label>{I.sonido}
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{nombreSonido(i, idioma)}</option>)}</select>
    </label>
    <Tempo clave="shells" inicial={90} />
  </SelectorTonica>

  <section class="ejemplo" aria-label={T.ejemplo}>
    <div class="opciones">
      <label class="campo">{T.progresion}
        <select data-progresion></select>
      </label>
      <div class="grupo-botones" role="group" aria-label={T.zona}>
        <span class="etiqueta">{T.empezarEn}</span>
        <button type="button" class="boton" data-zona="3" aria-pressed="false" title={T.graveAyuda}>{T.grave}</button>
        <button type="button" class="boton" data-zona="7" aria-pressed="false" title={T.mediaAyuda}>{T.media}</button>
        <button type="button" class="boton" data-zona="11" aria-pressed="false" title={T.agudaAyuda}>{T.aguda}</button>
      </div>
      <label class="casilla"><input type="checkbox" data-tension /> {T.tension}</label>
    </div>
    <ol class="shells" data-shells></ol>
    <div class="botones-audio">
      <button type="button" data-audio="una" aria-pressed="false">{T.tocar}</button>
      <button type="button" data-audio="bucle" aria-pressed="false" title={T.bucleAyuda}>{T.bucle}</button>
      <button type="button" data-detener>{I.detener}</button>
    </div>
  </section>

  <nav class="indice" aria-label={I.enEstaPagina}>
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>

  <script type="application/json" id="datos-shells" set:html={datos} />
</Base>

<script>
  import { idiomaValido } from '../../i18n/idiomas.ts';
  import { SHELLS } from '../../i18n/estudio/shells.ts';
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { SOSTENIDOS } from '../../lib/audio.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica } from '../../lib/cliente.ts';
  import { diagramaSVG } from '../../lib/diagrama.ts';
  import { analizarProgresion, aplicarCambiosProgresiones, type CambiosProgresiones, type Progresion } from '../../lib/progresiones.ts';
  import { conTension, eventosShells, shellsProgresion, type Shell } from '../../lib/shells.ts';

  // Las progresiones de la sección Progresiones, con lo editado en este navegador.
  const T = SHELLS[idiomaValido(document.documentElement.lang)];
  const base: Progresion[] = JSON.parse(document.getElementById('datos-shells')!.textContent!);
  const progresiones = aplicarCambiosProgresiones(base, leerJSON<CambiosProgresiones>('progresiones:cambios') ?? {}).filter((p) => {
    try {
      analizarProgresion(p.compases);
      return true;
    } catch {
      return false;
    }
  });

  interface Opciones {
    progresion: string;
    zona: number;
    tension: boolean;
  }
  const CLAVE = 'shells:opciones';
  const op: Opciones = { progresion: 'ii-v-i-mayor', zona: 7, tension: false, ...leerJSON<Partial<Opciones>>(CLAVE) };
  let tonica = 'C';
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('shells:sonido');

  const selector = document.querySelector<HTMLSelectElement>('[data-progresion]')!;
  selector.innerHTML = progresiones.map((p) => `<option value="${esc(p.id)}">${esc(p.nombre)}</option>`).join('');
  if (!progresiones.some((p) => p.id === op.progresion)) op.progresion = progresiones[0]?.id ?? '';
  selector.value = op.progresion;
  const casillaTension = document.querySelector<HTMLInputElement>('[data-tension]')!;
  casillaTension.checked = op.tension;
  const lista = document.querySelector<HTMLElement>('[data-shells]')!;

  const progresion = () => progresiones.find((p) => p.id === op.progresion)!;
  function calcular(): { compases: ReturnType<typeof analizarProgresion>; shells: Shell[] } {
    const compases = analizarProgresion(progresion().compases);
    const acordes = compases.flat();
    const shells = shellsProgresion(tonica, compases, op.zona).map((s, i) => (op.tension ? conTension(s, acordes[i], tonica) : s));
    return { compases, shells };
  }

  function pintar() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-zona]')) b.setAttribute('aria-pressed', String(Number(b.dataset.zona) === op.zona));
    if (!progresiones.length) {
      lista.innerHTML = `<li class="suave">${T.sinProgresiones}</li>`;
      return;
    }
    try {
      lista.innerHTML = calcular()
        .shells.map(
          (s, i) => `<li class="shell" data-indice="${i}">
            <span class="simbolo">${esc(s.simbolo)}</span>
            <span class="forma">${esc(s.forma)}</span>
            ${diagramaSVG({ trastes: s.trastes, grados: s.grados })}
          </li>`,
        )
        .join('');
    } catch (error) {
      // Los avisos de lib/shells.ts están en español; en inglés, el suyo.
      lista.innerHTML = `<li class="suave">${esc(T === SHELLS.es ? (error as Error).message : T.sinShell)}</li>`;
    }
    guardarJSON(CLAVE, op);
  }

  selector.addEventListener('change', () => {
    op.progresion = selector.value;
    pintar();
  });
  casillaTension.addEventListener('change', () => {
    op.tension = casillaTension.checked;
    pintar();
  });
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-zona]');
    if (!b) return;
    op.zona = Number(b.dataset.zona);
    pintar();
  });

  conectarAudio((boton) => {
    const { compases, shells } = calcular();
    const { eventos, tramos, duracion } = eventosShells(compases, shells, tempo(), progresion().pulsos ?? 4, SOSTENIDOS.includes(instrumento()));
    let marcado = -1;
    const marcar = (k: number) => {
      if (k === marcado) return;
      marcado = k;
      lista.querySelector('.sonando-ahora')?.classList.remove('sonando-ahora');
      if (k >= 0) lista.querySelector(`[data-indice="${k}"]`)?.classList.add('sonando-ahora');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion,
      bucle: () => boton.dataset.audio === 'bucle',
      alProgresar: (t) => marcar(tramos.findIndex((x) => t >= x.inicio && t < x.fin)),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((t) => {
    tonica = t;
    pintar();
  });
  pintar();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.5rem;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.5rem;
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    font-weight: 700;
  }
  .campo select {
    width: auto;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .grupo-botones .etiqueta {
    margin-right: 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .shells {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 10rem), 1fr));
    gap: 0.5rem;
  }
  .shells :global(.shell) {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    padding: 0.6rem 0.4rem 0.4rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .shells :global(.shell.sonando-ahora) {
    background: var(--acento-suave);
    border-color: var(--acento);
    box-shadow: 0 0 0 1px var(--acento);
  }
  .shells :global(.simbolo) {
    font-weight: 700;
    font-size: 1.15rem;
  }
  .shells :global(.forma) {
    font-size: 0.75rem;
    color: var(--texto-suave);
    text-align: center;
  }
  .shells :global(.diagrama) {
    max-width: 9rem;
    margin-top: 0.25rem;
  }
</style>
