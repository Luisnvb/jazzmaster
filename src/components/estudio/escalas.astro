---
// Escalas (sección Estudio). El texto está en src/data/estudio/escalas.md; aquí va
// el mapa del mástil con las notas de la escala y las del acorde (lib/arpegios.ts). En
// inglés, escalas.en.md e i18n/estudio/escalas.ts; lo usan pages/estudio/escalas.astro y
// pages/en/study/scales.astro.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import Acompanamiento from '../../components/Acompanamiento.astro';
import * as es from '../../data/estudio/escalas.md';
import * as en from '../../data/estudio/escalas.en.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { porOrden } from '../../lib/orden.ts';
import type { Idioma } from '../../i18n/idiomas.ts';
import { INTERFAZ, nombreSonido } from '../../i18n/interfaz.ts';
import { ESCALAS_ESTUDIO } from '../../i18n/estudio/escalas.ts';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const T = ESCALAS_ESTUDIO[idioma];
const I = INTERFAZ[idioma];
const { Content, getHeadings } = idioma === 'en' ? en : es;
const ingles = idioma === 'en';
const indice = getHeadings().filter((h) => h.depth === 2);
const grupos = porOrden(await getCollection('grupos'));
const escalas = porOrden(await getCollection('escalas')).map(({ id, data }) => ({
  id,
  nombre: (ingles && data.en?.nombre) || data.nombre,
  grupo: data.grupo.id,
  formula: data.formula,
  // Las notas del acorde de su tipo (grupos.yaml), para marcarlas dentro de la escala.
  acorde: grupos.find((g) => g.id === data.grupo.id)?.data.arpegio ?? [],
}));
const datos = JSON.stringify(escalas).replace(/</g, '\\u003c');
const CUERDAS = [6, 5, 4, 3, 2, 1];
const RECORRIDOS = ['grados', 'terceras', 'grupos-3', 'grupos-4'].map((v, i) => [v, T.recorridos[i]]);
const ordinal = (c: number) => (ingles ? `${c}${['', 'st', 'nd', 'rd'][c] ?? 'th'}` : `${c}ª`);
import { ULTIMA_POSICION } from '../../lib/arpegios.ts';
---

<Base titulo={T.titulo}>
  <SelectorTonica clave="estudio-escalas" idioma={idioma}>
    <label>{I.sonido}
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{nombreSonido(i, idioma)}</option>)}</select>
    </label>
    <Tempo clave="estudio-escalas" inicial={90} />
  </SelectorTonica>

  <section class="ejemplo" aria-label={T.mapa}>
    <div class="opciones">
      <label class="campo">{T.escala}
        <select data-escala>
          {
            grupos.map((g) => (
              <optgroup label={(ingles && g.data.en?.nombre) || g.data.nombre}>
                {escalas.filter((e) => e.grupo === g.id).map((e) => <option value={e.id}>{e.nombre}</option>)}
              </optgroup>
            ))
          }
        </select>
      </label>
      <div class="grupo-botones" role="group" aria-label={T.zona}>
        <button type="button" class="boton" data-zona="todo" aria-pressed="false">{T.todo}</button>
        <button type="button" class="boton" data-zona="posicion" aria-pressed="false">{T.posicion}</button>
        <button type="button" class="boton" data-zona="cuerda" aria-pressed="false">{T.unaCuerda}</button>
        <button type="button" class="boton" data-zona="dos-cuerdas" aria-pressed="false">{T.dosCuerdas}</button>
      </div>
      <label class="campo" data-solo="posicion">{T.desde}
        <select data-desde>{Array.from({ length: ULTIMA_POSICION }, (_, i) => <option value={i + 1}>{i + 1}</option>)}</select>
      </label>
      <label class="campo" data-solo="cuerda">{T.cuerda}
        <select data-cuerda>{CUERDAS.map((c) => <option value={6 - c}>{ordinal(c)}</option>)}</select>
      </label>
      <label class="campo" data-solo="dos-cuerdas">{T.cuerdas}
        <select data-dos-cuerdas>{CUERDAS.slice(0, 5).map((c) => <option value={6 - c}>{ordinal(c)} {T.y} {ordinal(c - 1)}</option>)}</select>
      </label>
      <label class="campo">{T.recorrido}
        <select data-recorrido>{RECORRIDOS.map(([v, n]) => <option value={v}>{n}</option>)}</select>
      </label>
      <label class="casilla"><input type="checkbox" data-pedal /> {T.pedal}</label>
    </div>
    <p class="titulo-escala" data-titulo></p>
    <div class="mastil-caja" data-mastil></div>
    <p class="suave leyenda">{T.leyenda}</p>
    <div class="botones-audio">
      <button type="button" data-audio="una" aria-pressed="false">{T.tocar}</button>
      <button type="button" data-audio="bucle" aria-pressed="false" title={T.bucleAyuda}>{T.bucle}</button>
      <button type="button" data-detener>{I.detener}</button>
    </div>
    <Acompanamiento clave="estudio-escalas" idioma={idioma} />
  </section>

  <nav class="indice" aria-label={I.enEstaPagina}>
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>

  <script type="application/json" id="datos-escalas-estudio" set:html={datos} />
</Base>

<script>
  import { idiomaValido } from '../../i18n/idiomas.ts';
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { eventosArpegio, mastilSVG, notasFormula, ordenadas, recorrido, secuenciaZona, type NotaMastil, type Zona, posicionValida } from '../../lib/arpegios.ts';
  import { conectarAcompanamiento, conectarAudio, conectarInstrumento, conectarTempo, conectarTonica, mostrarZona } from '../../lib/cliente.ts';
  import { parseNota, pitchClass } from '../../lib/teoria.ts';

  interface Escala {
    id: string;
    nombre: string;
    grupo: string;
    formula: string[];
    acorde: string[];
  }
  const ingles = idiomaValido(document.documentElement.lang) === 'en';
  const escalas: Escala[] = JSON.parse(document.getElementById('datos-escalas-estudio')!.textContent!);

  interface Opciones {
    escala: string;
    zona: Zona['tipo'];
    desde: number;
    cuerda: number;
    dosCuerdas: number;
    recorrido: string;
    pedal: boolean;
  }
  const CLAVE = 'estudio-escalas:opciones';
  const op: Opciones = {
    escala: 'jonico',
    zona: 'posicion',
    desde: 7,
    cuerda: 5,
    dosCuerdas: 4,
    recorrido: 'grados',
    pedal: false,
    ...leerJSON<Partial<Opciones>>(CLAVE),
  };
  op.desde = posicionValida(op.desde);
  if (!escalas.some((e) => e.id === op.escala)) op.escala = escalas[0].id;
  let tonica = 'C';
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('estudio-escalas:sonido');

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const selects = {
    escala: $<HTMLSelectElement>('[data-escala]'),
    desde: $<HTMLSelectElement>('[data-desde]'),
    cuerda: $<HTMLSelectElement>('[data-cuerda]'),
    dosCuerdas: $<HTMLSelectElement>('[data-dos-cuerdas]'),
    recorrido: $<HTMLSelectElement>('[data-recorrido]'),
  };
  const casillaPedal = $<HTMLInputElement>('[data-pedal]');
  for (const [k, sel] of Object.entries(selects)) sel.value = String(op[k as keyof typeof selects]);
  casillaPedal.checked = op.pedal;
  const caja = $('[data-mastil]');
  const titulo = $('[data-titulo]');

  const escala = () => escalas.find((e) => e.id === op.escala)!;
  const zona = (): Zona =>
    op.zona === 'posicion'
      ? { tipo: 'posicion', desde: op.desde }
      : op.zona === 'cuerda'
        ? { tipo: 'cuerda', cuerda: op.cuerda }
        : op.zona === 'dos-cuerdas'
          ? { tipo: 'dos-cuerdas', cuerda: op.dosCuerdas }
          : { tipo: 'todo' };
  const notas = () => notasFormula(tonica, escala().formula, escala().acorde);
  // De fondo, el acorde de la escala (el de su tipo en grupos.yaml).
  const acomp = conectarAcompanamiento(() => ({ raiz: tonica, formula: escala().acorde }), tempo);

  function pintar() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-zona]')) b.setAttribute('aria-pressed', String(b.dataset.zona === op.zona));
    for (const el of document.querySelectorAll<HTMLElement>('[data-solo]')) el.hidden = el.dataset.solo !== op.zona;
    const e = escala();
    titulo.innerHTML = `<strong>${esc(tonica)} ${esc(ingles ? e.nombre : e.nombre.toLowerCase())}</strong> · ${esc(e.formula.join(' '))}`;
    caja.innerHTML = mastilSVG(notas(), zona(), [], undefined, ingles ? 'en' : 'es');
    mostrarZona(caja);
    guardarJSON(CLAVE, op);
    acomp.actualizar();
  }

  for (const [k, sel] of Object.entries(selects)) {
    sel.addEventListener('change', () => {
      const v = sel.value;
      (op as unknown as Record<string, unknown>)[k] = ['desde', 'cuerda', 'dosCuerdas'].includes(k) ? Number(v) : v;
      pintar();
    });
  }
  casillaPedal.addEventListener('change', () => {
    op.pedal = casillaPedal.checked;
    guardarJSON(CLAVE, op);
  });
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-zona]');
    if (!b) return;
    op.zona = b.dataset.zona as Zona['tipo'];
    pintar();
  });

  const CELULAS: Record<string, number[]> = { terceras: [0, 2], 'grupos-3': [0, 1, 2], 'grupos-4': [0, 1, 2, 3] };

  conectarAudio((boton) => {
    if (boton.dataset.audio === 'acompanar') return acomp.reproduccion();
    const n = notas();
    const z = zona();
    const lista: NotaMastil[] = op.recorrido === 'grados' ? recorrido(n, z) : secuenciaZona(n, z, CELULAS[op.recorrido]);
    // La tónica como pedal, entre E2 y D#3 (el registro más grave de la guitarra).
    const pedal = op.pedal ? 40 + ((pitchClass(parseNota(tonica)) - 4 + 12) % 12) : undefined;
    const { eventos, duracion } = eventosArpegio(lista, tempo(), op.zona === 'todo' && ordenadas(n, z).length > 30, pedal);
    const paso = duracion / (lista.length + 2);
    let marcado = -1;
    const marcar = (k: number) => {
      if (k === marcado) return;
      marcado = k;
      caja.querySelector('.sonando')?.classList.remove('sonando');
      const x = lista[k];
      if (x) caja.querySelector(`.nota[data-midi="${x.midi}"][data-cuerda="${x.cuerda}"]`)?.classList.add('sonando');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion,
      bucle: () => boton.dataset.audio === 'bucle',
      alProgresar: (t) => marcar(Math.min(lista.length - 1, Math.floor(t / paso))),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((t) => {
    tonica = t;
    pintar();
  });
  pintar();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.5rem;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.5rem;
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    font-weight: 700;
  }
  .campo select {
    width: auto;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .titulo-escala {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }
  /* El mástil no cabe en el móvil: se desplaza en horizontal dentro de su caja. */
  .mastil-caja {
    overflow-x: auto;
    padding: 0.25rem 0.5rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .leyenda {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
  }
</style>
