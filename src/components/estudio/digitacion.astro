---
// Digitación y posiciones (sección Estudio). El texto está en src/data/estudio/digitacion.md;
// aquí va el comparador de dos digitaciones de una escala (lib/digitacion.ts). En inglés,
// digitacion.en.md e i18n/estudio/digitacion.ts; lo usan pages/estudio/digitacion.astro y
// pages/en/study/fingering.astro.
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import * as es from '../../data/estudio/digitacion.md';
import * as en from '../../data/estudio/digitacion.en.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { ESCALAS_DIGITACION, SISTEMAS } from '../../lib/digitacion.ts';
import { formatear, type Idioma } from '../../i18n/idiomas.ts';
import { INTERFAZ, nombreSonido } from '../../i18n/interfaz.ts';
import { DIGITACION } from '../../i18n/estudio/digitacion.ts';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const T = DIGITACION[idioma];
const I = INTERFAZ[idioma];
const { Content, getHeadings } = idioma === 'en' ? en : es;
const indice = getHeadings().filter((h) => h.depth === 2);
const LADOS = ['A', 'B'];
---

<Base titulo={T.titulo}>
  <SelectorTonica clave="estudio-digitacion" idioma={idioma}>
    <label>{I.sonido}
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{nombreSonido(i, idioma)}</option>)}</select>
    </label>
    <Tempo clave="estudio-digitacion" inicial={90} />
  </SelectorTonica>

  <section class="ejemplo" aria-label={T.comparador}>
    <div class="opciones">
      <div class="grupo-botones" role="group" aria-label={T.escala}>
        <span class="etiqueta">{T.escala}</span>
        {ESCALAS_DIGITACION.map((e) => <button type="button" class="boton" data-escala={e.id} aria-pressed="false"><span data-tonica-texto>C</span> {T.escalas[e.id] ?? e.nombre.toLowerCase()}</button>)}
      </div>
      <div class="grupo-botones" role="group" aria-label={T.queSeVe}>
        <span class="etiqueta">{T.enCadaNota}</span>
        <button type="button" class="boton" data-rotulo="dedo" aria-pressed="false">{T.dedo}</button>
        <button type="button" class="boton" data-rotulo="grado" aria-pressed="false">{T.grado}</button>
      </div>
      <!-- En el móvil, la escala y el rótulo van en selectores en vez de botones. -->
      <label class="campo solo-movil">{T.escala}
        <select data-sel-escala>
          {ESCALAS_DIGITACION.map((e) => {
            const nombre = T.escalas[e.id] ?? e.nombre.toLowerCase();
            return <option value={e.id} data-nombre={nombre}>C {nombre}</option>;
          })}
        </select>
      </label>
      <label class="campo solo-movil">{T.enCadaNota}
        <select data-sel-rotulo>
          <option value="dedo">{T.dedo}</option>
          <option value="grado">{T.grado}</option>
        </select>
      </label>
    </div>

    {
      LADOS.map((l, i) => (
        <div class="lado" data-lado={i}>
          <div class="cabecera-lado">
            <span class="letra" aria-hidden="true">{l}</span>
            <label class="campo">{T.sistema}
              <select data-sistema>{Object.keys(SISTEMAS).map((v) => <option value={v}>{T.sistemas[v]}</option>)}</select>
            </label>
            <label class="campo">{T.forma}
              <select data-forma></select>
            </label>
            <button type="button" class="boton" data-audio={`lado-${i}`} aria-pressed="false">{formatear(T.tocar, { lado: l })}</button>
          </div>
          <div class="mastil-caja" data-mastil></div>
          <ul class="datos" data-datos></ul>
        </div>
      ))
    }
    <p class="suave leyenda">{T.leyenda}</p>
    <div class="botones-audio">
      <button type="button" data-audio="seguidas" aria-pressed="false">{T.seguidas}</button>
      <button type="button" data-detener>{I.detener}</button>
    </div>
  </section>

  <nav class="indice" aria-label={I.enEstaPagina}>
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>
</Base>

<script>
  import { formatear, idiomaValido } from '../../i18n/idiomas.ts';
  import { DIGITACION } from '../../i18n/estudio/digitacion.ts';
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { eventosArpegio, mastilSVG, notasFormula, TRASTES, type NotaMastil } from '../../lib/arpegios.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica, mostrarZona } from '../../lib/cliente.ts';
  import { ESCALAS_DIGITACION, POSICIONES, conOctava, digitar, subeYBaja, type Digitacion, type NotaDigitada, type Sistema } from '../../lib/digitacion.ts';
  import { formatNota, notaDeGrado } from '../../lib/teoria.ts';

  interface Lado {
    sistema: Sistema;
    forma: number;
  }
  interface Opciones {
    escala: string;
    rotulo: 'dedo' | 'grado';
    lados: [Lado, Lado];
  }
  const T = DIGITACION[idiomaValido(document.documentElement.lang)];
  const CLAVE = 'estudio-digitacion:opciones';
  const guardadas = leerJSON<Partial<Opciones>>(CLAVE) ?? {};
  const op: Opciones = {
    escala: 'mayor',
    rotulo: 'dedo',
    ...guardadas,
    lados: [
      { sistema: 'posicion', forma: 7, ...guardadas.lados?.[0] },
      { sistema: 'tres', forma: 0, ...guardadas.lados?.[1] },
    ],
  };
  if (!ESCALAS_DIGITACION.some((e) => e.id === op.escala)) op.escala = 'mayor';
  const formasDe = (s: Sistema) => (s === 'posicion' ? POSICIONES : [0, 1, 2, 3, 4, 5, 6]);
  for (const l of op.lados) {
    if (l.sistema !== 'posicion' && l.sistema !== 'tres') l.sistema = 'posicion';
    if (!formasDe(l.sistema).includes(l.forma)) l.forma = formasDe(l.sistema)[0];
  }

  let tonica = 'C';
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('estudio-digitacion:sonido');
  const lados = [...document.querySelectorAll<HTMLElement>('[data-lado]')];
  const escala = () => ESCALAS_DIGITACION.find((e) => e.id === op.escala)!;
  let digitaciones: Digitacion[] = [];

  function opcionesForma(i: number) {
    const sel = lados[i].querySelector<HTMLSelectElement>('[data-forma]')!;
    const l = op.lados[i];
    const f = escala().formula;
    sel.innerHTML = formasDe(l.sistema)
      .map((k) => {
        const texto =
          l.sistema === 'posicion'
            ? formatear(T.posicion, { n: k })
            : formatear(T.desde, { grado: f[k], nota: formatNota(notaDeGrado(tonica, f[k])) });
        return `<option value="${k}">${esc(texto)}</option>`;
      })
      .join('');
    sel.value = String(l.forma);
  }

  function datos(d: Digitacion): string {
    const fila = (k: string, v: string) => `<li><span class="suave">${esc(k)}</span> ${v}</li>`;
    const graves = d.notas[0];
    const agudas = d.notas[d.notas.length - 1];
    return [
      fila(T.trastes, `<strong>${d.desde}–${d.hasta}</strong> (${d.hasta - d.desde + 1})`),
      fila(T.notasPorCuerda, `<strong>${d.porCuerda.join('·')}</strong>`),
      fila(T.notas, formatear(T.deA, { n: `<strong>${d.notas.length}</strong>`, grave: esc(conOctava(graves)), aguda: esc(conOctava(agudas)) })),
      fila(T.estiramientos, `<strong>${d.estiramientos}</strong>`),
      fila(T.cambios, `<strong>${d.cambios}</strong>`),
    ].join('');
  }

  const selEscala = document.querySelector<HTMLSelectElement>('[data-sel-escala]')!;
  const selRotulo = document.querySelector<HTMLSelectElement>('[data-sel-rotulo]')!;
  selEscala.addEventListener('change', () => ((op.escala = selEscala.value), pintar()));
  selRotulo.addEventListener('change', () => ((op.rotulo = selRotulo.value as Opciones['rotulo']), pintar()));

  function pintar() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-escala]')) b.setAttribute('aria-pressed', String(b.dataset.escala === op.escala));
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-rotulo]')) b.setAttribute('aria-pressed', String(b.dataset.rotulo === op.rotulo));
    // Selectores del móvil: lo mismo que los botones (la escala, con la tónica delante).
    for (const o of selEscala.options) o.textContent = `${tonica} ${o.dataset.nombre}`;
    selEscala.value = op.escala;
    selRotulo.value = op.rotulo;
    const f = escala().formula;
    digitaciones = op.lados.map((l) => digitar(tonica, f, l.sistema, l.forma));
    // Los dos mástiles, del mismo largo para que se puedan comparar.
    const largo = Math.max(TRASTES, ...digitaciones.map((d) => d.hasta));
    const todas = notasFormula(tonica, f).filter((n) => n.traste <= largo);
    digitaciones.forEach((d, i) => {
      const caja = lados[i].querySelector<HTMLElement>('[data-mastil]')!;
      const ocupadas = new Set(d.notas.map((n) => `${n.cuerda}-${n.traste}`));
      const fondo: NotaMastil[] = [...todas, ...masAlla(f, largo)]
        .filter((n) => !ocupadas.has(`${n.cuerda}-${n.traste}`))
        .map((n) => ({ ...n, atenuada: true }));
      const propias: NotaMastil[] = d.notas.map((n) => ({
        ...n,
        atenuada: false,
        rotulo: op.rotulo === 'dedo' ? String(n.dedo) : n.grado,
        clase: [n.estiramiento ? 'estirada' : '', n.cambio ? 'cambio' : ''].filter(Boolean).join(' ') || undefined,
      }));
      caja.innerHTML = mastilSVG([...fondo, ...propias], { tipo: 'trastes', desde: d.desde, hasta: d.hasta }, [], largo);
      mostrarZona(caja);
      lados[i].querySelector('[data-datos]')!.innerHTML = datos(d);
      lados[i].querySelector<HTMLSelectElement>('[data-sistema]')!.value = op.lados[i].sistema;
      opcionesForma(i);
    });
    guardarJSON(CLAVE, op);
  }

  /** Notas de la escala entre el traste 16 y el último dibujado (notasFormula llega al 15). */
  function masAlla(f: readonly string[], largo: number): NotaMastil[] {
    if (largo <= TRASTES) return [];
    return notasFormula(tonica, f)
      .filter((n) => n.traste + 12 > TRASTES && n.traste + 12 <= largo)
      .map((n) => ({ ...n, traste: n.traste + 12, midi: n.midi + 12 }));
  }

  lados.forEach((el, i) => {
    el.querySelector<HTMLSelectElement>('[data-sistema]')!.addEventListener('change', (e) => {
      const s = (e.target as HTMLSelectElement).value as Sistema;
      op.lados[i] = { sistema: s, forma: s === 'posicion' ? 7 : 0 };
      pintar();
    });
    el.querySelector<HTMLSelectElement>('[data-forma]')!.addEventListener('change', (e) => {
      op.lados[i].forma = Number((e.target as HTMLSelectElement).value);
      pintar();
    });
  });
  document.addEventListener('click', (e) => {
    const el = e.target as Element;
    const be = el.closest<HTMLButtonElement>('button[data-escala]');
    if (be) {
      op.escala = be.dataset.escala!;
      return pintar();
    }
    const br = el.closest<HTMLButtonElement>('button[data-rotulo]');
    if (br) {
      op.rotulo = br.dataset.rotulo as Opciones['rotulo'];
      pintar();
    }
  });

  conectarAudio((boton) => {
    const cuales = boton.dataset.audio === 'seguidas' ? [0, 1] : [Number(boton.dataset.audio!.slice(5))];
    const lista: { n: NotaDigitada; lado: number }[] = cuales.flatMap((i) => subeYBaja(digitaciones[i]).map((n) => ({ n, lado: i })));
    const { eventos, duracion } = eventosArpegio(
      lista.map((x) => x.n),
      tempo(),
    );
    const paso = duracion / (lista.length + 2);
    let marcado = -1;
    const marcar = (k: number) => {
      if (k === marcado) return;
      marcado = k;
      for (const l of lados) l.querySelector('.sonando')?.classList.remove('sonando');
      const x = lista[k];
      if (x) lados[x.lado].querySelector(`.nota[data-midi="${x.n.midi}"][data-cuerda="${x.n.cuerda}"]:not(.fuera)`)?.classList.add('sonando');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion,
      alProgresar: (t) => marcar(Math.min(lista.length - 1, Math.floor(t / paso))),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((t) => {
    tonica = t;
    for (const el of document.querySelectorAll('[data-tonica-texto]')) el.textContent = t;
    pintar();
  });
  pintar();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.5rem;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.5rem;
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .grupo-botones .etiqueta {
    margin-right: 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .lado {
    margin-bottom: 1.25rem;
  }
  .cabecera-lado {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-bottom: 0.5rem;
  }
  .letra {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    font-weight: 800;
    color: var(--sobre-acento);
    background: var(--acento);
    border-radius: 50%;
  }
  /* Móvil: selectores de escala y rótulo en vez de sus filas de botones. */
  .campo.solo-movil {
    display: none;
  }
  @media (max-width: 40rem) {
    .opciones > .grupo-botones {
      display: none;
    }
    .campo.solo-movil {
      display: flex;
    }
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    font-weight: 700;
  }
  .campo select {
    width: auto;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  /* El mástil no cabe en el móvil: se desplaza en horizontal dentro de su caja. */
  .mastil-caja {
    overflow-x: auto;
    padding: 0.25rem 0.5rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .mastil-caja :global(.nota.estirada circle) {
    stroke: var(--acento); /* COLOR: nota que se toca estirando un dedo */
    stroke-width: 2.5;
    stroke-dasharray: 3 2.5;
  }
  .mastil-caja :global(.nota.cambio circle) {
    stroke: var(--acento); /* COLOR: nota en la que la mano cambia de posición */
    stroke-width: 4;
  }
  .datos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    font-size: 0.92rem;
  }
  .leyenda {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
  }
</style>
