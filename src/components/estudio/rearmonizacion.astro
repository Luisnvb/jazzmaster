---
// Rearmonización (sección Estudio). El texto está en src/data/estudio/rearmonizacion.md;
// aquí va el ejemplo (lib/rearmonizacion.ts): técnicas combinables sobre una progresión. En
// inglés, rearmonizacion.en.md e i18n/estudio/rearmonizacion.ts; lo usan
// pages/estudio/rearmonizacion.astro y pages/en/study/reharmonization.astro.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import * as es from '../../data/estudio/rearmonizacion.md';
import * as en from '../../data/estudio/rearmonizacion.en.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { porOrden } from '../../lib/orden.ts';
import { TECNICAS } from '../../lib/rearmonizacion.ts';
import type { Idioma } from '../../i18n/idiomas.ts';
import { INTERFAZ, nombreSonido } from '../../i18n/interfaz.ts';
import { REARMONIZACION } from '../../i18n/estudio/rearmonizacion.ts';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const T = REARMONIZACION[idioma];
const I = INTERFAZ[idioma];
const { Content, getHeadings } = idioma === 'en' ? en : es;
const indice = getHeadings().filter((h) => h.depth === 2);
const progresiones = porOrden(await getCollection('progresiones')).map(({ id, data }) => ({
  id,
  nombre: (idioma === 'en' && data.en?.nombre) || data.nombre,
  pulsos: data.pulsos,
  compases: data.compases,
}));
const datos = JSON.stringify(progresiones).replace(/</g, '\\u003c');
---

<Base titulo={T.titulo}>
  <SelectorTonica clave="rearmonizacion" idioma={idioma}>
    <label>{I.sonido}
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{nombreSonido(i, idioma)}</option>)}</select>
    </label>
    <Tempo clave="rearmonizacion" inicial={100} />
  </SelectorTonica>

  <section class="ejemplo" aria-label={T.laboratorio}>
    <label class="campo">{T.progresion}
      <select data-progresion></select>
    </label>
    <fieldset class="tecnicas">
      <legend>{T.tecnicasTitulo}</legend>
      {
        TECNICAS.map((t) => (
          <label class="tecnica">
            <input type="checkbox" data-tecnica={t.id} />
            <span>
              <strong>{T.tecnicas[t.id]?.nombre ?? t.nombre}</strong>
              <span class="suave">{T.tecnicas[t.id]?.descripcion ?? t.descripcion}</span>
            </span>
          </label>
        ))
      }
    </fieldset>

    <div class="version">
      <div class="cabecera-version">
        <h2>{T.original}</h2>
        <button type="button" class="boton" data-audio="original" aria-pressed="false">{T.tocarOriginal}</button>
      </div>
      <div class="compases-rearm" data-original></div>
    </div>
    <div class="version">
      <div class="cabecera-version">
        <h2>{T.rearmonizada}</h2>
        <button type="button" class="boton" data-audio="rearmonizada" aria-pressed="false">{T.tocarRearmonizada}</button>
      </div>
      <div class="compases-rearm" data-rearmonizada></div>
    </div>
    <div class="botones-audio">
      <button type="button" class="boton" data-bucle aria-pressed="false" title={T.bucleAyuda}>{T.bucle}</button>
      <button type="button" data-detener>{I.detener}</button>
    </div>
  </section>

  <nav class="indice" aria-label={I.enEstaPagina}>
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>

  <script type="application/json" id="datos-rearmonizacion" set:html={datos} />
</Base>

<script>
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { SOSTENIDOS } from '../../lib/audio.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica } from '../../lib/cliente.ts';
  import { analizarProgresion, aplicarCambiosProgresiones, secuenciaProgresion, simboloEn, type CambiosProgresiones, type Progresion } from '../../lib/progresiones.ts';
  import { rearmonizar } from '../../lib/rearmonizacion.ts';

  // Las progresiones de la sección Progresiones, con lo editado en este navegador.
  const base: Progresion[] = JSON.parse(document.getElementById('datos-rearmonizacion')!.textContent!);
  const progresiones = aplicarCambiosProgresiones(base, leerJSON<CambiosProgresiones>('progresiones:cambios') ?? {}).filter((p) => {
    try {
      analizarProgresion(p.compases);
      return true;
    } catch {
      return false;
    }
  });

  interface Opciones {
    progresion: string;
    tecnicas: string[];
    bucle: boolean;
  }
  const CLAVE = 'rearmonizacion:opciones';
  const op: Opciones = { progresion: 'turnaround-dominantes', tecnicas: ['dominantes', 'tritonal'], bucle: false, ...leerJSON<Partial<Opciones>>(CLAVE) };
  let tonica = 'C';
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('rearmonizacion:sonido');

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const selector = $<HTMLSelectElement>('[data-progresion]');
  selector.innerHTML = progresiones.map((p) => `<option value="${esc(p.id)}">${esc(p.nombre)}</option>`).join('');
  if (!progresiones.some((p) => p.id === op.progresion)) op.progresion = progresiones[0]?.id ?? '';
  selector.value = op.progresion;
  for (const c of document.querySelectorAll<HTMLInputElement>('[data-tecnica]')) c.checked = op.tecnicas.includes(c.dataset.tecnica!);
  const botonBucle = $<HTMLButtonElement>('[data-bucle]');

  const progresion = () => progresiones.find((p) => p.id === op.progresion)!;
  const original = () => progresion().compases;
  const rearmonizada = () => rearmonizar(original(), op.tecnicas);

  /** Compases con sus acordes; en la rearmonizada se marcan los que no estaban en ese compás. */
  function htmlCompases(compases: string[], comparar?: string[]): string {
    let k = 0;
    return analizarProgresion(compases)
      .map((acordes, i) => {
        const antes = comparar ? comparar[i].trim().split(/\s+/) : null;
        return `<div class="compas-rearm" style="--n:${acordes.length}">${acordes
          .map((a) => {
            const nuevo = antes && !antes.includes(a.texto);
            return `<span class="acorde-rearm${nuevo ? ' nuevo' : ''}" data-k="${k++}"><span class="simbolo">${esc(simboloEn(tonica, a))}</span><span class="grado">${esc(a.texto)}</span></span>`;
          })
          .join('')}</div>`;
      })
      .join('');
  }

  function pintar() {
    $('[data-original]').innerHTML = htmlCompases(original());
    $('[data-rearmonizada]').innerHTML = htmlCompases(rearmonizada(), original());
    botonBucle.setAttribute('aria-pressed', String(op.bucle));
    guardarJSON(CLAVE, op);
  }

  selector.addEventListener('change', () => ((op.progresion = selector.value), pintar()));
  for (const c of document.querySelectorAll<HTMLInputElement>('[data-tecnica]')) {
    c.addEventListener('change', () => {
      // Dominantes secundarios e ii–V secundarios usan el mismo hueco del compás: o uno u otro.
      const excluyente = { dominantes: 'ii-v', 'ii-v': 'dominantes' }[c.dataset.tecnica!];
      if (c.checked && excluyente) document.querySelector<HTMLInputElement>(`[data-tecnica="${excluyente}"]`)!.checked = false;
      op.tecnicas = [...document.querySelectorAll<HTMLInputElement>('[data-tecnica]:checked')].map((x) => x.dataset.tecnica!);
      pintar();
    });
  }
  botonBucle.addEventListener('click', () => ((op.bucle = !op.bucle), pintar()));

  conectarAudio((boton) => {
    const cual = boton.dataset.audio === 'original' ? 'original' : 'rearmonizada';
    const compases = cual === 'original' ? original() : rearmonizada();
    const zona = $(`[data-${cual}]`);
    const { eventos, tramos, duracion } = secuenciaProgresion(tonica, analizarProgresion(compases), tempo(), progresion().pulsos ?? 4, {
      sostenido: SOSTENIDOS.includes(instrumento()),
    });
    let marcado = -1;
    const marcar = (k: number) => {
      if (k === marcado) return;
      marcado = k;
      document.querySelector('.acorde-rearm.sonando-ahora')?.classList.remove('sonando-ahora');
      if (k >= 0) zona.querySelector(`[data-k="${k}"]`)?.classList.add('sonando-ahora');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion,
      bucle: () => op.bucle,
      alProgresar: (t) => marcar(tramos.findIndex((x) => t >= x.inicio && t < x.fin)),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((t) => {
    tonica = t;
    pintar();
  });
  pintar();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.5rem;
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    font-weight: 700;
  }
  .campo select {
    width: auto;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  .tecnicas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 0.4rem 1rem;
    margin: 0.9rem 0 1.25rem;
    padding: 0.75rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .tecnicas legend {
    padding: 0 0.3rem;
    font-weight: 700;
    color: var(--texto);
  }
  .tecnica {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: var(--texto);
    font-size: 0.9rem;
  }
  .tecnica input {
    flex: 0 0 auto;
    width: 1.1rem;
    height: 1.1rem;
    margin: 0.15rem 0 0;
    accent-color: var(--acento);
  }
  .tecnica > span {
    display: grid;
  }
  .tecnica .suave {
    font-size: 0.82rem;
  }
  .version {
    margin-bottom: 1rem;
  }
  .cabecera-version {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }
  .cabecera-version h2 {
    margin: 0;
    font-size: 1.15rem;
  }
  .compases-rearm {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(50%, 11rem), 1fr));
    border-left: 2px solid var(--texto-suave);
  }
  .compases-rearm :global(.compas-rearm) {
    display: flex;
    min-height: 3.5rem;
    border-right: 2px solid var(--texto-suave);
    border-bottom: 1px solid var(--borde);
  }
  .compases-rearm :global(.acorde-rearm) {
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.1rem;
    margin: 0.15rem;
    padding: 0.3rem 0.1rem;
    border-radius: var(--radio);
    text-align: center;
  }
  /* Acordes que cambian respecto a la original. */
  .compases-rearm :global(.acorde-rearm.nuevo) {
    background: var(--acento-suave); /* COLOR: acorde cambiado por la rearmonización */
  }
  .compases-rearm :global(.acorde-rearm.sonando-ahora) {
    box-shadow: 0 0 0 2px var(--acento);
  }
  .compases-rearm :global(.simbolo) {
    font-weight: 700;
    font-size: clamp(0.8rem, calc(1.15rem - (var(--n, 1) - 1) * 0.12rem), 1.15rem);
    overflow-wrap: anywhere;
  }
  .compases-rearm :global(.grado) {
    font-size: 0.72rem;
    color: var(--acento);
    overflow-wrap: anywhere;
  }
</style>
