---
// Notas guía (sección Estudio). El texto está en src/data/estudio/notas-guia.md;
// aquí va el ejemplo interactivo (lib/notas-guia.ts) con las progresiones de la web. En
// inglés, notas-guia.en.md e i18n/estudio/notas-guia.ts; lo usan pages/estudio/notas-guia.astro
// y pages/en/study/guide-tones.astro.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import * as es from '../../data/estudio/notas-guia.md';
import * as en from '../../data/estudio/notas-guia.en.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { porOrden } from '../../lib/orden.ts';
import type { Idioma } from '../../i18n/idiomas.ts';
import { INTERFAZ, nombreSonido } from '../../i18n/interfaz.ts';
import { NOTAS_GUIA } from '../../i18n/estudio/notas-guia.ts';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const T = NOTAS_GUIA[idioma];
const I = INTERFAZ[idioma];
const { Content, getHeadings } = idioma === 'en' ? en : es;
const ingles = idioma === 'en';
const indice = getHeadings().filter((h) => h.depth === 2);
const progresiones = porOrden(await getCollection('progresiones')).map(({ id, data }) => ({
  id,
  nombre: (ingles && data.en?.nombre) || data.nombre,
  descripcion: (ingles && data.en?.descripcion) || data.descripcion,
  pulsos: data.pulsos,
  compases: data.compases,
}));
const datos = JSON.stringify(progresiones).replace(/</g, '\\u003c');
---

<Base titulo={T.titulo}>
  <SelectorTonica clave="notas-guia" idioma={idioma}>
    <label>{I.sonido}
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{nombreSonido(i, idioma)}</option>)}</select>
    </label>
    <Tempo clave="notas-guia" inicial={80} />
  </SelectorTonica>

  <section class="ejemplo" aria-label={T.ejemplo}>
    <div class="opciones">
      <label class="progresion">{T.progresion}
        <select data-progresion></select>
      </label>
      <div class="grupo-botones" role="group" aria-label={T.vozAguda}>
        <span class="etiqueta">{T.arriba}</span>
        <button type="button" class="boton" data-arriba="7" aria-pressed="false">{T.la7}</button>
        <button type="button" class="boton" data-arriba="3" aria-pressed="false">{T.la3}</button>
      </div>
      <label class="casilla"><input type="checkbox" data-con-bajo /> {T.conBajo}</label>
    </div>
    <ol class="acordes-guia" data-acordes></ol>
    <p class="suave leyenda">
      {T.leyenda1} <span class="muestra septima">7</span> {T.leyenda7}
      <span class="muestra tercera">3</span> {T.leyenda3}
    </p>
    <div class="botones-audio">
      <button type="button" data-audio="una" aria-pressed="false">{T.tocar}</button>
      <button type="button" data-audio="bucle" aria-pressed="false" title={T.bucleAyuda}>{T.bucle}</button>
      <button type="button" data-detener>{I.detener}</button>
    </div>
  </section>

  <nav class="indice" aria-label={I.enEstaPagina}>
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>

  <script type="application/json" id="datos-guia" set:html={datos} />
</Base>

<script>
  import { idiomaValido } from '../../i18n/idiomas.ts';
  import { NOTAS_GUIA } from '../../i18n/estudio/notas-guia.ts';
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { SOSTENIDOS } from '../../lib/audio.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica } from '../../lib/cliente.ts';
  import { eventosGuia, lineasGuia, textoPaso } from '../../lib/notas-guia.ts';
  import { analizarProgresion, aplicarCambiosProgresiones, type CambiosProgresiones, type Progresion } from '../../lib/progresiones.ts';

  // Las progresiones de la sección Progresiones, con lo editado en este navegador.
  const idioma = idiomaValido(document.documentElement.lang);
  const T = NOTAS_GUIA[idioma];
  const base: Progresion[] = JSON.parse(document.getElementById('datos-guia')!.textContent!);
  const progresiones = aplicarCambiosProgresiones(base, leerJSON<CambiosProgresiones>('progresiones:cambios') ?? {}).filter((p) => {
    try {
      analizarProgresion(p.compases);
      return true;
    } catch {
      return false;
    }
  });

  interface Opciones {
    progresion: string;
    arriba: '3' | '7';
    bajo: boolean;
  }
  const CLAVE = 'notas-guia:opciones';
  const op: Opciones = { progresion: 'turnaround-dominantes', arriba: '7', bajo: true, ...leerJSON<Partial<Opciones>>(CLAVE) };
  let tonica = 'C';
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('notas-guia:sonido');

  const selector = document.querySelector<HTMLSelectElement>('[data-progresion]')!;
  selector.innerHTML = progresiones.map((p) => `<option value="${esc(p.id)}">${esc(p.nombre)}</option>`).join('');
  if (!progresiones.some((p) => p.id === op.progresion)) op.progresion = progresiones[0]?.id ?? '';
  selector.value = op.progresion;
  const casillaBajo = document.querySelector<HTMLInputElement>('[data-con-bajo]')!;
  casillaBajo.checked = op.bajo;
  const lista = document.querySelector<HTMLElement>('[data-acordes]')!;

  const progresion = () => progresiones.find((p) => p.id === op.progresion)!;
  const compases = () => analizarProgresion(progresion().compases);
  /** Si un grado hace de 7 (7, b7, bb7, 6) o de 3 (3, b3, 4). */
  const esSeptima = (g: string) => /^(b{0,2}7|b?6)$/.test(g);

  function pintar() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-arriba]')) b.setAttribute('aria-pressed', String(b.dataset.arriba === op.arriba));
    if (!progresiones.length) {
      lista.innerHTML = `<li class="suave">${T.sinProgresiones}</li>`;
      return;
    }
    const guia = lineasGuia(tonica, compases(), op.arriba);
    lista.innerHTML = guia
      .map(
        (a, i) => `<li class="acorde-guia" data-indice="${i}">
          <span class="simbolo">${esc(a.simbolo)}</span>
          <span class="romano">${esc(a.romano)}</span>
          <ul class="voces">${[...a.voces]
            .reverse()
            .map(
              (v) => `<li class="${esSeptima(v.grado) ? 'septima' : 'tercera'}">
                <span class="nota">${esc(v.nota)}</span><span class="grado">${esc(v.grado)}</span>
                <span class="paso">${esc(textoPaso(v.paso, idioma))}</span></li>`,
            )
            .join('')}</ul>
        </li>`,
      )
      .join('');
    guardarJSON(CLAVE, op);
  }

  selector.addEventListener('change', () => {
    op.progresion = selector.value;
    pintar();
  });
  casillaBajo.addEventListener('change', () => {
    op.bajo = casillaBajo.checked;
    guardarJSON(CLAVE, op);
  });
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-arriba]');
    if (!b) return;
    op.arriba = b.dataset.arriba as '3' | '7';
    pintar();
  });

  conectarAudio((boton) => {
    const c = compases();
    const { eventos, tramos, duracion } = eventosGuia(c, lineasGuia(tonica, c, op.arriba), tempo(), progresion().pulsos ?? 4, {
      bajo: op.bajo,
      sostenido: SOSTENIDOS.includes(instrumento()),
    });
    let marcado = -1;
    const marcar = (k: number) => {
      if (k === marcado) return;
      marcado = k;
      lista.querySelector('.sonando-ahora')?.classList.remove('sonando-ahora');
      if (k >= 0) lista.querySelector(`[data-indice="${k}"]`)?.classList.add('sonando-ahora');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion,
      bucle: () => boton.dataset.audio === 'bucle',
      alProgresar: (t) => marcar(tramos.findIndex((x) => t >= x.inicio && t < x.fin)),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((t) => {
    tonica = t;
    pintar();
  });
  pintar();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.5rem;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    margin-bottom: 0.5rem;
  }
  .progresion {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }
  .progresion {
    min-width: 0;
    max-width: 100%;
  }
  .progresion select {
    width: auto;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .grupo-botones .etiqueta {
    margin-right: 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .acordes-guia {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: 0.5rem;
  }
  .acordes-guia :global(.acorde-guia) {
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    padding: 0.6rem 0.4rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .acordes-guia :global(.acorde-guia.sonando-ahora) {
    background: var(--acento-suave);
    border-color: var(--acento);
    box-shadow: 0 0 0 1px var(--acento);
  }
  .acordes-guia :global(.simbolo) {
    font-weight: 700;
    font-size: 1.15rem;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .acordes-guia :global(.romano) {
    font-size: 0.78rem;
    color: var(--acento);
  }
  .acordes-guia :global(.voces) {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
    width: 100%;
  }
  .acordes-guia :global(.voces li) {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: 0.3rem;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    background: var(--fondo);
  }
  .acordes-guia :global(.voces .nota) {
    font-weight: 700;
  }
  .acordes-guia :global(.voces .grado) {
    font-size: 0.78rem;
  }
  .acordes-guia :global(.voces .paso) {
    grid-column: 1 / -1;
    min-height: 1em;
    font-size: 0.75rem;
    color: var(--texto-suave);
  }
  /* La 7 (o la 6) en color de acento; la 3 (o la 4) con borde de acento. */
  .acordes-guia :global(.voces li.septima),
  .muestra.septima {
    background: var(--acento); /* COLOR: nota guía 7 */
    border-color: var(--acento);
    color: var(--sobre-acento);
  }
  .acordes-guia :global(.voces li.septima .paso) {
    color: var(--sobre-acento);
  }
  .acordes-guia :global(.voces li.tercera),
  .muestra.tercera {
    border: 2px solid var(--acento); /* COLOR: nota guía 3 */
  }
  .muestra {
    display: inline-block;
    padding: 0 0.4rem;
    border-radius: var(--radio);
    font-weight: 700;
  }
  .leyenda {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
  }
</style>
