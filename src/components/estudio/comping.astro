---
// Comping (sección Estudio). El texto está en src/data/estudio/comping.md; aquí va el
// acompañamiento generado con ritmos, voicings y registro (lib/comping.ts). En inglés,
// comping.en.md e i18n/estudio/comping.ts; lo usan pages/estudio/comping.astro y
// pages/en/study/comping.astro.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import * as es from '../../data/estudio/comping.md';
import * as en from '../../data/estudio/comping.en.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { CELULAS } from '../../lib/comping.ts';
import { porOrden } from '../../lib/orden.ts';
import type { Idioma } from '../../i18n/idiomas.ts';
import { INTERFAZ, nombreSonido } from '../../i18n/interfaz.ts';
import { COMPING } from '../../i18n/estudio/comping.ts';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const T = COMPING[idioma];
const I = INTERFAZ[idioma];
const { Content, getHeadings } = idioma === 'en' ? en : es;
const indice = getHeadings().filter((h) => h.depth === 2);
// Solo progresiones de 4/4 (las células son de un compás de cuatro pulsos).
const progresiones = porOrden(await getCollection('progresiones'))
  .filter(({ data }) => (data.pulsos ?? 4) === 4)
  .map(({ id, data }) => ({ id, nombre: (idioma === 'en' && data.en?.nombre) || data.nombre, pulsos: data.pulsos, compases: data.compases }));
const datos = JSON.stringify(progresiones).replace(/</g, '\\u003c');
const REGISTROS = ['grave', 'medio', 'agudo', 'alternar'].map((v) => [v, T.registros[v]]);
---

<Base titulo={T.titulo}>
  <SelectorTonica clave="comping" idioma={idioma}>
    <label>{I.sonido}
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{nombreSonido(i, idioma)}</option>)}</select>
    </label>
    <Tempo clave="comping" inicial={120} />
  </SelectorTonica>

  <section class="ejemplo" aria-label={T.ejemplo}>
    <div class="opciones">
      <label class="campo">{T.progresion} <select data-progresion></select></label>
      <div class="grupo-botones" role="group" aria-label={T.ritmo}>
        <span class="etiqueta">{T.ritmo}</span>
        <button type="button" class="boton" data-variacion="fijo" aria-pressed="false">{T.fijo}</button>
        <button type="button" class="boton" data-variacion="variado" aria-pressed="false">{T.variado}</button>
      </div>
      <label class="campo" data-solo-fijo>{T.celula} <select data-celula>{CELULAS.map((c) => <option value={c.id}>{T.celulas[c.id] ?? c.nombre}</option>)}</select></label>
      <button type="button" class="boton" data-otra data-solo-variado title={T.otraAyuda}>{T.otra}</button>
    </div>
    <div class="opciones">
      <div class="grupo-botones" role="group" aria-label={T.voicings}>
        <span class="etiqueta">{T.voicings}</span>
        <button type="button" class="boton" data-voicing="drop2" aria-pressed="false">Drop 2</button>
        <button type="button" class="boton" data-voicing="shells" aria-pressed="false">Shells</button>
      </div>
      <div class="grupo-botones" role="group" aria-label={T.registro}>
        <span class="etiqueta">{T.registro}</span>
        {REGISTROS.map(([v, n]) => <button type="button" class="boton" data-registro={v} aria-pressed="false">{n}</button>)}
      </div>
    </div>
    <div class="opciones">
      <label class="casilla"><input type="checkbox" data-bajo /> {T.bajo}</label>
      <label class="casilla"><input type="checkbox" data-charles /> {T.charles}</label>
      <label class="casilla"><input type="checkbox" data-swing /> Swing</label>
    </div>
    <ol class="compases-c" data-compases></ol>
    <p class="suave leyenda">{T.leyenda}</p>
    <div class="botones-audio">
      <button type="button" data-audio="una" aria-pressed="false">{T.tocar}</button>
      <button type="button" data-audio="bucle" aria-pressed="false" title={T.bucleAyuda}>{T.bucle}</button>
      <button type="button" data-detener>{I.detener}</button>
    </div>
  </section>

  <nav class="indice" aria-label={I.enEstaPagina}>
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>

  <script type="application/json" id="datos-comping" set:html={datos} />
</Base>

<script>
  import { idiomaValido } from '../../i18n/idiomas.ts';
  import { COMPING } from '../../i18n/estudio/comping.ts';
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { SOSTENIDOS } from '../../lib/audio.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica } from '../../lib/cliente.ts';
  import { generarComping, secuenciaComping, type Comping, type Registro, type TipoVoicing, type Variacion } from '../../lib/comping.ts';
  import { diagramaSVG } from '../../lib/diagrama.ts';
  import { analizarProgresion, aplicarCambiosProgresiones, simboloEn, type CambiosProgresiones, type Progresion } from '../../lib/progresiones.ts';

  const T = COMPING[idiomaValido(document.documentElement.lang)];
  const base: Progresion[] = JSON.parse(document.getElementById('datos-comping')!.textContent!);
  const progresiones = aplicarCambiosProgresiones(base, leerJSON<CambiosProgresiones>('progresiones:cambios') ?? {}).filter((p) => {
    try {
      analizarProgresion(p.compases);
      return (p.pulsos ?? 4) === 4;
    } catch {
      return false;
    }
  });

  interface Opciones {
    progresion: string;
    variacion: Variacion;
    celula: string;
    voicing: TipoVoicing;
    registro: Registro;
    semilla: number;
    bajo: boolean;
    charles: boolean;
    swing: boolean;
  }
  const CLAVE = 'comping:opciones';
  const op: Opciones = {
    progresion: 'blues-jazz',
    variacion: 'variado',
    celula: 'charleston',
    voicing: 'drop2',
    registro: 'medio',
    semilla: 1,
    bajo: true,
    charles: true,
    swing: true,
    ...leerJSON<Partial<Opciones>>(CLAVE),
  };
  if (!progresiones.some((p) => p.id === op.progresion)) op.progresion = progresiones[0]?.id ?? '';
  let tonica = 'C';
  let comping: Comping | null = null;
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('comping:sonido');

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const selProgresion = $<HTMLSelectElement>('[data-progresion]');
  const selCelula = $<HTMLSelectElement>('[data-celula]');
  const casillas = { bajo: $<HTMLInputElement>('[data-bajo]'), charles: $<HTMLInputElement>('[data-charles]'), swing: $<HTMLInputElement>('[data-swing]') };
  const lista = $('[data-compases]');
  selProgresion.innerHTML = progresiones.map((p) => `<option value="${esc(p.id)}">${esc(p.nombre)}</option>`).join('');
  selProgresion.value = op.progresion;
  selCelula.value = op.celula;
  for (const [k, c] of Object.entries(casillas)) c.checked = op[k as keyof typeof casillas];

  const progresion = () => progresiones.find((p) => p.id === op.progresion)!;
  const compases = () => analizarProgresion(progresion().compases);
  const PULSOS = ['1', T.y, '2', T.y, '3', T.y, '4', T.y];
  const REG: Record<string, string> = T.registrosMin;

  function pintar() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-variacion]')) b.setAttribute('aria-pressed', String(b.dataset.variacion === op.variacion));
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-voicing]')) b.setAttribute('aria-pressed', String(b.dataset.voicing === op.voicing));
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-registro]')) b.setAttribute('aria-pressed', String(b.dataset.registro === op.registro));
    $('[data-solo-fijo]').hidden = op.variacion !== 'fijo';
    $('[data-solo-variado]').hidden = op.variacion !== 'variado';
    const cs = compases();
    const acordes = cs.flat();
    try {
      comping = generarComping(tonica, cs, op);
    } catch {
      comping = null;
      lista.innerHTML = `<li class="suave">${T.sinVoicing}</li>`;
      return;
    }
    lista.innerHTML = comping.compases
      .map((cc, i) => {
        const golpes = new Map(cc.golpes.map((g, k) => [g.corchea - i * 8, { g, k }]));
        const celdas = PULSOS.map((p, j) => {
          const x = golpes.get(j);
          return `<span class="celda-r ${x ? 'golpe' : ''} ${x?.g.anticipa ? 'anticipa' : ''}" ${x ? `data-k="${x.k}"` : ''}>${x?.g.anticipa ? '↷' : p}</span>`;
        }).join('');
        const diagramas = cc.acordes
          .map((k) => {
            const v = comping!.voces[cc.registro][k];
            return `<div class="acorde-r"><strong>${esc(simboloEn(tonica, acordes[k]))}</strong>${diagramaSVG({ trastes: v.trastes, grados: v.grados })}</div>`;
          })
          .join('');
        return `<li class="compas-c" data-compas="${i}">
          <div class="cabeza"><span class="num">${i + 1}</span><span class="celula">${esc(T.celulas[cc.celula.id] ?? cc.celula.nombre)}</span><span class="suave registro">${REG[cc.registro]}</span></div>
          <div class="ritmo">${celdas}</div>
          <div class="diagramas">${diagramas}</div>
        </li>`;
      })
      .join('');
    guardarJSON(CLAVE, op);
  }

  selProgresion.addEventListener('change', () => ((op.progresion = selProgresion.value), pintar()));
  selCelula.addEventListener('change', () => ((op.celula = selCelula.value), pintar()));
  for (const [k, c] of Object.entries(casillas)) c.addEventListener('change', () => (((op as unknown as Record<string, boolean>)[k] = c.checked), guardarJSON(CLAVE, op)));
  document.addEventListener('click', (e) => {
    const el = e.target as Element;
    const bv = el.closest<HTMLButtonElement>('button[data-variacion]');
    if (bv) return ((op.variacion = bv.dataset.variacion as Variacion), pintar());
    const bo = el.closest<HTMLButtonElement>('button[data-voicing]');
    if (bo) return ((op.voicing = bo.dataset.voicing as TipoVoicing), pintar());
    const br = el.closest<HTMLButtonElement>('button[data-registro]');
    if (br) return ((op.registro = br.dataset.registro as Registro), pintar());
    if (el.closest('[data-otra]')) return ((op.semilla = 1 + Math.floor(Math.random() * 1e6)), pintar());
  });

  conectarAudio((boton) => {
    if (!comping) return [];
    const { eventos, golpes, duracion } = secuenciaComping(tonica, compases(), comping, tempo(), {
      swing: op.swing ? 0.62 : 0.5,
      bajo: op.bajo,
      charles: op.charles,
      sostenido: SOSTENIDOS.includes(instrumento()),
    });
    let marcadas: Element[] = [];
    const marcar = (t: number | null) => {
      for (const el of marcadas) el.classList.remove('sonando-ahora');
      marcadas = [];
      if (t === null) return;
      const compas = Math.floor(t / ((duracion / compases().length) || 1));
      const fila = lista.querySelector(`[data-compas="${compas}"]`);
      const g = golpes.find((x) => t >= x.inicio && t < x.fin);
      const celda = g ? lista.querySelector(`[data-compas="${g.compas}"] [data-k="${g.k}"]`) : null;
      marcadas = [fila, celda].filter((x): x is Element => !!x);
      for (const el of marcadas) el.classList.add('sonando-ahora');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion,
      bucle: () => boton.dataset.audio === 'bucle',
      alProgresar: (t) => marcar(t),
      alTerminar: () => marcar(null),
    };
  });

  conectarTonica((t) => {
    tonica = t;
    pintar();
  });
  pintar();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.5rem;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.5rem;
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .grupo-botones .etiqueta {
    margin-right: 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    font-weight: 700;
  }
  .campo select {
    width: auto;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  .compases-c {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.5rem;
  }
  .compases-c :global(.compas-c) {
    display: grid;
    gap: 0.4rem;
    padding: 0.5rem 0.6rem 0.6rem;
    background: var(--tarjeta);
    border: 1px solid var(--borde);
    border-radius: var(--radio-tarjeta);
  }
  .compases-c :global(.compas-c.sonando-ahora) {
    border-color: var(--acento);
    box-shadow: 0 0 0 1px var(--acento);
  }
  .compases-c :global(.cabeza) {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .compases-c :global(.num) {
    font-weight: 800;
    color: var(--texto-suave);
  }
  .compases-c :global(.celula) {
    font-weight: 700;
  }
  .compases-c :global(.registro) {
    margin-left: auto;
    font-size: 0.78rem;
  }
  .compases-c :global(.ritmo) {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.15rem;
  }
  .compases-c :global(.celda-r) {
    padding: 0.15rem 0;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--texto-suave);
    background: var(--fondo);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .compases-c :global(.celda-r.golpe) {
    color: var(--sobre-acento);
    background: var(--acento); /* COLOR: golpe del acompañamiento */
    border-color: var(--acento);
  }
  .compases-c :global(.celda-r.sonando-ahora) {
    outline: 2px solid var(--texto);
    outline-offset: 1px;
  }
  .compases-c :global(.diagramas) {
    display: flex;
    justify-content: space-around;
    gap: 0.3rem;
  }
  .compases-c :global(.acorde-r) {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    flex: 1 1 0;
    min-width: 0;
  }
  .compases-c :global(.diagrama) {
    width: 100%;
    max-width: 6.5rem;
  }
  .leyenda {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
  }
</style>
