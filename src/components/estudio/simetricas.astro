---
// Disminuida y tonos enteros (sección Estudio). El texto está en src/data/estudio/simetricas.md;
// aquí va el mapa del mástil con la posición y dónde se repite su dibujo (lib/simetricas.ts).
// En inglés, simetricas.en.md e i18n/estudio/simetricas.ts; lo usan
// pages/estudio/simetricas.astro y pages/en/study/symmetric.astro.
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import * as es from '../../data/estudio/simetricas.md';
import * as en from '../../data/estudio/simetricas.en.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { SIMETRICAS } from '../../lib/simetricas.ts';
import type { Idioma } from '../../i18n/idiomas.ts';
import { INTERFAZ, nombreSonido } from '../../i18n/interfaz.ts';
import { SIMETRICAS_TEXTOS } from '../../i18n/estudio/simetricas.ts';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const T = SIMETRICAS_TEXTOS[idioma];
const I = INTERFAZ[idioma];
const { Content, getHeadings } = idioma === 'en' ? en : es;
const ordinal = (c: number) => (idioma === 'en' ? `${c}${['', 'st', 'nd', 'rd'][c] ?? 'th'}` : `${c}ª`);
const indice = getHeadings().filter((h) => h.depth === 2);
const CUERDAS = [6, 5, 4, 3, 2, 1];
const RECORRIDOS = ['grados', 'terceras', 'grupos-4', 'eco'].map((v, i) => [v, T.recorridos[i]]);
import { ULTIMA_POSICION } from '../../lib/arpegios.ts';
---

<Base titulo={T.titulo}>
  <SelectorTonica clave="estudio-simetricas" idioma={idioma}>
    <label>{I.sonido}
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{nombreSonido(i, idioma)}</option>)}</select>
    </label>
    <Tempo clave="estudio-simetricas" inicial={90} />
  </SelectorTonica>

  <section class="ejemplo" aria-label={T.mapa}>
    <div class="opciones">
      <label class="campo">{T.escala}
        <select data-escala>{SIMETRICAS.map((s) => <option value={s.id}>{T.escalas[s.id]?.nombre ?? s.nombre}</option>)}</select>
      </label>
      <div class="grupo-botones" role="group" aria-label={T.zona}>
        <button type="button" class="boton" data-zona="todo" aria-pressed="false">{T.todo}</button>
        <button type="button" class="boton" data-zona="posicion" aria-pressed="false">{T.posicion}</button>
        <button type="button" class="boton" data-zona="cuerda" aria-pressed="false">{T.unaCuerda}</button>
        <button type="button" class="boton" data-zona="dos-cuerdas" aria-pressed="false">{T.dosCuerdas}</button>
      </div>
      <span class="campo" data-solo="posicion">
        <button type="button" class="boton" data-mover="-1" aria-label={T.haciaCejuela}>◀</button>
        <label class="campo">{T.desde}
          <select data-desde>{Array.from({ length: ULTIMA_POSICION }, (_, i) => <option value={i + 1}>{i + 1}</option>)}</select>
        </label>
        <button type="button" class="boton" data-mover="1" aria-label={T.haciaPuente}>▶</button>
      </span>
      <label class="campo" data-solo="cuerda">{T.cuerda}
        <select data-cuerda>{CUERDAS.map((c) => <option value={6 - c}>{ordinal(c)}</option>)}</select>
      </label>
      <label class="campo" data-solo="dos-cuerdas">{T.cuerdas}
        <select data-dos-cuerdas>{CUERDAS.slice(0, 5).map((c) => <option value={6 - c}>{ordinal(c)} {T.y} {ordinal(c - 1)}</option>)}</select>
      </label>
      <label class="campo">{T.recorrido}
        <select data-recorrido>{RECORRIDOS.map(([v, n]) => <option value={v}>{n}</option>)}</select>
      </label>
      <label class="casilla"><input type="checkbox" data-pedal /> {T.pedal}</label>
    </div>
    <p class="titulo-escala" data-titulo></p>
    <div class="mastil-caja" data-mastil></div>
    <p class="suave uso" data-uso></p>
    <p class="suave leyenda">{T.leyenda}</p>
    <div class="botones-audio">
      <button type="button" data-audio="una" aria-pressed="false">{T.tocar}</button>
      <button type="button" data-audio="bucle" aria-pressed="false" title={T.bucleAyuda}>{T.bucle}</button>
      <button type="button" data-detener>{I.detener}</button>
    </div>
  </section>

  <nav class="indice" aria-label={I.enEstaPagina}>
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>
</Base>

<script>
  import { formatear, idiomaValido } from '../../i18n/idiomas.ts';
  import { SIMETRICAS_TEXTOS } from '../../i18n/estudio/simetricas.ts';
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { eventosArpegio, mastilSVG, notasFormula, ordenadas, recorrido, secuenciaZona, type NotaMastil, type Zona, posicionValida } from '../../lib/arpegios.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica, mostrarZona } from '../../lib/cliente.ts';
  import { SIMETRICAS, acordesComunes, moverPosicion } from '../../lib/simetricas.ts';
  import { parseNota, pitchClass } from '../../lib/teoria.ts';

  interface Opciones {
    escala: string;
    zona: Zona['tipo'];
    desde: number;
    cuerda: number;
    dosCuerdas: number;
    recorrido: string;
    pedal: boolean;
  }
  const idioma = idiomaValido(document.documentElement.lang);
  const T = SIMETRICAS_TEXTOS[idioma];
  const CLAVE = 'estudio-simetricas:opciones';
  const op: Opciones = {
    escala: 'semitono-tono',
    zona: 'posicion',
    desde: 5,
    cuerda: 5,
    dosCuerdas: 4,
    recorrido: 'grados',
    pedal: false,
    ...leerJSON<Partial<Opciones>>(CLAVE),
  };
  op.desde = posicionValida(op.desde);
  if (!SIMETRICAS.some((s) => s.id === op.escala)) op.escala = SIMETRICAS[0].id;
  let tonica = 'C';
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('estudio-simetricas:sonido');

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const selects = {
    escala: $<HTMLSelectElement>('[data-escala]'),
    desde: $<HTMLSelectElement>('[data-desde]'),
    cuerda: $<HTMLSelectElement>('[data-cuerda]'),
    dosCuerdas: $<HTMLSelectElement>('[data-dos-cuerdas]'),
    recorrido: $<HTMLSelectElement>('[data-recorrido]'),
  };
  const casillaPedal = $<HTMLInputElement>('[data-pedal]');
  const sincronizar = () => {
    for (const [k, sel] of Object.entries(selects)) sel.value = String(op[k as keyof typeof selects]);
  };
  sincronizar();
  casillaPedal.checked = op.pedal;
  const caja = $('[data-mastil]');
  const titulo = $('[data-titulo]');
  const uso = $('[data-uso]');

  const escala = () => SIMETRICAS.find((s) => s.id === op.escala)!;
  const zona = (): Zona =>
    op.zona === 'posicion'
      ? { tipo: 'posicion', desde: op.desde }
      : op.zona === 'cuerda'
        ? { tipo: 'cuerda', cuerda: op.cuerda }
        : op.zona === 'dos-cuerdas'
          ? { tipo: 'dos-cuerdas', cuerda: op.dosCuerdas }
          : { tipo: 'todo' };
  const notas = () => notasFormula(tonica, escala().formula, escala().acorde);

  function pintar() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-zona]')) b.setAttribute('aria-pressed', String(b.dataset.zona === op.zona));
    for (const el of document.querySelectorAll<HTMLElement>('[data-solo]')) el.hidden = el.dataset.solo !== op.zona;
    const s = escala();
    const texto = T.escalas[s.id] ?? s;
    titulo.innerHTML =
      `<strong>${esc(tonica)}${esc(s.sufijo)}</strong> · ${esc(texto.nombre)} · ${esc(s.formula.join(' '))}` +
      `<span class="comunes">${esc(formatear(T.misma, { acordes: acordesComunes(tonica, s).join(', ') }))}</span>`;
    uso.textContent = formatear(T.repite, { uso: texto.uso, n: s.periodo });
    // El eco, hacia el puente si cabe (la posición ocupa 5 trastes y el mástil llega al 15); si no, hacia la cejuela.
    const eco = op.desde + s.periodo + 4 <= 15 ? op.desde + s.periodo : op.desde - s.periodo;
    caja.innerHTML = mastilSVG(notas(), zona(), op.zona === 'posicion' ? [eco] : [], undefined, idioma);
    mostrarZona(caja);
    guardarJSON(CLAVE, op);
  }

  for (const [k, sel] of Object.entries(selects)) {
    sel.addEventListener('change', () => {
      const v = sel.value;
      (op as unknown as Record<string, unknown>)[k] = ['desde', 'cuerda', 'dosCuerdas'].includes(k) ? Number(v) : v;
      pintar();
    });
  }
  casillaPedal.addEventListener('change', () => {
    op.pedal = casillaPedal.checked;
    guardarJSON(CLAVE, op);
  });
  document.addEventListener('click', (e) => {
    const zonaBoton = (e.target as Element).closest<HTMLButtonElement>('button[data-zona]');
    if (zonaBoton) {
      op.zona = zonaBoton.dataset.zona as Zona['tipo'];
      pintar();
      return;
    }
    const mover = (e.target as Element).closest<HTMLButtonElement>('button[data-mover]');
    if (mover) {
      op.desde = moverPosicion(op.desde, escala().periodo, Number(mover.dataset.mover) as 1 | -1);
      sincronizar();
      pintar();
    }
  });

  const CELULAS: Record<string, number[]> = { terceras: [0, 2], 'grupos-4': [0, 1, 2, 3] };

  /** La escala en la posición y después la misma, subiendo y bajando, en la posición del eco. */
  function conEco(n: NotaMastil[]): NotaMastil[] {
    const a = ordenadas(n, { tipo: 'posicion', desde: op.desde });
    const p = escala().periodo;
    const desdeEco = op.desde + p + 4 <= 15 ? op.desde + p : op.desde - p;
    const b = ordenadas(n, { tipo: 'posicion', desde: desdeEco });
    return [...a, ...[...a].reverse().slice(1), ...b, ...[...b].reverse().slice(1)];
  }

  conectarAudio((boton) => {
    const n = notas();
    const z = zona();
    const lista: NotaMastil[] =
      op.recorrido === 'eco' && op.zona === 'posicion'
        ? conEco(n)
        : op.recorrido in CELULAS
          ? secuenciaZona(n, z, CELULAS[op.recorrido])
          : recorrido(n, z);
    // La raíz como pedal, entre E2 y D#3 (el registro más grave de la guitarra).
    const pedal = op.pedal ? 40 + ((pitchClass(parseNota(tonica)) - 4 + 12) % 12) : undefined;
    const { eventos, duracion } = eventosArpegio(lista, tempo(), op.zona === 'todo' && ordenadas(n, z).length > 30, pedal);
    const paso = duracion / (lista.length + 2);
    let marcado = -1;
    const marcar = (k: number) => {
      if (k === marcado) return;
      marcado = k;
      caja.querySelector('.sonando')?.classList.remove('sonando');
      const x = lista[k];
      if (x) caja.querySelector(`.nota[data-midi="${x.midi}"][data-cuerda="${x.cuerda}"]`)?.classList.add('sonando');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion,
      bucle: () => boton.dataset.audio === 'bucle',
      alProgresar: (t) => marcar(Math.min(lista.length - 1, Math.floor(t / paso))),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((t) => {
    tonica = t;
    pintar();
  });
  pintar();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.5rem;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.5rem;
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    font-weight: 700;
  }
  .campo select {
    width: auto;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .titulo-escala {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }
  /* Se pinta desde el script: el estilo con ámbito no le llega. */
  .titulo-escala :global(.comunes) {
    display: block;
    font-size: 0.95rem;
    color: var(--texto-suave);
  }
  /* El mástil no cabe en el móvil: se desplaza en horizontal dentro de su caja. */
  .mastil-caja {
    overflow-x: auto;
    padding: 0.25rem 0.5rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .uso {
    margin: 0.5rem 0 0;
  }
  .leyenda {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
  }
</style>
