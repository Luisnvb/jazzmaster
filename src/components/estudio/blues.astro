---
// Blues (sección Estudio). El texto está en src/data/estudio/blues.md; aquí va la
// comparación de las variantes compás a compás, con el análisis funcional de
// Armonía funcional (lib/armonia.ts). Los compases están en progresiones.yaml. En inglés,
// blues.en.md e i18n/estudio/blues.ts; lo usan pages/estudio/blues.astro y
// pages/en/study/blues.astro.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SelectorTonica from '../../components/SelectorTonica.astro';
import Tempo from '../../components/Tempo.astro';
import * as es from '../../data/estudio/blues.md';
import * as en from '../../data/estudio/blues.en.md';
import { INSTRUMENTOS } from '../../lib/audio.ts';
import { VARIANTES } from '../../lib/blues.ts';
import type { Idioma } from '../../i18n/idiomas.ts';
import { INTERFAZ, nombreSonido } from '../../i18n/interfaz.ts';
import { BLUES } from '../../i18n/estudio/blues.ts';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const T = BLUES[idioma];
const I = INTERFAZ[idioma];
const { Content, getHeadings } = idioma === 'en' ? en : es;
const indice = getHeadings().filter((h) => h.depth === 2);
const todas = await getCollection('progresiones');
const variantes = VARIANTES.map((v) => {
  const p = todas.find((x) => x.id === v.id);
  if (!p) throw new Error(`Falta la progresión ${v.id} en progresiones.yaml`);
  return { ...v, ...T.variantes[v.id], pulsos: p.data.pulsos, compases: p.data.compases };
});
const datos = JSON.stringify(variantes).replace(/</g, '\\u003c');
---

<Base titulo={T.titulo}>
  <SelectorTonica clave="blues" idioma={idioma}>
    <label>{I.sonido}
      <select data-instrumento>{INSTRUMENTOS.map((i) => <option value={i.id}>{nombreSonido(i, idioma)}</option>)}</select>
    </label>
    <Tempo clave="blues" inicial={120} />
  </SelectorTonica>

  <section class="ejemplo" aria-labelledby="titulo-variantes">
    <div class="cabecera-bloque">
      <h2 id="titulo-variantes">{T.variantesLado}</h2>
    </div>
    <div class="opciones">
      <fieldset class="mostrar">
        <legend class="visualmente-oculto">{T.variantesVer}</legend>
        {
          variantes.map((v) => (
            <label class="casilla">
              <input type="checkbox" data-ver={v.id} /> {v.nombre}
            </label>
          ))
        }
      </fieldset>
      <div class="grupo-botones" role="group" aria-label={T.queSeVe}>
        <button type="button" class="boton" data-opcion="analisis" aria-pressed="false" title={T.analisisAyuda}>{T.analisis}</button>
        <button type="button" class="boton" data-opcion="cambios" aria-pressed="false" title={T.cambiosAyuda}>{T.cambios}</button>
        <button type="button" class="boton" data-opcion="bucle" aria-pressed="false" title={T.bucleAyuda}>{T.bucle}</button>
      </div>
    </div>
    <div class="tabla-desliza">
      <div class="tabla-blues" data-tabla></div>
    </div>
    <div class="botones-audio">
      <button type="button" data-detener>{I.detener}</button>
    </div>
    <details class="leyenda">
      <summary>{T.papeles}</summary>
      <ul data-leyenda></ul>
    </details>
  </section>

  <nav class="indice" aria-label={I.enEstaPagina}>
    {indice.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </nav>

  <article class="texto-estudio">
    <Content />
  </article>

  <script type="application/json" id="datos-blues" set:html={datos} />
</Base>

<script>
  import { idiomaValido } from '../../i18n/idiomas.ts';
  import { BLUES } from '../../i18n/estudio/blues.ts';
  import { ARMONIA, notaAnalisis } from '../../i18n/estudio/armonia.ts';
  import { esc, guardarJSON, leerJSON } from '../../lib/almacen.ts';
  import { analizarSecuencia, modoProbable, type Analisis } from '../../lib/armonia.ts';
  import { SOSTENIDOS } from '../../lib/audio.ts';
  import { FRASES, cambiados, type Variante } from '../../lib/blues.ts';
  import { conectarAudio, conectarInstrumento, conectarTempo, conectarTonica } from '../../lib/cliente.ts';
  import { analizarProgresion, secuenciaProgresion, simboloEn, type AcordeGrado } from '../../lib/progresiones.ts';
  import { ruta } from '../../lib/rutas.ts';

  type Datos = Variante & { pulsos?: number; compases: string[] };
  const idioma = idiomaValido(document.documentElement.lang);
  const T = BLUES[idioma];
  const NOMBRE = ARMONIA[idioma].funciones;

  const variantes: Datos[] = JSON.parse(document.getElementById('datos-blues')!.textContent!);
  // Cada variante, analizada una vez (el análisis no depende de la tónica).
  const analizadas = new Map(
    variantes.map((v) => {
      const compases = analizarProgresion(v.compases);
      const acordes = compases.flat();
      const modo = modoProbable(acordes);
      return [v.id, { compases, modo, analisis: analizarSecuencia(acordes, modo).map((r) => ({ ...r, nota: notaAnalisis(r.nota, idioma) })) }] as const;
    }),
  );
  const basico = variantes[0];

  interface Opciones {
    ver: string[];
    analisis: boolean;
    cambios: boolean;
    bucle: boolean;
  }
  const CLAVE = 'blues:opciones';
  const op: Opciones = { ver: variantes.map((v) => v.id), analisis: true, cambios: true, bucle: false, ...leerJSON<Partial<Opciones>>(CLAVE) };
  let tonica = 'C';
  const tempo = conectarTempo();
  const instrumento = conectarInstrumento('blues:sonido');

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const tabla = $('[data-tabla]');
  for (const c of document.querySelectorAll<HTMLInputElement>('[data-ver]')) c.checked = op.ver.includes(c.dataset.ver!);

  const visibles = () => variantes.filter((v) => op.ver.includes(v.id));
  const clase = (r: Analisis) => `funcion-${r.funcion === '?' ? 'otra' : r.funcion}`;

  function celda(v: Datos, compas: number, acordes: AcordeGrado[], primero: number): string {
    const { analisis } = analizadas.get(v.id)!;
    const marcas = op.cambios && v.id !== basico.id ? cambiados(v.compases[compas], basico.compases[compas]) : [];
    return `<div class="celda" style="--n:${acordes.length}">${acordes
      .map((a, j) => {
        const k = primero + j;
        const r = analisis[k];
        const extra = op.analisis
          ? `<span class="insignia ${clase(r)}">${r.funcion}</span><span class="papel">${esc(r.papel)}</span>`
          : `<span class="grado">${esc(a.texto)}</span>`;
        return `<span class="acorde-blues${marcas[j] ? ' nuevo' : ''}" data-v="${v.id}" data-k="${k}" title="${esc(`${a.texto}: ${r.nota}`)}">
          <span class="simbolo">${esc(simboloEn(tonica, a))}</span>${extra}</span>`;
      })
      .join('')}</div>`;
  }

  function pintar() {
    const vs = visibles();
    tabla.style.setProperty('--columnas', String(vs.length));
    // Primer acorde de cada compás en la lista plana de cada variante (para data-k).
    const inicios = new Map(
      vs.map((v) => {
        let n = 0;
        return [v.id, analizadas.get(v.id)!.compases.map((c) => ((n += c.length), n - c.length))];
      }),
    );
    const cabecera =
      `<div class="esquina"></div>` +
      vs
        .map(
          (v) => `<div class="cabeza">
            <h3>${esc(v.nombre)}</h3>
            <p class="suave">${esc(v.descripcion)}</p>
            <div class="acciones">
              <button type="button" class="boton" data-audio="${v.id}" aria-pressed="false">${T.tocar}</button>
              <a class="boton" href="${ruta(T.rutaArmonia)}#progresion=${v.id}" title="${T.analizarAyuda}">${T.analizar}</a>
            </div>
          </div>`,
        )
        .join('');
    let filas = '';
    for (let c = 0; c < 12; c++) {
      const i = FRASES.findIndex((f) => f.desde === c);
      const frase = T.frases[i];
      if (frase) filas += `<div class="frase"><strong>${frase.nombre}</strong> <span class="suave">${frase.papel}</span></div>`;
      filas +=
        `<div class="numero">${c + 1}</div>` +
        vs.map((v) => celda(v, c, analizadas.get(v.id)!.compases[c], inicios.get(v.id)![c])).join('');
    }
    tabla.innerHTML = vs.length ? cabecera + filas : `<p class="suave">${T.elige}</p>`;

    // Leyenda: cada papel que aparece, una vez.
    const vistos = new Map<string, Analisis>();
    for (const v of vs) for (const r of analizadas.get(v.id)!.analisis) if (!vistos.has(r.papel)) vistos.set(r.papel, r);
    $('[data-leyenda]').innerHTML = [...vistos.values()]
      .map((r) => `<li><span class="insignia ${clase(r)}">${r.funcion}</span> <strong>${esc(r.papel)}</strong> (${NOMBRE[r.funcion]}): ${esc(r.nota)}</li>`)
      .join('');

    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-opcion]')) b.setAttribute('aria-pressed', String(op[b.dataset.opcion as 'analisis' | 'cambios' | 'bucle']));
    guardarJSON(CLAVE, op);
  }

  for (const c of document.querySelectorAll<HTMLInputElement>('[data-ver]')) {
    c.addEventListener('change', () => {
      op.ver = [...document.querySelectorAll<HTMLInputElement>('[data-ver]:checked')].map((x) => x.dataset.ver!);
      pintar();
    });
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-opcion]')) {
    b.addEventListener('click', () => {
      const k = b.dataset.opcion as 'analisis' | 'cambios' | 'bucle';
      op[k] = !op[k];
      pintar();
    });
  }

  conectarAudio((boton) => {
    const v = variantes.find((x) => x.id === boton.dataset.audio)!;
    const { eventos, tramos, duracion } = secuenciaProgresion(tonica, analizadas.get(v.id)!.compases, tempo(), v.pulsos ?? 4, {
      sostenido: SOSTENIDOS.includes(instrumento()),
    });
    let marcado = -1;
    const marcar = (k: number) => {
      if (k === marcado) return;
      marcado = k;
      tabla.querySelector('.sonando-ahora')?.classList.remove('sonando-ahora');
      if (k >= 0) tabla.querySelector(`[data-v="${v.id}"][data-k="${k}"]`)?.classList.add('sonando-ahora');
    };
    return {
      eventos,
      instrumento: instrumento(),
      duracion,
      bucle: () => op.bucle,
      alProgresar: (t) => marcar(tramos.findIndex((x) => t >= x.inicio && t < x.fin)),
      alTerminar: () => marcar(-1),
    };
  });

  conectarTonica((t) => {
    tonica = t;
    pintar();
  });
  pintar();
</script>

<style>
  .ejemplo {
    margin: 0 0 1.75rem;
  }
  .cabecera-bloque h2 {
    margin: 0 0 0.75rem;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.5rem;
  }
  .mostrar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .casilla {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
  }
  .casilla input {
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
    accent-color: var(--acento);
  }
  .grupo-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  /* En el móvil, la tabla se desliza en horizontal en lugar de apretar las columnas. */
  .tabla-desliza {
    overflow-x: auto;
  }
  .tabla-blues {
    display: grid;
    grid-template-columns: 2rem repeat(var(--columnas, 4), minmax(10rem, 1fr));
    gap: 0;
  }
  .tabla-blues :global(.esquina),
  .tabla-blues :global(.cabeza) {
    padding: 0 0.5rem 0.6rem;
  }
  .tabla-blues :global(.cabeza h3) {
    margin: 0;
    font-size: 1.15rem;
  }
  .tabla-blues :global(.cabeza p) {
    margin: 0.2rem 0 0.5rem;
    font-size: 0.82rem;
    line-height: 1.35;
  }
  .tabla-blues :global(.acciones) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tabla-blues :global(.acciones a.boton) {
    text-decoration: none;
  }
  .tabla-blues :global(.frase) {
    grid-column: 1 / -1;
    padding: 0.5rem 0.5rem 0.3rem;
    margin-top: 0.4rem;
    border-bottom: 2px solid var(--texto-suave);
    font-size: 0.88rem;
  }
  .tabla-blues :global(.numero) {
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--texto-suave);
    border-bottom: 1px solid var(--borde);
  }
  .tabla-blues :global(.celda) {
    display: flex;
    min-height: 3.6rem;
    border-left: 1px solid var(--borde);
    border-bottom: 1px solid var(--borde);
  }
  .tabla-blues :global(.acorde-blues) {
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.1rem;
    margin: 0.15rem;
    padding: 0.3rem 0.1rem;
    border-radius: var(--radio);
    text-align: center;
  }
  /* Acordes que no están en el blues básico. */
  .tabla-blues :global(.acorde-blues.nuevo) {
    background: var(--acento-suave); /* COLOR: acorde que cambia respecto al blues básico */
  }
  .tabla-blues :global(.acorde-blues.sonando-ahora) {
    box-shadow: 0 0 0 2px var(--acento);
  }
  .tabla-blues :global(.simbolo) {
    font-weight: 700;
    font-size: clamp(0.85rem, calc(1.1rem - (var(--n, 1) - 1) * 0.12rem), 1.1rem);
    overflow-wrap: anywhere;
  }
  .tabla-blues :global(.papel),
  .tabla-blues :global(.grado) {
    font-size: 0.72rem;
    color: var(--acento);
    overflow-wrap: anywhere;
  }
  /* Insignias de función (como en Armonía funcional): T en blanco, SD con borde, D rellena. */
  :global(.insignia) {
    display: inline-block;
    min-width: 2.2em;
    padding: 0 0.35em;
    font-size: 0.72rem;
    font-weight: 700;
    text-align: center;
    border-radius: var(--radio);
    border: 2px solid var(--acento);
  }
  :global(.insignia.funcion-T) {
    background: var(--fondo); /* COLOR: función tónica */
    color: var(--acento);
  }
  :global(.insignia.funcion-SD) {
    background: var(--acento-suave); /* COLOR: función subdominante */
    color: var(--texto);
  }
  :global(.insignia.funcion-D) {
    background: var(--acento); /* COLOR: función dominante */
    color: var(--sobre-acento);
  }
  :global(.insignia.funcion-otra) {
    border-color: var(--borde);
  }
  .leyenda {
    margin-top: 0.75rem;
    font-size: 0.88rem;
  }
  .leyenda summary {
    cursor: pointer;
    font-weight: 700;
  }
  .leyenda ul {
    margin: 0.5rem 0 0;
    padding-left: 0;
    list-style: none;
  }
  .leyenda :global(li) {
    margin: 0.3rem 0;
  }
</style>
