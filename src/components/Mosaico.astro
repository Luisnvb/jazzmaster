---
// Mosaico de accesos grandes (portada de la web y de cada sección).
import type { Pagina } from '../lib/secciones.ts';

interface Props {
  secciones: Pagina[];
  /**
   * Tarjetas numeradas (01, 02…). Sin número, son páginas que se reordenan con las
   * favoritas primero (lib/paginas-favoritas.ts), marcadas con una estrella.
   */
  numerar?: boolean;
}

const { secciones, numerar = true } = Astro.props;
---

<ul class="portada" data-lista-paginas={numerar ? undefined : ''}>
  {
    secciones.map((s, i) => (
      <li data-pagina={numerar ? undefined : s.href}>
        <a href={s.href}>
          <span class="kicker">{numerar ? String(i + 1).padStart(2, '0') : ''}</span>
          <span class="nombre">{s.nombre}</span>
          <span class="lema">{s.lema}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .portada {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 0.75rem;
  }
  .portada a {
    box-sizing: border-box;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    height: 100%;
    min-height: 5.5rem;
    padding: 0.75rem 0.9rem;
    background: var(--tarjeta);
    border: 1px solid var(--borde);
    border-radius: var(--radio-tarjeta);
    color: var(--texto);
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }
  .portada .nombre {
    font-weight: 700;
    font-size: clamp(1.1rem, 1.25vw, 1.4rem);
    letter-spacing: -0.01em;
    line-height: 1.05;
    /* Palabras largas («Rearmonización») en tarjetas estrechas: se parten con guion, sin salirse. */
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .portada .lema {
    color: var(--texto-suave);
    font-size: 0.88rem;
    line-height: 1.35;
  }
  /* En el móvil, tarjetas más bajas: las secciones se ven casi de un vistazo. */
  @media (max-width: 40rem) {
    .portada {
      gap: 0.6rem;
    }
    .portada a {
      min-height: 0;
      gap: 0.35rem;
      padding: 0.8rem 1rem;
    }
    .portada .lema {
      font-size: 0.85rem;
    }
  }
  /* Favorita: la estrella en el hueco del número (no antes del nombre, como en los menús). */
  .portada :global(.favorita) > a::before {
    content: none;
  }
  .portada :global(.favorita) .kicker::before {
    content: '★ Favorita';
    color: var(--acento);
  }
  .portada a:hover {
    background: var(--acento);
    border-color: var(--acento);
    color: var(--sobre-acento);
  }
  .portada a:hover .kicker,
  .portada a:hover .lema,
  .portada a:hover .kicker::before {
    color: var(--sobre-acento);
  }
</style>
