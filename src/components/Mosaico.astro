---
// Mosaico de accesos grandes (portada y secciones múltiples).
import type { Seccion } from '../lib/secciones.ts';

interface Props {
  secciones: Seccion[];
  /** Número de la primera tarjeta (para seguir la cuenta entre grupos). */
  desde?: number;
}

const { secciones, desde = 1 } = Astro.props;
---

<ul class="portada">
  {
    secciones.map((s, i) => (
      <li>
        <a href={s.href}>
          <span class="kicker">{String(i + desde).padStart(2, '0')}</span>
          <span class="nombre">{s.nombre}</span>
          <span class="lema">{s.lema}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .portada {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
  }
  .portada a {
    display: grid;
    align-content: space-between;
    gap: 1rem;
    min-height: 8rem;
    padding: 1rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    color: var(--texto);
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }
  .portada .nombre {
    font-weight: 700;
    font-size: clamp(1.5rem, 1.9vw, 2.3rem);
    letter-spacing: -0.01em;
    line-height: 1.05;
    /* Palabras largas («Rearmonización») en tarjetas estrechas: se parten con guion, sin salirse. */
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .portada .lema {
    color: var(--texto-suave);
    font-size: 1.05rem;
  }
  /* En el móvil, tarjetas más bajas: las secciones se ven casi de un vistazo. */
  @media (max-width: 40rem) {
    .portada {
      gap: 0.6rem;
    }
    .portada a {
      min-height: 0;
      gap: 0.35rem;
      padding: 0.8rem 1rem;
    }
    .portada .lema {
      font-size: 0.95rem;
    }
  }
  .portada a:hover {
    background: var(--acento);
    border-color: var(--acento);
    color: var(--sobre-acento);
  }
  .portada a:hover .kicker,
  .portada a:hover .lema {
    color: var(--sobre-acento);
  }
</style>
